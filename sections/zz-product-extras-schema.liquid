<div></div>
{% schema %}
{
 "name": "Product info blocks",
 "tag": "section",
 "class": "section",
 "enabled_on": {
  "templates": [
   "product"
  ]
 },
 "settings": [
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  }
 ],
 "blocks": [
  {
   "type": "urgency",
   "name": "Urgency text",
   "settings": [
    {
     "type": "range",
     "id": "threshold",
     "min": 1,
     "max": 50,
     "label": "Show when stock is at or below",
     "default": 10
    },
    {
     "type": "text",
     "id": "fallback",
     "label": "Message when stock is above the limit or not tracked (leave empty to show nothing)",
     "default": ""
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "inventory",
   "name": "Inventory status",
   "settings": [
    {
     "type": "checkbox",
     "id": "show_qty",
     "label": "Show quantity",
     "default": false
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "estimated_delivery",
   "name": "Estimated shipping",
   "settings": [
    {
     "type": "range",
     "id": "min_days",
     "min": 1,
     "max": 30,
     "label": "Min days",
     "default": 4
    },
    {
     "type": "range",
     "id": "max_days",
     "min": 2,
     "max": 40,
     "label": "Max days",
     "default": 8
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "benefits",
   "name": "Emoji benefits",
   "settings": [
    {
     "type": "text",
     "id": "b1",
     "label": "Benefit 1",
     "default": "Free shipping worldwide"
    },
    {
     "type": "text",
     "id": "b2",
     "label": "Benefit 2",
     "default": "30-day money-back guarantee"
    },
    {
     "type": "text",
     "id": "b3",
     "label": "Benefit 3"
    },
    {
     "type": "text",
     "id": "b4",
     "label": "Benefit 4"
    },
    {
     "type": "text",
     "id": "b5",
     "label": "Benefit 5"
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "payment_badges",
   "name": "Payment badges",
   "settings": [
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "shipping_checkpoints",
   "name": "Shipping checkpoints",
   "settings": [
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "trust_stars",
   "name": "Trust stars",
   "settings": [
    {
     "type": "text",
     "id": "rating",
     "label": "Your real rating (0-5)",
     "info": "Optional. Leave empty to use your review app's rating (the standard reviews.rating product metafield). Nothing shows if neither exists."
    },
    {
     "type": "text",
     "id": "text",
     "label": "Text after rating (e.g. \"from 320 reviews\")",
     "default": ""
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "bestseller",
   "name": "Bestseller badge",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "⭐ Bestseller"
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "sizing_chart",
   "name": "Sizing chart",
   "settings": [
    {
     "type": "text",
     "id": "label",
     "label": "Label",
     "default": "Size guide"
    },
    {
     "type": "richtext",
     "id": "content",
     "label": "Content",
     "default": "<p>Add your sizing table or text here.</p>"
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "text_icon",
   "name": "Text with icon",
   "settings": [
    {
     "type": "text",
     "id": "icon",
     "label": "Emoji",
     "default": "🚚"
    },
    {
     "type": "text",
     "id": "icon_name",
     "label": "Or icon name (e.g. truck)",
     "info": "From the built-in icon library"
    },
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "Free shipping over $50"
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "custom_field",
   "name": "Custom product field",
   "settings": [
    {
     "type": "text",
     "id": "label",
     "label": "Field label",
     "default": "Engraving text"
    },
    {
     "type": "checkbox",
     "id": "required",
     "label": "Required",
     "default": false
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "breadcrumb",
   "name": "Breadcrumb",
   "settings": [
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "review_avatars",
   "name": "Review avatars",
   "settings": [
    {
     "type": "image_picker",
     "id": "a1",
     "label": "Avatar 1"
    },
    {
     "type": "image_picker",
     "id": "a2",
     "label": "Avatar 2"
    },
    {
     "type": "image_picker",
     "id": "a3",
     "label": "Avatar 3"
    },
    {
     "type": "image_picker",
     "id": "a4",
     "label": "Avatar 4"
    },
    {
     "type": "image_picker",
     "id": "a5",
     "label": "Avatar 5"
    },
    {
     "type": "text",
     "id": "text",
     "label": "Text (use only a claim you can back up)",
     "default": ""
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "divider",
   "name": "Divider",
   "settings": [
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  },
  {
   "type": "liquid",
   "name": "Custom liquid",
   "settings": [
    {
     "type": "liquid",
     "id": "code",
     "label": "Liquid / HTML"
    },
    {
     "type": "range",
     "id": "mb",
     "min": 0,
     "max": 40,
     "step": 4,
     "unit": "px",
     "label": "Margin below",
     "default": 12
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Product info blocks",
   "blocks": [
    {
     "type": "urgency"
    },
    {
     "type": "estimated_delivery"
    },
    {
     "type": "benefits"
    },
    {
     "type": "payment_badges"
    }
   ]
  }
 ]
}
{% endschema %}