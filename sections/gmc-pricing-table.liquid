<div class="page-width gmc-pt {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-pt__grid">{%- for block in section.blocks -%}
    <div class="gmc-pt__card{% if block.settings.featured %} gmc-pt__card--hl{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.badge != blank -%}<span class="gmc-pt__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
      <h3>{{ block.settings.name | escape }}</h3><p class="gmc-pt__price">{{ block.settings.price | escape }}</p>
      <div class="rte">{{ block.settings.features }}</div>
      {%- if block.settings.link != blank -%}<a class="button" href="{{ block.settings.link }}">{{ block.settings.button | escape }}</a>{%- endif -%}
    </div>{%- endfor -%}</div>
</div>
<style>.gmc-pt{padding:36px 0}.gmc-pt__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:1.5rem}.gmc-pt__card{position:relative;border:1px solid rgba(var(--color-foreground),.2);border-radius:14px;padding:2rem;text-align:center}.gmc-pt__card--hl{border:2px solid rgb(var(--color-foreground));transform:scale(1.03)}.gmc-pt__badge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:{{ settings.gmc_accent }};color:#fff;padding:2px 12px;border-radius:99px;font-size:12px}.gmc-pt__price{font-size:2.6rem;font-weight:700;margin:.5rem 0}</style>
{% schema %}
{"name":"Pricing table","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose your plan"},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"blocks":[{"type":"plan","name":"Plan","settings":[{"type":"text","id":"name","label":"Name","default":"Starter"},{"type":"text","id":"price","label":"Price","default":"$19"},{"type":"richtext","id":"features","label":"Features","default":"<ul><li>Feature one</li><li>Feature two</li></ul>"},{"type":"text","id":"badge","label":"Badge"},{"type":"checkbox","id":"featured","label":"Highlight","default":false},{"type":"text","id":"button","label":"Button label","default":"Choose"},{"type":"url","id":"link","label":"Button link"}]}],"max_blocks":4,"presets":[{"name":"Pricing table","blocks":[{"type":"plan"},{"type":"plan","settings":{"name":"Pro","price":"$39","featured":true,"badge":"Popular"}}]}]}
{% endschema %}
