{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one plan block.' -%}{%- endif -%}
<div class="page-width gmc-pt {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-pt__grid gmc-pt__grid--{{ section.settings.card_style }}">{%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <div class="gmc-pt__card{% if b.featured %} gmc-pt__card--hl{% endif %}" {{ block.shopify_attributes }}>
      {%- if b.badge != blank -%}<span class="gmc-pt__badge">{{ b.badge | escape }}</span>{%- endif -%}
      {%- if b.icon_name != blank -%}<span class="gmc-pt__ic">{%- render 'gmc-icon', name: b.icon_name, size: 36 -%}</span>{%- endif -%}
      <h3>{{ b.name | escape }}</h3>
      {%- if b.product != blank -%}
        <p class="gmc-pt__price">{{ b.product.price | money }}{%- if b.product.compare_at_price > b.product.price %} <s style="opacity:.6;font-size:.7em">{{ b.product.compare_at_price | money }}</s>{%- endif -%}{%- if b.price_suffix != blank %} <small>{{ b.price_suffix | escape }}</small>{%- endif -%}</p>
      {%- else -%}<p class="gmc-pt__price">{{ b.price | escape }}{%- if b.price_suffix != blank %} <small>{{ b.price_suffix | escape }}</small>{%- endif -%}</p>{%- endif -%}
      {%- if b.benefits != blank -%}<ul class="gmc-pt__ben" role="list">{%- assign bl = b.benefits | newline_to_br | split: '<br />' -%}{%- for line in bl -%}{%- assign lt = line | strip -%}{%- if lt != blank -%}<li>{%- render 'gmc-icon', name: 'check', size: 16 -%} {{ lt | escape }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
      <div class="rte">{{ b.features }}</div>
      {%- if b.action == 'cart' or b.action == 'checkout' -%}{%- if b.product != blank -%}{%- assign pt_skip = false -%}{%- if b.action == 'checkout' -%}{%- assign pt_skip = true -%}{%- endif -%}{%- render 'gmc-inline-atc', product: b.product, label: b.button, skip: pt_skip, align: 'center' -%}{%- endif -%}
      {%- elsif b.link != blank -%}<a class="button" href="{{ b.link }}">{{ b.button | escape }}</a>{%- endif -%}
    </div>{%- endfor -%}</div>
</div>
<style>.gmc-pt__grid--filled .gmc-pt__card{background:rgba(var(--color-foreground),.05);border-color:transparent}.gmc-pt__grid--shadow .gmc-pt__card{border:0;box-shadow:0 6px 24px rgba(0,0,0,.12)}.gmc-pt__ic{display:block;margin-bottom:.6rem}.gmc-pt__ben{list-style:none;padding:0;margin:1rem 0;text-align:left;display:grid;gap:.5rem}.gmc-pt__ben li{display:flex;gap:.6rem;align-items:center}.gmc-pt{padding:36px 0}.gmc-pt__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:1.5rem}.gmc-pt__card{position:relative;border:1px solid rgba(var(--color-foreground),.2);border-radius:var(--text-boxes-radius);padding:2rem;text-align:center}.gmc-pt__card--hl{border:2px solid rgb(var(--color-foreground));transform:scale(1.03)}.gmc-pt__badge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:{{ settings.gmc_accent }};color:#fff;padding:2px 12px;border-radius:99px;font-size:12px}.gmc-pt__price{font-size:2.6rem;font-weight:700;margin:.5rem 0}</style>
{% schema %}
{
  "name": "Pricing table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your plan"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "shadow",
          "label": "Shadow"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "gmc_card_tint",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "label": "Translucent card tint (0 = off)",
      "info": "Tints the cards over any section background.",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$19"
        },
        {
          "type": "richtext",
          "id": "features",
          "label": "Features",
          "default": "<ul><li>Feature one</li><li>Feature two</li></ul>"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight",
          "default": false
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Choose"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked product (price comes from it)"
        },
        {
          "type": "text",
          "id": "price_suffix",
          "label": "Text after price",
          "info": "For example /month"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name"
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "Benefits (one per line, shown with ticks)"
        },
        {
          "type": "select",
          "id": "action",
          "label": "Button action",
          "options": [
            {
              "value": "link",
              "label": "Go to link"
            },
            {
              "value": "cart",
              "label": "Add linked product to cart"
            },
            {
              "value": "checkout",
              "label": "Add linked product and go to checkout"
            }
          ],
          "default": "link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Pricing table",
      "blocks": [
        {
          "type": "plan"
        },
        {
          "type": "plan",
          "settings": {
            "name": "Pro",
            "price": "$39",
            "featured": true,
            "badge": "Popular"
          }
        }
      ]
    }
  ]
}
{% endschema %}
