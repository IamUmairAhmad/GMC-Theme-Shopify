{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one item block.' -%}{%- endif -%}
{%- comment -%} GMC Theme: trust badge / icon bar (original code) {%- endcomment -%}
<div class="page-width gmc-iconbar">
  {%- if section.settings.heading != blank -%}<h2 class="gmc-iconbar__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <ul class="gmc-iconbar__list gmc-iconbar__list--{{ section.settings.item_layout }}" style="--cols:{{ section.settings.columns }};--cols-m:{{ section.settings.columns_m }};--ic:{{ section.settings.icon_color }};text-align:{{ section.settings.align }}">
    {%- for block in section.blocks -%}
      <li class="gmc-iconbar__item" {{ block.shopify_attributes }}>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gmc-iconbar__a">{%- endif -%}
        {%- if block.settings.icon_name != blank -%}<span class="gmc-iconbar__ic" style="color:var(--ic)">{%- render 'gmc-icon', name: block.settings.icon_name, size: section.settings.icon_size -%}</span>{%- elsif block.settings.icon != blank -%}
          <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="{{ block.settings.icon.alt | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
        {%- endif -%}
        <strong>{{ block.settings.title | escape }}</strong>
        {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
      {%- if block.settings.link != blank -%}</a>{%- endif -%}</li>
    {%- endfor -%}
  </ul>
</div>
<style>
  .gmc-iconbar__list--side .gmc-iconbar__a,.gmc-iconbar__list--side .gmc-iconbar__item{display:flex;gap:1rem;align-items:center;text-align:left}.gmc-iconbar__a{color:inherit;text-decoration:none;display:block}@media(max-width:749px){.gmc-iconbar__list{grid-template-columns:repeat(var(--cols-m,2),1fr)!important}}
  .gmc-iconbar{padding-top:{{ section.settings.pad }}px;padding-bottom:{{ section.settings.pad }}px}
  .gmc-iconbar__title{text-align:center;margin:0 0 2rem}
  .gmc-iconbar__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:1.5rem;text-align:center}
  .gmc-iconbar__item{display:flex;flex-direction:column;align-items:center;gap:.4rem}
  .gmc-iconbar__item img{object-fit:contain}
  .gmc-iconbar__item span{opacity:.75;font-size:.9em}
  @media(max-width:749px){.gmc-iconbar__list{grid-template-columns:repeat(2,1fr)}}
</style>
{% schema %}
{
  "name": "Icon bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_m",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "item_layout",
      "label": "Item layout",
      "options": [
        {
          "value": "stack",
          "label": "Icon above text"
        },
        {
          "value": "side",
          "label": "Icon beside text"
        }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "gmc_card_tint",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "label": "Translucent card tint (0 = off)",
      "info": "Tints the cards over any section background.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop."
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name",
          "info": "From the built-in 2,500-icon library, e.g. truck, shield-check. See assets/gmc-icon-list.txt"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Or icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Delivered in 3-5 days"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Icon bar",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "title": "Easy returns",
            "text": "Your returns message"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Secure payment",
            "text": "SSL encrypted"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "24/7 support",
            "text": "We're here to help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
