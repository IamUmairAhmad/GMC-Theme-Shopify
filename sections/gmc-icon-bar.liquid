{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one item block.' -%}{%- endif -%}
{%- liquid
  assign gap = section.settings.gap
  assign m_only = false
  if section.settings.mobile_slider and section.settings.as_slider == false
    assign m_only = true
  endif
  assign ib_slide = false
  assign ib_attrs = true
  if section.settings.as_slider
    assign ib_slide = true
  endif
-%}
{%- comment -%} GMC Theme: trust badge / icon bar (original code) {%- endcomment -%}
<div class="{% unless section.settings.full_width %}page-width {% endunless %}gmc-iconbar{% if section.settings.full_width %} gmc-iconbar--full{% endif %}{% if m_only %} gmc-iconbar--ms{% endif %}" style="--cols:{{ section.settings.columns }};--cols-m:{{ section.settings.columns_m }};--ic:{{ section.settings.icon_color }};--gmc-gap:{{ gap }}px;text-align:{{ section.settings.align }}">
  {%- if section.settings.heading != blank -%}<h2 class="gmc-iconbar__title {{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.intro != blank -%}<div class="gmc-iconbar__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
  {%- capture ib_items -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign use_filled = false
        if section.settings.filled_icons or block.settings.filled
          assign use_filled = true
        endif
      -%}
      <li class="gmc-iconbar__item{% if ib_slide %} gmc-sl__s{% endif %}{% if section.settings.show_cards %} color-{{ section.settings.card_scheme }} gradient{% endif %}"{% if ib_attrs %} {{ block.shopify_attributes }}{% endif %}>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gmc-iconbar__a">{%- endif -%}
        {%- if block.settings.icon_name != blank -%}<span class="gmc-iconbar__ic">{%- render 'gmc-icon', name: block.settings.icon_name, size: section.settings.icon_size, filled: use_filled -%}</span>{%- elsif block.settings.icon != blank -%}
          <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.icon.alt | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
        {%- endif -%}
        <span class="gmc-iconbar__copy"><strong>{{ block.settings.title | escape }}</strong>{%- if block.settings.text != blank -%}<span class="gmc-iconbar__tx">{{ block.settings.text | escape }}</span>{%- endif -%}</span>
      {%- if block.settings.link != blank -%}</a>{%- endif -%}</li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if section.settings.as_slider -%}
    <div class="gmc-sl gmc-iconbar__sl gmc-iconbar__list--{{ section.settings.item_layout }}" data-gmc-slider data-mode="slide" data-autoplay="{{ section.settings.gmc_slider_autoplay }}" data-loop="true" data-dots="{{ section.settings.slider_dots }}" data-arrows="{{ section.settings.slider_arrows }}" data-drag="true" data-perview="{{ section.settings.columns }}" data-perview-m="{{ section.settings.columns_m }}" style="--per:{{ section.settings.columns }};--per-m:{{ section.settings.columns_m }};--gmc-gap:{{ gap }}px;--gmc-peek:{{ section.settings.peek }}px;--gmc-dot:rgb(var(--color-foreground))" role="region" aria-label="{{ section.settings.heading | default: 'Icon bar' | escape }}">
      <div class="gmc-sl__vp"><ul class="gmc-sl__tr gmc-iconbar__list" role="list">{{ ib_items }}</ul></div>
    </div>
  {%- else -%}
    <ul class="gmc-iconbar__list gmc-iconbar__list--{{ section.settings.item_layout }}{% if m_only %} gmc-iconbar__d{% endif %}" role="list">{{ ib_items }}</ul>
    {%- if m_only -%}
      {%- assign ib_slide = true -%}
      {%- assign ib_attrs = false -%}
      {%- capture ib_items_m -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign use_filled = false
            if section.settings.filled_icons or block.settings.filled
              assign use_filled = true
            endif
          -%}
          <li class="gmc-iconbar__item gmc-sl__s{% if section.settings.show_cards %} color-{{ section.settings.card_scheme }} gradient{% endif %}">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gmc-iconbar__a">{%- endif -%}
            {%- if block.settings.icon_name != blank -%}<span class="gmc-iconbar__ic">{%- render 'gmc-icon', name: block.settings.icon_name, size: section.settings.icon_size, filled: use_filled -%}</span>{%- elsif block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.icon.alt | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
            {%- endif -%}
            <span class="gmc-iconbar__copy"><strong>{{ block.settings.title | escape }}</strong>{%- if block.settings.text != blank -%}<span class="gmc-iconbar__tx">{{ block.settings.text | escape }}</span>{%- endif -%}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}</li>
        {%- endfor -%}
      {%- endcapture -%}
      <div class="gmc-sl gmc-iconbar__sl gmc-iconbar__m gmc-iconbar__list--{{ section.settings.item_layout }}" data-gmc-slider data-mode="slide" data-autoplay="{{ section.settings.gmc_slider_autoplay }}" data-loop="false" data-dots="{{ section.settings.slider_dots }}" data-arrows="{{ section.settings.slider_arrows }}" data-arrows-pos="below" data-pag-pos="under" data-drag="true" data-perview="{{ section.settings.columns }}" data-perview-m="{{ section.settings.columns_m }}" style="--per:{{ section.settings.columns }};--per-m:{{ section.settings.columns_m }};--gmc-gap:{{ gap }}px;--gmc-peek:{{ section.settings.peek }}px;--gmc-dot:rgb(var(--color-foreground))" role="region" aria-label="{{ section.settings.heading | default: 'Icon bar' | escape }}">
        <div class="gmc-sl__vp"><ul class="gmc-sl__tr gmc-iconbar__list" role="list">{{ ib_items_m }}</ul></div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
<style>
  .gmc-iconbar{padding-top:{{ section.settings.pad }}px;padding-bottom:{{ section.settings.pad }}px}
  .gmc-iconbar--full{padding-left:1.5rem;padding-right:1.5rem}
  .gmc-iconbar__title{margin:0 0 1.2rem}
  .gmc-iconbar__intro{margin:0 auto 2rem;max-width:72rem}
  .gmc-iconbar__intro > :first-child{margin-top:0}
  .gmc-iconbar__intro > :last-child{margin-bottom:0}
  .gmc-iconbar__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:var(--gmc-gap,15px)}
  .gmc-iconbar__item{display:flex;flex-direction:column;align-items:center;gap:.4rem}
  .gmc-iconbar__a{color:inherit;text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:.4rem;width:100%}
  .gmc-iconbar__ic{color:var(--ic);display:inline-flex;line-height:0}
  .gmc-iconbar__copy{display:flex;flex-direction:column;gap:.2rem;min-width:0}
  .gmc-iconbar__tx{opacity:.75;font-size:.9em}
  .gmc-iconbar__item img{object-fit:contain}
  .gmc-iconbar__item.gradient{padding:1.2rem;border-radius:var(--text-boxes-radius,8px)}
  .gmc-iconbar__sl .gmc-iconbar__list{display:flex!important;grid-template-columns:none!important}
  .gmc-iconbar__list--side .gmc-iconbar__a,
  .gmc-iconbar__list--side .gmc-iconbar__item:not(:has(.gmc-iconbar__a)){display:grid;grid-template-columns:auto 1fr;column-gap:1rem;row-gap:.2rem;align-items:center;justify-items:start;text-align:left}
  .gmc-iconbar__list--side .gmc-iconbar__copy{grid-column:1 / -1}
  .gmc-iconbar__list--side :is(.gmc-iconbar__ic,img){grid-column:1;grid-row:1 / span 2;align-self:center}
  .gmc-iconbar__list--side :is(.gmc-iconbar__a,.gmc-iconbar__item):has(.gmc-iconbar__ic) .gmc-iconbar__copy,
  .gmc-iconbar__list--side :is(.gmc-iconbar__a,.gmc-iconbar__item):has(img) .gmc-iconbar__copy{grid-column:2;grid-row:1 / span 2;align-self:center}
  .gmc-iconbar[style*="text-align:left"] .gmc-iconbar__list--stack :is(.gmc-iconbar__item,.gmc-iconbar__a){align-items:flex-start;text-align:left}
  @media(min-width:750px){
    .gmc-iconbar--full{padding-left:2rem;padding-right:2rem}
    .gmc-iconbar__m{display:none!important}
  }
  @media(max-width:749px){
    .gmc-iconbar__list{grid-template-columns:repeat(var(--cols-m,2),1fr)}
    .gmc-iconbar--ms .gmc-iconbar__d{display:none!important}
    .gmc-iconbar__m.gmc-sl--arr-below{display:grid;grid-template-columns:auto 1fr auto;grid-template-areas:"vp vp vp" "prev dots next";align-items:center;column-gap:.8rem;padding-bottom:0}
    .gmc-iconbar__m .gmc-sl__vp{grid-area:vp}
    .gmc-iconbar__m.gmc-sl--arr-below .gmc-sl__dots{grid-area:dots;display:flex;position:static;margin:1.2rem 0 0}
    .gmc-iconbar__m.gmc-sl--arr-below .gmc-sl__a{position:static;transform:none;margin-top:1.2rem;width:3.6rem;height:3.6rem;background:rgba(128,128,128,.2);color:inherit}
    .gmc-iconbar__m.gmc-sl--arr-below .gmc-sl__a--prev{grid-area:prev;left:auto}
    .gmc-iconbar__m.gmc-sl--arr-below .gmc-sl__a--next{grid-area:next;right:auto}
  }
</style>
{% schema %}
{
  "name": "Icon bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_m",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Space between items",
      "default": 15
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "item_layout",
      "label": "Item layout",
      "options": [
        {
          "value": "stack",
          "label": "Icon above text"
        },
        {
          "value": "side",
          "label": "Icon beside text"
        }
      ],
      "default": "stack"
    },
    {
      "type": "checkbox",
      "id": "filled_icons",
      "label": "Filled icons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Put each item on a card",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "card_scheme",
      "label": "Card colour",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "as_slider",
      "label": "Slide the icons",
      "info": "Uses the column counts above on both desktop and mobile. Arrows, dots and autoplay are in Slider options.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Slide on mobile only",
      "info": "Used when Slide the icons is off. Phones get one sliding row with dots and arrows underneath. Desktop stays a grid.",
      "default": false
    },
    {
      "type": "range",
      "id": "peek",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Peek of the next icon",
      "info": "Used when icons slide. 0 shows only the full columns.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "slider_arrows",
      "label": "Slider arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "slider_dots",
      "label": "Slider dots",
      "default": true
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "info": "Stretches past the theme page width. Leave this off when a max content width is set.",
      "default": false
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "gmc_card_tint",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "label": "Translucent card tint (0 = off)",
      "info": "Tints the cards over any section background.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name",
          "info": "From the built-in 2,500-icon library, e.g. truck, shield-check. See assets/gmc-icon-list.txt"
        },
        {
          "type": "checkbox",
          "id": "filled",
          "label": "Filled icon",
          "info": "Fills this icon. The section Filled icons setting fills every icon.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Or icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Delivered in 3-5 days"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Icon bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon_name": "truck"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_name": "refresh",
            "title": "Easy returns",
            "text": "Your returns message"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_name": "lock",
            "title": "Secure payment",
            "text": "SSL encrypted"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_name": "headset",
            "title": "24/7 support",
            "text": "We're here to help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
