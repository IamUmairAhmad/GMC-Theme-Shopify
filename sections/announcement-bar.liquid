{%- render 'gmc-scheme' -%}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{%- capture gmc_gate -%}{%- render 'gmc-gate', only: section.settings.gmc_only, hide: section.settings.gmc_hide -%}{%- endcapture -%}
{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- unless gmc_gate contains 'hide' -%}
<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- liquid
      assign lay_d = section.settings.gmc_layout_d
      assign lay_m = section.settings.gmc_layout_m
      assign need_slider = false
      assign need_cols = false
      if section.blocks.size > 1
        if lay_d == 'slider' or lay_m == 'slider'
          assign need_slider = true
        endif
        if lay_d == 'columns' or lay_m == 'columns'
          assign need_cols = true
        endif
      endif
      case section.settings.gmc_slider_type
        when 'fade'
          assign sl_mode = 'fade'
          assign sl_loop = 'true'
        when 'slide'
          assign sl_mode = 'slide'
          assign sl_loop = 'false'
        else
          assign sl_mode = 'slide'
          assign sl_loop = 'true'
      endcase
      assign sl_auto = 0
      if section.settings.auto_rotate
        assign sl_auto = section.settings.change_slides_speed
      endif
    -%}
    {%- if section.blocks.size == 1 -%}
      <div class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
        {%- render 'gmc-an-block', block: section.blocks.first -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <div class="announcement-bar gmc-an-wrap" role="region" aria-label="{{ 'sections.announcements.announcement_bar' | t }}">
        {%- if need_slider -%}
          <div class="gmc-sl gmc-an-sl{% if lay_d != 'slider' %} gmc-an-m-only{% endif %}{% if lay_m != 'slider' %} gmc-an-d-only{% endif %}" data-gmc-slider data-mode="{{ sl_mode }}" data-autoplay="{{ sl_auto }}" data-loop="{{ sl_loop }}" data-dots="false" data-arrows="true" data-drag="true">
            <div class="gmc-sl__vp"><div class="gmc-sl__tr">
              {%- for block in section.blocks -%}
                <div class="gmc-sl__s" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}">{%- render 'gmc-an-block', block: block -%}</div>
              {%- endfor -%}
            </div></div>
          </div>
        {%- endif -%}
        {%- if need_cols -%}
          <div class="gmc-an-cols{% if section.settings.gmc_sep %} gmc-an-cols--sep{% endif %}{% if lay_d != 'columns' %} gmc-an-m-only{% endif %}{% if lay_m != 'columns' %} gmc-an-d-only{% endif %}" style="--cd:{{ section.settings.gmc_cols_d }};--cm:{{ section.settings.gmc_cols_m }};--gap:{{ section.settings.gmc_gap }}px">
            {%- for block in section.blocks -%}{%- render 'gmc-an-block', block: block -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{%- endunless -%}
{%- render 'gmc-section-extras' -%}
{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "gmc_layout_d",
      "label": "Desktop layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "columns",
          "label": "Columns"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "gmc_layout_m",
      "label": "Mobile layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "columns",
          "label": "Columns"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "gmc_slider_type",
      "label": "Slider type",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "loop",
          "label": "Loop"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "loop"
    },
    {
      "type": "range",
      "id": "gmc_cols_d",
      "min": 0,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop (0 = auto)",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_cols_m",
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "Columns on mobile (0 = auto)",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Space between columns",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "gmc_sep",
      "label": "Separators between columns",
      "default": false
    },
    {
      "type": "header",
      "content": "Show only on products"
    },
    {
      "type": "textarea",
      "id": "gmc_only",
      "label": "Show only on these product handles",
      "info": "Comma separated. Leave empty to show everywhere."
    },
    {
      "type": "textarea",
      "id": "gmc_hide",
      "label": "Hide on these product handles",
      "info": "Comma separated."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.announcement-bar.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    },
    {
      "type": "header",
      "content": "GMC extras"
    },
    {
      "type": "select",
      "id": "gmc_hide_on",
      "label": "Hide section on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Or icon image"
        },
        {
          "type": "range",
          "id": "size",
          "min": 0,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Text size (0 = default)",
          "default": 0
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "row",
              "label": "Side by side"
            },
            {
              "value": "stack",
              "label": "Stacked"
            }
          ],
          "default": "row"
        }
      ]
    },
    {
      "type": "code",
      "name": "Discount code",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Use code"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Code",
          "default": "SAVE10"
        },
        {
          "type": "text",
          "id": "copy_label",
          "label": "Copy button text",
          "default": "Copy"
        },
        {
          "type": "text",
          "id": "copied_text",
          "label": "Copied text",
          "default": "Copied"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Or icon image"
        },
        {
          "type": "range",
          "id": "size",
          "min": 0,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Text size (0 = default)",
          "default": 0
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "row",
              "label": "Side by side"
            },
            {
              "value": "stack",
              "label": "Stacked"
            }
          ],
          "default": "row"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social icons",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the social links from Theme settings."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
