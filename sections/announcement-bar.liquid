      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "gmc_layout_d",
      "label": "Desktop layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "columns",
          "label": "Columns"
        }
      ],
      "default": "columns"
    },
    {
      "type": "select",
      "id": "gmc_layout_m",
      "label": "Mobile layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "columns",
          "label": "Columns"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "gmc_slider_type",
      "label": "Slider type",
      "options": [
        {
          "value": "slide",
          "label": "Classic"
        },
        {
          "value": "loop",
          "label": "Infinite"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "loop"
    },
    {
      "type": "range",
      "id": "gmc_cols_d",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "info": "0 fits every block in the centre. With a slider, 0 shows one block at a time.",
      "default": 1
    },
    {
      "type": "range",
      "id": "gmc_cols_m",
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "info": "0 fits every block in the centre. With a slider, 0 shows one block at a time.",
      "default": 1
    },
    {
      "type": "range",
      "id": "gmc_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop spacing",
      "default": 28
    },
    {
      "type": "range",
      "id": "gmc_gap_m",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Mobile spacing",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "gmc_sep",
      "label": "Show separator between blocks",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "Show only on products"
    },
    {
      "type": "textarea",
      "id": "gmc_only",
      "label": "Show only on these product handles",
      "info": "Comma separated. Leave empty to show everywhere."
    },
    {
      "type": "textarea",
      "id": "gmc_hide",
      "label": "Hide on these product handles",
      "info": "Comma separated."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
