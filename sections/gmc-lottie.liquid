{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.settings.json_url == blank -%}{%- render 'gmc-empty', msg: 'Paste an animation JSON URL.' -%}{%- endif -%}
{%- if section.settings.json_url != blank -%}
<div class="page-width gmc-lt {% render 'gmc-vis', hide: section.settings.hide_on %}" style="text-align:center;padding:{{ section.settings.pad }}px 0">
  <div id="gmc-lt-{{ section.id }}" role="img" aria-label="{{ section.settings.alt | escape }}" style="max-width:{{ section.settings.width }}px;margin:0 auto"></div>
</div>
<script>(function(){var id='gmc-lt-{{ section.id }}';
function go(){var el=document.getElementById(id);if(!el||!window.lottie)return;var a=lottie.loadAnimation({container:el,renderer:'svg',loop:{{ section.settings.loop | json }},autoplay:{{ section.settings.autoplay | json }},path:{{ section.settings.json_url | json }}});a.setSpeed({{ section.settings.speed | json }});}
if(window.lottie){go();}else{var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js';s.onload=go;document.head.appendChild(s);}})();</script>
{%- endif -%}
{% schema %}
{
  "name": "JSON animation (Lottie)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "json_url",
      "label": "Animation JSON URL",
      "info": "Upload the .json file under Content > Files and paste its URL."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Description (accessibility)"
    },
    {
      "type": "range",
      "id": "width",
      "min": 120,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 400
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "label": "Speed",
      "default": 1
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Spacing",
      "default": 24
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "JSON animation (Lottie)"
    }
  ]
}
{% endschema %}
