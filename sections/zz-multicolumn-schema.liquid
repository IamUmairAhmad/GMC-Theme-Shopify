<div></div>
{% schema %}
{
  "name": "Multicolumn (Advanced)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "label": "Columns (mobile grid)",
      "default": 1
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "swipe",
          "label": "Swipe carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "swipe_width",
      "min": 50,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Swipe card width",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },
    {
      "type": "select",
      "id": "style",
      "label": "Column style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "card",
          "label": "Filled card"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "hover",
      "label": "Hover effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "zoom",
          "label": "Zoom image"
        }
      ],
      "default": "none"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "rect",
          "label": "Rectangle"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "rect"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Circle size",
      "default": 160
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "3/2",
          "label": "Landscape"
        },
        {
          "value": "16/9",
          "label": "Wide"
        }
      ],
      "default": "3/2"
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 40,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "Show step numbers",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Section button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Section button link"
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "select",
      "id": "gmc_hide_on",
      "label": "Hide section on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Or icon name",
          "info": "Used when no image is chosen. See assets/gmc-icon-list.txt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Column title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this point.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (makes the whole column clickable)"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Column background (optional)"
        },
        {
          "type": "color",
          "id": "fg",
          "label": "Column text (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Multicolumn (Advanced)",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon_name": "truck",
            "title": "Fast shipping"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon_name": "shield-check",
            "title": "Secure checkout"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon_name": "refresh",
            "title": "Easy returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}