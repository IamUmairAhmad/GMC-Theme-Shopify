{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.settings.blog == blank and blog == blank -%}{%- render 'gmc-empty', msg: 'Choose a blog.' -%}{%- endif -%}
{%- assign blog = section.settings.blog | default: blog -%}
{%- if blog != blank -%}
<div class="page-width gmc-bl {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}<div class="gmc-bl__tags"><a href="{{ blog.url }}">All</a>{%- for tag in blog.all_tags limit: 8 -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>{%- endfor -%}</div>{%- endif -%}
  <div class="gmc-bl__g">{%- for article in blog.articles limit: section.settings.count -%}
    <a class="gmc-bl__c{% if forloop.first and section.settings.featured %} gmc-bl__c--hero{% endif %}" href="{{ article.url }}">
      {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,700,900' }}{%- endif -%}
      <span class="gmc-bl__t"><small>{{ article.published_at | time_tag: '%b %d, %Y' }}{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</small><strong>{{ article.title | escape }}</strong>{%- if section.settings.excerpt -%}<span>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</span>{%- endif -%}</span>
    </a>{%- endfor -%}</div>
</div>
<style>.gmc-bl{padding:36px 0}.gmc-bl__tags{display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin:1rem 0}.gmc-bl__tags a{padding:.4rem 1.2rem;border:1px solid rgba(var(--color-foreground),.25);border-radius:var(--badge-corner-radius,99px);text-decoration:none;font-size:1.3rem}.gmc-bl__g{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;margin-top:1.5rem}.gmc-bl__c{text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:.8rem}.gmc-bl__c img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:var(--media-radius)}.gmc-bl__c--hero{grid-column:span 3;display:grid;grid-template-columns:1.4fr 1fr;align-items:center}.gmc-bl__c--hero strong{font-size:2.6rem}.gmc-bl__t{display:grid;gap:.4rem}.gmc-bl__t small{opacity:.65}.gmc-bl__t>span{opacity:.8}@media(max-width:749px){.gmc-bl__g{grid-template-columns:1fr}.gmc-bl__c--hero{grid-column:auto;display:flex}}</style>
{%- endif -%}
{% schema %}
{
  "name": "Blog grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Leave empty on a blog template to use that blog."
    },
    {
      "type": "range",
      "id": "count",
      "min": 3,
      "max": 12,
      "label": "Posts",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "featured",
      "label": "Large featured first post",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tag filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Blog grid"
    }
  ]
}
{% endschema %}
