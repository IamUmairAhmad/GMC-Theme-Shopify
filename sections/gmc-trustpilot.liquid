{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one review block.' -%}{%- endif -%}
<div class="page-width gmc-tp {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.score != blank -%}<div class="gmc-tp__head"><span class="gmc-tp__logo">★ Trustpilot</span><span class="gmc-tp__stars" aria-hidden="true">{%- for i in (1..5) -%}<i>★</i>{%- endfor -%}</span><span>{{ section.settings.score | escape }} · {{ section.settings.count | escape }}</span></div>{%- endif -%}
  {%- if section.settings.embed != blank -%}<div class="gmc-tp__embed">{{ section.settings.embed }}</div>{%- endif -%}
  <div class="gmc-tp__grid">{%- for block in section.blocks -%}<div class="gmc-tp__card" {{ block.shopify_attributes }}><span class="gmc-tp__stars gmc-tp__stars--sm">{%- for i in (1..block.settings.rating) -%}<i>★</i>{%- endfor -%}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p><small>{{ block.settings.name | escape }}</small></div>{%- endfor -%}</div>
</div>
<style>.gmc-tp{padding:36px 0}.gmc-tp__head{display:flex;gap:1rem;align-items:center;justify-content:center;flex-wrap:wrap;font-weight:600}.gmc-tp__logo{font-weight:800}.gmc-tp__stars i{font-style:normal;background:#00b67a;color:#fff;padding:2px 5px;margin-right:2px;display:inline-block}.gmc-tp__stars--sm i{font-size:1.2rem}.gmc-tp__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.2rem;margin-top:1.5rem}.gmc-tp__card{border:1px solid rgba(var(--color-foreground),.15);border-radius:var(--text-boxes-radius);padding:1.4rem}.gmc-tp__card h3{margin:.8rem 0 .3rem;font-size:1.6rem}.gmc-tp__card p{margin:0 0 .8rem}.gmc-tp__embed{margin-top:1.5rem}</style>
{% schema %}
{
  "name": "Trustpilot reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "score",
      "label": "Score text",
      "info": "Your real Trustpilot score / review count. The header is hidden while the score is empty."
    },
    {
      "type": "text",
      "id": "count",
      "label": "Review count text",
      "info": "Your real Trustpilot score / review count. The header is hidden while the score is empty."
    },
    {
      "type": "liquid",
      "id": "embed",
      "label": "Optional official TrustBox embed code",
      "info": "Paste the widget code from your Trustpilot Business account to show live reviews."
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Review headline"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Fast delivery and exactly as described."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Trustpilot reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
