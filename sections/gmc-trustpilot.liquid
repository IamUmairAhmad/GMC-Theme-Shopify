<div class="page-width gmc-tp {% render 'gmc-vis', hide: section.settings.hide_on %}">
  <div class="gmc-tp__head"><span class="gmc-tp__logo">★ Trustpilot</span><span class="gmc-tp__stars" aria-hidden="true">{%- for i in (1..5) -%}<i>★</i>{%- endfor -%}</span><span>{{ section.settings.score | escape }} · {{ section.settings.count | escape }}</span></div>
  {%- if section.settings.embed != blank -%}<div class="gmc-tp__embed">{{ section.settings.embed }}</div>{%- endif -%}
  <div class="gmc-tp__grid">{%- for block in section.blocks -%}<div class="gmc-tp__card" {{ block.shopify_attributes }}><span class="gmc-tp__stars gmc-tp__stars--sm">{%- for i in (1..block.settings.rating) -%}<i>★</i>{%- endfor -%}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p><small>{{ block.settings.name | escape }}</small></div>{%- endfor -%}</div>
</div>
<style>.gmc-tp{padding:36px 0}.gmc-tp__head{display:flex;gap:1rem;align-items:center;justify-content:center;flex-wrap:wrap;font-weight:600}.gmc-tp__logo{font-weight:800}.gmc-tp__stars i{font-style:normal;background:#00b67a;color:#fff;padding:2px 5px;margin-right:2px;display:inline-block}.gmc-tp__stars--sm i{font-size:1.2rem}.gmc-tp__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.2rem;margin-top:1.5rem}.gmc-tp__card{border:1px solid rgba(var(--color-foreground),.15);border-radius:10px;padding:1.4rem}.gmc-tp__card h3{margin:.8rem 0 .3rem;font-size:1.6rem}.gmc-tp__card p{margin:0 0 .8rem}.gmc-tp__embed{margin-top:1.5rem}</style>
{% schema %}
{"name":"Trustpilot reviews","tag":"section","class":"section","settings":[{"type":"text","id":"score","label":"Score text","default":"4.8 Excellent"},{"type":"text","id":"count","label":"Review count text","default":"based on 1,200 reviews"},{"type":"liquid","id":"embed","label":"Optional official TrustBox embed code","info":"Paste the widget code from your Trustpilot Business account to show live reviews."},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","min":1,"max":5,"label":"Stars","default":5},{"type":"text","id":"title","label":"Title","default":"Great service"},{"type":"textarea","id":"text","label":"Text","default":"Fast delivery and exactly as described."},{"type":"text","id":"name","label":"Name","default":"Verified customer"}]}],"max_blocks":9,"presets":[{"name":"Trustpilot reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}
