{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add column blocks.' -%}{%- endif -%}
<div class="gmc-mc page-width" id="gmc-mc-{{ section.id }}" style="--cols:{{ s.columns }};--mcols:{{ s.columns_mobile }};--gap:{{ s.gap }}px;--ta:{{ s.text_align }};--ratio:{{ s.ratio }};--rad:{{ s.radius }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px">
  {%- if s.heading != blank or s.subheading != blank -%}<header class="gmc-mc__head">{%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}{%- if s.subheading != blank -%}<p>{{ s.subheading | escape }}</p>{%- endif -%}</header>{%- endif -%}
  <ul class="gmc-mc__g gmc-mc__g--{{ s.mobile_layout }} gmc-mc__style--{{ s.style }} gmc-mc__hover--{{ s.hover }}" role="list">
    {%- for block in section.blocks -%}
      <li class="gmc-mc__c" {% if block.settings.bg != blank %}style="background:{{ block.settings.bg }};{% if block.settings.fg != blank %}color:{{ block.settings.fg }}{% endif %}"{% endif %} {{ block.shopify_attributes }}>
        {%- if s.numbered -%}<span class="gmc-mc__n" aria-hidden="true">{{ forloop.index }}</span>{%- endif -%}
        {%- if block.settings.image != blank -%}
          <div class="gmc-mc__img gmc-mc__img--{{ s.image_shape }}">{%- assign gmc_fp = 'object-position:' | append: block.settings.image.presentation.focal_point -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240,400,600,800', style: gmc_fp, alt: block.settings.image.alt }}</div>
        {%- elsif block.settings.icon_name != blank -%}
          <div class="gmc-mc__icon">{%- render 'gmc-icon', name: block.settings.icon_name, size: s.icon_size -%}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}<h3 class="gmc-mc__t">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gmc-mc__a">{{ block.settings.title | escape }}</a>{%- else -%}{{ block.settings.title | escape }}{%- endif -%}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="rte gmc-mc__x">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link != blank and block.settings.link_label != blank -%}<a class="gmc-mc__l" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} →</a>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if s.button_label != blank and s.button_link != blank -%}<div class="gmc-mc__cta"><a class="button" href="{{ s.button_link }}">{{ s.button_label | escape }}</a></div>{%- endif -%}
</div>
<style>
  #gmc-mc-{{ section.id }} .gmc-mc__head{text-align:center;margin-bottom:2.4rem}#gmc-mc-{{ section.id }} .gmc-mc__head h2{margin:0}#gmc-mc-{{ section.id }} .gmc-mc__head p{margin:.6rem 0 0;opacity:.75}
  #gmc-mc-{{ section.id }} .gmc-mc__g{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:var(--gap)}
  #gmc-mc-{{ section.id }} .gmc-mc__c{position:relative;text-align:var(--ta);display:flex;flex-direction:column;gap:.8rem;align-items:{% if s.text_align == 'center' %}center{% elsif s.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  #gmc-mc-{{ section.id }} .gmc-mc__style--card .gmc-mc__c{padding:2rem;border-radius:var(--rad);background:rgba(var(--color-foreground),.05)}
  #gmc-mc-{{ section.id }} .gmc-mc__style--bordered .gmc-mc__c{padding:2rem;border-radius:var(--rad);border:1px solid rgba(var(--color-foreground),.2)}
  #gmc-mc-{{ section.id }} .gmc-mc__img{width:100%;overflow:hidden;border-radius:var(--rad)}#gmc-mc-{{ section.id }} .gmc-mc__img img{display:block;width:100%;aspect-ratio:var(--ratio);object-fit:cover;transition:transform .4s}
  #gmc-mc-{{ section.id }} .gmc-mc__img--circle{width:min(100%,{{ s.circle_size }}px);aspect-ratio:1;border-radius:50%}#gmc-mc-{{ section.id }} .gmc-mc__img--circle img{height:100%;aspect-ratio:1}
  #gmc-mc-{{ section.id }} .gmc-mc__t,#gmc-mc-{{ section.id }} .gmc-mc__x>:first-child{margin:0}#gmc-mc-{{ section.id }} .gmc-mc__x{opacity:.85}#gmc-mc-{{ section.id }} .gmc-mc__a{color:inherit;text-decoration:none}
  #gmc-mc-{{ section.id }} .gmc-mc__a::after{content:"";position:absolute;inset:0}
  #gmc-mc-{{ section.id }} .gmc-mc__l{margin-top:auto;font-weight:600}
  #gmc-mc-{{ section.id }} .gmc-mc__n{position:absolute;top:-1rem;left:-.4rem;width:3.2rem;height:3.2rem;border-radius:50%;background:rgb(var(--color-foreground));color:rgb(var(--color-background));display:grid;place-items:center;font-weight:700;z-index:2}
  #gmc-mc-{{ section.id }} .gmc-mc__hover--lift .gmc-mc__c{transition:transform .25s,box-shadow .25s}#gmc-mc-{{ section.id }} .gmc-mc__hover--lift .gmc-mc__c:hover{transform:translateY(-6px);box-shadow:0 14px 28px rgba(var(--color-shadow),.12)}
  #gmc-mc-{{ section.id }} .gmc-mc__hover--zoom .gmc-mc__c:hover .gmc-mc__img img{transform:scale(1.07)}
  #gmc-mc-{{ section.id }} .gmc-mc__cta{text-align:center;margin-top:2.4rem}
  #gmc-mc-{{ section.id }} a:focus-visible{outline:2px solid rgb(var(--color-foreground));outline-offset:3px}
  @media(max-width:749px){#gmc-mc-{{ section.id }} .gmc-mc__g{grid-template-columns:repeat(var(--mcols),1fr)}
    #gmc-mc-{{ section.id }} .gmc-mc__g--swipe{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:var(--gap);padding-bottom:1rem;scrollbar-width:thin}
    #gmc-mc-{{ section.id }} .gmc-mc__g--swipe .gmc-mc__c{flex:0 0 {{ s.swipe_width }}%;scroll-snap-align:start}}
  @media(prefers-reduced-motion:reduce){#gmc-mc-{{ section.id }} *{transition:none!important}}
</style>
{% schema %}
{
  "name": "Multicolumn (Advanced)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile grid)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "swipe",
          "label": "Swipe carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "swipe_width",
      "min": 50,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Swipe card width",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },
    {
      "type": "select",
      "id": "style",
      "label": "Column style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "card",
          "label": "Filled card"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "hover",
      "label": "Hover effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "zoom",
          "label": "Zoom image"
        }
      ],
      "default": "none"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "rect",
          "label": "Rectangle"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "rect"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Circle size",
      "default": 160
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "3/2",
          "label": "Landscape"
        },
        {
          "value": "16/9",
          "label": "Wide"
        }
      ],
      "default": "3/2"
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 40,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "Show step numbers",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Section button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Section button link"
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "select",
      "id": "gmc_hide_on",
      "label": "Hide section on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop."
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Or icon name",
          "info": "Used when no image is chosen. See assets/gmc-icon-list.txt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Column title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this point.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (makes the whole column clickable)"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Column background (optional)"
        },
        {
          "type": "color",
          "id": "fg",
          "label": "Column text (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Multicolumn (Advanced)",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon_name": "truck",
            "title": "Fast shipping"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon_name": "shield-check",
            "title": "Secure checkout"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon_name": "refresh",
            "title": "Easy returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
