{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'quotes', title: 'Product reviews' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- comment -%}
  GMC Theme: product reviews area (original code). Hosts your review app's block or embed code and shows the product rating
  from the standard reviews.rating / reviews.rating_count metafields (set by review apps such as Judge.me, Loox, Stamped).
{%- endcomment -%}
{%- assign rv = product.metafields.reviews.rating.value -%}
{%- assign rv_count = product.metafields.reviews.rating_count.value -%}
{%- assign has_content = false -%}
{%- assign has_widget = false -%}
{%- for block in section.blocks -%}{%- if block.type == '@app' or block.type == 'custom_liquid' -%}{%- assign has_widget = true -%}{%- endif -%}{%- endfor -%}
{%- if has_widget or rv != blank -%}{%- assign has_content = true -%}{%- endif -%}
{%- if has_content or request.design_mode -%}
<div id="reviews" class="gmc-rv color-{{ section.settings.color_scheme }} gradient" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="page-width gmc-rv--{{ section.settings.width }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="title {{ section.settings.heading_size }}" style="text-align:{{ section.settings.align }};margin:0 0 2rem">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'rating_summary' -%}
          {%- if rv != blank -%}
            {%- liquid
              assign rating_decimal = 0
              assign dec = rv.rating | modulo: 1
              if dec >= 0.3 and dec <= 0.7
                assign rating_decimal = 0.5
              elsif dec > 0.7
                assign rating_decimal = 1
              endif
            -%}
            <div class="gmc-rv__sum" style="display:flex;flex-direction:column;align-items:{% if section.settings.align == 'center' %}center{% elsif section.settings.align == 'right' %}flex-end{% else %}flex-start{% endif %};gap:.4rem;margin-bottom:2rem" {{ block.shopify_attributes }}>
              <span class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rv.rating, rating_max: rv.scale_max }}">
                <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ rv.rating | floor }}; --rating-max: {{ rv.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
              </span>
              <p style="margin:0"><strong>{{ rv.rating }}</strong> / {{ rv.scale_max }}{% if rv_count != blank %} · {{ rv_count }} {{ block.settings.count_label | default: 'reviews' | escape }}{% endif %}</p>
            </div>
          {%- elsif request.design_mode -%}
            <p style="opacity:.6;text-align:{{ section.settings.align }}" {{ block.shopify_attributes }}>Rating summary appears when your review app has saved a rating for this product.</p>
          {%- endif -%}
        {%- when 'custom_liquid' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
        {%- when 'write_review_button' -%}
          {%- if has_widget or block.settings.link != blank -%}
          <div style="text-align:{{ section.settings.align }};margin:1.6rem 0" {{ block.shopify_attributes }}>
            <a class="button{% if block.settings.secondary %} button--secondary{% endif %}" href="{{ block.settings.link | default: '#reviews' }}">{{ block.settings.label | default: 'Write a review' | escape }}</a>
          </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p style="opacity:.6;text-align:{{ section.settings.align }}">Install your review app, then add its reviews block here (Add block → Apps).</p>
    {%- endif -%}
  </div>
</div>
<style>.gmc-rv--narrow{max-width:96rem}.gmc-rv--medium{max-width:120rem}</style>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Install a review app (Judge.me, Loox, Stamped or similar), then add its block here with Add block > Apps."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "rating_summary",
      "name": "Rating summary",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "count_label",
          "label": "Label after the count",
          "default": "reviews"
        }
      ]
    },
    {
      "type": "write_review_button",
      "name": "Write a review button",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to jump to the reviews area."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Write a review"
        },
        {
          "type": "checkbox",
          "id": "secondary",
          "label": "Outline style",
          "default": false
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom code",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "Code",
          "info": "Paste the embed code your review app gives you."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product reviews",
      "blocks": [
        {
          "type": "rating_summary"
        },
        {
          "type": "write_review_button"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
