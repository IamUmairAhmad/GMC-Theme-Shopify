<div class="page-width gmc-bd {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-bd-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-bd__g">{%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    <div class="gmc-bd__c" {{ block.shopify_attributes }}>
      {%- assign pv = p.selected_or_first_available_variant -%}
      <label class="gmc-bd__chk"><input type="checkbox" checked data-id="{{ pv.id }}" data-price="{{ pv.price }}"><span class="visually-hidden">Include {{ p.title | escape }}</span></label>
      {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy' }}{%- endif -%}
      <a href="{{ p.url }}" style="text-decoration:none;color:inherit">{{ p.title | escape }}</a>
      {%- if p.has_only_default_variant == false -%}
        <select class="select__select gmc-bd__var" aria-label="Variant for {{ p.title | escape }}">
          {%- for variant in p.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant.id == pv.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} (sold out){% endunless %}</option>{%- endfor -%}
        </select>
      {%- endif -%}
      <strong class="gmc-bd__p">{{ pv.price | money }}</strong></div>{%- endif -%}{%- endfor -%}</div>
  <div class="gmc-bd__f"><span>Total: <strong class="gmc-bd__tot"></strong>{% if section.settings.discount != blank %} <em>{{ section.settings.discount | escape }}</em>{% endif %}</span><button class="button" type="button" id="gmc-bd-btn-{{ section.id }}">{{ section.settings.button | escape }}</button></div>
</div>
<style>.gmc-bd{padding:36px 0}.gmc-bd__g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin:1.5rem 0}.gmc-bd__c{display:flex;flex-direction:column;gap:.4rem;text-align:center;border:1px solid rgba(var(--color-foreground),.2);border-radius:12px;padding:1rem;cursor:pointer;position:relative}.gmc-bd__chk{position:absolute;top:.6rem;left:.6rem}.gmc-bd__c:has(.gmc-bd__chk input:not(:checked)){opacity:.5}.gmc-bd__var{width:100%}.gmc-bd__f{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}</style>
<script>(function(){var w=document.getElementById('gmc-bd-{{ section.id }}');if(!w)return;var cur={{ cart.currency.iso_code | json }};
function calc(){var t=0;w.querySelectorAll('input:checked').forEach(function(i){t+=+i.dataset.price;});w.querySelector('.gmc-bd__tot').textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:cur}).format(t/100);}
w.addEventListener('change',function(e){var t=e.target;if(t.classList.contains('gmc-bd__var')){var c=t.closest('.gmc-bd__c'),o=t.options[t.selectedIndex],i=c.querySelector('input[type=checkbox]');i.dataset.id=o.value;i.dataset.price=o.dataset.price;c.querySelector('.gmc-bd__p').textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:cur}).format(o.dataset.price/100);}calc();});calc();
var bdBtn=document.getElementById('gmc-bd-btn-{{ section.id }}');bdBtn.addEventListener('click',function(){if(bdBtn.disabled)return;var items=[];w.querySelectorAll('input:checked').forEach(function(i){items.push({id:+i.dataset.id,quantity:1});});if(!items.length)return;
fetch({{ routes.cart_add_url | json }}+'.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})}).then(function(r){if(!r.ok)throw new Error('add failed');location.href={{ routes.cart_url | json }};}).catch(function(){bdBtn.disabled=false;bdBtn.textContent='Could not add — try again';});bdBtn.disabled=true;});})();</script>
{% schema %}
{"name":"Bundle deals","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently bought together"},{"type":"text","id":"button","label":"Button label","default":"Add bundle to cart"},{"type":"text","id":"discount","label":"Discount note","info":"Display only. Create a matching automatic discount in Shopify admin for a real price cut."},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"max_blocks":5,"presets":[{"name":"Bundle deals"}]}
{% endschema %}
