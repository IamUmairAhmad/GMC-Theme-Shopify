{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'logos', title: 'Featured on' -%}
{%- else -%}
{%- comment -%} gmc {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add logo blocks.' -%}{%- endif -%}
<div class="page-width gmc-fo{% if section.settings.gray %} gmc-fo--gray{% endif %} {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--lh:{{ section.settings.h }}px;--lh-m:{{ section.settings.h_m }}px">
  {%- if section.settings.heading != blank -%}<p class="gmc-fo__t">{{ section.settings.heading | escape }}</p>{%- endif -%}
  {%- capture logos -%}{%- for block in section.blocks -%}{%- if block.settings.logo != blank -%}<span class="gmc-fo__i{% if section.settings.layout == 'slider' %} gmc-sl__s{% endif %}" {{ block.shopify_attributes }}>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if section.settings.new_tab or block.settings.new_tab %} target="_blank" rel="noopener"{% endif %} aria-label="{{ block.settings.logo.alt | escape }}">{%- endif -%}{{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'gmc-fo__img', alt: block.settings.logo.alt }}{%- if block.settings.link != blank -%}</a>{%- endif -%}</span>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {%- if section.settings.layout == 'slider' -%}
    <div class="gmc-sl gmc-fo__sl{% if section.settings.slider_desktop == false %} gmc-fo__sl--m{% endif %}" data-gmc-slider data-mode="slide" data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}" data-loop="true" data-dots="{{ section.settings.dots }}" data-arrows="false" data-drag="true" data-perview="{{ section.settings.per_view }}" data-perview-m="{{ section.settings.per_view_m }}" style="--per:{{ section.settings.per_view }};--per-m:{{ section.settings.per_view_m }};--gmc-gap:24px;--gmc-dot:rgb(var(--color-foreground))"><div class="gmc-sl__vp"><div class="gmc-sl__tr">{{ logos }}</div></div></div>
  {%- else -%}
    <div class="gmc-fo__row gmc-fo__row--{{ section.settings.layout }}"{% if section.settings.layout == 'grid' %} style="--cols:{{ section.settings.per_view }}"{% endif %}>{{ logos }}</div>
  {%- endif -%}
</div>
<style>.gmc-fo{padding:28px 0;text-align:center}.gmc-fo__t{opacity:.65;margin:0 0 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:1.2rem}.gmc-fo__row{display:flex;gap:2.5rem;flex-wrap:wrap;justify-content:center;align-items:center;opacity:.8}.gmc-fo--gray .gmc-fo__row,.gmc-fo--gray .gmc-fo__sl{filter:grayscale(1)}.gmc-fo__row--grid{display:grid;grid-template-columns:repeat(var(--cols,4),1fr)}.gmc-fo__i{display:flex;justify-content:center;align-items:center}.gmc-fo__i a{display:block}.gmc-fo__img{height:var(--lh,32px);width:auto;max-width:100%}@media(max-width:749px){.gmc-fo__img{height:var(--lh-m,var(--lh,32px))}}</style>
{%- endif -%}
{% schema %}
{
  "name": "Featured on",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As featured on"
    },
    {
      "type": "range",
      "id": "h",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Logo height on desktop",
      "default": 32
    },
    {
      "type": "range",
      "id": "h_m",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Logo height on mobile",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "gray",
      "label": "Grayscale logos",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Row (wraps)"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "per_view",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Logos per row (grid and slider, desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "per_view_m",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Logos per view on mobile (slider)",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Slider autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Open links in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open this logo in a new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured on",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
