{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'logos', title: 'Featured on' -%}
{%- else -%}
{%- comment -%} gmc {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- liquid
  assign fo_layout = section.settings.layout
  assign fo_slide_both = false
  assign fo_slide_mobile = false
  if fo_layout == 'slider'
    assign fo_slide_both = true
  elsif section.settings.mobile_slider
    assign fo_slide_mobile = true
  endif
-%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add logo blocks.' -%}{%- endif -%}
<div class="page-width gmc-fo gmc-fo--{{ section.settings.place | default: 'beside' }}{% if section.settings.gray %} gmc-fo--gray{% endif %} {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--lh:{{ section.settings.h }}px;--lh-m:{{ section.settings.h_m }}px;--cols:{{ section.settings.per_view }};--mcols:{{ section.settings.per_view_m }}">
  {%- if section.settings.heading != blank -%}<h2 class="gmc-fo__t title {{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-fo__logos">
    {%- capture fo_static -%}
      {%- for block in section.blocks -%}
        <span class="gmc-fo__i" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if section.settings.new_tab or block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'gmc-fo__img', alt: block.settings.logo.alt }}
          {%- else -%}
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg gmc-fo__img gmc-fo__ph' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </span>
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture fo_slides -%}
      {%- for block in section.blocks -%}
        <span class="gmc-fo__i gmc-sl__s"{% if fo_slide_both %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if section.settings.new_tab or block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'gmc-fo__img', alt: block.settings.logo.alt }}
          {%- else -%}
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg gmc-fo__img gmc-fo__ph' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </span>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if fo_slide_both or fo_slide_mobile -%}
      <div class="gmc-sl gmc-fo__sl{% if fo_slide_mobile %} gmc-fo__only-m{% endif %}" data-gmc-slider data-mode="slide" data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}" data-loop="true" data-dots="{{ section.settings.dots }}" data-pag-pos="under" data-arrows="false" data-drag="true" data-perview="{% if fo_slide_both %}{{ section.settings.per_view }}{% else %}{{ section.settings.per_view_m }}{% endif %}" data-perview-m="{{ section.settings.per_view_m }}" style="--per:{% if fo_slide_both %}{{ section.settings.per_view }}{% else %}{{ section.settings.per_view_m }}{% endif %};--per-m:{{ section.settings.per_view_m }};--gmc-gap:24px;--gmc-dot:rgb(var(--color-foreground))"><div class="gmc-sl__vp"><div class="gmc-sl__tr">{{ fo_slides }}</div></div></div>
    {%- endif -%}
    {%- unless fo_slide_both -%}
      <div class="gmc-fo__row gmc-fo__row--{{ fo_layout }}{% if fo_slide_mobile %} gmc-fo__only-d{% elsif section.settings.mobile_slider == false %} gmc-fo__mgrid{% endif %}">{{ fo_static }}</div>
    {%- endunless -%}
  </div>
</div>
<style>
  .gmc-fo{padding-top:36px;padding-bottom:36px;text-align:center}
  .gmc-fo--beside{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:2.4rem 3.2rem}
  .gmc-fo--beside .gmc-fo__t{margin:0;flex:0 1 auto}
  .gmc-fo--beside .gmc-fo__logos{flex:1 1 28rem;min-width:0}
  .gmc-fo--above .gmc-fo__t{margin:0 0 1.6rem}
  .gmc-fo__row{display:flex;gap:2.4rem;flex-wrap:wrap;justify-content:center;align-items:center}
  .gmc-fo__row--grid{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));align-items:center}
  .gmc-fo--gray .gmc-fo__img{filter:grayscale(1);opacity:.85}
  .gmc-fo__i{display:flex;justify-content:center;align-items:center}
  .gmc-fo__i a{display:flex;justify-content:center;align-items:center;max-width:100%}
  .gmc-fo__img{height:var(--lh,50px);width:auto;max-width:100%;object-fit:contain}
  .gmc-fo__ph{background:#f3f3f3}
  .gmc-fo__sl{position:relative}
  .gmc-fo__sl .gmc-sl__pp{display:none}
  @media(min-width:750px){.gmc-fo__only-m{display:none}}
  @media(max-width:749px){
    .gmc-fo--beside{flex-direction:column;gap:1.2rem}
    .gmc-fo__img{height:var(--lh-m,var(--lh,50px))}
    .gmc-fo__only-d{display:none}
    .gmc-fo__mgrid{display:grid;grid-template-columns:repeat(var(--mcols,2),minmax(0,1fr));gap:1.6rem}
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Featured on",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured on"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "place",
      "label": "Desktop arrangement",
      "default": "beside",
      "options": [
        { "value": "beside", "label": "Heading beside logos" },
        { "value": "above", "label": "Heading above logos" }
      ]
    },
    {
      "type": "range",
      "id": "h",
      "min": 30,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Logo height on desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "h_m",
      "min": 30,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Logo height on mobile",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "gray",
      "label": "Gray logos",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Row (wraps)"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "per_view",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Logos per row (grid and slider, desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "per_view_m",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Logos per row on mobile",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Mobile slider",
      "info": "On phones, the row or grid becomes a looping slider. A slider layout uses the slider on every screen.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Slider autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Open links in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open this logo in a new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Featured on",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}

