{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'table', title: 'Comparison table' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one row block.' -%}{%- endif -%}
{%- liquid
  assign ts = section.settings.tick_style
  assign solid = false
  if ts == 'round' or section.settings.table_style == 'minimal'
    assign solid = true
  endif
  assign us_label = section.settings.us | replace: '[shop_name]', shop.name
  if us_label == blank
    assign us_label = shop.name
  endif
  assign them_label = section.settings.them | replace: '[shop_name]', shop.name
-%}
{%- capture yes_mark -%}{%- if ts == 'text' -%}Yes{%- elsif solid -%}<span class="gmc-ct__m gmc-ct__m--y" aria-label="Yes">✓</span>{%- else -%}<span class="gmc-ct__y" aria-label="Yes">✔</span>{%- endif -%}{%- endcapture -%}
{%- capture no_mark -%}{%- if ts == 'text' -%}No{%- elsif solid -%}<span class="gmc-ct__m gmc-ct__m--n" aria-label="No">✕</span>{%- else -%}<span class="gmc-ct__n" aria-label="No">✘</span>{%- endif -%}{%- endcapture -%}
<div class="page-width gmc-ct gmc-ct--{{ section.settings.table_style }} gmc-ct--{{ section.settings.place | default: 'stacked' }} {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--ct-hl:{{ section.settings.us_bg | default: 'rgba(128,128,128,.08)' }};--ct-y:{{ section.settings.tick_color }};--ct-n:{{ section.settings.cross_color }}">
  <div class="gmc-ct__copy">
    {%- if section.settings.heading != blank -%}<h2 class="gmc-ct__title {{ section.settings.heading_size | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      {%- liquid
        assign ct_btn = 'button button--primary'
        if section.settings.button_outline
          assign ct_btn = 'button button--secondary'
        endif
      -%}
      {%- if section.settings.button_link != blank -%}
        <a class="{{ ct_btn }}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- else -%}
        <button type="button" class="{{ ct_btn }}" disabled aria-disabled="true">{{ section.settings.button_label | escape }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="gmc-ct__table" style="overflow-x:auto"><table class="gmc-ct__t">
    <thead><tr><th></th>
      <th class="gmc-ct__us">{%- if section.settings.us_logo != blank -%}{{ section.settings.us_logo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'gmc-ct__logo', alt: us_label }}{%- else -%}{{ us_label | escape }}{%- endif -%}</th>
      <th>{%- if section.settings.them_logo != blank -%}{{ section.settings.them_logo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'gmc-ct__logo', alt: them_label }}{%- else -%}{{ them_label | escape }}{%- endif -%}</th></tr></thead>
    <tbody>{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td class="gmc-ct__feat">{{ block.settings.feature | escape }}</td><td class="gmc-ct__us">{%- if block.settings.us_text != blank -%}{{ block.settings.us_text | escape }}{%- elsif block.settings.us_yes -%}{{ yes_mark }}{%- else -%}{{ no_mark }}{%- endif -%}</td><td>{%- if block.settings.them_text != blank -%}{{ block.settings.them_text | escape }}{%- elsif block.settings.them_yes -%}{{ yes_mark }}{%- else -%}{{ no_mark }}{%- endif -%}</td></tr>{%- endfor -%}</tbody>
  </table></div>
</div>
<style>
  .gmc-ct{padding-top:36px;padding-bottom:36px}.gmc-ct__copy{display:grid;gap:1rem;justify-items:center;text-align:center;margin-bottom:1rem}.gmc-ct__title{margin:0}
  .gmc-ct__t{width:100%;max-width:760px;margin:0 auto;border-collapse:collapse;text-align:center}.gmc-ct__t th{font-size:18px}
  .gmc-ct__t td,.gmc-ct__t th{padding:1rem;border-bottom:1px solid rgba(var(--color-foreground),.1)}
  .gmc-ct__feat{text-align:left;font-weight:600}.gmc-ct__us{font-weight:700}
  .gmc-ct--classic .gmc-ct__feat{background:var(--ct-hl)}
  .gmc-ct--centered .gmc-ct__feat{text-align:center}.gmc-ct--centered .gmc-ct__us{background:var(--ct-hl)}
  .gmc-ct--minimal .gmc-ct__t td,.gmc-ct--minimal .gmc-ct__t th{border-bottom:1px solid rgba(var(--color-foreground),.16);background:transparent}
  .gmc-ct__y{color:var(--ct-y,#53af01)}.gmc-ct__n{color:var(--ct-n,#121212);opacity:.8}
  .gmc-ct__m{display:inline-grid;place-items:center;width:2.6rem;height:2.6rem;border-radius:50%;color:#fff;font-size:1.4rem}
  .gmc-ct__m--y{background:var(--ct-y,#53af01)}.gmc-ct__m--n{background:var(--ct-n,#dbdbdb);color:#121212}
  .gmc-ct__logo{display:block;margin:auto;width:60px;height:auto}
  @media(min-width:750px){
    .gmc-ct__logo{width:90px}
    .gmc-ct--table-first,.gmc-ct--table-second{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center}
    .gmc-ct--table-first .gmc-ct__table{order:-1}
    .gmc-ct--table-first .gmc-ct__copy,.gmc-ct--table-second .gmc-ct__copy{margin:0}
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparison table"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_outline",
      "label": "Use outline button style",
      "default": false
    },
    {
      "type": "text",
      "id": "us",
      "label": "Your column",
      "info": "Leave empty to use your shop name. [shop_name] is replaced with the shop name."
    },
    {
      "type": "text",
      "id": "them",
      "label": "Other column",
      "default": "Others"
    },
    {
      "type": "select",
      "id": "place",
      "label": "Desktop table placement",
      "options": [
        { "value": "table-first", "label": "Table first" },
        { "value": "table-second", "label": "Table second" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "table_style",
      "label": "Table style",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "minimal",
          "label": "Minimalistic"
        }
      ],
      "default": "classic"
    },
    {
      "type": "select",
      "id": "tick_style",
      "label": "Tick and cross style",
      "options": [
        {
          "value": "check",
          "label": "Check marks"
        },
        {
          "value": "round",
          "label": "Round badges"
        },
        {
          "value": "text",
          "label": "Yes / No text"
        }
      ],
      "default": "check"
    },
    {
      "type": "color",
      "id": "tick_color",
      "label": "Tick colour"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Cross colour"
    },
    {
      "type": "color",
      "id": "us_bg",
      "label": "Highlighted column colour"
    },
    {
      "type": "image_picker",
      "id": "us_logo",
      "label": "Your logo (instead of name)"
    },
    {
      "type": "image_picker",
      "id": "them_logo",
      "label": "Other brand logo"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Premium quality"
        },
        {
          "type": "checkbox",
          "id": "us_yes",
          "label": "You have it",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "them_yes",
          "label": "Others have it",
          "default": false
        },
        {
          "type": "text",
          "id": "us_text",
          "label": "Your cell text (replaces tick)"
        },
        {
          "type": "text",
          "id": "them_text",
          "label": "Other cell text (replaces tick)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row",
          "settings": {
            "feature": "Fast shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}

