{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'table', title: 'Comparison table' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one row block.' -%}{%- endif -%}
{%- assign ts = section.settings.tick_style -%}
{%- capture yes_mark -%}{%- case ts -%}{%- when 'round' -%}<span class="gmc-ct__m gmc-ct__m--y" aria-label="Yes">✓</span>{%- when 'text' -%}Yes{%- else -%}<span class="gmc-ct__y" aria-label="Yes">✔</span>{%- endcase -%}{%- endcapture -%}
{%- capture no_mark -%}{%- case ts -%}{%- when 'round' -%}<span class="gmc-ct__m gmc-ct__m--n" aria-label="No">✕</span>{%- when 'text' -%}No{%- else -%}<span class="gmc-ct__n" aria-label="No">✘</span>{%- endcase -%}{%- endcapture -%}
<div class="page-width gmc-ct gmc-ct--{{ section.settings.table_style }} {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--ct-hl:{{ section.settings.us_bg | default: 'rgba(128,128,128,.08)' }};--ct-y:{{ section.settings.tick_color }};--ct-n:{{ section.settings.cross_color }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div style="overflow-x:auto"><table class="gmc-ct__t">
    <thead><tr><th></th>
      <th class="gmc-ct__us">{%- if section.settings.us_logo != blank -%}{{ section.settings.us_logo | image_url: width: 240 | image_tag: height: 32, loading: 'lazy', alt: section.settings.us }}{%- else -%}{{ section.settings.us | default: shop.name | escape }}{%- endif -%}</th>
      <th>{%- if section.settings.them_logo != blank -%}{{ section.settings.them_logo | image_url: width: 240 | image_tag: height: 32, loading: 'lazy', alt: section.settings.them }}{%- else -%}{{ section.settings.them | escape }}{%- endif -%}</th></tr></thead>
    <tbody>{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td>{{ block.settings.feature | escape }}</td><td class="gmc-ct__us">{%- if block.settings.us_text != blank -%}{{ block.settings.us_text | escape }}{%- elsif block.settings.us_yes -%}{{ yes_mark }}{%- else -%}{{ no_mark }}{%- endif -%}</td><td>{%- if block.settings.them_text != blank -%}{{ block.settings.them_text | escape }}{%- elsif block.settings.them_yes -%}{{ yes_mark }}{%- else -%}{{ no_mark }}{%- endif -%}</td></tr>{%- endfor -%}</tbody>
  </table></div>
</div>
<style>.gmc-ct{padding:36px 0}.gmc-ct__t{width:100%;max-width:760px;margin:1rem auto 0;border-collapse:collapse;text-align:center}.gmc-ct__t td,.gmc-ct__t th{padding:1rem;border-bottom:1px solid rgba(var(--color-foreground),.12)}.gmc-ct__t td:first-child{text-align:left}.gmc-ct__us{background:var(--ct-hl);font-weight:700}.gmc-ct__y{color:var(--ct-y,inherit)}.gmc-ct__n{color:var(--ct-n,inherit);opacity:.8}.gmc-ct__m{display:inline-grid;place-items:center;width:2.6rem;height:2.6rem;border-radius:50%;color:#fff;font-size:1.4rem}.gmc-ct__m--y{background:var(--ct-y,#16a34a)}.gmc-ct__m--n{background:var(--ct-n,#9ca3af)}.gmc-ct__t img{display:block;margin:auto;width:auto}
.gmc-ct--centered .gmc-ct__t td:first-child{text-align:center}.gmc-ct--minimal .gmc-ct__t td,.gmc-ct--minimal .gmc-ct__t th{border:0}.gmc-ct--minimal .gmc-ct__us{background:transparent;border-bottom:2px solid currentColor}</style>
{%- endif -%}
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "us",
      "label": "Your column",
      "info": "Leave empty to use your shop name."
    },
    {
      "type": "text",
      "id": "them",
      "label": "Other column",
      "default": "Others"
    },
    {
      "type": "select",
      "id": "table_style",
      "label": "Table style",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ],
      "default": "classic"
    },
    {
      "type": "select",
      "id": "tick_style",
      "label": "Tick and cross style",
      "options": [
        {
          "value": "check",
          "label": "Check marks"
        },
        {
          "value": "round",
          "label": "Round badges"
        },
        {
          "value": "text",
          "label": "Yes / No text"
        }
      ],
      "default": "check"
    },
    {
      "type": "color",
      "id": "tick_color",
      "label": "Tick colour"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Cross colour"
    },
    {
      "type": "color",
      "id": "us_bg",
      "label": "Highlighted column colour"
    },
    {
      "type": "image_picker",
      "id": "us_logo",
      "label": "Your logo (instead of name)"
    },
    {
      "type": "image_picker",
      "id": "them_logo",
      "label": "Other brand logo"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Premium quality"
        },
        {
          "type": "checkbox",
          "id": "us_yes",
          "label": "You have it",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "them_yes",
          "label": "Others have it",
          "default": false
        },
        {
          "type": "text",
          "id": "us_text",
          "label": "Your cell text (replaces tick)"
        },
        {
          "type": "text",
          "id": "them_text",
          "label": "Other cell text (replaces tick)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row",
          "settings": {
            "feature": "Fast shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
