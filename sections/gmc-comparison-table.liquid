<div class="page-width gmc-ct {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div style="overflow-x:auto"><table class="gmc-ct__t">
    <thead><tr><th></th><th class="gmc-ct__us">{{ section.settings.us | escape }}</th><th>{{ section.settings.them | escape }}</th></tr></thead>
    <tbody>{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td>{{ block.settings.feature | escape }}</td><td class="gmc-ct__us">{% if block.settings.us_yes %}✔{% else %}✘{% endif %}</td><td>{% if block.settings.them_yes %}✔{% else %}✘{% endif %}</td></tr>{%- endfor -%}</tbody>
  </table></div>
</div>
<style>.gmc-ct{padding:36px 0}.gmc-ct__t{width:100%;max-width:760px;margin:1rem auto 0;border-collapse:collapse;text-align:center}.gmc-ct__t td,.gmc-ct__t th{padding:1rem;border-bottom:1px solid rgba(var(--color-foreground),.12)}.gmc-ct__t td:first-child{text-align:left}.gmc-ct__us{background:rgba(var(--color-foreground),.05);font-weight:700}</style>
{% schema %}
{"name":"Comparison table","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why choose us"},{"type":"text","id":"us","label":"Your column","default":"Us"},{"type":"text","id":"them","label":"Other column","default":"Others"},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"blocks":[{"type":"row","name":"Row","settings":[{"type":"text","id":"feature","label":"Feature","default":"Premium quality"},{"type":"checkbox","id":"us_yes","label":"You have it","default":true},{"type":"checkbox","id":"them_yes","label":"Others have it","default":false}]}],"max_blocks":12,"presets":[{"name":"Comparison table","blocks":[{"type":"row"},{"type":"row","settings":{"feature":"Fast shipping"}}]}]}
{% endschema %}
