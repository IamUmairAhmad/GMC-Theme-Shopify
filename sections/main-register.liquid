{%- render 'gmc-scheme' -%}
<div class="gmc-acct color-{{ section.settings.color_scheme }} gradient"><div class="page-width page-width--narrow" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
<h1 class="h2">Create account</h1>
{%- form 'create_customer', novalidate: 'novalidate' -%}
  {%- if form.errors -%}<div class="gmc-acct__err" role="alert" tabindex="-1"><strong>{{ 'Please fix the following' }}</strong>{{ form.errors | default_errors }}</div>{%- endif -%}
  <div class="field"><input class="field__input" type="text" id="RegisterForm-FirstName" name="customer[first_name]" autocomplete="given-name" placeholder="First name"><label class="field__label" for="RegisterForm-FirstName">First name</label></div>
  <div class="field"><input class="field__input" type="text" id="RegisterForm-LastName" name="customer[last_name]" autocomplete="family-name" placeholder="Last name"><label class="field__label" for="RegisterForm-LastName">Last name</label></div>
  <div class="field"><input class="field__input" type="email" id="RegisterForm-email" name="customer[email]" autocomplete="email" placeholder="Email" required><label class="field__label" for="RegisterForm-email">Email</label></div>
  <div class="field"><input class="field__input" type="password" id="RegisterForm-password" name="customer[password]" autocomplete="new-password" placeholder="Password" required><label class="field__label" for="RegisterForm-password">Password</label></div>
  <button class="button">Create</button>
  <p><a href="{{ routes.account_login_url }}">Already have an account? Log in</a></p>
{%- endform -%}
</div></div>
{% schema %}
{
  "name": "Customer register",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
