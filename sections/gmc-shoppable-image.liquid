{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'shoppable', title: 'Shoppable image' -%}
{%- else -%}
{%- comment -%} gmc {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.settings.image == blank -%}{%- render 'gmc-empty', msg: 'Choose an image and add hotspot blocks.' -%}{%- endif -%}
<div class="page-width gmc-si {% render 'gmc-vis', hide: section.settings.hide_on %}" data-open="{{ section.settings.open_on }}" data-sheet="{{ section.settings.mobile_modal }}" style="--gmc-si-card:{{ section.settings.card_width }}px;--gmc-si-thumb:{{ section.settings.thumb }}px">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.intro != blank or section.settings.button_label != blank -%}
    <div class="gmc-si__copy">
      {%- if section.settings.intro != blank -%}{{ section.settings.intro }}{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.settings.image != blank -%}<div class="gmc-si__wrap">
    {%- if section.settings.image_mobile != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1600' }}
      </picture>
    {%- else -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1600' }}
    {%- endif -%}
  {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    {%- assign bm = block.settings.mobile_pos -%}
    <div class="gmc-si__pin{% if section.settings.ripple %} gmc-si__pin--ripple{% endif %}" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;--xm:{% if bm %}{{ block.settings.x_m }}{% else %}{{ block.settings.x }}{% endif %}%;--ym:{% if bm %}{{ block.settings.y_m }}{% else %}{{ block.settings.y }}{% endif %}%" {{ block.shopify_attributes }}>
      <button type="button" class="gmc-si__dot" aria-expanded="false" aria-label="{{ p.title | escape }}">+</button>
      <div class="gmc-si__card" role="dialog" aria-label="{{ p.title | escape }}">
        <button type="button" class="gmc-si__x" aria-label="Close">×</button>
        <a class="gmc-si__lnk" href="{{ p.url }}">{%- if section.settings.show_image and p.featured_image -%}{{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <span>{{ p.title | escape }}{%- if section.settings.show_price -%}<br><strong>{{ p.price | money }}</strong>{%- endif -%}{%- if section.settings.show_badge and p.compare_at_price > p.price -%} <s>{{ p.compare_at_price | money }}</s> <em class="gmc-si__off">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</em>{%- endif -%}</span></a>
        {%- if block.settings.add_to_cart -%}{%- render 'gmc-inline-atc', product: p, label: block.settings.atc_label, skip: block.settings.skip, align: 'left' -%}{%- endif -%}
      </div>
    </div>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
</div>
<style>.gmc-si{padding:36px 0}.gmc-si__wrap{position:relative;max-width:1000px;margin:1rem auto 0}.gmc-si__wrap>img{display:block;width:100%;height:auto;border-radius:var(--media-radius)}
.gmc-si__pin{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);z-index:2}.gmc-si__dot{width:30px;height:30px;border-radius:50%;background:#fff;color:#111;border:0;display:grid;place-items:center;font-weight:700;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.35);font-size:18px;line-height:1}
.gmc-si__pin--ripple .gmc-si__dot{animation:gmcsir 2s infinite}@keyframes gmcsir{0%{box-shadow:0 0 0 0 rgba(255,255,255,.8)}100%{box-shadow:0 0 0 16px rgba(255,255,255,0)}}@media(prefers-reduced-motion:reduce){.gmc-si__pin--ripple .gmc-si__dot{animation:none}}
.gmc-si__copy{max-width:42rem;margin:0 auto 1.2rem;text-align:center}.gmc-si__copy .button{margin-top:.8rem}
.gmc-si__card{display:none;position:absolute;top:36px;left:50%;transform:translateX(-50%);width:min(80vw,var(--gmc-si-card,240px));background:#fff;color:#111;border-radius:10px;padding:1rem;box-shadow:0 8px 28px rgba(0,0,0,.28);z-index:5}.gmc-si__pin.is-open{z-index:6}.gmc-si__pin.is-open .gmc-si__card{display:block}
.gmc-si[data-open="hover"] .gmc-si__pin:hover .gmc-si__card{display:block}.gmc-si__lnk{display:flex;gap:.8rem;align-items:center;color:inherit;text-decoration:none;font-size:1.3rem}.gmc-si__lnk img{width:var(--gmc-si-thumb,64px);height:var(--gmc-si-thumb,64px);object-fit:cover;border-radius:6px}.gmc-si__off{background:#b91c1c;color:#fff;font-style:normal;font-size:1.1rem;padding:0 .4rem;border-radius:4px}.gmc-si__x{position:absolute;top:2px;right:8px;background:none;border:0;font-size:2rem;cursor:pointer;color:#111;display:none}
@media(max-width:749px){.gmc-si__pin{left:var(--xm);top:var(--ym)}.gmc-si__card{position:fixed;top:auto;left:0;right:0;bottom:0;transform:none;width:auto;border-radius:16px 16px 0 0;padding:1.6rem}.gmc-si[data-sheet="center"] .gmc-si__card{top:50%;left:5vw;right:5vw;bottom:auto;transform:translateY(-50%);border-radius:14px}.gmc-si__pin.is-open .gmc-si__x{display:block}.gmc-si[data-open="hover"] .gmc-si__pin:hover:not(.is-open) .gmc-si__card{display:none}}</style>
<script>(function(){var r=document.currentScript.previousElementSibling&&document.currentScript.previousElementSibling.previousElementSibling,root=document.currentScript.parentNode;var w=root.querySelector('.gmc-si');if(!w)return;
function close(){w.querySelectorAll('.gmc-si__pin.is-open').forEach(function(p){p.classList.remove('is-open');p.querySelector('.gmc-si__dot').setAttribute('aria-expanded','false');});}
w.addEventListener('click',function(e){var d=e.target.closest('.gmc-si__dot');if(d){var p=d.closest('.gmc-si__pin'),was=p.classList.contains('is-open');close();if(!was){p.classList.add('is-open');d.setAttribute('aria-expanded','true');}return;}if(e.target.closest('.gmc-si__x'))close();});
document.addEventListener('click',function(e){if(!e.target.closest('.gmc-si__pin'))close();});document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});})();</script>
{%- endif -%}
{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Product image in the card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Price in the card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Discount badge in the card",
      "default": true
    },
    {
      "type": "range",
      "id": "thumb",
      "min": 48,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Product image size",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 200,
      "max": 360,
      "step": 20,
      "unit": "px",
      "label": "Card width",
      "default": 240
    },
    {
      "type": "select",
      "id": "open_on",
      "label": "Open product card on",
      "options": [
        {
          "value": "click",
          "label": "Click"
        },
        {
          "value": "hover",
          "label": "Hover (desktop)"
        }
      ],
      "default": "click"
    },
    {
      "type": "select",
      "id": "mobile_modal",
      "label": "Mobile card position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom sheet"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "ripple",
      "label": "Animated ripple on hotspots",
      "default": true
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile position"
        },
        {
          "type": "checkbox",
          "id": "mobile_pos",
          "label": "Use a different position on mobile",
          "default": false
        },
        {
          "type": "range",
          "id": "x_m",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mobile horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_m",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mobile vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Add to cart"
        },
        {
          "type": "checkbox",
          "id": "add_to_cart",
          "label": "Show add to cart in the card",
          "default": true
        },
        {
          "type": "text",
          "id": "atc_label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "checkbox",
          "id": "skip",
          "label": "Go straight to checkout",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 30,
            "y": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 65,
            "y": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}
