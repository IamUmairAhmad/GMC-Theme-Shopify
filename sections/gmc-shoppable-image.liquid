<div class="page-width gmc-si {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.image != blank -%}<div class="gmc-si__wrap">{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1600' }}
  {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    <details class="gmc-si__pin" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" {{ block.shopify_attributes }}><summary aria-label="{{ p.title | escape }}">+</summary>
      <a class="gmc-si__card" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}<span>{{ p.title | escape }}<br><strong>{{ p.price | money }}</strong></span></a></details>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
</div>
<style>.gmc-si{padding:36px 0}.gmc-si__wrap{position:relative;max-width:1000px;margin:1rem auto 0}.gmc-si__wrap>img{display:block;width:100%;height:auto;border-radius:12px}.gmc-si__pin{position:absolute;transform:translate(-50%,-50%)}.gmc-si__pin summary{list-style:none;width:30px;height:30px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-weight:700;cursor:pointer;box-shadow:0 0 0 6px rgba(255,255,255,.4)}.gmc-si__pin summary::-webkit-details-marker{display:none}.gmc-si__card{position:absolute;top:38px;left:50%;transform:translateX(-50%);width:220px;display:flex;gap:.6rem;align-items:center;background:rgb(var(--color-background));color:rgb(var(--color-foreground));padding:.6rem;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.25);z-index:3;text-decoration:none}.gmc-si__card img{width:56px;height:56px;object-fit:cover;border-radius:6px}</style>
{% schema %}
{"name":"Shoppable image","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop the look"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"blocks":[{"type":"hotspot","name":"Hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"x","min":0,"max":100,"unit":"%","label":"Horizontal position","default":50},{"type":"range","id":"y","min":0,"max":100,"unit":"%","label":"Vertical position","default":50}]}],"max_blocks":8,"presets":[{"name":"Shoppable image"}]}
{% endschema %}
