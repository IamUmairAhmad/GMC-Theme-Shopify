{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.settings.image == blank -%}{%- render 'gmc-empty', msg: 'Choose an image and add hotspot blocks.' -%}{%- endif -%}
<div class="page-width gmc-si {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.image != blank -%}<div class="gmc-si__wrap">{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1600' }}
  {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
    <details class="gmc-si__pin" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" {{ block.shopify_attributes }}><summary aria-label="{{ p.title | escape }}">+</summary>
      <a class="gmc-si__card" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}<span>{{ p.title | escape }}<br><strong>{{ p.price | money }}</strong></span></a></details>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
</div>
<style>.gmc-si{padding:36px 0}.gmc-si__wrap{position:relative;max-width:1000px;margin:1rem auto 0}.gmc-si__wrap>img{display:block;width:100%;height:auto;border-radius:var(--media-radius)}.gmc-si__pin{position:absolute;transform:translate(-50%,-50%)}.gmc-si__pin summary{list-style:none;width:30px;height:30px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-weight:700;cursor:pointer;box-shadow:0 0 0 6px rgba(255,255,255,.4)}.gmc-si__pin summary::-webkit-details-marker{display:none}.gmc-si__card{position:absolute;top:38px;left:50%;transform:translateX(-50%);width:220px;display:flex;gap:.6rem;align-items:center;background:rgb(var(--color-background));color:rgb(var(--color-foreground));padding:.6rem;border-radius:var(--text-boxes-radius);box-shadow:0 6px 20px rgba(var(--color-shadow),.25);z-index:3;text-decoration:none}.gmc-si__card img{width:56px;height:56px;object-fit:cover;border-radius:var(--media-radius)}</style>
{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 30,
            "y": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 65,
            "y": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}
