{%- comment -%} GMC shoppable image. Hotspots, content placement, and modal sizing follow the same jobs as a product-pin image. {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign ptm = pt | times: 0.75 | round: 0
  assign pbm = pb | times: 0.75 | round: 0
  assign dot_bg = '#121212'
  assign dot_fg = '#ffffff'
  assign card_bg = '#ffffff'
  assign card_fg = '#121212'
  assign copy_bg = '#ffffff'
  assign copy_fg = '#121212'
  for scheme in settings.color_schemes
    if scheme.id == section.settings.hotspot_scheme
      assign dot_bg = scheme.settings.background
      assign dot_fg = scheme.settings.text
    endif
    if scheme.id == section.settings.modal_scheme
      assign card_bg = scheme.settings.background
      assign card_fg = scheme.settings.text
      if scheme.settings.background_gradient != blank
        assign card_bg = scheme.settings.background_gradient
      endif
    endif
    if scheme.id == section.settings.content_scheme
      assign copy_bg = scheme.settings.background
      assign copy_fg = scheme.settings.text
      if scheme.settings.background_gradient != blank
        assign copy_bg = scheme.settings.background_gradient
      endif
    endif
  endfor
  assign copy_panel = false
  if section.settings.content_scheme != section.settings.gmc_scheme
    assign copy_panel = true
  endif
-%}
<style>
  #shopify-section-{{ section.id }} .gmc-si { padding-top: {{ ptm }}px; padding-bottom: {{ pbm }}px; }
  #shopify-section-{{ section.id }} .gmc-si__layout { display: grid; gap: 2.4rem; align-items: center; }
  #shopify-section-{{ section.id }} .gmc-si__copy { text-align: {{ section.settings.content_align }}; }
  #shopify-section-{{ section.id }} .gmc-si__copy--panel { background: {{ copy_bg }}; color: {{ copy_fg }}; border-radius: var(--text-boxes-radius, 12px); padding: 2.4rem; }
  #shopify-section-{{ section.id }} .gmc-si__copy .button { margin-top: 1.2rem; }
  #shopify-section-{{ section.id }} .gmc-si__wrap { position: relative; margin: 0 auto; width: 100%; max-width: {{ section.settings.image_max }}px; }
  #shopify-section-{{ section.id }} .gmc-si__wrap > img,
  #shopify-section-{{ section.id }} .gmc-si__wrap picture img,
  #shopify-section-{{ section.id }} .gmc-si__ph { display: block; width: 100%; height: auto; border-radius: var(--media-radius, 0); }
  #shopify-section-{{ section.id }} .gmc-si__ph { aspect-ratio: 4 / 3; background: rgba(var(--color-foreground), .06); }
  #shopify-section-{{ section.id }} .gmc-si__pin { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; z-index: 2; }
  #shopify-section-{{ section.id }} .gmc-si__dot { width: 3rem; height: 3rem; border-radius: 50%; border: 0; background: {{ dot_bg }}; color: {{ dot_fg }}; display: grid; place-items: center; font-weight: 700; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.35); font-size: 1.8rem; line-height: 1; transform: translate(-50%, -50%); }
  #shopify-section-{{ section.id }} .gmc-si__dot:focus-visible { outline: 2px solid {{ dot_fg }}; outline-offset: 3px; }
  #shopify-section-{{ section.id }} .gmc-si__pin--ripple .gmc-si__dot { animation: gmc-si-rip 2s infinite; }
  @keyframes gmc-si-rip { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,.75); } 100% { box-shadow: 0 0 0 16px rgba(255,255,255,0); } }
  #shopify-section-{{ section.id }} .gmc-si__card { display: none; position: absolute; z-index: 5; width: min(80vw, {{ section.settings.modal_d_width }}px); background: {{ card_bg }}; color: {{ card_fg }}; border-radius: 10px; padding: 1.2rem; box-shadow: 0 8px 28px rgba(0,0,0,.28); text-align: left; }
  #shopify-section-{{ section.id }} .gmc-si__card--center { text-align: center; }
  #shopify-section-{{ section.id }} .gmc-si__card--right { text-align: right; }
  #shopify-section-{{ section.id }} .gmc-si__pin.is-open { z-index: 6; }
  #shopify-section-{{ section.id }} .gmc-si__pin.is-open .gmc-si__card { display: block; }
  #shopify-section-{{ section.id }} .gmc-si__lnk { display: flex; gap: .8rem; align-items: center; color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .gmc-si__card--center .gmc-si__lnk,
  #shopify-section-{{ section.id }} .gmc-si__card--right .gmc-si__lnk { flex-direction: column; }
  #shopify-section-{{ section.id }} .gmc-si__lnk img { width: 6.4rem; height: 6.4rem; object-fit: cover; border-radius: 6px; flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .gmc-si__title { display: block; margin: 0 0 .4rem; font-size: 1.6rem; }
  #shopify-section-{{ section.id }} .gmc-si__off { background: #b91c1c; color: #fff; font-style: normal; font-size: 1.1rem; padding: 0 .4rem; border-radius: 4px; }
  #shopify-section-{{ section.id }} .gmc-si__text { margin: .6rem 0 0; }
  #shopify-section-{{ section.id }} .gmc-si__x { position: absolute; top: .2rem; right: .6rem; background: none; border: 0; font-size: 2rem; cursor: pointer; color: inherit; display: none; }
  #shopify-section-{{ section.id }} .gmc-si__shade { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 4; }
  #shopify-section-{{ section.id }} .gmc-si.is-sheet .gmc-si__shade { display: block; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gmc-si__pin { left: var(--xm); top: var(--ym); }
    {%- if section.settings.hide_content_mobile -%}
      #shopify-section-{{ section.id }} .gmc-si__copy { display: none; }
    {%- endif -%}
    {%- if section.settings.mobile_content == 'bottom' -%}
      #shopify-section-{{ section.id }} .gmc-si__copy { order: 2; }
    {%- endif -%}
    #shopify-section-{{ section.id }} .gmc-si__card { width: min(calc(100vw - 3.2rem), {{ section.settings.modal_m_width }}px); }
    {%- if section.settings.mobile_modal == 'fixed' -%}
      #shopify-section-{{ section.id }} .gmc-si__card { position: fixed; left: 0; right: 0; bottom: 0; top: auto; width: auto; max-width: none; border-radius: 16px 16px 0 0; padding: 1.6rem; transform: none; }
      #shopify-section-{{ section.id }} .gmc-si__pin.is-open .gmc-si__x { display: block; }
    {%- endif -%}
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .gmc-si { padding-top: {{ pt }}px; padding-bottom: {{ pb }}px; }
    {%- if section.settings.content_position == 'left' or section.settings.content_position == 'right' -%}
      #shopify-section-{{ section.id }} .gmc-si__layout { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 3.2rem; }
    {%- endif -%}
    {%- if section.settings.content_position == 'right' or section.settings.content_position == 'bottom' -%}
      #shopify-section-{{ section.id }} .gmc-si__copy { order: 2; }
    {%- endif -%}
    {%- if section.settings.content_position == 'right' -%}
      #shopify-section-{{ section.id }} .gmc-si__layout { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
    {%- endif -%}
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .gmc-si__pin--ripple .gmc-si__dot { animation: none; }
  }
</style>
<div class="gmc-si" data-open="{{ section.settings.open_on }}" data-sheet="{{ section.settings.mobile_modal }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="gmc-si__layout">
      {%- if section.settings.heading != blank or section.settings.intro != blank or section.settings.button_label != blank -%}
        <div class="gmc-si__copy{% if copy_panel %} gmc-si__copy--panel{% endif %}">
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="rte">{{ section.settings.intro }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="button{% if section.settings.outline %} button--secondary{% endif %}" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="gmc-si__wrap">
        {%- if section.settings.image != blank -%}
          {%- if section.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
              {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1600' }}
            </picture>
          {%- else -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1600' }}
          {%- endif -%}
        {%- else -%}
          <div class="gmc-si__ph" aria-hidden="true"></div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- assign bm = block.settings.mobile_pos -%}
          {%- assign title = 'Product title' -%}
          {%- if p != blank -%}{%- assign title = p.title -%}{%- endif -%}
          <div class="gmc-si__pin{% if section.settings.ripple %} gmc-si__pin--ripple{% endif %}" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;--xm:{% if bm %}{{ block.settings.x_m }}{% else %}{{ block.settings.x }}{% endif %}%;--ym:{% if bm %}{{ block.settings.y_m }}{% else %}{{ block.settings.y }}{% endif %}%" {{ block.shopify_attributes }}>
            <button type="button" class="gmc-si__dot" aria-expanded="false" aria-label="{{ title | escape }}">+</button>
            <div class="gmc-si__card gmc-si__card--{{ block.settings.align }}" role="dialog" aria-label="{{ title | escape }}">
              <button type="button" class="gmc-si__x" aria-label="Close">&times;</button>
              <div class="gmc-si__lnk">
                {%- if section.settings.show_image and p.featured_image -%}
                  {{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
                <div>
                  {%- if p != blank -%}
                    <a class="gmc-si__title" href="{{ p.url }}">{{ p.title | escape }}</a>
                  {%- else -%}
                    <span class="gmc-si__title">{{ title | escape }}</span>
                  {%- endif -%}
                  {%- if section.settings.show_price and p != blank -%}
                    <strong>{{ p.price | money }}</strong>
                    {%- if section.settings.show_badge and p.compare_at_price > p.price -%}
                      <s>{{ p.compare_at_price | money }}</s>
                      <em class="gmc-si__off">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</em>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="gmc-si__text rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </div>
              {%- if block.settings.add_to_cart and p != blank -%}
                {%- render 'gmc-inline-atc', product: p, label: block.settings.atc_label, skip: block.settings.skip, align: block.settings.align -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <div class="gmc-si__shade" hidden></div>
</div>
<script>
  (function () {
    var root = document.currentScript.closest('.shopify-section') || document.currentScript.parentNode;
    var w = root.querySelector('.gmc-si');
    if (!w) return;
    var shade = w.querySelector('.gmc-si__shade');
    function narrow() { return window.matchMedia('(max-width: 749px)').matches; }
    function closeAll() {
      w.classList.remove('is-sheet');
      if (shade) shade.hidden = true;
      w.querySelectorAll('.gmc-si__pin.is-open').forEach(function (pin) {
        pin.classList.remove('is-open');
        var dot = pin.querySelector('.gmc-si__dot');
        if (dot) dot.setAttribute('aria-expanded', 'false');
      });
    }
    function place(pin) {
      var card = pin.querySelector('.gmc-si__card');
      var wrap = pin.closest('.gmc-si__wrap');
      if (!card || !wrap) return;
      if (narrow() && w.getAttribute('data-sheet') === 'fixed') {
        card.style.left = '';
        card.style.top = '';
        card.style.maxWidth = '';
        return;
      }
      card.style.position = 'absolute';
      card.style.transform = 'none';
      card.style.display = 'block';
      var wr = wrap.getBoundingClientRect();
      var pr = pin.getBoundingClientRect();
      var limit = wr.width - 16;
      if (limit < 40) return;
      card.style.maxWidth = limit + 'px';
      var width = card.getBoundingClientRect().width;
      if (width > limit) width = limit;
      var left = pr.left - wr.left + pr.width / 2 - width / 2;
      if (left < 8) left = 8;
      var maxLeft = wr.width - width - 8;
      if (left > maxLeft) left = maxLeft;
      var top = pr.bottom - wr.top + 8;
      var height = card.offsetHeight;
      if (top + height > wr.height - 8) top = pr.top - wr.top - height - 8;
      if (top < 8) top = 8;
      card.style.left = (left - (pr.left - wr.left)) + 'px';
      card.style.top = (top - (pr.top - wr.top)) + 'px';
    }
    function openPin(pin) {
      closeAll();
      pin.classList.add('is-open');
      var dot = pin.querySelector('.gmc-si__dot');
      if (dot) dot.setAttribute('aria-expanded', 'true');
      if (narrow() && w.getAttribute('data-sheet') === 'fixed') {
        w.classList.add('is-sheet');
        if (shade) shade.hidden = false;
      }
      place(pin);
    }
    w.addEventListener('click', function (e) {
      var dot = e.target.closest('.gmc-si__dot');
      if (dot) {
        var pin = dot.closest('.gmc-si__pin');
        var was = pin.classList.contains('is-open');
        closeAll();
        if (!was) openPin(pin);
        return;
      }
      if (e.target.closest('.gmc-si__x') || e.target === shade) closeAll();
    });
    if (w.getAttribute('data-open') === 'hover') {
      w.addEventListener('mouseover', function (e) {
        if (narrow()) return;
        var pin = e.target.closest('.gmc-si__pin');
        if (!pin || pin.classList.contains('is-open')) return;
        openPin(pin);
      });
      w.addEventListener('mouseout', function (e) {
        if (narrow()) return;
        var pin = e.target.closest('.gmc-si__pin');
        if (!pin) return;
        if (e.relatedTarget && pin.contains(e.relatedTarget)) return;
        closeAll();
      });
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.gmc-si__pin')) return;
      closeAll();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' || e.keyCode === 27) closeAll(); });
    window.addEventListener('resize', function () {
      var pin = w.querySelector('.gmc-si__pin.is-open');
      if (pin) place(pin);
    });
  })();
</script>
{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shoppable image"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text",
      "default": "<p>Use this section to highlight multiple products with one image that contains all of them.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "outline",
      "label": "Outline button",
      "default": false
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "right", "label": "Right" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Desktop content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_content_mobile",
      "label": "Hide content on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_content",
      "label": "Mobile content position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "content_scheme",
      "label": "Content color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "If this is empty, the desktop image is used on mobile."
    },
    {
      "type": "range",
      "id": "image_max",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Image max width",
      "default": 900
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full page width",
      "default": false
    },
    {
      "type": "header",
      "content": "Hotspots and modals"
    },
    {
      "type": "select",
      "id": "open_on",
      "label": "Open modal on",
      "default": "click",
      "options": [
        { "value": "click", "label": "Click" },
        { "value": "hover", "label": "Hover" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "hotspot_scheme",
      "label": "Hotspot buttons color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "ripple",
      "label": "Display button ripple animation",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "modal_scheme",
      "label": "Hotspot modal color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "mobile_modal",
      "label": "Mobile modal position",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "Over the button" },
        { "value": "fixed", "label": "Fixed to the page" }
      ]
    },
    {
      "type": "range",
      "id": "modal_d_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Hotspot modal desktop width",
      "default": 400
    },
    {
      "type": "range",
      "id": "modal_m_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Hotspot modal mobile width",
      "default": 300
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Display product featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Display price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Display price discount badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "info": "On screens under 750px this is 75% of the value.",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "info": "On screens under 750px this is 75% of the value.",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button for this product at the end of the section. Each hotspot has its own button."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "default": "all",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ]
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
