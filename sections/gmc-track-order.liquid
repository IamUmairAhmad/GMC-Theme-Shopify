{%- render 'gmc-section-extras' -%}
<div class="page-width gmc-to {% render 'gmc-vis', hide: section.settings.hide_on %}">
  <h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>
  <form id="gmc-to-{{ section.id }}" class="gmc-to__f"><input class="field__input" style="padding:1rem" required placeholder="Tracking number" aria-label="Tracking number"><button class="button" type="submit">Track</button></form>
  {%- if customer -%}<p><a href="{{ routes.account_url }}">View my orders</a></p>{%- endif -%}
</div>
<style>.gmc-to{padding:36px 0;text-align:center;max-width:560px}.gmc-to__f{display:flex;gap:.6rem}.gmc-to__f input{flex:1}</style>
<script>document.getElementById('gmc-to-{{ section.id }}').addEventListener('submit',function(e){e.preventDefault();var v=this.querySelector('input').value.trim();if(v)window.open({{ settings.gmc_track_url | json }}+encodeURIComponent(v),'_blank','noopener');});</script>
{% schema %}
{
 "name": "Track order",
 "tag": "section",
 "class": "section",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Track your order"
  },
  {
   "type": "text",
   "id": "text",
   "label": "Text",
   "default": "Enter the tracking number from your shipping email."
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "presets": [
  {
   "name": "Track order"
  }
 ]
}
{% endschema %}
