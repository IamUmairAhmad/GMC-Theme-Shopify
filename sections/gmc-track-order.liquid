<div class="page-width gmc-to {% render 'gmc-vis', hide: section.settings.hide_on %}">
  <h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>
  <form id="gmc-to-{{ section.id }}" class="gmc-to__f"><input class="field__input" style="padding:1rem" required placeholder="Tracking number" aria-label="Tracking number"><button class="button" type="submit">Track</button></form>
  {%- if customer -%}<p><a href="{{ routes.account_url }}">View my orders</a></p>{%- endif -%}
</div>
<style>.gmc-to{padding:36px 0;text-align:center;max-width:560px}.gmc-to__f{display:flex;gap:.6rem}.gmc-to__f input{flex:1}</style>
<script>document.getElementById('gmc-to-{{ section.id }}').addEventListener('submit',function(e){e.preventDefault();var v=this.querySelector('input').value.trim();if(v)window.open({{ settings.gmc_track_url | json }}+encodeURIComponent(v),'_blank','noopener');});</script>
{% schema %}
{"name":"Track order","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Track your order"},{"type":"text","id":"text","label":"Text","default":"Enter the tracking number from your shipping email."},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"presets":[{"name":"Track order"}]}
{% endschema %}
