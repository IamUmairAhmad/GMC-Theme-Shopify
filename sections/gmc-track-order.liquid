{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- liquid
  assign s = section.settings
  assign intro = s.text | replace: '[shop email]', shop.email
  assign track_tpl = s.tracking_url
  if track_tpl == blank
    assign track_tpl = settings.gmc_track_url
  endif
-%}
<div
  class="gmc-trk"
  id="gmc-trk-{{ section.id }}"
  style="--gmc-trk-pt:{{ s.padding_top }}px;--gmc-trk-pb:{{ s.padding_bottom }}px"
  data-url="{{ track_tpl | escape }}"
  data-empty="{{ s.empty_message | escape }}"
>
  <div class="page-width">
    <div class="gmc-trk__inner">
      <div class="gmc-trk__head">
        {%- if s.heading != blank -%}
          <h2 class="title {{ s.heading_size }}">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if intro != blank -%}
          <div class="rte gmc-trk__text">{{ intro }}</div>
        {%- endif -%}
      </div>
      <form class="gmc-trk__form" action="{{ routes.root_url }}" method="get">
        <div class="field">
          <input
            id="gmc-trk-num-{{ section.id }}"
            class="field__input"
            type="text"
            name="tracking"
            maxlength="50"
            autocomplete="off"
            placeholder="{{ s.placeholder | escape }}"
            aria-describedby="gmc-trk-err-{{ section.id }}"
          >
          <label class="field__label" for="gmc-trk-num-{{ section.id }}">{{ s.placeholder | escape }}</label>
        </div>
        <p class="form__message gmc-trk__err" id="gmc-trk-err-{{ section.id }}" role="alert" hidden></p>
        <button type="submit" class="button{% if s.button_full_width %} button--full-width{% endif %}">{{ s.button_label | escape }}</button>
      </form>
      {%- if customer -%}
        <p class="gmc-trk__orders"><a href="{{ routes.account_url }}">{{ s.orders_label | escape }}</a></p>
      {%- endif -%}
      <div class="gmc-trk__result" data-gmc-trk-result hidden>
        <div class="gmc-trk__meta">
          <p class="gmc-trk__num" data-gmc-trk-num></p>
          <a class="link" data-gmc-trk-open href="{{ routes.root_url }}" target="_blank" rel="noopener noreferrer">{{ s.open_label | escape }}</a>
        </div>
        <iframe
          class="gmc-trk__frame"
          title="{{ s.heading | default: 'Tracking result' | escape }}"
          style="height:{{ s.result_height }}px"
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
      </div>
    </div>
  </div>
</div>
<style>
  .gmc-trk{padding-top:calc(var(--gmc-trk-pt) * .75);padding-bottom:calc(var(--gmc-trk-pb) * .75)}
  @media(min-width:750px){.gmc-trk{padding-top:var(--gmc-trk-pt);padding-bottom:var(--gmc-trk-pb)}}
  .gmc-trk__inner{max-width:64rem;margin:0 auto}
  .gmc-trk__head{text-align:center}
  .gmc-trk__head .title{margin:0}
  .gmc-trk__text{margin-top:1rem}
  .gmc-trk__form{display:grid;gap:1.6rem;margin-top:2.4rem;justify-items:stretch}
  .gmc-trk__form .button{justify-self:start}
  .gmc-trk__form .button--full-width{justify-self:stretch;width:100%}
  .gmc-trk__err{margin:0}
  .gmc-trk__err[hidden],.gmc-trk__result[hidden],.gmc-trk__frame[hidden],.gmc-trk__meta [hidden]{display:none}
  .gmc-trk__orders{text-align:center;margin:1.6rem 0 0}
  .gmc-trk__result{margin-top:2.4rem}
  .gmc-trk__meta{display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap;margin:0 0 1rem}
  .gmc-trk__num{margin:0;font-weight:600;letter-spacing:.04em}
  .gmc-trk__frame{width:100%;border:1px solid rgba(var(--color-foreground),.15);border-radius:var(--text-boxes-radius,8px);background:rgb(var(--color-background))}
</style>
<script>
(function(){
  var root = document.getElementById('gmc-trk-{{ section.id }}');
  if (!root) return;
  var form = root.querySelector('form');
  var input = root.querySelector('input');
  var err = root.querySelector('.gmc-trk__err');
  var box = root.querySelector('[data-gmc-trk-result]');
  var frame = root.querySelector('iframe');
  var link = root.querySelector('[data-gmc-trk-open]');
  var numEl = root.querySelector('[data-gmc-trk-num]');
  function build(template, num){
    if (!template || template.slice(0, 8) !== 'https://') return '';
    if (template.indexOf(' ') !== -1) return '';
    var enc = encodeURIComponent(num);
    if (template.indexOf('[number]') !== -1 || template.indexOf('[tracking]') !== -1) {
      return template.split('[number]').join(enc).split('[tracking]').join(enc);
    }
    return template + enc;
  }
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var num = input.value.trim();
    if (num.length === 0) {
      err.hidden = false;
      err.textContent = root.dataset.empty || 'Enter your number.';
      input.setAttribute('aria-invalid', 'true');
      box.hidden = true;
      input.focus();
      return;
    }
    err.hidden = true;
    input.removeAttribute('aria-invalid');
    var url = build(root.dataset.url || '', num);
    numEl.textContent = num;
    if (url) {
      frame.hidden = false;
      frame.src = url;
      link.hidden = false;
      link.href = url;
    } else {
      frame.hidden = true;
      frame.removeAttribute('src');
      link.hidden = true;
    }
    box.hidden = false;
  });
})();
</script>
{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track Order" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Please enter your tracking number below. If your tracking number does not work, contact us at [shop email]</p>"
    },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "placeholder", "label": "Field label", "default": "Tracking Number" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "TRACK" },
    { "type": "checkbox", "id": "button_full_width", "label": "Use full width button", "default": true },
    { "type": "text", "id": "orders_label", "label": "Link to customer orders", "default": "View my orders", "info": "Shown only when a customer is logged in." },
    { "type": "text", "id": "empty_message", "label": "Message when the number is empty", "default": "Enter your number." },
    {
      "type": "text",
      "id": "tracking_url",
      "label": "Tracking page link",
      "info": "Leave blank to use the theme tracking URL, which appends the number. Or set a full https:// link and write [number] where the number goes. The result opens on this page."
    },
    { "type": "text", "id": "open_label", "label": "Open-page link label", "default": "Open tracking page" },
    {
      "type": "range",
      "id": "result_height",
      "min": 280,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Result height",
      "default": 560
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "gmc_pad_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Extra space above", "default": 0 },
    { "type": "range", "id": "gmc_pad_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Extra space below", "default": 0 },
    { "type": "range", "id": "gmc_max_width", "min": 0, "max": 1600, "step": 50, "unit": "px", "label": "Max content width (0 = theme default)", "default": 0 },
    { "type": "color", "id": "gmc_bg_color", "label": "Section background colour" },
    { "type": "text", "id": "gmc_bg_gradient", "label": "Section background gradient (CSS)", "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above." },
    { "type": "image_picker", "id": "gmc_bg_image", "label": "Background image", "info": "Recommended: 2000 × 1200 px. Tested: fills the section edge to edge and is cropped to fit, never stretched; the theme loads at most 2000 px wide, so larger files add no sharpness. At full desktop width (1920 px) a 2000 × 1200 image covers sections up to about 1150 px tall without enlarging; section height follows its content." },
    { "type": "video", "id": "gmc_bg_video", "label": "Background video (MP4 upload)" },
    { "type": "range", "id": "gmc_bg_overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Background overlay", "default": 0 },
    { "type": "header", "content": "Add to cart in this section" },
    { "type": "product", "id": "gmc_atc_product", "label": "Add-to-cart product", "info": "Adds a button at the end of this section." },
    { "type": "text", "id": "gmc_atc_label", "label": "Button label", "default": "Add to cart" },
    { "type": "checkbox", "id": "gmc_atc_skip", "label": "Add to cart button: skip the cart and go to checkout", "default": false },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "color_scheme", "id": "gmc_scheme", "label": "t:sections.all.colors.label", "default": "scheme-4" },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "default": "all",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ]
    },
    { "type": "header", "content": "Section ID and pairing" },
    { "type": "text", "id": "gmc_anchor", "label": "Section ID (for links like #my-id)", "info": "Letters, numbers and dashes. Use this ID in a link to scroll here." },
    { "type": "text", "id": "gmc_pair_with", "label": "Place beside the section with this ID", "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)" },
    { "type": "checkbox", "id": "gmc_pair_rev", "label": "Reverse the pair order on mobile", "default": false }
  ],
  "presets": [
    { "name": "Track order" }
  ]
}
{% endschema %}
