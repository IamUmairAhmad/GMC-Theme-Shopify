{%- render 'gmc-section-extras' -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add column blocks.' -%}{%- endif -%}
<div class="gmc-mc page-width" id="gmc-mc-{{ section.id }}" style="--cols:{{ s.columns }};--mcols:{{ s.columns_mobile }};--gap:{{ s.gap }}px;--ta:{{ s.text_align }};--ratio:{{ s.ratio }};--rad:{{ s.radius }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px">
  {%- if s.heading != blank or s.subheading != blank -%}<header class="gmc-mc__head">{%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}{%- if s.subheading != blank -%}<p>{{ s.subheading | escape }}</p>{%- endif -%}</header>{%- endif -%}
  <ul class="gmc-mc__g gmc-mc__g--{{ s.mobile_layout }} gmc-mc__style--{{ s.style }} gmc-mc__hover--{{ s.hover }}" role="list">
    {%- for block in section.blocks -%}
      <li class="gmc-mc__c" {% if block.settings.bg != blank %}style="background:{{ block.settings.bg }};{% if block.settings.fg != blank %}color:{{ block.settings.fg }}{% endif %}"{% endif %} {{ block.shopify_attributes }}>
        {%- if s.numbered -%}<span class="gmc-mc__n" aria-hidden="true">{{ forloop.index }}</span>{%- endif -%}
        {%- if block.settings.image != blank -%}
          <div class="gmc-mc__img gmc-mc__img--{{ s.image_shape }}">{%- assign gmc_fp = 'object-position:' | append: block.settings.image.presentation.focal_point -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240,400,600,800', style: gmc_fp, alt: block.settings.image.alt }}</div>
        {%- elsif block.settings.icon_name != blank -%}
          <div class="gmc-mc__icon">{%- render 'gmc-icon', name: block.settings.icon_name, size: s.icon_size -%}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}<h3 class="gmc-mc__t">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gmc-mc__a">{{ block.settings.title | escape }}</a>{%- else -%}{{ block.settings.title | escape }}{%- endif -%}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="rte gmc-mc__x">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link != blank and block.settings.link_label != blank -%}<a class="gmc-mc__l" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} →</a>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if s.button_label != blank and s.button_link != blank -%}<div class="gmc-mc__cta"><a class="button" href="{{ s.button_link }}">{{ s.button_label | escape }}</a></div>{%- endif -%}
</div>
<style>
  #gmc-mc-{{ section.id }} .gmc-mc__head{text-align:center;margin-bottom:2.4rem}#gmc-mc-{{ section.id }} .gmc-mc__head h2{margin:0}#gmc-mc-{{ section.id }} .gmc-mc__head p{margin:.6rem 0 0;opacity:.75}
  #gmc-mc-{{ section.id }} .gmc-mc__g{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:var(--gap)}
  #gmc-mc-{{ section.id }} .gmc-mc__c{position:relative;text-align:var(--ta);display:flex;flex-direction:column;gap:.8rem;align-items:{% if s.text_align == 'center' %}center{% elsif s.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  #gmc-mc-{{ section.id }} .gmc-mc__style--card .gmc-mc__c{padding:2rem;border-radius:var(--rad);background:rgba(var(--color-foreground),.05)}
  #gmc-mc-{{ section.id }} .gmc-mc__style--bordered .gmc-mc__c{padding:2rem;border-radius:var(--rad);border:1px solid rgba(var(--color-foreground),.2)}
  #gmc-mc-{{ section.id }} .gmc-mc__img{width:100%;overflow:hidden;border-radius:var(--rad)}#gmc-mc-{{ section.id }} .gmc-mc__img img{display:block;width:100%;aspect-ratio:var(--ratio);object-fit:cover;transition:transform .4s}
  #gmc-mc-{{ section.id }} .gmc-mc__img--circle{width:min(100%,{{ s.circle_size }}px);aspect-ratio:1;border-radius:50%}#gmc-mc-{{ section.id }} .gmc-mc__img--circle img{height:100%;aspect-ratio:1}
  #gmc-mc-{{ section.id }} .gmc-mc__t,#gmc-mc-{{ section.id }} .gmc-mc__x>:first-child{margin:0}#gmc-mc-{{ section.id }} .gmc-mc__x{opacity:.85}#gmc-mc-{{ section.id }} .gmc-mc__a{color:inherit;text-decoration:none}
  #gmc-mc-{{ section.id }} .gmc-mc__a::after{content:"";position:absolute;inset:0}
  #gmc-mc-{{ section.id }} .gmc-mc__l{margin-top:auto;font-weight:600}
  #gmc-mc-{{ section.id }} .gmc-mc__n{position:absolute;top:-1rem;left:-.4rem;width:3.2rem;height:3.2rem;border-radius:50%;background:rgb(var(--color-foreground));color:rgb(var(--color-background));display:grid;place-items:center;font-weight:700;z-index:2}
  #gmc-mc-{{ section.id }} .gmc-mc__hover--lift .gmc-mc__c{transition:transform .25s,box-shadow .25s}#gmc-mc-{{ section.id }} .gmc-mc__hover--lift .gmc-mc__c:hover{transform:translateY(-6px);box-shadow:0 14px 28px rgba(0,0,0,.12)}
  #gmc-mc-{{ section.id }} .gmc-mc__hover--zoom .gmc-mc__c:hover .gmc-mc__img img{transform:scale(1.07)}
  #gmc-mc-{{ section.id }} .gmc-mc__cta{text-align:center;margin-top:2.4rem}
  #gmc-mc-{{ section.id }} a:focus-visible{outline:2px solid rgb(var(--color-foreground));outline-offset:3px}
  @media(max-width:749px){#gmc-mc-{{ section.id }} .gmc-mc__g{grid-template-columns:repeat(var(--mcols),1fr)}
    #gmc-mc-{{ section.id }} .gmc-mc__g--swipe{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:var(--gap);padding-bottom:1rem;scrollbar-width:thin}
    #gmc-mc-{{ section.id }} .gmc-mc__g--swipe .gmc-mc__c{flex:0 0 {{ s.swipe_width }}%;scroll-snap-align:start}}
  @media(prefers-reduced-motion:reduce){#gmc-mc-{{ section.id }} *{transition:none!important}}
</style>
{% schema %}{"name":"zz body","presets":[{"name":"zz body"}]}{% endschema %}