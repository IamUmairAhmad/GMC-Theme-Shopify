{%- comment -%} GMC Theme: before/after image slider (original code) {%- endcomment -%}
<div class="page-width gmc-cmp-wrap">
  {%- if section.settings.heading != blank -%}<h2 class="gmc-cmp-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.before != blank and section.settings.after != blank -%}
  <div class="gmc-cmp" id="gmc-cmp-{{ section.id }}" style="--pos:50%">
    <div class="gmc-cmp__img">{{ section.settings.after | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', alt: section.settings.after_label }}</div>
    <div class="gmc-cmp__img gmc-cmp__before">{{ section.settings.before | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', alt: section.settings.before_label }}</div>
    <span class="gmc-cmp__tag gmc-cmp__tag--l">{{ section.settings.before_label | escape }}</span>
    <span class="gmc-cmp__tag gmc-cmp__tag--r">{{ section.settings.after_label | escape }}</span>
    <span class="gmc-cmp__handle" aria-hidden="true"></span>
    <input type="range" min="0" max="100" value="50" class="gmc-cmp__range" aria-label="Compare before and after">
  </div>
  {%- else -%}
    <p class="gmc-cmp-empty">Add a before and after image.</p>
  {%- endif -%}
</div>
<style>
  .gmc-cmp-wrap{padding:36px 0}.gmc-cmp-title{text-align:center;margin:0 0 1.5rem}
  .gmc-cmp{position:relative;overflow:hidden;max-width:900px;margin:0 auto;border-radius:12px;user-select:none}
  .gmc-cmp__img img{display:block;width:100%;height:auto}
  .gmc-cmp__before{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
  .gmc-cmp__before img{height:100%;object-fit:cover}
  .gmc-cmp__handle{position:absolute;top:0;bottom:0;left:var(--pos);width:3px;background:#fff;transform:translateX(-50%);box-shadow:0 0 6px rgba(0,0,0,.4);pointer-events:none}
  .gmc-cmp__handle:after{content:"↔";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center}
  .gmc-cmp__range{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
  .gmc-cmp__tag{position:absolute;top:12px;padding:3px 10px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;border-radius:20px;pointer-events:none}
  .gmc-cmp__tag--l{left:12px}.gmc-cmp__tag--r{right:12px}
</style>
<script>
  (function(){var r=document.querySelector('#gmc-cmp-{{ section.id }} .gmc-cmp__range');if(!r)return;
  r.addEventListener('input',function(){r.parentNode.style.setProperty('--pos',r.value+'%');});})();
</script>
{% schema %}
{
  "name": "Before / after slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"See the difference"},
    {"type":"image_picker","id":"before","label":"Before image"},
    {"type":"image_picker","id":"after","label":"After image"},
    {"type":"text","id":"before_label","label":"Before label","default":"Before"},
    {"type":"text","id":"after_label","label":"After label","default":"After"}
  ],
  "presets": [{"name":"Before / after slider"}]
}
{% endschema %}
