{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'before', title: 'Before and after' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- comment -%} GMC Theme: before/after image slider (original code) {%- endcomment -%}
<div class="page-width gmc-cmp-wrap gmc-cmp-wrap--{{ section.settings.layout | default: 'stacked' }}">
  <div class="gmc-cmp-copy">
    {%- if section.settings.heading != blank -%}<h2 class="gmc-cmp-title {{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      {%- liquid
        assign cmp_btn = 'button button--primary'
        if section.settings.button_outline
          assign cmp_btn = 'button button--secondary'
        endif
      -%}
      {%- if section.settings.button_link != blank -%}
        <a class="{{ cmp_btn }}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- else -%}
        <button type="button" class="{{ cmp_btn }}" disabled aria-disabled="true">{{ section.settings.button_label | escape }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="gmc-cmp gmc-cmp--{{ section.settings.handle_style | default: 'circle' }} gmc-cmp--tags-{{ section.settings.tag_pos | default: 'top' }}" id="gmc-cmp-{{ section.id }}" style="--pos:50%;--cl:{{ section.settings.line_color }};--cw:{{ section.settings.line_w }}px;--tg:{{ section.settings.tag_bg }};--tf:{{ section.settings.tag_fg }}">
    <div class="gmc-cmp__img">
      {%- if section.settings.after != blank -%}
        {{ section.settings.after | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', alt: section.settings.after_label }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="gmc-cmp__img gmc-cmp__before">
      {%- if section.settings.before != blank -%}
        {{ section.settings.before | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', alt: section.settings.before_label }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    {%- if section.settings.before_label != blank -%}<span class="gmc-cmp__tag gmc-cmp__tag--l">{{ section.settings.before_label | escape }}</span>{%- endif -%}
    {%- if section.settings.after_label != blank -%}<span class="gmc-cmp__tag gmc-cmp__tag--r">{{ section.settings.after_label | escape }}</span>{%- endif -%}
    <span class="gmc-cmp__handle" aria-hidden="true"></span>
    <input type="range" min="0" max="100" value="50" class="gmc-cmp__range" aria-label="Compare before and after">
  </div>
</div>
<style>
  .gmc-cmp__handle{background:var(--cl,#fff)!important;width:var(--cw,3px)!important}.gmc-cmp__tag{background:var(--tg)!important;color:var(--tf)!important}.gmc-cmp--bar .gmc-cmp__handle:after{content:"";width:8px;height:44px;border-radius:4px}.gmc-cmp--classic .gmc-cmp__handle:after,.gmc-cmp--arrows .gmc-cmp__handle:after{content:"‹ ›";width:auto;height:auto;letter-spacing:.2em}.gmc-cmp--classic .gmc-cmp__handle:after{background:transparent;box-shadow:none;color:var(--cl,#fff)}.gmc-cmp--arrows .gmc-cmp__handle:after{padding:.3rem .9rem;border-radius:99px}.gmc-cmp--line .gmc-cmp__handle:after{display:none}.gmc-cmp--tags-bottom .gmc-cmp__tag{top:auto!important;bottom:1rem}
  .gmc-cmp-wrap{padding:36px 0;display:grid;gap:2rem;align-items:center}.gmc-cmp-title{margin:0 0 1rem}.gmc-cmp-copy{display:grid;gap:1rem;justify-items:center;text-align:center}.gmc-cmp-wrap--stacked{justify-items:center}.gmc-cmp-wrap--stacked .gmc-cmp{width:100%}.gmc-cmp-wrap--stacked .gmc-cmp,.gmc-cmp-wrap--slider-left .gmc-cmp{order:-1}@media(min-width:750px){.gmc-cmp-wrap--slider-left,.gmc-cmp-wrap--slider-right{grid-template-columns:1fr 1fr}.gmc-cmp-wrap--slider-left .gmc-cmp,.gmc-cmp-wrap--slider-right .gmc-cmp{max-width:none}}
  .gmc-cmp{position:relative;overflow:hidden;max-width:900px;width:100%;margin:0 auto;border-radius:var(--text-boxes-radius);user-select:none;min-height:12rem}
  .gmc-cmp__img img,.gmc-cmp__img svg{display:block;width:100%;height:auto}
  .gmc-cmp__before{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
  .gmc-cmp__before img,.gmc-cmp__before svg{height:100%;object-fit:cover}
  .gmc-cmp__handle{position:absolute;top:0;bottom:0;left:var(--pos);width:3px;background:#fff;transform:translateX(-50%);box-shadow:0 0 6px rgba(var(--color-shadow),.4);pointer-events:none}
  .gmc-cmp__handle:after{content:"↔";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center}
  .gmc-cmp__range{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
  .gmc-cmp__tag{position:absolute;top:12px;padding:3px 10px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;border-radius:var(--text-boxes-radius);pointer-events:none}
  .gmc-cmp__tag--l{left:12px}.gmc-cmp__tag--r{right:12px}
</style>
<script>
  (function(){var r=document.querySelector('#gmc-cmp-{{ section.id }} .gmc-cmp__range');if(!r)return;
  r.addEventListener('input',function(){r.parentNode.style.setProperty('--pos',r.value+'%');});})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Before / after slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before & After slider"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Drag the handle to compare the two photos.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_outline",
      "label": "Use outline button style",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop slider placement",
      "options": [
        { "value": "slider-left", "label": "Slider first" },
        { "value": "slider-right", "label": "Slider second" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "slider-right"
    },
    {
      "type": "image_picker",
      "id": "before",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "select",
      "id": "handle_style",
      "label": "Handle style",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "circle",
          "label": "Circle around"
        },
        {
          "value": "arrows",
          "label": "Arrow pill"
        },
        {
          "value": "bar",
          "label": "Bar"
        },
        {
          "value": "line",
          "label": "Line only"
        }
      ],
      "default": "circle"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "line_w",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Line width",
      "default": 3
    },
    {
      "type": "select",
      "id": "tag_pos",
      "label": "Label position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "color",
      "id": "tag_bg",
      "label": "Label background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_fg",
      "label": "Label text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Before / after slider"
    }
  ]
}
{% endschema %}
