{%- render 'gmc-section-extras' -%}
<div class="page-width gmc-sg" style="padding-top:{{ section.settings.pt }}px;padding-bottom:{{ section.settings.pb }}px">
  <div class="gmc-sg__in" style="display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:{{ section.settings.gap }}px;align-items:{{ section.settings.align }}">
    {%- content_for 'blocks' -%}
  </div>
</div>
<style>@media(max-width:749px){#shopify-section-{{ section.id }} .gmc-sg__in{grid-template-columns:repeat({{ section.settings.columns_mobile }},1fr)!important}}</style>
{% schema %}
{"name":"Section group","tag":"section","class":"section","settings":[
 {"type":"paragraph","content":"A flexible container: add groups, text, images, buttons and icons in any order."},
 {"type":"range","id":"columns","min":1,"max":4,"label":"Columns (desktop)","default":2},
 {"type":"range","id":"columns_mobile","min":1,"max":2,"label":"Columns (mobile)","default":1},
 {"type":"range","id":"gap","min":0,"max":80,"step":4,"unit":"px","label":"Gap","default":24},
 {"type":"select","id":"align","label":"Vertical alignment","options":[{"value":"start","label":"Top"},{"value":"center","label":"Middle"},{"value":"end","label":"Bottom"}],"default":"start"},
 {"type":"range","id":"pt","min":0,"max":120,"step":4,"unit":"px","label":"Top padding","default":36},
 {"type":"range","id":"pb","min":0,"max":120,"step":4,"unit":"px","label":"Bottom padding","default":36},
 {"type":"header","content":"Layout (GMC)"},
 {"type":"range","id":"gmc_max_width","min":0,"max":1600,"step":50,"unit":"px","label":"Max content width (0 = theme default)","default":0},
 {"type":"color","id":"gmc_bg_color","label":"Section background color"},
 {"type":"image_picker","id":"gmc_bg_image","label":"Background image"},
 {"type":"video","id":"gmc_bg_video","label":"Background video (MP4 upload)"},
 {"type":"range","id":"gmc_bg_overlay","min":0,"max":80,"step":5,"unit":"%","label":"Background overlay","default":0}],
 "blocks":[{"type":"_gmc-group"},{"type":"_gmc-text"},{"type":"_gmc-image"},{"type":"_gmc-button"},{"type":"_gmc-icon-text"}],
 "presets":[{"name":"Section group","blocks":[{"type":"_gmc-group","blocks":[{"type":"_gmc-text"},{"type":"_gmc-button"}]},{"type":"_gmc-image"}]}]}
{% endschema %}
