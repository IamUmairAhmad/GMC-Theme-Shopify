{%- render 'gmc-section-extras' -%}
<div class="page-width {% render 'gmc-vis', hide: section.settings.hide_on %}" style="padding:{{ section.settings.pad }}px 0"><hr style="border:0;border-top:{{ section.settings.w }}px {{ section.settings.style }} {{ section.settings.color }};margin:0"></div>
{% schema %}
{
 "name": "Section divider",
 "tag": "section",
 "settings": [
  {
   "type": "color",
   "id": "color",
   "label": "Color",
   "default": "#cccccc"
  },
  {
   "type": "select",
   "id": "style",
   "label": "Style",
   "options": [
    {
     "value": "solid",
     "label": "Solid"
    },
    {
     "value": "dashed",
     "label": "Dashed"
    },
    {
     "value": "dotted",
     "label": "Dotted"
    }
   ],
   "default": "solid"
  },
  {
   "type": "range",
   "id": "w",
   "min": 1,
   "max": 6,
   "unit": "px",
   "label": "Thickness",
   "default": 1
  },
  {
   "type": "range",
   "id": "pad",
   "min": 0,
   "max": 80,
   "step": 4,
   "unit": "px",
   "label": "Spacing",
   "default": 16
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "presets": [
  {
   "name": "Section divider"
  }
 ]
}
{% endschema %}
