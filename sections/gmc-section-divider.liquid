<div class="page-width {% render 'gmc-vis', hide: section.settings.hide_on %}" style="padding:{{ section.settings.pad }}px 0"><hr style="border:0;border-top:{{ section.settings.w }}px {{ section.settings.style }} {{ section.settings.color }};margin:0"></div>
{% schema %}
{"name":"Section divider","tag":"section","settings":[{"type":"color","id":"color","label":"Color","default":"#cccccc"},{"type":"select","id":"style","label":"Style","options":[{"value":"solid","label":"Solid"},{"value":"dashed","label":"Dashed"},{"value":"dotted","label":"Dotted"}],"default":"solid"},{"type":"range","id":"w","min":1,"max":6,"unit":"px","label":"Thickness","default":1},{"type":"range","id":"pad","min":0,"max":80,"step":4,"unit":"px","label":"Spacing","default":16},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"presets":[{"name":"Section divider"}]}
{% endschema %}
