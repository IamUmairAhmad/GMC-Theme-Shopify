{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'features', title: 'Product extra blocks' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- comment -%} GMC Theme: product page info blocks. Add this section to the product template and stack the blocks you want. {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<div class="gmc-pe {% render 'gmc-vis', hide: section.settings.hide_on %}">
{%- for block in section.blocks -%}
  <div class="gmc-pe__b" style="margin-bottom:{{ block.settings.mb }}px" {{ block.shopify_attributes }}>
  {%- case block.type -%}{%- when 'complimentary' -%}
      {%- assign cp = block.settings.product -%}{%- if cp != blank -%}
      <div class="gmc-pe__comp" data-gmc-addon="{{ cp.selected_or_first_available_variant.id }}" data-gmc-always="1">{%- if cp.featured_image -%}{{ cp.featured_image | image_url: width: 120 | image_tag: width: 52, height: 52, loading: 'lazy' }}{%- endif -%}<span><strong>{{ block.settings.text | escape }}</strong><br>{{ cp.title | escape }} <s style="opacity:.6">{{ cp.price | money }}</s> <b style="color:{{ settings.gmc_accent }}">FREE</b></span></div>{%- endif -%}{%- when 'upsell' -%}
      {%- assign up = block.settings.product -%}{%- if up != blank -%}
      <label class="gmc-pe__comp"><input type="checkbox" data-gmc-addon="{{ up.selected_or_first_available_variant.id }}" {% if block.settings.checked %}checked{% endif %}>{%- if up.featured_image -%}{{ up.featured_image | image_url: width: 120 | image_tag: width: 52, height: 52, loading: 'lazy' }}{%- endif -%}<span><strong>{{ block.settings.text | escape }}</strong><br>{{ up.title | escape }} — {{ up.selected_or_first_available_variant.price | money }}</span></label>{%- endif -%}{%- when 'upsells' -%}
      {%- assign ups = block.settings.products -%}
      {%- if ups != blank -%}
      {%- liquid
        assign us = block.settings
        assign u_style = us.toggle_style | default: 'checkbox'
      -%}
      <div class="gmc-ups gmc-ups--{{ us.layout }}" style="{% if us.bg != blank %}background:{{ us.bg }};{% endif %}{% if us.pad > 0 %}padding:{{ us.pad }}px;{% endif %}border-radius:{{ us.radius }}px;{% if us.border > 0 %}border:{{ us.border }}px solid rgba(var(--color-foreground),.2);{% endif %}">
        {%- if us.heading != blank -%}<p class="gmc-ups__h">{{ us.heading | escape }}</p>{%- endif -%}
        <div class="gmc-ups__list">
        {%- for up in ups limit: 3 -%}
          {%- liquid
            assign uv = up.selected_or_first_available_variant
            assign up_price = uv.price
            assign up_disc = up_price
            if us.discount_type == 'percent' and us.discount_percent > 0
              assign um = 100 | minus: us.discount_percent
              assign up_disc = up_price | times: um | divided_by: 100.0 | round
            elsif us.discount_type == 'fixed' and us.discount_fixed > 0
              assign ufx = us.discount_fixed | times: 100 | round
              assign up_disc = up_price | minus: ufx
              if up_disc < 0
                assign up_disc = 0
              endif
            endif
          -%}
          <div class="gmc-ups__item" data-dtype="{{ us.discount_type }}" data-dpct="{{ us.discount_percent }}" data-dfix="{{ us.discount_fixed | times: 100 | round }}">
            <label class="gmc-ups__row">
              <input type="checkbox" class="gmc-ups__in" data-gmc-unitadd="{{ uv.id }}" {% if us.preselect %}checked{% endif %} {% unless uv.available %}disabled{% endunless %}>
              <span class="gmc-ups__tgl gmc-ups__tgl--{{ u_style }}" aria-hidden="true"></span>
              {%- if us.show_image and up.featured_image != blank -%}<span class="gmc-ups__img">{{ up.featured_image | image_url: width: 140 | image_tag: width: 56, height: 56, loading: 'lazy', alt: up.title }}</span>{%- endif -%}
              <span class="gmc-ups__txt">
                <strong>{{ up.title | escape }}</strong>
                {%- if us.show_description and up.description != blank -%}<small>{{ up.description | strip_html | truncate: 90 }}</small>{%- endif -%}
                <span class="gmc-ups__price">{% if up_disc < up_price %}<s>{{ up_price | money }}</s> {% endif %}<b data-ups-now>{{ up_disc | money }}</b></span>
              </span>
            </label>
            {%- if up.variants.size > 1 -%}
              <select class="gmc-ups__var" aria-label="{{ up.title | escape }}">
                {%- for uvar in up.variants -%}<option value="{{ uvar.id }}" data-price="{{ uvar.price }}" {% if uvar.id == uv.id %}selected{% endif %} {% unless uvar.available %}disabled{% endunless %}>{{ uvar.title | escape }} — {{ uvar.price | money }}</option>{%- endfor -%}
              </select>
            {%- endif -%}
          </div>
        {%- endfor -%}
        </div>
      </div>
      {%- endif -%}{%- when 'bundle' -%}
      {%- assign bps = block.settings.products -%}
      {%- liquid
        assign bs = block.settings
        assign b_main = false
        if bs.bundle_type == 'main'
          assign b_main = true
        endif
      -%}
      {%- if bps != blank or b_main -%}
      <div class="gmc-bnd" data-block="{{ block.id }}" data-dtype="{{ bs.discount_type }}" data-dpct="{{ bs.discount_percent }}" data-dfix="{{ bs.discount_fixed | times: 100 | round }}" data-code="{{ bs.discount_code | escape }}" data-skip="{{ bs.skip_cart }}" data-save="{{ bs.save_text | default: 'You save [saved]' | escape }}" data-total="{{ bs.total_text | default: 'Bundle total' | escape }}" style="{% if bs.bg != blank %}background:{{ bs.bg }};{% endif %}border-radius:{{ bs.radius }}px;{% if bs.pad > 0 %}padding:{{ bs.pad }}px;{% endif %}{% if bs.border > 0 %}border:{{ bs.border }}px solid rgba(var(--color-foreground),.2);{% endif %}">
        {%- if bs.heading != blank -%}<p class="gmc-ups__h">{{ bs.heading | escape }}</p>{%- endif -%}
        <div class="gmc-bnd__list">
          {%- if b_main -%}
            {%- assign bmv = product.selected_or_first_available_variant -%}
            <div class="gmc-bnd__item" data-main="true">
              {%- if product.featured_image != blank -%}<span class="gmc-ups__img">{{ product.featured_image | image_url: width: 140 | image_tag: width: 56, height: 56, loading: 'lazy', alt: product.title }}</span>{%- endif -%}
              <span class="gmc-ups__txt"><strong>{{ product.title | escape }}</strong>{%- if bs.show_description and product.description != blank -%}<small>{{ product.description | strip_html | truncate: 90 }}</small>{%- endif -%}
                {%- if product.variants.size > 1 -%}<select class="gmc-bnd__var" aria-label="{{ product.title | escape }}">{%- for bv in product.variants -%}<option value="{{ bv.id }}" data-price="{{ bv.price }}" {% if bv.id == bmv.id %}selected{% endif %} {% unless bv.available %}disabled{% endunless %}>{{ bv.title | escape }}</option>{%- endfor -%}</select>{%- else -%}<input type="hidden" class="gmc-bnd__var" value="{{ bmv.id }}" data-price="{{ bmv.price }}">{%- endif -%}
              </span>
              <span class="gmc-ups__price" data-bnd-price></span>
            </div>
          {%- endif -%}
          {%- for bp in bps limit: 3 -%}
            {%- assign bpv = bp.selected_or_first_available_variant -%}
            <div class="gmc-bnd__item">
              {%- if bp.featured_image != blank -%}<span class="gmc-ups__img">{{ bp.featured_image | image_url: width: 140 | image_tag: width: 56, height: 56, loading: 'lazy', alt: bp.title }}</span>{%- endif -%}
              <span class="gmc-ups__txt"><strong>{{ bp.title | escape }}</strong>{%- if bs.show_description and bp.description != blank -%}<small>{{ bp.description | strip_html | truncate: 90 }}</small>{%- endif -%}
                {%- if bp.variants.size > 1 -%}<select class="gmc-bnd__var" aria-label="{{ bp.title | escape }}">{%- for bv in bp.variants -%}<option value="{{ bv.id }}" data-price="{{ bv.price }}" {% if bv.id == bpv.id %}selected{% endif %} {% unless bv.available %}disabled{% endunless %}>{{ bv.title | escape }}</option>{%- endfor -%}</select>{%- else -%}<input type="hidden" class="gmc-bnd__var" value="{{ bpv.id }}" data-price="{{ bpv.price }}">{%- endif -%}
              </span>
              <span class="gmc-ups__price" data-bnd-price></span>
            </div>
          {%- endfor -%}
        </div>
        <p class="gmc-bnd__sum"><span>{{ bs.total_text | default: 'Bundle total' | escape }}</span> <b data-bnd-total></b></p>
        <p class="gmc-bnd__save" data-bnd-save hidden></p>
        <button type="button" class="button button--full-width gmc-bnd__btn">{{ bs.button | default: 'Add bundle to cart' | escape }}</button>
        <p class="gmc-bnd__err" role="alert" hidden></p>
      </div>
      {%- endif -%}{%- when 'qty_gift' -%}
      {%- assign qg = block.settings.product -%}
      {%- if qg != blank -%}
      {%- assign qgv = qg.selected_or_first_available_variant -%}
      <div class="gmc-qg" data-need="{{ block.settings.unlock_qty }}" data-locked="{{ block.settings.locked_text | default: 'Buy [need] to unlock' | escape }}" data-open="{{ block.settings.unlocked_text | default: 'Unlocked! Free gift added' | escape }}" data-gmc-qgift="{{ qgv.id }}" style="--qg-lock:{{ block.settings.locked_color | default: '#9ca3af' }};--qg-open:{{ block.settings.unlocked_color | default: '#16a34a' }}">
        {%- if block.settings.show_image and qg.featured_image != blank -%}<span class="gmc-ups__img">{{ qg.featured_image | image_url: width: 140 | image_tag: width: 56, height: 56, loading: 'lazy', alt: qg.title }}</span>{%- endif -%}
        <span class="gmc-ups__txt"><strong>{{ qg.title | escape }}</strong><small class="gmc-qg__msg"></small></span>
        <span class="gmc-qg__ic" aria-hidden="true">🔒</span>
      </div>
      {%- endif -%}{%- when 'clickable_discount' -%}
      <button type="button" class="gmc-pe__code gmc-cdisc" data-gmc-code="{{ block.settings.code | escape }}" data-t-on="{{ block.settings.applied_cta | default: 'Code applied' | escape }}" data-t-off="{{ block.settings.cta | default: 'Click to apply' | escape }}" data-i-on="{{ block.settings.applied_icon | default: 'check' }}" style="--cd-bg:{{ block.settings.bg | default: 'transparent' }};--cd-fg:{{ block.settings.fg | default: 'inherit' }};--cd-bd:{{ block.settings.border | default: settings.gmc_accent }};--cd-abg:{{ block.settings.applied_bg | default: '#e8f7ee' }};--cd-afg:{{ block.settings.applied_fg | default: '#14532d' }}"><span class="gmc-cdisc__i">{%- render 'gmc-icon', name: block.settings.icon, size: 20 -%}</span><span>{{ block.settings.text | escape }}</span><b>{{ block.settings.code | escape }}</b><small class="gmc-cdisc__s">{{ block.settings.cta | default: 'Click to apply' | escape }}</small></button>{%- when 'popup_page' -%}
      {%- if block.settings.page != blank -%}<button type="button" class="gmc-pe__link" data-gmc-open="gmc-pop-{{ block.id }}">{{ block.settings.label | escape }}</button>
      <dialog id="gmc-pop-{{ block.id }}" class="gmc-pe__dlg"><form method="dialog"><button class="gmc-pe__dx" aria-label="Close">×</button></form><h3>{{ block.settings.page.title | escape }}</h3><div class="rte">{{ block.settings.page.content }}</div></dialog>{%- endif -%}{%- when 'scroll_to' -%}
      <button type="button" class="button button--secondary button--full-width" data-gmc-scroll="{{ block.settings.target | escape }}">{{ block.settings.label | escape }}</button>{%- when 'link_button' -%}
      <a class="button{% if block.settings.secondary %} button--secondary{% endif %} button--full-width" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>{%- when 'image' -%}
      {%- if block.settings.image != blank -%}<div class="gmc-pm__img{% if block.settings.mobile_full %} gmc-pm__img--mfull{% endif %}" style="--w:{{ block.settings.width }}%;text-align:{{ block.settings.align }}">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300,600,900,1200', style: 'width:100%;height:auto;border-radius:' | append: block.settings.radius | append: 'px' }}</div>{%- endif -%}{%- when 'video' -%}
      {%- if block.settings.video != blank -%}<div class="gmc-pm__vid" data-gmc-vid style="border-radius:{{ block.settings.radius }}px"><video playsinline preload="metadata" {% if block.settings.autoplay %}autoplay muted{% endif %} {% if block.settings.loop %}loop{% endif %} {% unless block.settings.autoplay or block.settings.custom_ui %}controls{% endunless %} {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}>{%- for vs in block.settings.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
        {%- if block.settings.custom_ui -%}<div class="gmc-pm__vc"><button type="button" data-gmc-vplay aria-label="Play or pause">❚❚</button>{%- if block.settings.sound_btn -%}<button type="button" data-gmc-vsound aria-label="Sound on or off">🔇</button>{%- endif -%}{%- if block.settings.timeline -%}<i class="gmc-pm__vt"><b></b></i>{%- endif -%}</div>{%- endif -%}
        {%- if block.settings.ripple -%}<span class="gmc-pm__ripple" aria-hidden="true"></span>{%- endif -%}</div>{%- endif -%}{%- when 'countdown' -%}
      <div class="gmc-pe__cd color-{{ block.settings.scheme }} gradient" data-minutes="{{ block.settings.minutes }}" data-seconds="{{ block.settings.show_seconds }}" data-key="{{ block.id }}" style="font-size:{{ block.settings.text_size }}px;text-align:{{ block.settings.align }};padding:1rem 1.4rem;border-radius:var(--text-boxes-radius,8px)">⏰ {{ block.settings.text | escape }} <b class="gmc-pe__cdt">--:--</b></div>{%- when 'slider' -%}
      <div class="gmc-pe__sl">{%- for i in (1..5) -%}{%- assign k = 'i' | append: i -%}{%- if block.settings[k] != blank -%}<div>{{ block.settings[k] | image_url: width: 700 | image_tag: loading: 'lazy' }}</div>{%- endif -%}{%- endfor -%}</div>{%- when 'container_start' -%}
      <div class="gmc-pe__ctr" style="background:{{ block.settings.bg }};color:{{ block.settings.fg }};padding:{{ block.settings.pad }}px;border-radius:{{ block.settings.radius }}px;border:{{ block.settings.border }}px solid currentColor">{%- when 'container_end' -%}
      </div>{%- when 'tabs' -%}
      <div class="gmc-pe__tabs"><div class="gmc-pe__tn">{%- for i in (1..3) -%}{%- assign tk = 't' | append: i -%}{%- if block.settings[tk] != blank -%}<button type="button" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" data-t="{{ i }}">{{ block.settings[tk] | escape }}</button>{%- endif -%}{%- endfor -%}</div>
        {%- for i in (1..3) -%}{%- assign ck = 'c' | append: i -%}{%- assign tk = 't' | append: i -%}{%- if block.settings[tk] != blank -%}<div class="gmc-pe__tp rte" data-t="{{ i }}" {% unless i == 1 %}hidden{% endunless %}>{{ block.settings[ck] }}</div>{%- endif -%}{%- endfor -%}</div>{%- when 'reviews' -%}
      <div class="gmc-pe__rv">{%- for i in (1..3) -%}{%- assign rk = 'r' | append: i -%}{%- assign nk = 'n' | append: i -%}{%- if block.settings[rk] != blank -%}<blockquote><span style="color:#f5a623">★★★★★</span><p>{{ block.settings[rk] | escape }}</p><small>— {{ block.settings[nk] | escape }}</small></blockquote>{%- endif -%}{%- endfor -%}</div>{%- when 'metafield' -%}
      {%- assign mf = product.metafields[block.settings.namespace][block.settings.key] -%}
      {%- if mf != blank -%}{%- if block.settings.label != blank -%}<strong>{{ block.settings.label | escape }}: </strong>{%- endif -%}{{ mf | metafield_tag }}{%- endif -%}
    {%- when 'savings' -%}
      <p class="gmc-pe__sv" data-text="{{ block.settings.text | escape }}" {% unless v.compare_at_price > v.price %}hidden{% endunless %}>{% if v.compare_at_price > v.price %}{{ block.settings.text | escape }} {{ v.compare_at_price | minus: v.price | money }} ({{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}%){% endif %}</p>{%- endcase -%}
  </div>
{%- endfor -%}
</div>
<style>.gmc-pe__urg{color:#b91c1c;font-weight:600;margin:0}.gmc-pe__stock{color:#16a34a;margin:0}.gmc-pe__eta,.gmc-pe__ts,.gmc-pe__ti{margin:0}.gmc-pe__ben{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}.gmc-pe__ben li:before{content:"✅ "}.gmc-pe__cp{list-style:none;display:flex;justify-content:space-between;text-align:center;padding:0;margin:0}.gmc-pe__bs{display:inline-block;background:#f59e0b;color:#111;font-weight:700;padding:3px 12px;border-radius:var(--badge-corner-radius,99px);font-size:1.2rem}.gmc-pe__sz summary{cursor:pointer;font-weight:600;text-decoration:underline}.gmc-pe__cf{display:grid;gap:.4rem;font-weight:600}.gmc-pe__ra{display:flex;align-items:center;gap:1rem}.gmc-pe__stack{display:flex}.gmc-pe__stack img{border-radius:50%;border:2px solid rgb(var(--color-background));margin-left:-10px;object-fit:cover}.gmc-pe__stack img:first-child{margin-left:0}.gmc-pe__bc{font-size:1.2rem;opacity:.75}
.gmc-pe__comp{display:flex;gap:1rem;align-items:center;padding:.9rem 1.1rem;border:1px dashed rgba(var(--color-foreground),.35);border-radius:var(--text-boxes-radius);cursor:pointer}.gmc-pe__comp img{border-radius:var(--media-radius);object-fit:cover}
.gmc-pe__code{display:flex;gap:1rem;align-items:center;width:100%;padding:.9rem 1.2rem;border:2px dashed {{ settings.gmc_accent }};border-radius:10px;background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:left}.gmc-pe__code b{background:{{ settings.gmc_accent }};color:#fff;padding:2px 10px;border-radius:6px}.gmc-pe__code small{margin-left:auto;opacity:.65}
.gmc-pe__link{background:none;border:0;padding:0;text-decoration:underline;cursor:pointer;color:inherit;font:inherit}.gmc-pe__dlg{max-width:560px;width:92vw;border:0;border-radius:var(--text-boxes-radius);padding:2rem;position:relative}.gmc-pe__dlg::backdrop{background:rgba(0,0,0,.55)}.gmc-pe__dx{position:absolute;top:.5rem;right:1rem;background:none;border:0;font-size:2.6rem;cursor:pointer}
.gmc-pe__sl{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:.6rem}.gmc-pe__sl>div{flex:0 0 85%;scroll-snap-align:start}.gmc-pe__sl img{width:100%;border-radius:var(--media-radius)}
.gmc-pe__tn{display:flex;gap:.4rem;border-bottom:1px solid rgba(var(--color-foreground),.15)}.gmc-pe__tn button{background:none;border:0;padding:.7rem 1rem;cursor:pointer;color:inherit;font:inherit;opacity:.6}.gmc-pe__tn button[aria-selected=true]{opacity:1;border-bottom:2px solid currentColor}.gmc-pe__tp{padding-top:1rem}
.gmc-pe__rv{display:grid;gap:.8rem}.gmc-pe__rv blockquote{margin:0;padding:1rem 1.2rem;border-radius:var(--text-boxes-radius);background:rgba(var(--color-foreground),.05)}.gmc-pe__rv p{margin:.3rem 0}.gmc-pe__sv{color:{{ settings.gmc_accent }};font-weight:700;margin:0}.gmc-pe__cd{font-weight:600}
.gmc-ups{display:grid;gap:.8rem}.gmc-ups__h{margin:0;font-weight:700}.gmc-ups__list{display:grid;gap:.7rem}.gmc-ups--row .gmc-ups__list{grid-template-columns:repeat(auto-fit,minmax(18rem,1fr))}.gmc-ups--slider .gmc-ups__list{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.gmc-ups--slider .gmc-ups__item{flex:0 0 85%;scroll-snap-align:start}
.gmc-ups__item{border:1px solid rgba(var(--color-foreground),.2);border-radius:var(--text-boxes-radius);padding:.9rem 1.1rem}.gmc-ups__row{display:flex;gap:1rem;align-items:center;cursor:pointer}.gmc-ups__in{position:absolute;opacity:0;pointer-events:none}.gmc-ups__img img{border-radius:6px;object-fit:cover;display:block}.gmc-ups__txt{display:grid;gap:.2rem;flex:1}.gmc-ups__txt small{opacity:.7}.gmc-ups__price s{opacity:.6}.gmc-ups__price b{color:{{ settings.gmc_accent }}}
.gmc-ups__tgl{flex:none;width:2.2rem;height:2.2rem;border:2px solid rgba(var(--color-foreground),.5);border-radius:4px;display:grid;place-items:center;transition:.15s}.gmc-ups__tgl--checkbox:after{content:"";width:.9rem;height:.5rem;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg) translate(1px,-1px);opacity:0}.gmc-ups__in:checked+.gmc-ups__tgl--checkbox{background:{{ settings.gmc_accent }};border-color:{{ settings.gmc_accent }}}.gmc-ups__in:checked+.gmc-ups__tgl--checkbox:after{opacity:1}
.gmc-ups__tgl--switch{width:4rem;border-radius:99px;position:relative;display:block}.gmc-ups__tgl--switch:after{content:"";position:absolute;top:2px;left:2px;width:1.4rem;height:1.4rem;border-radius:50%;background:rgba(var(--color-foreground),.5);transition:.15s}.gmc-ups__in:checked+.gmc-ups__tgl--switch{background:{{ settings.gmc_accent }};border-color:{{ settings.gmc_accent }}}.gmc-ups__in:checked+.gmc-ups__tgl--switch:after{left:calc(100% - 1.4rem - 2px);background:#fff}
.gmc-ups__tgl--plus{border-radius:50%}.gmc-ups__tgl--plus:after{content:"+";font-size:2rem;line-height:1}.gmc-ups__in:checked+.gmc-ups__tgl--plus{background:{{ settings.gmc_accent }};border-color:{{ settings.gmc_accent }};color:#fff}.gmc-ups__in:checked+.gmc-ups__tgl--plus:after{content:"✓";font-size:1.4rem}
.gmc-ups__in:focus-visible+.gmc-ups__tgl{outline:2px solid currentColor;outline-offset:2px}.gmc-ups__var{margin-top:.6rem;width:100%;padding:.5rem;border-radius:var(--inputs-radius,4px)}
.gmc-bnd{display:grid;gap:.8rem}.gmc-bnd__list{display:grid;gap:.6rem}.gmc-bnd__item{display:flex;gap:1rem;align-items:center;border:1px solid rgba(var(--color-foreground),.2);border-radius:var(--text-boxes-radius);padding:.9rem 1.1rem}.gmc-bnd__item select{margin-top:.4rem;width:100%;padding:.5rem;border-radius:var(--inputs-radius,4px)}.gmc-bnd__sum{display:flex;justify-content:space-between;margin:0;font-weight:700;font-size:1.1em}.gmc-bnd__save{margin:0;color:{{ settings.gmc_accent }};font-weight:600}.gmc-bnd__err{margin:0;color:#b91c1c}
.gmc-qg{display:flex;gap:1rem;align-items:center;border:2px dashed var(--qg-lock);border-radius:var(--text-boxes-radius);padding:.9rem 1.1rem;transition:.2s}.gmc-qg .gmc-ups__img img{filter:grayscale(1);opacity:.6;transition:.2s}.gmc-qg__ic{font-size:2rem}.gmc-qg[data-state=open]{border:2px solid var(--qg-open);background:color-mix(in srgb,var(--qg-open) 8%,transparent)}.gmc-qg[data-state=open] .gmc-ups__img img{filter:none;opacity:1}.gmc-qg[data-state=open] .gmc-qg__msg{color:var(--qg-open);font-weight:600;opacity:1}
.gmc-pm__img{width:var(--w,100%);margin-inline:auto}@media(max-width:749px){.gmc-pm__img--mfull{width:100%}}.gmc-pm__vid{position:relative;overflow:hidden}.gmc-pm__vid video{width:100%;display:block}.gmc-pm__vc{position:absolute;left:0;right:0;bottom:0;display:flex;gap:.6rem;align-items:center;padding:.6rem;background:linear-gradient(transparent,rgba(0,0,0,.5))}.gmc-pm__vc button{background:rgba(0,0,0,.55);color:#fff;border:0;border-radius:50%;width:3.2rem;height:3.2rem;cursor:pointer}.gmc-pm__vt{flex:1;height:4px;background:rgba(255,255,255,.35);border-radius:2px;overflow:hidden}.gmc-pm__vt b{display:block;height:100%;width:0;background:#fff}.gmc-pm__ripple{position:absolute;inset:auto auto 1rem 1rem;width:3rem;height:3rem;border-radius:50%;box-shadow:0 0 0 0 rgba(255,255,255,.7);animation:gmcrip 2s infinite;pointer-events:none}@keyframes gmcrip{to{box-shadow:0 0 0 18px rgba(255,255,255,0)}}@media(prefers-reduced-motion:reduce){.gmc-pm__ripple{animation:none}}</style>
<script>(function(){document.querySelectorAll('.gmc-eta').forEach(function(e){function f(n){var d=new Date();d.setDate(d.getDate()+(+n));return d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});}e.textContent=f(e.dataset.min)+' and '+f(e.dataset.max);});})();</script>
