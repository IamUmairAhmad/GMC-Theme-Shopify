        },
        {
          "type": "range",
          "id": "gmc_wm",
          "min": 0,
          "max": 100,
          "step": 50,
          "unit": "%",
          "label": "Width on mobile (0 = automatic)",
          "default": 0
        }
      ]
    },
    {
      "type": "featured_product",
      "name": "Featured product",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "add_to_cart",
          "label": "Show add to cart",
          "default": false
        },
        {
          "type": "text",
          "id": "atc_label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "header",
          "content": "Width"
        },
        {
          "type": "range",
          "id": "gmc_wd",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Width on desktop (0 = automatic)",
          "default": 0
        },
        {
          "type": "range",
          "id": "gmc_wm",
          "min": 0,
          "max": 100,
          "step": 50,
          "unit": "%",
          "label": "Width on mobile (0 = automatic)",
          "default": 0
        }
      ]
    },
    {
      "type": "featured_collection",
      "name": "Featured collection",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "count",
          "min": 0,
          "max": 8,
          "step": 1,
          "label": "Product links",
          "default": 3
        },
        {
          "type": "header",
          "content": "Width"
        },
        {
          "type": "range",
          "id": "gmc_wd",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Width on desktop (0 = automatic)",
          "default": 0
        },
        {
          "type": "range",
          "id": "gmc_wm",
          "min": 0,
          "max": 100,
          "step": 50,
          "unit": "%",
          "label": "Width on mobile (0 = automatic)",
          "default": 0
        }
      ]
