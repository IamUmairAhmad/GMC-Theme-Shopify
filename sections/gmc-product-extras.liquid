          "id": "mb",
          "min": 0,
          "max": 40,
          "step": 4,
          "unit": "px",
          "label": "Margin below",
          "default": 12
        }
      ]
    },
    {
      "type": "bestseller",
      "name": "Bestseller badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
