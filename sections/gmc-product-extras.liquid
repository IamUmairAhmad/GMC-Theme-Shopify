          "min": 0,
          "max": 40,
          "step": 4,
          "unit": "px",
          "label": "Margin below",
          "default": 12
        }
      ]
    },
    {
      "type": "text_icon",
      "name": "Text with icon",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Or icon name (e.g. truck)",
          "info": "From the built-in icon library"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your shipping message"
        },
        {
          "type": "range",
          "id": "mb",
          "min": 0,
          "max": 40,
          "step": 4,
          "unit": "px",
          "label": "Margin below",
          "default": 12
        }
      ]
    },
    {
      "type": "custom_field",
      "name": "Custom product field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field label",
          "default": "Engraving text"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "range",
          "id": "mb",
          "min": 0,
          "max": 40,
          "step": 4,
          "unit": "px",
          "label": "Margin below",
          "default": 12
        }
      ]
    },
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "settings": [
        {
          "type": "range",
          "id": "mb",
          "min": 0,
          "max": 40,
          "step": 4,
          "unit": "px",
          "label": "Margin below",
          "default": 12
        }
      ]
    },
    {
      "type": "review_avatars",
      "name": "Review avatars",
      "settings": [
        {
          "type": "image_picker",
          "id": "a1",
          "label": "Avatar 1"
        },
        {
          "type": "image_picker",
          "id": "a2",
          "label": "Avatar 2"
        },
        {
          "type": "image_picker",
          "id": "a3",
          "label": "Avatar 3"
        },
        {
          "type": "image_picker",
          "id": "a4",
          "label": "Avatar 4"
        },
        {
          "type": "image_picker",
          "id": "a5",
          "label": "Avatar 5"
        },
        {
          "type": "text",
          "id": "text",
