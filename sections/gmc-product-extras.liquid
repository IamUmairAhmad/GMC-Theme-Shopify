{%- render 'gmc-scheme' -%}
{%- comment -%} GMC Theme: product page info blocks. Add this section to the product template and stack the blocks you want. {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<div class="gmc-pe {% render 'gmc-vis', hide: section.settings.hide_on %}">
<script type="application/json" class="gmc-vdata">[{%- for pv in product.variants -%}{"id":{{ pv.id }},"a":{{ pv.available | json }},"q":{% if pv.inventory_management != blank %}{{ pv.inventory_quantity | default: 0 }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
{%- for block in section.blocks -%}
  <div class="gmc-pe__b" style="margin-bottom:{{ block.settings.mb }}px" {{ block.shopify_attributes }}>
  {%- case block.type -%}{%- when 'urgency' -%}
      <p class="gmc-pe__urg" data-gmc-urg data-threshold="{{ block.settings.threshold }}" data-fallback="{{ block.settings.fallback | escape }}" {% unless v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= block.settings.threshold or block.settings.fallback != blank and v.available %}hidden{% endunless %}>{%- if v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= block.settings.threshold -%}🔥 Only {{ v.inventory_quantity }} left in stock — order soon{%- elsif v.available -%}{{ block.settings.fallback | escape }}{%- endif -%}</p>
    {%- when 'inventory' -%}
      <p class="gmc-pe__stock" data-gmc-inv data-showqty="{{ block.settings.show_qty }}" {% unless v.available %}style="color:#b91c1c"{% endunless %}>{%- if v.available -%}● In stock{% if v.inventory_management != blank and v.inventory_quantity > 0 and block.settings.show_qty %} ({{ v.inventory_quantity }} available){% endif %}{%- else -%}● Out of stock{%- endif -%}</p>
    {%- when 'estimated_delivery' -%}
      <p class="gmc-pe__eta" data-gmc-eta data-min="{{ block.settings.min_days }}" data-max="{{ block.settings.max_days }}" data-skip="{{ block.settings.skip_weekends }}" data-fmt="{{ block.settings.date_format }}" data-days="{{ block.settings.day_names | escape }}" data-months="{{ block.settings.month_names | escape }}" data-tpl="{{ block.settings.text | default: 'Order today and get it between [start_date] and [end_date]' | escape }}" style="text-align:{{ block.settings.align }}">{%- if block.settings.icon != blank -%}<span class="gmc-pe__ic">{%- render 'gmc-icon', name: block.settings.icon, size: 22 -%}</span> {%- endif -%}<span class="gmc-pe__eta-t">{{ block.settings.text | default: 'Order today and get it between [start_date] and [end_date]' | escape }}</span></p>{%- when 'benefits' -%}
      <ul class="gmc-pe__ben">{%- for i in (1..5) -%}{%- assign k = 'b' | append: i -%}{%- if block.settings[k] != blank -%}<li>{{ block.settings[k] | escape }}</li>{%- endif -%}{%- endfor -%}</ul>{%- when 'payment_badges' -%}
      {%- assign pt_all = 'visa,master,american_express,discover,diners_club,jcb,paypal,apple_pay,google_pay,shopify_pay,amazon,klarna,afterpay,ideal,bancontact,sofort,maestro,unionpay,alipay,venmo,dankort,elo,forbrugsforeningen' | split: ',' -%}{%- assign pt_pick = '' -%}{%- for pn in pt_all -%}{%- assign pk = 'pay_' | append: pn -%}{%- if block.settings[pk] -%}{%- assign pt_pick = pt_pick | append: pn | append: ',' -%}{%- endif -%}{%- endfor -%}{%- if block.settings.types != blank -%}{%- assign pt_list = block.settings.types | remove: ' ' | split: ',' -%}{%- elsif pt_pick != blank -%}{%- assign pt_list = pt_pick | split: ',' -%}{%- else -%}{%- assign pt_list = shop.enabled_payment_types -%}{%- endif -%}
      <ul class="list-payment" role="list" style="display:flex;gap:.5rem;flex-wrap:wrap;padding:0;margin:0;list-style:none;justify-content:{{ block.settings.align }}">{%- for type in pt_list -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- when 'shipping_checkpoints' -%}
      <ol class="gmc-pe__cp gmc-pe__cp--dated" data-gmc-cp data-skip="{{ block.settings.skip_weekends }}" data-fmt="{{ block.settings.date_format }}" data-days="{{ block.settings.day_names | escape }}" data-months="{{ block.settings.month_names | escape }}" style="{% if block.settings.accent != blank %}--gmc-cp:{{ block.settings.accent }};{% endif %}">
        {%- for i in (1..4) -%}
          {%- assign lk = 'step' | append: i -%}{%- assign ik = 'icon' | append: i -%}{%- assign fk = 'from' | append: i -%}{%- assign tk = 'to' | append: i -%}{%- assign bk = 'bottom' | append: i -%}
          <li data-from="{{ block.settings[fk] }}" data-to="{{ block.settings[tk] }}" data-tpl="{{ block.settings[bk] | escape }}"><span class="gmc-pe__cpi">{%- render 'gmc-icon', name: block.settings[ik], size: 22 -%}</span><b>{{ block.settings[lk] | escape }}</b><small class="gmc-pe__cpd">{{ block.settings[bk] | escape }}</small></li>
        {%- endfor -%}
      </ol>{%- when 'trust_stars' -%}
      {%- assign mf = product.metafields.reviews.rating.value -%}
      {%- assign mfc = product.metafields.reviews.rating_count.value -%}
      {%- if block.settings.rating != blank -%}{%- assign tr = block.settings.rating | plus: 0.0 -%}{%- assign tcount = block.settings.text -%}
      {%- elsif mf != blank -%}{%- assign tr = mf.rating | plus: 0.0 | times: 5 | divided_by: mf.scale_max -%}{%- if mfc != blank -%}{%- capture tcount -%}({{ mfc }} reviews){%- endcapture -%}{%- endif -%}
      {%- else -%}{%- assign tr = nil -%}{%- endif -%}
      {%- if tr != nil -%}{%- assign tfull = tr | round -%}{%- assign sc = block.settings.star_color | default: '#00b67a' -%}
      <p class="gmc-pe__ts" style="font-size:{{ block.settings.size }}px">{%- if block.settings.link_to != blank -%}<a href="#{{ block.settings.link_to | escape }}" class="gmc-pe__tsl" style="color:inherit;text-decoration:none">{%- endif -%}<span class="gmc-pe__stars gmc-pe__stars--{{ block.settings.star_style }}" style="color:{{ sc }};font-size:{{ block.settings.size | times: 1.3 | round }}px" aria-label="Rated {{ tr | round: 1 }} out of 5">{%- for i in (1..5) -%}{%- if i <= tfull -%}<i class="on">★</i>{%- else -%}<i>★</i>{%- endif -%}{%- endfor -%}</span> {{ tr | round: 1 }}/5 {{ tcount | escape }}{%- if block.settings.link_to != blank -%}</a>{%- endif -%}</p>{%- endif -%}
    {%- when 'reviews_slider' -%}
      <div class="gmc-pe__rvs gmc-sl" data-gmc-slider data-mode="slide" data-autoplay="{% if block.settings.autoplay %}5{% else %}0{% endif %}" data-loop="true" data-dots="true" data-arrows="false" data-drag="true" style="text-align:{{ block.settings.align }}"><div class="gmc-sl__vp"><div class="gmc-sl__tr">
        {%- for i in (1..3) -%}{%- assign tk = 'text' | append: i -%}{%- assign nk = 'name' | append: i -%}{%- assign ak = 'avatar' | append: i -%}{%- assign rk = 'stars' | append: i -%}
          {%- if block.settings[tk] != blank -%}<figure class="gmc-sl__s gmc-pe__rvi">{%- if block.settings[ak] != blank -%}{{ block.settings[ak] | image_url: width: 120 | image_tag: loading: 'lazy', class: 'gmc-pe__rva', width: 48, height: 48 }}{%- endif -%}<span style="color:{{ block.settings.star_color }}" aria-label="{{ block.settings[rk] }} out of 5">{%- for n in (1..5) -%}{%- if n <= block.settings[rk] -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</span><blockquote>{{ block.settings[tk] | escape }}</blockquote><figcaption>{{ block.settings[nk] | escape }}</figcaption></figure>{%- endif -%}
        {%- endfor -%}
      </div></div></div>
    {%- when 'bestseller' -%}
      <span class="gmc-pe__bs">{{ block.settings.text | escape }}</span>{%- when 'sizing_chart' -%}
      {%- assign sz_id = 'gmc-sz-' | append: block.id -%}
      <button type="button" class="gmc-pe__szb{% if block.settings.underline %} gmc-pe__szb--u{% endif %}{% if block.settings.style == 'button' %} button button--secondary{% endif %}" data-gmc-dlg="{{ sz_id }}" style="font-size:{{ block.settings.text_size }}px">{%- if block.settings.icon != blank -%}{%- render 'gmc-icon', name: block.settings.icon, size: block.settings.icon_size -%} {%- endif -%}{{ block.settings.label | escape }}</button>
      <dialog class="gmc-dlg" id="{{ sz_id }}" aria-label="{{ block.settings.heading | escape }}"{% if block.settings.test_mode %} data-gmc-open{% endif %}>
        <div class="gmc-dlg__in"><button type="button" class="gmc-dlg__x" data-gmc-dlgx aria-label="Close">×</button>
          {%- if block.settings.heading != blank -%}<h3 class="gmc-dlg__h">{{ block.settings.heading | escape }}</h3>{%- endif -%}
          {%- if block.settings.image_top != blank -%}{{ block.settings.image_top | image_url: width: 900 | image_tag: loading: 'lazy', class: 'gmc-dlg__img' }}{%- endif -%}
          {%- if block.settings.header_row != blank -%}<p class="gmc-dlg__hr">{{ block.settings.header_row | escape }}</p>{%- endif -%}
          {%- if block.settings.table_text != blank -%}
            {%- assign tt_rows = block.settings.table_text | strip | newline_to_br | split: '<br />' -%}
            <div class="gmc-dlg__tw"><table class="gmc-dlg__t">
            {%- for tr in tt_rows -%}{%- assign tr_s = tr | strip -%}{%- if tr_s != blank -%}
              {%- assign tt_cells = tr_s | split: ',' -%}
              <tr>{%- for tc in tt_cells -%}{%- assign tc_s = tc | strip -%}{%- if tc_s == '-' -%}{%- assign tc_s = '' -%}{%- endif -%}{%- if forloop.parentloop.first or forloop.first -%}<th scope="{% if forloop.parentloop.first %}col{% else %}row{% endif %}">{{ tc_s | escape }}</th>{%- else -%}<td>{{ tc_s | escape }}</td>{%- endif -%}{%- endfor -%}</tr>
            {%- endif -%}{%- endfor -%}
            </table></div>
          {%- endif -%}
          <div class="rte gmc-dlg__body">{{ block.settings.content }}</div>
          {%- if block.settings.image_bottom != blank -%}{{ block.settings.image_bottom | image_url: width: 900 | image_tag: loading: 'lazy', class: 'gmc-dlg__img' }}{%- endif -%}
          {%- if block.settings.caption != blank -%}<p class="gmc-dlg__cap">{{ block.settings.caption | escape }}</p>{%- endif -%}
        </div></dialog>{%- when 'text_icon' -%}
      <div class="gmc-pe__ti{% if block.settings.box %} gmc-pe__ti--box{% endif %}" style="text-align:{{ block.settings.align }};{% if block.settings.box %}border:{{ block.settings.border_w }}px solid {{ block.settings.border_c }};border-radius:{{ block.settings.radius }}px;background:{{ block.settings.bg }};padding:1rem 1.4rem;{% endif %}"><span class="gmc-pe__tii" style="font-size:{{ block.settings.icon_size }}px;color:{{ block.settings.icon_c }}">{%- if block.settings.icon_name != blank -%}{%- render 'gmc-icon', name: block.settings.icon_name, size: block.settings.icon_size -%}{%- else -%}{{ block.settings.icon | escape }}{%- endif -%}</span><span class="gmc-pe__tit"><strong>{{ block.settings.text | escape }}</strong>{%- if block.settings.text2 != blank -%}<br>{{ block.settings.text2 | escape }}{%- endif -%}{%- if block.settings.text3 != blank -%}<br><small>{{ block.settings.text3 | escape }}</small>{%- endif -%}</span></div>{%- when 'custom_field' -%}
      {%- liquid
        assign cf_type = block.settings.field_type | default: 'text'
        assign cf_name = block.settings.label | escape
        assign cf_opts = block.settings.options | split: ','
      -%}
      <div class="gmc-pe__cf" data-gmc-cf data-required="{{ block.settings.required }}" data-type="{{ cf_type }}" data-error="{{ block.settings.error | default: 'Please complete this field.' | escape }}" style="margin-bottom:{{ block.settings.mb }}px">
        <span class="gmc-pe__cfl" id="cf-{{ block.id }}-l">{{ cf_name }}{% if block.settings.required %} <abbr title="required" style="text-decoration:none">*</abbr>{% endif %}</span>
        {%- case cf_type -%}
          {%- when 'textarea' -%}
            <textarea class="field__input" rows="3" data-gmc-prop="properties[{{ cf_name }}]" aria-labelledby="cf-{{ block.id }}-l" {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %} {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %} style="padding:.9rem"></textarea>
          {%- when 'number' -%}
            <input type="number" class="field__input" data-gmc-prop="properties[{{ cf_name }}]" aria-labelledby="cf-{{ block.id }}-l" {% if block.settings.number_min != blank %}min="{{ block.settings.number_min }}"{% endif %} {% if block.settings.number_max != blank %}max="{{ block.settings.number_max }}"{% endif %} {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %} style="padding:.9rem">
          {%- when 'dropdown' -%}
            <select class="field__input" data-gmc-prop="properties[{{ cf_name }}]" aria-labelledby="cf-{{ block.id }}-l" style="padding:.9rem">
              <option value="">{{ block.settings.placeholder | default: 'Choose an option' | escape }}</option>
              {%- for o in cf_opts -%}{%- assign ov = o | strip -%}{%- if ov != blank -%}<option value="{{ ov | escape }}">{{ ov | escape }}</option>{%- endif -%}{%- endfor -%}
            </select>
          {%- when 'pills' -%}
            <div class="gmc-pe__pills" role="radiogroup" aria-labelledby="cf-{{ block.id }}-l">
              {%- for o in cf_opts -%}{%- assign ov = o | strip -%}{%- if ov != blank -%}<label class="gmc-pe__pill"><input type="radio" name="cf-{{ block.id }}" value="{{ ov | escape }}" data-gmc-prop="properties[{{ cf_name }}]"><span>{{ ov | escape }}</span></label>{%- endif -%}{%- endfor -%}
            </div>
          {%- else -%}
            <input type="text" class="field__input" data-gmc-prop="properties[{{ cf_name }}]" aria-labelledby="cf-{{ block.id }}-l" {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %} {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %} style="padding:.9rem">
        {%- endcase -%}
        <small class="gmc-pe__cferr" role="alert" hidden></small>
      </div>{%- when 'breadcrumb' -%}
      <nav class="gmc-pe__bc"><a href="{{ routes.root_url }}">Home</a> › {%- if collection != blank %} <a href="{{ collection.url }}">{{ collection.title | escape }}</a> › {% endif %} {{ product.title | escape }}</nav>{%- when 'review_avatars' -%}
      {%- if block.settings.text != blank or block.settings.a1 != blank -%}<div class="gmc-pe__ra"><span class="gmc-pe__stack">{%- for i in (1..5) -%}{%- assign k = 'a' | append: i -%}{%- if block.settings[k] != blank -%}{{ block.settings[k] | image_url: width: 80 | image_tag: width: 32, height: 32, loading: 'lazy' }}{%- endif -%}{%- endfor -%}</span><span><span style="color:#f5a623">★★★★★</span> {{ block.settings.text | escape }}</span></div>{%- endif -%}{%- when 'divider' -%}<hr style="border:0;border-top:1px solid rgba(var(--color-foreground),.15)">{%- when 'liquid' -%}{{ block.settings.code }}
  {%- endcase -%}
  </div>
{%- endfor -%}
</div>
<style>.gmc-pe__urg{color:#b91c1c;font-weight:600;margin:0}.gmc-pe__stock{color:#16a34a;margin:0}.gmc-pe__eta,.gmc-pe__ts,.gmc-pe__ti{margin:0}.gmc-pe__ben{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}.gmc-pe__ben li:before{content:"✅ "}.gmc-pe__cp{list-style:none;display:flex;justify-content:space-between;text-align:center;padding:0;margin:0}.gmc-pe__bs{display:inline-block;background:#f59e0b;color:#111;font-weight:700;padding:3px 12px;border-radius:var(--badge-corner-radius,99px);font-size:1.2rem}.gmc-pe__sz summary{cursor:pointer;font-weight:600;text-decoration:underline}.gmc-pe__cf{display:grid;gap:.4rem;font-weight:600}.gmc-pe__cf[data-invalid] .field__input,.gmc-pe__cf[data-invalid] .gmc-pe__pill span{border-color:#b91c1c}.gmc-pe__cferr{color:#b91c1c;font-weight:400}.gmc-pe__pills{display:flex;gap:.6rem;flex-wrap:wrap}.gmc-pe__pill input{position:absolute;opacity:0;pointer-events:none}.gmc-pe__pill span{display:inline-block;padding:.7rem 1.4rem;border:1px solid rgba(var(--color-foreground),.3);border-radius:99px;cursor:pointer;font-weight:400}.gmc-pe__pill input:checked+span{background:rgb(var(--color-foreground));color:rgb(var(--color-background));border-color:rgb(var(--color-foreground))}.gmc-pe__pill input:focus-visible+span{outline:2px solid currentColor;outline-offset:2px}.gmc-pe__ra{display:flex;align-items:center;gap:1rem}.gmc-pe__stack{display:flex}.gmc-pe__stack img{border-radius:50%;border:2px solid rgb(var(--color-background));margin-left:-10px;object-fit:cover}.gmc-pe__stack img:first-child{margin-left:0}.gmc-pe__bc{font-size:1.2rem;opacity:.75}
.gmc-pe__comp{display:flex;gap:1rem;align-items:center;padding:.9rem 1.1rem;border:1px dashed rgba(var(--color-foreground),.35);border-radius:var(--text-boxes-radius);cursor:pointer}.gmc-pe__comp img{border-radius:var(--media-radius);object-fit:cover}
.gmc-pe__code{display:flex;gap:1rem;align-items:center;width:100%;padding:.9rem 1.2rem;border:2px dashed {{ settings.gmc_accent }};border-radius:10px;background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:left}.gmc-pe__code b{background:{{ settings.gmc_accent }};color:#fff;padding:2px 10px;border-radius:6px}.gmc-pe__code small{margin-left:auto;opacity:.65}
.gmc-pe__link{background:none;border:0;padding:0;text-decoration:underline;cursor:pointer;color:inherit;font:inherit}.gmc-pe__dlg{max-width:560px;width:92vw;border:0;border-radius:var(--text-boxes-radius);padding:2rem;position:relative}.gmc-pe__dlg::backdrop{background:rgba(0,0,0,.55)}.gmc-pe__dx{position:absolute;top:.5rem;right:1rem;background:none;border:0;font-size:2.6rem;cursor:pointer}
.gmc-pe__sl{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:.6rem}.gmc-pe__sl>div{flex:0 0 85%;scroll-snap-align:start}.gmc-pe__sl img{width:100%;border-radius:var(--media-radius)}
.gmc-pe__tn{display:flex;gap:.4rem;border-bottom:1px solid rgba(var(--color-foreground),.15)}.gmc-pe__tn button{background:none;border:0;padding:.7rem 1rem;cursor:pointer;color:inherit;font:inherit;opacity:.6}.gmc-pe__tn button[aria-selected=true]{opacity:1;border-bottom:2px solid currentColor}.gmc-pe__tp{padding-top:1rem}
.gmc-pe__rv{display:grid;gap:.8rem}.gmc-pe__rv blockquote{margin:0;padding:1rem 1.2rem;border-radius:var(--text-boxes-radius);background:rgba(var(--color-foreground),.05)}.gmc-pe__rv p{margin:.3rem 0}.gmc-pe__sv{color:{{ settings.gmc_accent }};font-weight:700;margin:0}.gmc-pe__cd{font-weight:600}
.gmc-pe__cp--dated{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;position:relative}.gmc-pe__cp--dated li{display:flex;flex-direction:column;align-items:center;gap:.3rem;position:relative}.gmc-pe__cpi{width:4.4rem;height:4.4rem;border-radius:50%;display:grid;place-items:center;background:var(--gmc-cp,rgb(var(--color-foreground)));color:rgb(var(--color-background));position:relative;z-index:1}.gmc-pe__cp--dated li:not(:last-child):after{content:"";position:absolute;top:2.2rem;left:50%;width:100%;height:2px;background:var(--gmc-cp,rgb(var(--color-foreground)));opacity:.35}.gmc-pe__cpd{opacity:.75;font-size:1.15rem}.gmc-pe__ic{vertical-align:middle}.gmc-pe__szb{background:none;border:0;padding:0;cursor:pointer;color:inherit;font-family:inherit;display:inline-flex;align-items:center;gap:.5rem}.gmc-pe__szb--u{text-decoration:underline;text-underline-offset:.3rem}.gmc-dlg{border:0;border-radius:var(--popup-corner-radius,8px);padding:0;max-width:min(92vw,64rem);width:100%;max-height:88vh;color:rgb(var(--color-foreground));background:rgb(var(--color-background))}.gmc-dlg::backdrop{background:rgba(0,0,0,.55)}.gmc-dlg__in{padding:2.4rem;position:relative}.gmc-dlg__x{position:absolute;top:.6rem;right:1rem;background:none;border:0;font-size:2.8rem;line-height:1;cursor:pointer;color:inherit}.gmc-dlg__h{margin:0 0 1.2rem}.gmc-dlg__hr{font-weight:700;margin:0 0 .8rem}.gmc-dlg__img{max-width:100%;height:auto;display:block;margin:1rem auto}.gmc-dlg__cap{font-size:1.3rem;opacity:.7;margin:1rem 0 0}.gmc-dlg table{width:100%;border-collapse:collapse}.gmc-dlg td,.gmc-dlg th{border:1px solid rgba(var(--color-foreground),.2);padding:.6rem 1rem;text-align:center}.gmc-pe__stars--outline i:not(.on){opacity:.35}.gmc-pe__stars i{font-style:normal}.gmc-pe__stars--outline i.on{color:transparent;-webkit-text-stroke:1.5px currentColor}.gmc-pe__stars--filled i:not(.on){opacity:.25}.gmc-pe__rvi{margin:0;padding:1rem 1.4rem;display:flex;flex-direction:column;gap:.4rem;align-items:inherit}.gmc-pe__rva{border-radius:50%;object-fit:cover}.gmc-pe__rvi blockquote{margin:0}.gmc-pe__rvi figcaption{font-weight:700;font-size:1.3rem}.gmc-pe__ti{display:flex;gap:1rem;align-items:center}.gmc-pe__tii{display:inline-flex;flex:none}.gmc-pe__tit{flex:1}</style>
<script>(function(){
  var dj=document.querySelector('.gmc-vdata'),data={};try{JSON.parse(dj.textContent).forEach(function(x){data[x.id]=x;});}catch(e){}
  function upd(id){var d=data[id];
    document.querySelectorAll('[data-gmc-inv]').forEach(function(el){if(!d){return;}el.style.color=d.a?'':'#b91c1c';el.textContent=d.a?('● In stock'+(el.dataset.showqty==='true'&&d.q>0?' ('+d.q+' available)':'')):'● Out of stock';});
    document.querySelectorAll('[data-gmc-urg]').forEach(function(el){if(!d){el.hidden=true;return;}var th=+el.dataset.threshold;
      if(d.q!==null&&d.q>0&&d.q<=th){el.textContent='🔥 Only '+d.q+' left in stock — order soon';el.hidden=false;}
      else if(d.a&&el.dataset.fallback){el.textContent=el.dataset.fallback;el.hidden=false;}else{el.hidden=true;}});}
  gmcWhenPubsub(function(){subscribe(PUB_SUB_EVENTS.variantChange,function(ev){var v=ev&&ev.data&&ev.data.variant;upd(v?v.id:null);});});
})();</script>
{% schema %}
{
  "name": "Product info blocks",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
