{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one review block.' -%}{%- endif -%}
<div class="page-width gmc-tm {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-tm__grid">{%- for block in section.blocks -%}
    <figure class="gmc-tm__card" {{ block.shopify_attributes }}>
      <div class="gmc-tm__stars" aria-label="{{ block.settings.rating }} out of 5">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
      <blockquote>{{ block.settings.quote | escape }}</blockquote>
      <figcaption>{%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 80 | image_tag: width: 40, height: 40, loading: 'lazy', class: 'gmc-tm__av' }}{%- endif -%}<span>{{ block.settings.name | escape }}{% if block.settings.verified %} <small>✔ Verified buyer</small>{% endif %}</span></figcaption>
    </figure>{%- endfor -%}</div>
</div>
<style>.gmc-tm{padding:36px 0}.gmc-tm__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:1.5rem}.gmc-tm__card{margin:0;padding:1.6rem;border:1px solid rgba(var(--color-foreground),.15);border-radius:14px}.gmc-tm__stars{color:#f5a623;letter-spacing:2px}.gmc-tm__card blockquote{margin:.8rem 0 1rem}.gmc-tm__card figcaption{display:flex;align-items:center;gap:.8rem;font-weight:600}.gmc-tm__av{border-radius:50%;object-fit:cover}.gmc-tm__card small{display:block;font-weight:400;opacity:.65}</style>
{% schema %}
{
 "name": "Testimonials",
 "tag": "section",
 "class": "section",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Loved by customers"
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "blocks": [
  {
   "type": "review",
   "name": "Review",
   "settings": [
    {
     "type": "range",
     "id": "rating",
     "min": 1,
     "max": 5,
     "label": "Stars",
     "default": 5
    },
    {
     "type": "textarea",
     "id": "quote",
     "label": "Quote",
     "default": "Amazing quality, arrived fast!"
    },
    {
     "type": "text",
     "id": "name",
     "label": "Name",
     "default": "Sarah M."
    },
    {
     "type": "image_picker",
     "id": "avatar",
     "label": "Photo"
    },
    {
     "type": "checkbox",
     "id": "verified",
     "label": "Verified buyer",
     "default": true
    }
   ]
  }
 ],
 "max_blocks": 12,
 "presets": [
  {
   "name": "Testimonials",
   "blocks": [
    {
     "type": "review"
    },
    {
     "type": "review",
     "settings": {
      "name": "James T."
     }
    },
    {
     "type": "review",
     "settings": {
      "name": "Aisha K."
     }
    }
   ]
  }
 ]
}
{% endschema %}
