{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one review block.' -%}{%- endif -%}
<div class="page-width gmc-tm gmc-tm--{{ section.settings.style }} {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--tm-cols:{{ section.settings.cols }};--tm-star:{{ section.settings.star_color }};--tm-ratio:{{ section.settings.media_ratio }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- capture cards -%}{%- for block in section.blocks -%}{%- assign b = block.settings -%}
    <figure class="gmc-tm__card color-{{ section.settings.card_scheme }} gradient{% if section.settings.style == 'slider' %} gmc-sl__s{% endif %}" {{ block.shopify_attributes }}>
      {%- if b.video != blank -%}<div class="gmc-tm__media gmc-pm__vid" data-gmc-vid><video playsinline preload="metadata" controls {% if b.image != blank %}poster="{{ b.image | image_url: width: 800 }}"{% endif %}>{%- for vs in b.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video></div>
      {%- elsif b.image != blank -%}<div class="gmc-tm__media">{{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: b.name }}</div>{%- endif -%}
      <div class="gmc-tm__body">
      {%- if section.settings.show_stars -%}<div class="gmc-tm__stars" aria-label="{{ b.rating }} out of 5">{%- for i in (1..5) -%}{%- if i <= b.rating -%}★{%- elsif section.settings.empty_stars -%}<span style="opacity:.3">★</span>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
      {%- if section.settings.quote_marks -%}<span class="gmc-tm__qm" aria-hidden="true">“</span>{%- endif -%}
      <blockquote>{{ b.quote | escape }}</blockquote>
      <figcaption>{%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 80 | image_tag: width: 40, height: 40, loading: 'lazy', class: 'gmc-tm__av' }}{%- endif -%}<span>{{ b.name | escape }}{% if b.verified %} <small>✔ Verified buyer</small>{% endif %}</span></figcaption>
      </div>
    </figure>{%- endfor -%}{%- endcapture -%}
  {%- if section.settings.style == 'slider' -%}
    <div class="gmc-sl gmc-tm__sl" data-gmc-slider data-mode="slide" data-autoplay="0" data-loop="false" data-dots="true" data-arrows="true" data-drag="true" data-perview="{{ section.settings.cols }}" data-perview-m="1"><div class="gmc-sl__vp"><div class="gmc-sl__tr">{{ cards }}</div></div></div>
  {%- else -%}
    <div class="gmc-tm__grid">{{ cards }}</div>
  {%- endif -%}
</div>
<style>.gmc-tm{padding:36px 0}.gmc-tm__grid{display:grid;grid-template-columns:repeat(var(--tm-cols,3),1fr);gap:1.5rem;margin-top:1.5rem}@media(max-width:989px){.gmc-tm__grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}}.gmc-tm__card{margin:0;border:1px solid rgba(var(--color-foreground),.15);border-radius:var(--text-boxes-radius);overflow:hidden;display:flex;flex-direction:column}.gmc-tm__body{padding:1.6rem}.gmc-tm__media{aspect-ratio:var(--tm-ratio,4/3);overflow:hidden}.gmc-tm__media img,.gmc-tm__media video{width:100%;height:100%;object-fit:cover;display:block}.gmc-tm__stars{color:var(--tm-star,#f5a623);letter-spacing:2px}.gmc-tm__card blockquote{margin:.8rem 0 1rem}.gmc-tm__card figcaption{display:flex;align-items:center;gap:.8rem;font-weight:600}.gmc-tm__av{border-radius:50%;object-fit:cover}.gmc-tm__card small{display:block;font-weight:400;opacity:.65}.gmc-tm__qm{font-size:4rem;line-height:.6;display:block;opacity:.25;font-family:Georgia,serif}.gmc-tm--minimal .gmc-tm__card{border:0;background:transparent!important;text-align:center}.gmc-tm--minimal .gmc-tm__card figcaption{justify-content:center}.gmc-tm--quote .gmc-tm__card{border:0;border-left:4px solid var(--tm-star,#f5a623);border-radius:0}.gmc-tm__sl .gmc-sl__s{padding:0 .8rem}</style>
{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by customers"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "quote",
          "label": "Quote bar"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "cols",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "card_scheme",
      "label": "Card colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "empty_stars",
      "label": "Show faded empty stars",
      "default": false
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#f5a623"
    },
    {
      "type": "checkbox",
      "id": "quote_marks",
      "label": "Show quote mark",
      "default": false
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Photo / video shape",
      "options": [
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/3",
          "label": "Landscape"
        },
        {
          "value": "3/4",
          "label": "Portrait"
        },
        {
          "value": "9/16",
          "label": "Tall (video)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Paste a real customer review"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "info": "Tick only for reviews you have confirmed.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (shown above the review)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video review (MP4 upload)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review",
          "settings": {
            "name": "James T."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Aisha K."
          }
        }
      ]
    }
  ]
}
{% endschema %}
