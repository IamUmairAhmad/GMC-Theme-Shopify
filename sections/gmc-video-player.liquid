{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'video', title: 'Video player' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.settings.video == blank and section.settings.video_url == blank -%}{%- render 'gmc-empty', msg: 'Upload an MP4 or add a YouTube/Vimeo link.' -%}{%- endif -%}
<div class="page-width gmc-vp {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-vp-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-vp__box" style="aspect-ratio:{{ section.settings.ratio }}">
    {%- if section.settings.video != blank -%}
      <video preload="none" playsinline controls controlslist="nodownload" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1400 }}"{% endif %}>{%- for s in section.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
      <button type="button" class="gmc-vp__play" aria-label="Play video">▶</button>
    {%- elsif section.settings.video_url != blank -%}
      {%- assign u = section.settings.video_url.id -%}
      {%- if section.settings.video_url.type == 'youtube' -%}<iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ u | url_encode }}?rel=0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" title="Video"></iframe>{%- else -%}<iframe loading="lazy" src="https://player.vimeo.com/video/{{ u | url_encode }}" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" title="Video"></iframe>{%- endif -%}
    {%- endif -%}
  </div>
</div>
<style>.gmc-vp{padding-top:36px;padding-bottom:36px}.gmc-vp__box{position:relative;max-width:900px;margin:1rem auto 0;border-radius:var(--text-boxes-radius);overflow:hidden;background:#000}.gmc-vp__box video,.gmc-vp__box iframe{width:100%;height:100%;border:0;display:block;object-fit:cover}.gmc-vp__play{position:absolute;inset:0;margin:auto;width:76px;height:76px;border-radius:50%;border:0;background:rgba(255,255,255,.92);font-size:28px;cursor:pointer}.gmc-vp__box.on .gmc-vp__play{display:none}</style>
<script>(function(){var b=document.querySelector('#gmc-vp-{{ section.id }} .gmc-vp__box'),v=b&&b.querySelector('video'),p=b&&b.querySelector('.gmc-vp__play');if(!v||!p)return;p.onclick=function(){b.classList.add('on');v.play();};})();</script>
{%- endif -%}
{% schema %}
{
  "name": "Video player",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "MP4 video (upload)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or YouTube / Vimeo",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "text",
      "id": "ratio",
      "label": "Aspect ratio",
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Video player"
    }
  ]
}
{% endschema %}

