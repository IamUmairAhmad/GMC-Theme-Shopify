<div class="page-width gmc-vp {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-vp-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-vp__box" style="aspect-ratio:{{ section.settings.ratio }}">
    {%- if section.settings.video != blank -%}
      <video preload="none" playsinline controls controlslist="nodownload" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1400 }}"{% endif %}>{%- for s in section.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
      <button type="button" class="gmc-vp__play" aria-label="Play video">▶</button>
    {%- elsif section.settings.video_url != blank -%}
      {%- assign u = section.settings.video_url.id -%}
      {%- if section.settings.video_url.type == 'youtube' -%}<iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ u }}?rel=0" allowfullscreen title="Video"></iframe>{%- else -%}<iframe loading="lazy" src="https://player.vimeo.com/video/{{ u }}" allowfullscreen title="Video"></iframe>{%- endif -%}
    {%- endif -%}
  </div>
</div>
<style>.gmc-vp{padding:36px 0}.gmc-vp__box{position:relative;max-width:900px;margin:1rem auto 0;border-radius:14px;overflow:hidden;background:#000}.gmc-vp__box video,.gmc-vp__box iframe{width:100%;height:100%;border:0;display:block;object-fit:cover}.gmc-vp__play{position:absolute;inset:0;margin:auto;width:76px;height:76px;border-radius:50%;border:0;background:rgba(255,255,255,.92);font-size:28px;cursor:pointer}.gmc-vp__box.on .gmc-vp__play{display:none}</style>
<script>(function(){var b=document.querySelector('#gmc-vp-{{ section.id }} .gmc-vp__box'),v=b&&b.querySelector('video'),p=b&&b.querySelector('.gmc-vp__play');if(!v||!p)return;p.onclick=function(){b.classList.add('on');v.play();};})();</script>
{% schema %}
{"name":"Video player","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"video","id":"video","label":"MP4 video (upload)"},{"type":"video_url","id":"video_url","label":"Or YouTube / Vimeo","accept":["youtube","vimeo"]},{"type":"image_picker","id":"poster","label":"Poster image"},{"type":"text","id":"ratio","label":"Aspect ratio","default":"16/9"},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"presets":[{"name":"Video player"}]}
{% endschema %}
