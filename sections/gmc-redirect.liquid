{%- if section.settings.url != blank and section.settings.enabled -%}<script>if(!(window.Shopify&&Shopify.designMode)){setTimeout(function(){location.replace({{ section.settings.url | json }});},{{ section.settings.delay | times: 1000 }});}</script>{%- endif -%}
{% schema %}
{"name":"Redirect to page","settings":[{"type":"checkbox","id":"enabled","label":"Enable redirect","default":true},{"type":"url","id":"url","label":"Redirect to"},{"type":"range","id":"delay","min":0,"max":30,"unit":"s","label":"Delay","default":0},{"type":"paragraph","content":"Redirect is disabled inside the theme editor."}],"presets":[{"name":"Redirect to page"}]}
{% endschema %}
