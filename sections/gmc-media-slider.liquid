{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add slide blocks with an image or MP4.' -%}{%- endif -%}
<div class="gmc-ms {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-ms-{{ section.id }}" style="--ratio:{{ section.settings.ratio }}">
  <div class="gmc-ms__track">{%- for block in section.blocks -%}
    <div class="gmc-ms__s" {{ block.shopify_attributes }}>
      {%- if block.settings.video != blank -%}<video muted loop playsinline autoplay preload="metadata">{%- for s in block.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
      {%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,1000,1600', style: 'object-position:' | append: block.settings.image.presentation.focal_point }}{%- endif -%}
      {%- if block.settings.caption != blank -%}<span class="gmc-ms__cap">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.caption | escape }}</a>{%- else -%}{{ block.settings.caption | escape }}{%- endif -%}</span>{%- endif -%}
    </div>{%- endfor -%}</div>
  <button type="button" class="gmc-ms__b gmc-ms__b--p" aria-label="Previous">‹</button><button type="button" class="gmc-ms__b gmc-ms__b--n" aria-label="Next">›</button>
</div>
<style>.gmc-ms{position:relative}.gmc-ms__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.gmc-ms__track::-webkit-scrollbar{display:none}.gmc-ms__s{flex:0 0 {{ section.settings.per_view }}%;scroll-snap-align:start;position:relative;aspect-ratio:var(--ratio)}.gmc-ms__s img,.gmc-ms__s video{width:100%;height:100%;object-fit:cover;display:block}.gmc-ms__cap{position:absolute;left:1rem;bottom:1rem;background:rgba(0,0,0,.6);color:#fff;padding:.4rem 1rem;border-radius:99px}.gmc-ms__cap a{color:#fff}.gmc-ms__b{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;border:0;background:rgba(255,255,255,.9);color:#111;font-size:26px;cursor:pointer}.gmc-ms__b--p{left:.8rem}.gmc-ms__b--n{right:.8rem}@media(max-width:749px){.gmc-ms__s{flex-basis:{{ section.settings.per_view_mobile }}%}}</style>
<script>(function(){var w=document.getElementById('gmc-ms-{{ section.id }}'),t=w.querySelector('.gmc-ms__track');
w.querySelector('.gmc-ms__b--n').onclick=function(){t.scrollBy({left:t.clientWidth*.9,behavior:'smooth'});};w.querySelector('.gmc-ms__b--p').onclick=function(){t.scrollBy({left:-t.clientWidth*.9,behavior:'smooth'});};
{% if section.settings.autoplay %}if(!matchMedia('(prefers-reduced-motion:reduce)').matches){var iv=setInterval(function(){if(t.scrollLeft+t.clientWidth>=t.scrollWidth-4)t.scrollTo({left:0,behavior:'smooth'});else t.scrollBy({left:t.clientWidth*.9,behavior:'smooth'});},{{ section.settings.interval | times: 1000 }});w.addEventListener('mouseenter',function(){clearInterval(iv);});w.addEventListener('focusin',function(){clearInterval(iv);});}{% endif %}})();</script>
{% schema %}
{
 "name": "Image & video slider",
 "tag": "section",
 "class": "section",
 "settings": [
  {
   "type": "range",
   "id": "per_view",
   "min": 25,
   "max": 100,
   "step": 25,
   "unit": "%",
   "label": "Slide width (desktop)",
   "default": 100
  },
  {
   "type": "range",
   "id": "per_view_mobile",
   "min": 50,
   "max": 100,
   "step": 25,
   "unit": "%",
   "label": "Slide width (mobile)",
   "default": 100
  },
  {
   "type": "text",
   "id": "ratio",
   "label": "Aspect ratio",
   "default": "16/9"
  },
  {
   "type": "checkbox",
   "id": "autoplay",
   "label": "Autoplay",
   "default": false
  },
  {
   "type": "range",
   "id": "interval",
   "min": 2,
   "max": 12,
   "unit": "s",
   "label": "Interval",
   "default": 5
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "blocks": [
  {
   "type": "slide",
   "name": "Slide",
   "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "Image"
    },
    {
     "type": "video",
     "id": "video",
     "label": "MP4 video (optional)"
    },
    {
     "type": "text",
     "id": "caption",
     "label": "Caption"
    },
    {
     "type": "url",
     "id": "link",
     "label": "Link"
    }
   ]
  }
 ],
 "max_blocks": 12,
 "presets": [
  {
   "name": "Image & video slider"
  }
 ]
}
{% endschema %}
