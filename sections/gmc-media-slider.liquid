{%- comment -%} gmc {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add slide blocks with an image or MP4.' -%}{%- endif -%}
{%- assign ms = section.settings -%}
<div class="gmc-ms gmc-ms--{{ ms.transition | default: 'slide' }} gmc-ms--ctrl-{{ ms.controls | default: 'sides' }}{% if ms.center %} gmc-ms--center{% endif %}{% if ms.arrows_clear %} gmc-ms--clear{% endif %} {% render 'gmc-vis', hide: ms.hide_on %}" id="gmc-ms-{{ section.id }}" style="--ratio:{{ ms.ratio }};--peek:{{ ms.peek | default: 0 }}px;--radius:{{ ms.radius | default: 0 }}px;--per:{{ ms.per_view }}%;--perm:{{ ms.per_view_mobile }}%" data-move="{{ ms.move | default: 1 }}" data-fade="{% if ms.transition == 'fade' %}1{% else %}0{% endif %}" data-adapt="{% if ms.height == 'adapt' %}1{% else %}0{% endif %}" data-auto="{% if ms.autoplay %}{{ ms.interval | times: 1000 }}{% else %}0{% endif %}">
  <div class="gmc-ms__track">{%- for block in section.blocks -%}
    <div class="gmc-ms__s{% if ms.transition == 'fade' and forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.video != blank -%}<div class="gmc-pm__vid gmc-ms__vid" data-gmc-vid><video playsinline preload="metadata" {% if block.settings.autoplay %}autoplay muted{% endif %}{% if block.settings.loop %} loop{% endif %}{% unless block.settings.autoplay or block.settings.custom_ui %} controls{% endunless %}{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 1200 }}"{% endif %}>{%- for s in block.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
        {%- if block.settings.custom_ui -%}<div class="gmc-pm__vc"><button type="button" data-gmc-vplay aria-label="Play or pause">❚❚</button>{%- if block.settings.sound_btn -%}<button type="button" data-gmc-vsound aria-label="Sound on or off">🔇</button>{%- endif -%}{%- if block.settings.timeline -%}<i class="gmc-pm__vt"><b></b></i>{%- endif -%}</div>{%- endif -%}</div>
      {%- elsif block.settings.image != blank -%}{%- assign gmc_fp = 'object-position:' | append: block.settings.image.presentation.focal_point -%}{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,1000,1600', style: gmc_fp }}{%- endif -%}
      {%- if block.settings.caption != blank -%}<span class="gmc-ms__cap">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.caption | escape }}</a>{%- else -%}{{ block.settings.caption | escape }}{%- endif -%}</span>{%- endif -%}
      {%- if block.settings.desc != blank -%}<div class="gmc-ms__desc color-{{ block.settings.desc_scheme }} gradient" style="text-align:{{ block.settings.desc_align }}">{{ block.settings.desc | escape }}</div>{%- endif -%}
    </div>{%- endfor -%}</div>
  <div class="gmc-ms__nav">
    <button type="button" class="gmc-ms__b gmc-ms__b--p" aria-label="Previous">‹</button>
    {%- if ms.dots -%}<div class="gmc-ms__dots">{%- for block in section.blocks -%}<button type="button" data-i="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} class="is-on" aria-current="true"{% endif %}></button>{%- endfor -%}</div>{%- endif -%}
    <button type="button" class="gmc-ms__b gmc-ms__b--n" aria-label="Next">›</button>
  </div>
</div>
<style>
  .gmc-ms{position:relative}
  .gmc-ms__desc{position:absolute;left:0;right:0;bottom:0;padding:1rem 1.4rem;z-index:2}
  .gmc-ms__vid{width:100%;height:100%}
  .gmc-ms__vid video{width:100%;height:100%;object-fit:cover}
  .gmc-ms__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-inline:var(--peek,0)}
  .gmc-ms__track::-webkit-scrollbar{display:none}
  .gmc-ms__s{flex:0 0 var(--per,100%);scroll-snap-align:start;position:relative;aspect-ratio:var(--ratio,16/9);border-radius:var(--radius,0);overflow:hidden}
  .gmc-ms--center .gmc-ms__s{scroll-snap-align:center}
  .gmc-ms[data-fade="1"] .gmc-ms__track{display:grid;overflow:hidden;padding:0}
  .gmc-ms[data-fade="1"] .gmc-ms__s{grid-area:1/1;width:100%;flex:none;opacity:0;pointer-events:none;transition:opacity .4s}
  .gmc-ms[data-fade="1"] .gmc-ms__s.is-on{opacity:1;pointer-events:auto}
  .gmc-ms__s img,.gmc-ms__s video{width:100%;height:100%;object-fit:cover;display:block}
  .gmc-ms__cap{position:absolute;left:1rem;bottom:1rem;background:rgba(0,0,0,.6);color:#fff;padding:.4rem 1rem;border-radius:var(--badge-corner-radius,99px)}
  .gmc-ms__cap a{color:#fff}
  .gmc-ms__b{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;border:0;background:rgba(255,255,255,.9);color:#111;font-size:26px;cursor:pointer}
  .gmc-ms__b--p{left:.8rem}.gmc-ms__b--n{right:.8rem}
  .gmc-ms--clear .gmc-ms__b{background:transparent;color:inherit;box-shadow:inset 0 0 0 1px currentColor}
  .gmc-ms--ctrl-below .gmc-ms__nav{display:flex;justify-content:center;align-items:center;gap:1rem;margin-top:1rem}
  .gmc-ms--ctrl-below .gmc-ms__b{position:static;transform:none}
  .gmc-ms__dots{display:flex;gap:.5rem;justify-content:center}
  .gmc-ms:not(.gmc-ms--ctrl-below) .gmc-ms__dots{position:absolute;left:0;right:0;bottom:1rem;z-index:2}
  .gmc-ms__dots button{width:1rem;height:1rem;padding:0;border-radius:50%;border:1px solid currentColor;background:transparent;cursor:pointer}
  .gmc-ms__dots button.is-on{background:currentColor}
  .gmc-ms[data-adapt="1"] .gmc-ms__s{aspect-ratio:auto;height:auto}
  .gmc-ms[data-adapt="1"] .gmc-ms__s img{height:auto}
  .gmc-ms[data-adapt="1"] .gmc-ms__vid{aspect-ratio:16/9}
  @media(max-width:749px){.gmc-ms__s{flex-basis:var(--perm,100%)}}
  @media(prefers-reduced-motion:reduce){.gmc-ms[data-fade="1"] .gmc-ms__s{transition:none}}
</style>
<script>(function(){var w=document.getElementById('gmc-ms-{{ section.id }}');if(!w)return;var t=w.querySelector('.gmc-ms__track'),slides=[].slice.call(t.children),dots=[].slice.call(w.querySelectorAll('.gmc-ms__dots button')),i=0,fade=w.dataset.fade==='1',center=w.classList.contains('gmc-ms--center');
function paint(){dots.forEach(function(d,k){var on=k===i;d.classList.toggle('is-on',on);if(on)d.setAttribute('aria-current','true');else d.removeAttribute('aria-current');});}
function go(n){if(!slides.length)return;i=(n+slides.length)%slides.length;if(fade){slides.forEach(function(s,k){s.classList.toggle('is-on',k===i);});}else{var s=slides[i],left=s.offsetLeft;if(center)left=s.offsetLeft-(t.clientWidth-s.clientWidth)/2;t.scrollTo({left:Math.max(0,left),behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'});}paint();}
function step(dir){go(i+dir*(+w.dataset.move||1));}
w.querySelector('.gmc-ms__b--n').onclick=function(){step(1);};w.querySelector('.gmc-ms__b--p').onclick=function(){step(-1);};
dots.forEach(function(d){d.onclick=function(){go(+d.dataset.i);};});
if(fade)go(0);
if(!fade){t.addEventListener('scroll',function(){var best=0,dist=1e9;slides.forEach(function(s,k){var d=Math.abs(s.offsetLeft-t.scrollLeft);if(d<dist){dist=d;best=k;}});if(best!==i){i=best;paint();}});}
var auto=+w.dataset.auto;if(auto&&!matchMedia('(prefers-reduced-motion:reduce)').matches){var iv=setInterval(function(){step(1);},auto);w.addEventListener('mouseenter',function(){clearInterval(iv);});w.addEventListener('focusin',function(){clearInterval(iv);});}})();</script>
{% schema %}
{
  "name": "Image & video slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "per_view",
      "min": 25,
      "max": 100,
      "step": 25,
      "unit": "%",
      "label": "Slide width (desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "per_view_mobile",
      "min": 50,
      "max": 100,
      "step": 25,
      "unit": "%",
      "label": "Slide width (mobile)",
      "default": 100
    },
    {
      "type": "text",
      "id": "ratio",
      "label": "Aspect ratio",
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Slide height",
      "options": [
        { "value": "ratio", "label": "Fixed ratio" },
        { "value": "adapt", "label": "Adapt to the image" }
      ],
      "default": "ratio"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centre the active slide",
      "default": false
    },
    {
      "type": "range",
      "id": "peek",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Preview of the next slide",
      "default": 0
    },
    {
      "type": "range",
      "id": "move",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to move at once",
      "default": 1
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "controls",
      "label": "Arrow position",
      "options": [
        { "value": "sides", "label": "On the sides" },
        { "value": "below", "label": "Below the slides" }
      ],
      "default": "sides"
    },
    {
      "type": "checkbox",
      "id": "arrows_clear",
      "label": "Transparent arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "interval",
      "min": 2,
      "max": 12,
      "unit": "s",
      "label": "Interval",
      "default": 5
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "MP4 video (optional)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "desc_align",
          "label": "Description alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "color_scheme",
          "id": "desc_scheme",
          "label": "Description colour scheme",
          "default": "scheme-1"
        },
        {
          "type": "header",
          "content": "Video options"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay muted",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "custom_ui",
          "label": "Play/pause controls",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "sound_btn",
          "label": "Sound button",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "timeline",
          "label": "Timeline",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Image & video slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "caption": "Slide one"
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "Slide two"
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "Slide three"
          }
        }
      ]
    }
  ]
}
{% endschema %}
