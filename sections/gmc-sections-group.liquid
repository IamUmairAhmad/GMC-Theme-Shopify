{%- comment -%} GMC sections group: places two existing sections side by side from their section IDs. {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- liquid
  assign one_id = section.settings.section_1_id | strip
  assign two_id = section.settings.section_2_id | strip
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign ptm = pt | times: 0.75 | round: 0
  assign pbm = pb | times: 0.75 | round: 0
-%}
<style>
  #shopify-section-{{ section.id }} .gmc-sgrp {
    padding-top: {{ ptm }}px;
    padding-bottom: {{ pbm }}px;
  }
  #shopify-section-{{ section.id }} .gmc-sgrp__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: {{ section.settings.spacing_mobile }}px;
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .gmc-sgrp__col { min-width: 0; }
  #shopify-section-{{ section.id }} .gmc-sgrp__col > .shopify-section { width: 100%; }
  #shopify-section-{{ section.id }} .gmc-sgrp__miss { margin: 1.6rem 0; text-align: center; }
  #shopify-section-{{ section.id }} .gmc-sgrp__empty { margin: 0; text-align: center; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gmc-sgrp--rev .gmc-sgrp__col:first-child { order: 2; }
    #shopify-section-{{ section.id }} .gmc-sgrp--mfull .page-width { max-width: none; padding-left: 0; padding-right: 0; }
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .gmc-sgrp {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
    #shopify-section-{{ section.id }} .gmc-sgrp__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: {{ section.settings.spacing_desktop }}px;
    }
    #shopify-section-{{ section.id }} .gmc-sgrp--dfull .page-width { max-width: none; padding-left: 0; padding-right: 0; }
  }
</style>
<div class="gmc-sgrp{% if section.settings.desktop_full %} gmc-sgrp--dfull{% endif %}{% if section.settings.mobile_full %} gmc-sgrp--mfull{% endif %}{% if section.settings.mobile_reverse %} gmc-sgrp--rev{% endif %}">
  {%- if one_id != blank and two_id != blank -%}
    <div class="page-width">
      <div class="gmc-sgrp__grid" data-gmc-sgrp data-one="{{ one_id | escape }}" data-two="{{ two_id | escape }}">
        <div class="gmc-sgrp__col" data-gmc-sgrp-col="1"><p class="gmc-sgrp__miss" data-miss hidden>No section with this ID.</p></div>
        <div class="gmc-sgrp__col" data-gmc-sgrp-col="2"><p class="gmc-sgrp__miss" data-miss hidden>No section with this ID.</p></div>
      </div>
    </div>
    <script>
      (function () {
        function findSection(raw) {
          var id = String(raw || '').trim();
          if (id.indexOf('#') === 0) id = id.slice(1);
          if (!id) return null;
          var direct = document.getElementById(id);
          if (direct && direct.classList && direct.classList.contains('shopify-section')) return direct;
          var prefixed = document.getElementById('shopify-section-' + id);
          if (prefixed) return prefixed;
          if (direct && direct.getAttribute('data-sec')) {
            var via = document.getElementById(direct.getAttribute('data-sec'));
            if (via && via.classList.contains('shopify-section')) return via;
          }
          return null;
        }
        function mount(root) {
          if (!root || root.getAttribute('data-gmc-sgrp-ready') === '1') return;
          var group = root.closest('.shopify-section');
          var first = findSection(root.getAttribute('data-one'));
          var second = findSection(root.getAttribute('data-two'));
          if (first && group && first.contains(group)) first = null;
          if (second && group && second.contains(group)) second = null;
          if (first && second && first === second) second = null;
          var col1 = root.querySelector('[data-gmc-sgrp-col="1"]');
          var col2 = root.querySelector('[data-gmc-sgrp-col="2"]');
          if (first && col1) col1.appendChild(first);
          if (second && col2) col2.appendChild(second);
          var miss1 = col1 && col1.querySelector('[data-miss]');
          var miss2 = col2 && col2.querySelector('[data-miss]');
          if (!first && miss1) miss1.hidden = false;
          if (!second && miss2) miss2.hidden = false;
          root.setAttribute('data-gmc-sgrp-ready', '1');
        }
        function boot() {
          document.querySelectorAll('[data-gmc-sgrp]').forEach(mount);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
        else boot();
        document.addEventListener('shopify:section:load', function (event) {
          var hit = event.target && event.target.querySelector && event.target.querySelector('[data-gmc-sgrp]');
          if (!hit) return;
          hit.removeAttribute('data-gmc-sgrp-ready');
          mount(hit);
        });
      })();
    </script>
  {%- else -%}
    <div class="page-width">
      <h2 class="gmc-sgrp__empty title h1">Paste the IDs of the two sections to show side by side.</h2>
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Sections group",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "all"
    },
    {
      "type": "paragraph",
      "content": "Combines two sections that are already on the page. Paste the Section ID from each one. On desktop they sit next to each other."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Section 1"
    },
    {
      "type": "text",
      "id": "section_1_id",
      "label": "Section 1 ID",
      "info": "The Section ID set on the first section. A leading # is ignored."
    },
    {
      "type": "checkbox",
      "id": "mobile_reverse",
      "label": "Display second on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Section 2"
    },
    {
      "type": "text",
      "id": "section_2_id",
      "label": "Section 2 ID"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "checkbox",
      "id": "desktop_full",
      "label": "Full page width",
      "default": false
    },
    {
      "type": "range",
      "id": "spacing_desktop",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Spacing",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_full",
      "label": "Full page width",
      "default": false
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Spacing",
      "default": 50
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "info": "On screens under 750px this is 75% of the value.",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "info": "On screens under 750px this is 75% of the value.",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image",
      "info": "Recommended: 2000 × 1200 px. Tested: fills the section edge to edge and is cropped to fit, never stretched; the theme loads at most 2000 px wide, so larger files add no sharpness. At full desktop width (1920 px) a 2000 × 1200 image covers sections up to about 1150 px tall without enlarging; section height follows its content."
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Sections group"
    }
  ]
}
{% endschema %}
