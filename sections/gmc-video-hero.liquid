{%- render 'gmc-section-extras' -%}
<section class="gmc-vh {% render 'gmc-vis', hide: section.settings.hide_on %}" style="min-height:{{ section.settings.h }}vh">
  {%- if section.settings.video != blank -%}<video autoplay muted loop playsinline {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}>{%- for s in section.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
  {%- elsif section.settings.poster != blank -%}{{ section.settings.poster | image_url: width: 1600 | image_tag: class: 'gmc-vh__bg', loading: 'eager', style: 'object-position:' | append: section.settings.poster.presentation.focal_point }}{%- endif -%}
  <div class="gmc-vh__ov" style="background:rgba(0,0,0,{{ section.settings.ov | divided_by: 100.0 }})"></div>
  <div class="gmc-vh__c page-width"><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>{%- if section.settings.link != blank -%}<a class="button" href="{{ section.settings.link }}">{{ section.settings.button | escape }}</a>{%- endif -%}</div>
</section>
<style>.gmc-vh{position:relative;display:grid;place-items:center;overflow:hidden;color:#fff;text-align:center}.gmc-vh video,.gmc-vh__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.gmc-vh__ov,.gmc-vh__c{grid-area:1/1;position:relative}.gmc-vh__ov{position:absolute;inset:0}.gmc-vh__c{z-index:1;padding:3rem 0}</style>
{% schema %}
{
 "name": "Video hero",
 "tag": "section",
 "class": "section",
 "settings": [
  {
   "type": "video",
   "id": "video",
   "label": "MP4 video (upload)"
  },
  {
   "type": "image_picker",
   "id": "poster",
   "label": "Poster / fallback image"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Your headline"
  },
  {
   "type": "textarea",
   "id": "text",
   "label": "Text",
   "default": "Supporting text goes here."
  },
  {
   "type": "text",
   "id": "button",
   "label": "Button label",
   "default": "Shop now"
  },
  {
   "type": "url",
   "id": "link",
   "label": "Button link"
  },
  {
   "type": "range",
   "id": "h",
   "min": 30,
   "max": 100,
   "unit": "vh",
   "label": "Height",
   "default": 70
  },
  {
   "type": "range",
   "id": "ov",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Overlay",
   "default": 35
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "presets": [
  {
   "name": "Video hero"
  }
 ]
}
{% endschema %}
