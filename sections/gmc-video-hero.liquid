<section class="gmc-vh {% render 'gmc-vis', hide: section.settings.hide_on %}" style="min-height:{{ section.settings.h }}vh">
  {%- if section.settings.video != blank -%}<video autoplay muted loop playsinline {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}>{%- for s in section.settings.video.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
  {%- elsif section.settings.poster != blank -%}{{ section.settings.poster | image_url: width: 1600 | image_tag: class: 'gmc-vh__bg', loading: 'eager' }}{%- endif -%}
  <div class="gmc-vh__ov" style="background:rgba(0,0,0,{{ section.settings.ov | divided_by: 100.0 }})"></div>
  <div class="gmc-vh__c page-width"><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>{%- if section.settings.link != blank -%}<a class="button" href="{{ section.settings.link }}">{{ section.settings.button | escape }}</a>{%- endif -%}</div>
</section>
<style>.gmc-vh{position:relative;display:grid;place-items:center;overflow:hidden;color:#fff;text-align:center}.gmc-vh video,.gmc-vh__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.gmc-vh__ov,.gmc-vh__c{grid-area:1/1;position:relative}.gmc-vh__ov{position:absolute;inset:0}.gmc-vh__c{z-index:1;padding:3rem 0}</style>
{% schema %}
{"name":"Video hero","tag":"section","class":"section","settings":[{"type":"video","id":"video","label":"MP4 video (upload)"},{"type":"image_picker","id":"poster","label":"Poster / fallback image"},{"type":"text","id":"heading","label":"Heading","default":"Your headline"},{"type":"textarea","id":"text","label":"Text","default":"Supporting text goes here."},{"type":"text","id":"button","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Button link"},{"type":"range","id":"h","min":30,"max":100,"unit":"vh","label":"Height","default":70},{"type":"range","id":"ov","min":0,"max":80,"step":5,"unit":"%","label":"Overlay","default":35},{"type":"select","id":"hide_on","label":"Hide on","options":[{"value":"","label":"Show everywhere"},{"value":"mobile","label":"Mobile"},{"value":"desktop","label":"Desktop"}],"default":""}],"presets":[{"name":"Video hero"}]}
{% endschema %}
