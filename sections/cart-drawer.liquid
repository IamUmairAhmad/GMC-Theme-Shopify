{%- render 'cart-drawer' -%}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add, remove and reorder blocks to build your cart drawer. Amounts and colors are under Theme settings > Cart."
    }
  ],
  "blocks": [
    {
      "type": "countdown_timer",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your cart is reserved for"
        },
        {
          "type": "range",
          "id": "minutes",
          "label": "Minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "default": 10,
          "info": "Counts down per visitor. It does not reserve stock."
        }
      ]
    },
    {
      "type": "checkpoints_bar",
      "name": "Checkpoints bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Up to three reward goals on one bar. Leave an amount blank to skip that checkpoint. Blank amounts everywhere use Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "amount_1",
          "label": "Goal 1 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Goal 1 label",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "icon_1",
          "label": "Goal 1 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Message before goal 1",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "number",
          "id": "amount_2",
          "label": "Goal 2 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Goal 2 label",
          "default": "Free gift"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Goal 2 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Message before goal 2",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for a free gift"
        },
        {
          "type": "number",
          "id": "amount_3",
          "label": "Goal 3 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Goal 3 label"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Goal 3 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Message before goal 3",
          "info": "[amount] becomes the amount still missing."
        },
        {
          "type": "text",
          "id": "text_done",
          "label": "Message when complete",
          "default": "All rewards unlocked"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal amounts for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "progress_bar",
      "name": "Progress bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Progress toward a goal such as free shipping. A blank goal uses Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Goal amount (store currency)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_before",
          "label": "Message before the goal",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "text",
          "id": "text_after",
          "label": "Message after the goal",
          "default": "You have unlocked free shipping"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "cart_items",
      "name": "Cart items",
      "limit": 1
    },
    {
      "type": "discount_field",
      "name": "Discount field",
      "limit": 1
    },
    {
      "type": "subtotals",
      "name": "Subtotals",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "checkout_button",
      "name": "Checkout button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "info": "Leave blank for the default text."
        },
        {
          "type": "checkbox",
          "id": "show_express",
          "label": "Show express checkout buttons",
          "info": "Shop Pay, Apple Pay, Google Pay and PayPal appear under the button when your payment settings allow them.",
          "default": true
        }
      ]
    },
    {
      "type": "payment_badges",
      "name": "Payment badges",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text above the icons"
        }
      ]
    },
    {
      "type": "icons_with_text",
      "name": "Icons with text",
      "settings": [
        {
          "type": "text",
          "id": "icon_1",
          "label": "Icon 1",
          "default": "check",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Text 1",
          "default": "Your benefit text"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Icon 2",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Icon 3",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "progress_bar",
        "settings": {
          "goal": 50
        }
      },
      {
        "type": "checkpoints_bar",
        "settings": {
          "amount_1": 40,
          "amount_2": 80,
          "amount_3": 160,
          "icon_3": "star",
          "label_3": "VIP",
          "text_3": "Add [amount] more for VIP"
        }
      },
      {
        "type": "cart_items"
      },
      {
        "type": "discount_field"
      },
      {
        "type": "subtotals"
      },
      {
        "type": "checkout_button"
      },
      {
        "type": "payment_badges"
      },
      {
        "type": "icons_with_text"
      }
    ]
  }
}
{% endschema %}
