{%- render 'cart-drawer' -%}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add, remove and reorder blocks to build your cart drawer. Amounts and colors are under Theme settings > Cart."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for the default."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "width",
      "min": 0,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Drawer width on desktop",
      "default": 0,
      "info": "0 uses the theme default."
    },
    {
      "type": "checkbox",
      "id": "continue_link",
      "label": "Show a continue shopping link",
      "default": false
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue shopping label",
      "default": "Continue shopping"
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "Test mode: open the drawer in the theme editor",
      "info": "Opens the drawer automatically while you edit. Customers never see this.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "countdown_timer",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your cart is reserved for"
        },
        {
          "type": "range",
          "id": "minutes",
          "label": "Minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "default": 10,
          "info": "Counts down per visitor. It does not reserve stock."
        }
      ]
    },
    {
      "type": "checkpoints_bar",
      "name": "Checkpoints bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Up to three reward goals on one bar. Leave an amount blank to skip that checkpoint. Blank amounts everywhere use Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "amount_1",
          "label": "Goal 1 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Goal 1 label",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "icon_1",
          "label": "Goal 1 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Message before goal 1",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "number",
          "id": "amount_2",
          "label": "Goal 2 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Goal 2 label",
          "default": "Free gift"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Goal 2 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Message before goal 2",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for a free gift"
        },
        {
          "type": "number",
          "id": "amount_3",
          "label": "Goal 3 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Goal 3 label"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Goal 3 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Message before goal 3",
          "info": "[amount] becomes the amount still missing."
        },
        {
          "type": "text",
          "id": "text_done",
          "label": "Message when complete",
          "default": "All rewards unlocked"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal amounts for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "progress_bar",
      "name": "Progress bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Progress toward a goal such as free shipping. A blank goal uses Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Goal amount (store currency)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_before",
          "label": "Message before the goal",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "text",
          "id": "text_after",
          "label": "Message after the goal",
          "default": "You have unlocked free shipping"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "cart_items",
      "name": "Cart items",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "range",
          "id": "image_size",
          "min": 0,
          "max": 140,
          "step": 10,
          "unit": "px",
          "label": "Image width",
          "default": 0,
          "info": "0 uses the theme default."
        },
        {
          "type": "checkbox",
          "id": "image_link",
          "label": "Link the image to the product",
          "default": true
        },
        {
          "type": "header",
          "content": "Title and variants"
        },
        {
          "type": "range",
          "id": "title_size",
          "min": 0,
          "max": 22,
          "step": 1,
          "unit": "px",
          "label": "Title size",
          "default": 0,
          "info": "0 uses the theme default."
        },
        {
          "type": "checkbox",
          "id": "title_link",
          "label": "Link the title to the product",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "variants_inline",
          "label": "Show variant options on one line",
          "default": false
        },
        {
          "type": "header",
          "content": "Prices and savings"
        },
        {
          "type": "checkbox",
          "id": "show_compare",
          "label": "Show the old price when discounted",
          "default": true
        },
        {
          "type": "color",
          "id": "price_color",
          "label": "Price colour"
        },
        {
          "type": "color",
          "id": "compare_color",
          "label": "Old price colour"
        },
        {
          "type": "checkbox",
          "id": "show_savings",
          "label": "Show compare-at price and savings line",
          "default": true,
          "info": "Needs Theme settings > Cart > compare prices on."
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings text",
          "default": "Save [amount]",
          "info": "[amount] becomes the amount saved."
        },
        {
          "type": "color",
          "id": "savings_color",
          "label": "Savings colour"
        },
        {
          "type": "header",
          "content": "Quantity selector"
        },
        {
          "type": "range",
          "id": "qty_radius",
          "min": 0,
          "max": 30,
          "step": 2,
          "unit": "px",
          "label": "Corner radius",
          "default": 0
        }
      ]
    },
    {
      "type": "discount_field",
      "name": "Discount field",
      "limit": 1
    },
    {
      "type": "subtotals",
      "name": "Subtotals",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_savings",
          "label": "Show total savings line",
          "default": false,
          "info": "Adds up discounts and compare-at savings."
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Total savings text",
          "default": "Total savings: [amount]"
        },
        {
          "type": "color",
          "id": "savings_color",
          "label": "Total savings colour"
        },
        {
          "type": "range",
          "id": "savings_size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Total savings size",
          "default": 14
        },
        {
          "type": "select",
          "id": "savings_align",
          "label": "Total savings alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            },
            {
              "value": "center",
              "label": "Centre"
            }
          ],
          "default": "right"
        },
        {
          "type": "select",
          "id": "savings_pos",
          "label": "Total savings position",
          "options": [
            {
              "value": "above",
              "label": "Above the total"
            },
            {
              "value": "below",
              "label": "Below the total"
            }
          ],
          "default": "above"
        }
      ]
    },
    {
      "type": "gift",
      "name": "Free gift",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Gift product"
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Spend goal (store currency)",
          "info": "Gift unlocks when paid items reach this amount."
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92."
        },
        {
          "type": "product_list",
          "id": "only_products",
          "label": "Show only when the cart has these products",
          "limit": 10
        },
        {
          "type": "text",
          "id": "locked_text",
          "label": "Locked text",
          "default": "Add [amount] more to unlock a free gift"
        },
        {
          "type": "text",
          "id": "unlocked_text",
          "label": "Unlocked text",
          "default": "Free gift unlocked"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Show gift image",
          "default": true
        },
        {
          "type": "color",
          "id": "locked_color",
          "label": "Locked colour",
          "default": "#9ca3af"
        },
        {
          "type": "color",
          "id": "unlocked_color",
          "label": "Unlocked colour",
          "default": "#16a34a"
        }
      ]
    },
    {
      "type": "upsell_products",
      "name": "Upsell products",
      "settings": [
        {
          "type": "product_list",
          "id": "products",
          "label": "Upsell products",
          "limit": 3
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "You may also like"
        },
        {
          "type": "product_list",
          "id": "only_for",
          "label": "Show only when the cart has these products",
          "limit": 10
        },
        {
          "type": "checkbox",
          "id": "hide_in_cart",
          "label": "Hide products already in the cart",
          "default": true
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Add"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Add control style",
          "options": [
            {
              "value": "add",
              "label": "Add button"
            },
            {
              "value": "plus",
              "label": "Plus button"
            },
            {
              "value": "toggle",
              "label": "Toggle switch"
            },
            {
              "value": "checkbox",
              "label": "Checkbox"
            }
          ],
          "default": "add"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "column",
              "label": "Column"
            },
            {
              "value": "row",
              "label": "Row"
            }
          ],
          "default": "column"
        }
      ]
    },
    {
      "type": "cart_note",
      "name": "Cart note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order note"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder"
        },
        {
          "type": "range",
          "id": "rows",
          "min": 2,
          "max": 6,
          "step": 1,
          "label": "Rows",
          "default": 3
        }
      ]
    },
    {
      "type": "text_with_icon",
      "name": "Text with icon",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free returns within 30 days"
        },
        {
          "type": "range",
          "id": "size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Text size",
          "default": 13
        },
        {
          "type": "select",
          "id": "align",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text colour"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "checkout_button",
      "name": "Checkout button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "info": "Leave blank for the default text."
        },
        {
          "type": "checkbox",
          "id": "show_express",
          "label": "Show express checkout buttons",
          "info": "Shop Pay, Apple Pay, Google Pay and PayPal appear under the button when your payment settings allow them.",
          "default": true
        }
      ]
    },
    {
      "type": "payment_badges",
      "name": "Payment badges",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text above the icons"
        },
        {
          "type": "text",
          "id": "icons",
          "label": "Payment icons",
          "info": "Optional, comma separated, e.g. visa, master, paypal. Blank shows your store's enabled methods."
        }
      ]
    },
    {
      "type": "icons_with_text",
      "name": "Icons with text",
      "settings": [
        {
          "type": "text",
          "id": "icon_1",
          "label": "Icon 1",
          "default": "check",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Text 1",
          "default": "Your benefit text"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Icon 2",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Icon 3",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3"
        }
      ]
    },
    {
      "type": "gift_wrap",
      "name": "Gift wrap",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Add gift wrap"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Gift wrap product (optional)",
          "info": "If set, it is added to the cart as a line item when ticked."
        },
        {
          "type": "checkbox",
          "id": "message",
          "label": "Show gift message box",
          "default": true
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Message placeholder",
          "default": "Your gift message"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "cart_items"
      },
      {
        "type": "discount_field"
      },
      {
        "type": "subtotals"
      },
      {
        "type": "checkout_button"
      },
      {
        "type": "payment_badges"
      },
      {
        "type": "icons_with_text"
      }
    ]
  }
}
{% endschema %}

