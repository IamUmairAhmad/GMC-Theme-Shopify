{%- render 'cart-drawer' -%}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add, remove and reorder blocks to build your cart drawer. Amounts and colors are under Theme settings > Cart."
    }
  ],
  "blocks": [
    {
      "type": "countdown_timer",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your cart is reserved for"
        },
        {
          "type": "range",
          "id": "minutes",
          "label": "Minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "default": 10,
          "info": "Counts down per visitor. It does not reserve stock."
        }
      ]
    },
    {
      "type": "checkpoints_bar",
      "name": "Checkpoints bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Up to three reward goals on one bar. Leave an amount blank to skip that checkpoint. Blank amounts everywhere use Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "amount_1",
          "label": "Goal 1 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Goal 1 label",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "icon_1",
          "label": "Goal 1 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Message before goal 1",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "number",
          "id": "amount_2",
          "label": "Goal 2 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Goal 2 label",
          "default": "Free gift"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Goal 2 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Message before goal 2",
          "info": "[amount] becomes the amount still missing.",
          "default": "Add [amount] more for a free gift"
        },
        {
          "type": "number",
          "id": "amount_3",
          "label": "Goal 3 amount (store currency)"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Goal 3 label"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Goal 3 icon",
          "info": "Icon name from the theme icon library, e.g. truck or gift."
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Message before goal 3",
          "info": "[amount] becomes the amount still missing."
        },
        {
          "type": "text",
          "id": "text_done",
          "label": "Message when complete",
          "default": "All rewards unlocked"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal amounts for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "progress_bar",
      "name": "Progress bar",
      "settings": [
        {
          "type": "paragraph",
          "content": "Progress toward a goal such as free shipping. A blank goal uses Theme settings > Cart."
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Goal amount (store currency)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_before",
          "label": "Message before the goal",
          "default": "Add [amount] more for free shipping"
        },
        {
          "type": "text",
          "id": "text_after",
          "label": "Message after the goal",
          "default": "You have unlocked free shipping"
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92. Multiplies the goal for that currency."
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "Track colour"
        },
        {
          "type": "range",
          "id": "height",
          "min": 4,
          "max": 16,
          "step": 2,
          "unit": "px",
          "label": "Bar height",
          "default": 8
        }
      ]
    },
    {
      "type": "cart_items",
      "name": "Cart items",
      "limit": 1
    },
    {
      "type": "discount_field",
      "name": "Discount field",
      "limit": 1
    },
    {
      "type": "subtotals",
      "name": "Subtotals",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "gift",
      "name": "Free gift",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Gift product"
        },
        {
          "type": "number",
          "id": "goal",
          "label": "Spend goal (store currency)",
          "info": "Gift unlocks when paid items reach this amount."
        },
        {
          "type": "textarea",
          "id": "rate_map",
          "label": "Currency rates",
          "info": "Optional. One per line, e.g. EUR:0.92."
        },
        {
          "type": "product_list",
          "id": "only_products",
          "label": "Show only when the cart has these products",
          "limit": 10
        },
        {
          "type": "text",
          "id": "locked_text",
          "label": "Locked text",
          "default": "Add [amount] more to unlock a free gift"
        },
        {
          "type": "text",
          "id": "unlocked_text",
          "label": "Unlocked text",
          "default": "Free gift unlocked"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Show gift image",
          "default": true
        },
        {
          "type": "color",
          "id": "locked_color",
          "label": "Locked colour",
          "default": "#9ca3af"
        },
        {
          "type": "color",
          "id": "unlocked_color",
          "label": "Unlocked colour",
          "default": "#16a34a"
        }
      ]
    },
    {
      "type": "upsell_products",
      "name": "Upsell products",
      "settings": [
        {
          "type": "product_list",
          "id": "products",
          "label": "Upsell products",
          "limit": 3
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "You may also like"
        },
        {
          "type": "product_list",
          "id": "only_for",
          "label": "Show only when the cart has these products",
          "limit": 10
        },
        {
          "type": "checkbox",
          "id": "hide_in_cart",
          "label": "Hide products already in the cart",
          "default": true
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Add"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "column",
              "label": "Column"
            },
            {
              "value": "row",
              "label": "Row"
            }
          ],
          "default": "column"
        }
      ]
    },
    {
      "type": "cart_note",
      "name": "Cart note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order note"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder"
        },
        {
          "type": "range",
          "id": "rows",
          "min": 2,
          "max": 6,
          "step": 1,
          "label": "Rows",
          "default": 3
        }
      ]
    },
    {
      "type": "text_with_icon",
      "name": "Text with icon",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free returns within 30 days"
        },
        {
          "type": "range",
          "id": "size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Text size",
          "default": 13
        },
        {
          "type": "select",
          "id": "align",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text colour"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "checkout_button",
      "name": "Checkout button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "info": "Leave blank for the default text."
        },
        {
          "type": "checkbox",
          "id": "show_express",
          "label": "Show express checkout buttons",
          "info": "Shop Pay, Apple Pay, Google Pay and PayPal appear under the button when your payment settings allow them.",
          "default": true
        }
      ]
    },
    {
      "type": "payment_badges",
      "name": "Payment badges",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text above the icons"
        },
        {
          "type": "text",
          "id": "icons",
          "label": "Payment icons",
          "info": "Optional, comma separated, e.g. visa, master, paypal. Blank shows your store's enabled methods."
        }
      ]
    },
    {
      "type": "icons_with_text",
      "name": "Icons with text",
      "settings": [
        {
          "type": "text",
          "id": "icon_1",
          "label": "Icon 1",
          "default": "check",
          "info": "Icon name from the theme icon library."
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Text 1",
          "default": "Your benefit text"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Icon 2",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Icon 3",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "cart_items"
      },
      {
        "type": "gift",
        "settings": {
          "product": "gmc-test-free-gift",
          "goal": 40
        }
      },
      {
        "type": "upsell_products",
        "settings": {
          "products": [
            "gmc-demo-hoodie"
          ]
        }
      },
      {
        "type": "cart_note"
      },
      {
        "type": "text_with_icon"
      },
      {
        "type": "image"
      },
      {
        "type": "discount_field"
      },
      {
        "type": "subtotals"
      },
      {
        "type": "checkout_button"
      },
      {
        "type": "payment_badges"
      },
      {
        "type": "icons_with_text"
      }
    ]
  }
}
{% endschema %}
