{%- render 'gmc-scheme' -%}
<div class="gmc-acct color-{{ section.settings.color_scheme }} gradient"><div class="page-width page-width--narrow" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
<h1 class="h2">Reset account password</h1>
<p>Enter a new password for {{ email }}</p>
{%- form 'reset_customer_password' -%}
  {%- if form.errors -%}<div class="gmc-acct__err" role="alert" tabindex="-1"><strong>{{ 'Please fix the following' }}</strong>{{ form.errors | default_errors }}</div>{%- endif -%}
  <div class="field"><input class="field__input" type="password" id="password" name="customer[password]" autocomplete="new-password" placeholder="Password" required><label class="field__label" for="password">Password</label></div>
  <div class="field"><input class="field__input" type="password" id="password_confirmation" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Confirm password" required><label class="field__label" for="password_confirmation">Confirm password</label></div>
  <button class="button">Reset password</button>
{%- endform -%}
</div></div>
{% schema %}
{
  "name": "Reset password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
