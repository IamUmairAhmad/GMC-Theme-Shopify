{%- render 'gmc-scheme' -%}
{%- assign mp = section.settings -%}
{%- if mp.enabled -%}
<div class="gmc-pmus gmc-pmus--{{ mp.position }} color-{{ mp.gmc_scheme }}" id="gmc-pmus-{{ section.id }}">
  <button type="button" aria-label="Play or pause music" aria-pressed="false"{% if mp.url == blank %} disabled{% endif %}>
    <span class="gmc-pmus__play" aria-hidden="true">▶</span>
    <span class="gmc-pmus__pause" aria-hidden="true">❚❚</span>
  </button>
  {%- if mp.url != blank -%}
    <audio src="{{ mp.url }}" loop preload="none" data-vol="{{ mp.volume }}"></audio>
  {%- endif -%}
</div>
<style>
  #gmc-pmus-{{ section.id }}{--pmx:{{ mp.off_x }}px;--pmy:{{ mp.off_y }}px}
  @media(max-width:749px){#gmc-pmus-{{ section.id }}{--pmx:{{ mp.off_x | times: 0.75 | round: 0 }}px;--pmy:{{ mp.off_y | times: 0.75 | round: 0 }}px}}
  .gmc-pmus{position:fixed;z-index:39}
  .gmc-pmus--bottom-left{left:calc(1.2rem + var(--pmx));bottom:calc(var(--gmc-dock,0px) + 1.2rem + var(--pmy))}
  .gmc-pmus--bottom-center{left:50%;bottom:calc(var(--gmc-dock,0px) + 1.2rem + var(--pmy));transform:translateX(-50%)}
  .gmc-pmus--bottom-right{right:calc(1.2rem + var(--pmx));bottom:calc(var(--gmc-dock,0px) + 1.2rem + var(--pmy))}
  .gmc-pmus button{position:relative;display:grid;place-items:center;width:4.4rem;height:4.4rem;border:0;border-radius:50%;cursor:pointer;background:rgb(var(--color-button));color:rgb(var(--color-button-text));box-shadow:0 2px 10px rgba(var(--color-shadow),.25);padding:0}
  .gmc-pmus button:disabled{opacity:.45;cursor:not-allowed}
  .gmc-pmus__pause,.gmc-pmus button.is-on .gmc-pmus__play{display:none}
  .gmc-pmus button.is-on .gmc-pmus__pause{display:block}
  {%- if mp.ripple -%}
  .gmc-pmus button.is-on:after{content:'';position:absolute;inset:0;border-radius:50%;border:2px solid currentColor;animation:gmc-pmus-r 1.6s ease-out infinite;pointer-events:none}
  @keyframes gmc-pmus-r{to{transform:scale(1.8);opacity:0}}
  @media(prefers-reduced-motion:reduce){.gmc-pmus button.is-on:after{animation:none}}
  {%- endif -%}
</style>
<script>
  (function(){
    var root=document.getElementById('gmc-pmus-{{ section.id }}');
    if(!root)return;
    var b=root.querySelector('button'),a=root.querySelector('audio');
    if(a){
      var raw=a.dataset.vol;
      var n=raw===''||raw==null?10:Number(raw);
      if(!isFinite(n))n=10;
      a.volume=Math.max(0,Math.min(1,n/100));
    }
    b.addEventListener('click',function(){
      if(!a||b.disabled)return;
      if(a.paused){
        var play=a.play();
        if(play&&play.then){
          play.then(function(){
            b.classList.add('is-on');
            b.setAttribute('aria-pressed','true');
          }).catch(function(){});
        }else{
          b.classList.add('is-on');
          b.setAttribute('aria-pressed','true');
        }
      }else{
        a.pause();
        b.classList.remove('is-on');
        b.setAttribute('aria-pressed','false');
      }
    });
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Music Player",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Plays on this page only. For one song across the store, use the global music player."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the player",
      "default": true
    },
    {
      "type": "text",
      "id": "url",
      "label": "Audio source",
      "info": "Upload an MP3 under Content > Files and paste the link. The button stays visible but cannot play until a link is set. Sound starts after the visitor taps it."
    },
    {
      "type": "range",
      "id": "volume",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Volume",
      "default": 10
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "off_x",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Offset X",
      "info": "Not applied when the button is centred. On mobile this offset is 75% of the value.",
      "default": 20
    },
    {
      "type": "range",
      "id": "off_y",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Offset Y",
      "info": "On mobile this offset is 75% of the value.",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "ripple",
      "label": "Display ripple animation",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "all"
    }
  ],
  "presets": [
    { "name": "Music Player" }
  ]
}
{% endschema %}
