{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one result row.' -%}{%- endif -%}
{%- assign ss = section.settings -%}
{%- liquid
  assign show_copy = false
  if ss.heading != blank or ss.intro != blank or ss.image != blank or ss.video != blank
    assign show_copy = true
  endif
-%}
<div class="page-width gmc-rs {% render 'gmc-vis', hide: ss.hide_on %}" id="gmc-rs-{{ section.id }}">
  <div class="gmc-rs__grid{% if show_copy %} gmc-rs__grid--split{% endif %}{% if ss.layout == 'results_first' %} gmc-rs__grid--first{% endif %}">
    {%- if show_copy -%}
      <div class="gmc-rs__copy">
        {%- if ss.heading != blank -%}<h2 class="gmc-rs__title {{ ss.heading_size }}">{{ ss.heading | escape }}</h2>{%- endif -%}
        {%- if ss.intro != blank -%}<div class="rte gmc-rs__intro">{{ ss.intro }}</div>{%- endif -%}
        {%- if ss.video != blank -%}
          <div class="gmc-rs__media" {% if ss.video.aspect_ratio > 0 %}style="aspect-ratio:{{ ss.video.aspect_ratio }}"{% endif %}>
            <video playsinline preload="metadata" autoplay muted loop {% if ss.video.preview_image != blank %}poster="{{ ss.video.preview_image | image_url: width: 1200 }}"{% endif %}>
              {%- for vs in ss.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
            </video>
          </div>
        {%- elsif ss.image != blank -%}
          <div class="gmc-rs__media" {% if ss.image.aspect_ratio > 0 %}style="aspect-ratio:{{ ss.image.aspect_ratio }}"{% endif %}>
            {{ ss.image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'gmc-rs__img', widths: '360, 535, 750, 1070, 1500', sizes: '(min-width: 750px) 40vw, 100vw', alt: ss.image.alt }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="gmc-rs__stats">
      {%- if ss.results_heading != blank -%}<h3 class="gmc-rs__rh {{ ss.results_size }} gmc-rs__rh--{{ ss.results_align }}">{{ ss.results_heading | escape }}</h3>{%- endif -%}
      <div class="gmc-rs__rows">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="gmc-rs__row" {{ block.shopify_attributes }}>
            <div class="gmc-rs__top">
              <strong class="gmc-rs__num">{{ b.percentage }}%</strong>
              <div class="gmc-rs__track" role="img" aria-label="{{ b.percentage }}%"><span class="gmc-rs__fill" style="--percentage:{{ b.percentage }}%"></span></div>
            </div>
            {%- if b.row_text != blank -%}<div class="rte gmc-rs__txt">{{ b.row_text }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if ss.caption != blank -%}<div class="rte gmc-rs__cap">{{ ss.caption }}</div>{%- endif -%}
      {%- if ss.button != blank or ss.atc_label != blank -%}
        <div class="gmc-rs__actions">
          {%- if ss.button != blank -%}
            <a class="button{% if ss.secondary %} button--secondary{% else %} button--primary{% endif %}" {% if ss.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ ss.link }}"{% endif %}>{{ ss.button | escape }}</a>
          {%- endif -%}
          {%- if ss.atc_label != blank -%}
            {%- if ss.atc_product != blank -%}
              {%- render 'gmc-inline-atc', product: ss.atc_product, label: ss.atc_label, skip: ss.atc_skip, align: 'center' -%}
            {%- else -%}
              <button type="button" class="button button--primary" data-gmc-rs-atc {% if product != blank and product.selected_or_first_available_variant.available == false %}disabled{% endif %}>{{ ss.atc_label | escape }}</button>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- if ss.gmc_pad_top > 0 or ss.gmc_pad_bottom > 0 -%}
<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {%- if ss.gmc_pad_top > 0 -%}padding-top: {{ ss.gmc_pad_top | times: 0.75 | round: 0 }}px;{%- endif -%}
      {%- if ss.gmc_pad_bottom > 0 -%}padding-bottom: {{ ss.gmc_pad_bottom | times: 0.75 | round: 0 }}px;{%- endif -%}
    }
  }
</style>
{%- endif -%}
<style>
  .gmc-rs__grid{display:grid;gap:3rem;align-items:center}
  .gmc-rs__copy{text-align:center}
  .gmc-rs__title{margin:0}
  .gmc-rs__intro{margin-top:1rem}
  .gmc-rs__media{margin:1.6rem auto 0;max-width:100%;overflow:hidden;border-radius:var(--media-radius,8px)}
  .gmc-rs__media video,.gmc-rs__img{width:100%;height:100%;display:block;object-fit:cover}
  .gmc-rs__rh{margin:0 0 1.6rem}
  .gmc-rs__rh--center{text-align:center}
  .gmc-rs__row{margin-bottom:1.8rem}
  .gmc-rs__top{display:flex;align-items:center;gap:1.2rem}
  .gmc-rs__num{flex:none;min-width:5.6rem;font-size:2.4rem;font-weight:700;line-height:1}
  .gmc-rs__track{flex:1;height:.8rem;border-radius:1rem;background:rgba(var(--color-foreground),.15);overflow:hidden}
  .gmc-rs__fill{display:block;height:100%;width:0;background:rgb(var(--color-foreground));border-radius:inherit}
  .gmc-rs.is-in .gmc-rs__fill{width:var(--percentage);transition:width 1.2s ease}
  @media(prefers-reduced-motion:reduce){.gmc-rs__fill{width:var(--percentage);transition:none}}
  .gmc-rs__txt{margin:.6rem 0 0}
  .gmc-rs__cap{margin-top:.4rem}
  .gmc-rs__actions{display:flex;flex-direction:column;align-items:center;gap:1rem;margin-top:1.6rem}
  .gmc-rs__actions .gmc-sec-atc{padding:0}
  @media(min-width:750px){
    .gmc-rs__grid--split{grid-template-columns:1fr 1fr;gap:4rem}
    .gmc-rs__grid--first .gmc-rs__stats{order:-1}
  }
</style>
<script>
  (function(){
    var w = document.getElementById('gmc-rs-{{ section.id }}');
    if (!w) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function run(){ w.classList.add('is-in'); }
    function shown(){
      var r = w.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight || 0;
      return r.bottom > 0 && vh > r.top;
    }
    if (reduce || !('IntersectionObserver' in window)) run();
    else {
      var o = new IntersectionObserver(function(entries){
        if (entries[0].isIntersecting) { run(); o.disconnect(); }
      });
      o.observe(w);
      requestAnimationFrame(function(){ if (shown()) run(); });
    }
    var atc = w.querySelector('[data-gmc-rs-atc]');
    if (atc) atc.addEventListener('click', function(){
      var form = document.querySelector('product-form');
      var submit = form && form.querySelector('[type="submit"]');
      if (submit) submit.click();
    });
  })();
</script>
{% schema %}
{
  "name": "Results",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text",
      "default": "<p>Talk about results of your customers and how your product improved their life.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "paragraph",
      "content": "Or"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Use an autoplay MP4 instead of a GIF or animated WEBP. A video replaces the image."
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop results placement",
      "options": [
        { "value": "results_first", "label": "Results first" },
        { "value": "results_second", "label": "Results second" }
      ],
      "default": "results_second"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results heading",
      "default": "Results heading"
    },
    {
      "type": "select",
      "id": "results_size",
      "label": "Results heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "results_align",
      "label": "Results heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "caption",
      "label": "Caption",
      "default": "<p>Caption about the results and/or link for their proof.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "secondary",
      "label": "Use outline button style",
      "default": false
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart button label",
      "info": "Leave blank to hide. If the custom product below is empty, this adds the variant selected on the product page."
    },
    {
      "type": "product",
      "id": "atc_product",
      "label": "Add to cart custom product"
    },
    {
      "type": "checkbox",
      "id": "atc_skip",
      "label": "Custom product skips the cart",
      "default": false
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        { "value": "", "label": "Show everywhere" },
        { "value": "mobile", "label": "Mobile" },
        { "value": "desktop", "label": "Desktop" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 36
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 36
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button for a chosen product at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Result row",
      "settings": [
        {
          "type": "range",
          "id": "percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Percentage",
          "default": 90
        },
        {
          "type": "richtext",
          "id": "row_text",
          "label": "Result",
          "default": "<p>Noticed that this product has significantly improved their life.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Results",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
