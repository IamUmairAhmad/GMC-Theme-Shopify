{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one stat block.' -%}{%- endif -%}
<div class="page-width gmc-rs {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-rs-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-rs__g" style="--rs-cols:{{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="gmc-rs__c" {{ block.shopify_attributes }}>
        {%- if b.video != blank -%}<div class="gmc-pm__vid" data-gmc-vid><video playsinline preload="metadata" autoplay muted loop {% if b.image != blank %}poster="{{ b.image | image_url: width: 800 }}"{% endif %}>{%- for vs in b.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video></div>
        {%- elsif b.image != blank -%}{{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: b.image.alt, class: 'gmc-rs__img' }}{%- endif -%}
        <div class="gmc-rs__n"><span data-to="{{ b.number }}">0</span>{{ b.suffix | escape }}</div>
        {%- if b.bar > 0 -%}<div class="gmc-rs__bar" role="img" aria-label="{{ b.bar }}%"><span style="--w:{{ b.bar }}%;background:{{ b.bar_color | default: 'currentColor' }}"></span></div>{%- endif -%}
        <p>{{ b.label | escape }}</p>
        {%- if b.caption != blank -%}<p class="gmc-rs__cap">{{ b.caption | escape }}</p>{%- endif -%}
        {%- if b.product != blank -%}{%- render 'gmc-inline-atc', product: b.product, label: b.button, skip: false, align: 'center' -%}{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<style>.gmc-rs{padding:36px 0}.gmc-rs__g{display:grid;grid-template-columns:repeat(auto-fit,minmax(max(150px,calc(100%/var(--rs-cols,4) - 1.5rem)),1fr));gap:1.5rem;text-align:center;margin-top:1rem}.gmc-rs__n{font-size:4rem;font-weight:800}.gmc-rs__g p{margin:0;opacity:.75}.gmc-rs__img,.gmc-rs__c video{width:100%;height:auto;border-radius:var(--media-radius,8px);margin-bottom:1rem}.gmc-rs__bar{height:.8rem;border-radius:9px;background:rgba(128,128,128,.25);overflow:hidden;margin:.8rem auto;max-width:24rem}.gmc-rs__bar span{display:block;height:100%;width:0;border-radius:9px;transition:width 1.4s ease}.gmc-rs.is-in .gmc-rs__bar span{width:var(--w)}.gmc-rs__cap{font-size:1.3rem;opacity:.65!important}</style>
<script>(function(){var w=document.getElementById('gmc-rs-{{ section.id }}');function run(){w.classList.add('is-in');w.querySelectorAll('[data-to]').forEach(function(s){var to=+s.dataset.to,t0=null;function f(t){t0=t0||t;var p=Math.min(1,(t-t0)/1400);s.textContent=Math.round(to*p).toLocaleString();if(p<1)requestAnimationFrame(f);}requestAnimationFrame(f);});}
if('IntersectionObserver' in window){var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){run();o.disconnect();}});o.observe(w);}else{run();}})();</script>
{% schema %}
{
  "name": "Results",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results that speak"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop."
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Number",
          "default": 10000
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy customers"
        },
        {
          "type": "range",
          "id": "bar",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Progress bar (0 = off)",
          "default": 0
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar colour"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (MP4)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Add-to-cart product"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Add to cart"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Results",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat",
          "settings": {
            "number": 98,
            "suffix": "%",
            "label": "Satisfaction"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 50,
            "suffix": "+",
            "label": "Countries"
          }
        }
      ]
    }
  ]
}
{% endschema %}
