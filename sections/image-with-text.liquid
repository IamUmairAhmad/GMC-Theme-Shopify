{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'imagetext', title: 'Image with text' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .image-with-text__media video {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .gmc-ti {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap, 12px);
    width: var(--box, 100%);
    max-width: 100%;
    font-size: var(--size, 16px);
    color: var(--fg, inherit);
    justify-content: var(--align, flex-start);
    text-align: var(--talign, left);
    background: var(--bg, transparent);
    border-radius: var(--radius, 0);
    padding: var(--pad, 0);
    border: var(--border, 0);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gmc-ti--vertical {
    flex-direction: column;
    align-items: var(--align, flex-start);
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .gmc-ti__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  #shopify-section-{{ section.id }} .gmc-ti__icon {
    color: var(--icon, currentColor);
    display: inline-flex;
    flex: 0 0 auto;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .image-with-text__grid--mobile-reverse {
      flex-direction: column-reverse;
      flex-wrap: nowrap;
    }

    #shopify-section-{{ section.id }} .image-with-text__media--mobile-full {
      width: calc(100% + 3rem);
      max-width: none;
      margin-left: -1.5rem;
      margin-right: -1.5rem;
    }

    #shopify-section-{{ section.id }} .image-with-text__media--mobile-full .image-with-text__media,
    #shopify-section-{{ section.id }} .image-with-text__media--mobile-full img,
    #shopify-section-{{ section.id }} .image-with-text__media--mobile-full video {
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .gmc-ti {
      font-size: var(--size-m, var(--size, 14px));
      justify-content: var(--align-m, var(--align, flex-start));
      text-align: var(--talign-m, var(--talign, left));
    }

    #shopify-section-{{ section.id }} .gmc-ti--vertical {
      align-items: var(--align-m, var(--align, flex-start));
      justify-content: flex-start;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}{% if section.settings.mobile_direction == 'reverse' %} image-with-text__grid--mobile-reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }}{% if section.settings.mobile_full_media_width %} image-with-text__media--mobile-full{% endif %} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank or section.settings.video != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.video == blank and section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.video != blank and section.settings.video.aspect_ratio != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.video.aspect_ratio | times: 100 }}%;"
            {% elsif section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.video != blank -%}
              {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1200x' }}
            {%- elsif section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'rating_stars' or 'text_icon' or 'image' -%}
                  {%- render 'gmc-block-extra', block: block -%}
                {%- when 'text_icons' -%}
                  {%- liquid
                    assign gmc_ti_align = block.settings.align | default: 'left'
                    assign gmc_ti_align_m = block.settings.mobile_align | default: gmc_ti_align
                    if gmc_ti_align == 'center'
                      assign gmc_ti_j = 'center'
                    elsif gmc_ti_align == 'right'
                      assign gmc_ti_j = 'flex-end'
                    else
                      assign gmc_ti_j = 'flex-start'
                    endif
                    if gmc_ti_align_m == 'center'
                      assign gmc_ti_jm = 'center'
                    elsif gmc_ti_align_m == 'right'
                      assign gmc_ti_jm = 'flex-end'
                    else
                      assign gmc_ti_jm = 'flex-start'
                    endif
                    if block.settings.width == 'fit'
                      assign gmc_ti_box = 'fit-content'
                    else
                      assign gmc_ti_box = '100%'
                    endif
                  -%}
                  <div
                    class="gmc-ti gmc-ti--{{ block.settings.direction }}"
                    style="--gap:{{ block.settings.gap }}px;--size:{{ block.settings.text_size }}px;--size-m:{{ block.settings.mobile_text_size }}px;--fg:{{ block.settings.text_color }};--icon:{{ block.settings.icon_color }};--align:{{ gmc_ti_j }};--talign:{{ gmc_ti_align }};--align-m:{{ gmc_ti_jm }};--talign-m:{{ gmc_ti_align_m }};--box:{{ gmc_ti_box }};{% if block.settings.show_bg %}--bg:{{ block.settings.bg_color }};--pad:{{ block.settings.pad }}px;--radius:{{ block.settings.radius }}px;{% endif %}{% if block.settings.border_size > 0 %}--border:{{ block.settings.border_size }}px solid {{ block.settings.border_color }};{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for gmc_i in (1..3) -%}
                      {%- liquid
                        assign gmc_line_key = 'line_' | append: gmc_i
                        assign gmc_icon_key = 'icon_' | append: gmc_i
                        assign gmc_fill_key = 'filled_' | append: gmc_i
                        assign gmc_img_key = 'image_' | append: gmc_i
                        assign gmc_line = block.settings[gmc_line_key]
                        assign gmc_icon = block.settings[gmc_icon_key]
                        assign gmc_filled = block.settings[gmc_fill_key]
                        assign gmc_img = block.settings[gmc_img_key]
                      -%}
                      {%- if gmc_line != blank or gmc_icon != blank or gmc_img != blank -%}
                        <span class="gmc-ti__item">
                          <span class="gmc-ti__icon">
                            {%- render 'gmc-icon', name: gmc_icon, size: block.settings.icon_size, image: gmc_img, filled: gmc_filled -%}
                          </span>
                          <span>{{ gmc_line }}</span>
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- when 'atc_button' -%}
                  <div class="image-with-text__atc" {{ block.shopify_attributes }}>
                    {%- if block.settings.atc_product == blank -%}
                      <button type="button" class="button" disabled>{{ block.settings.button_label | default: 'Add to cart' | escape }}</button>
                    {%- else -%}
                      {%- render 'gmc-inline-atc',
                        product: block.settings.atc_product,
                        label: block.settings.button_label,
                        skip: block.settings.atc_skip_cart,
                        align: 'inherit'
                      -%}
                    {%- endif -%}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- render 'gmc-section-extras' -%}
{%- endif -%}
{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label",
      "info": "Recommended: 1100 px wide. Tested: 548 px wide on desktop and 358 px on phones. The height depends on the Image height setting: Adapt follows your image (367 px high for a 3:2 picture), Small is 312 px, Medium 458 px and Large 693 px (phones: 192 / 294 / 433 px). Small, Medium and Large crop the image."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays in place of the image. Muted, looping, and without controls."
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__2.label"
        }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "top",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.desktop_content_alignment.label"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_media_width",
      "label": "Full media width",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_direction",
      "label": "Mobile media position",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Media first"
        },
        {
          "value": "reverse",
          "label": "Media second"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.mobile_content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header_colors.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "GMC extras"
    },
    {
      "type": "select",
      "id": "gmc_hide_on",
      "label": "Hide section on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image",
      "info": "Recommended: 2000 × 1200 px. Tested: fills the section edge to edge and is cropped to fit, never stretched; the theme loads at most 2000 px wide, so larger files add no sharpness. At full desktop width (1920 px) a 2000 × 1200 image covers sections up to about 1150 px tall without enlarging; section height follows its content."
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
