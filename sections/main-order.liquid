{%- render 'gmc-scheme' -%}
<div class="gmc-acct color-{{ section.settings.color_scheme }} gradient"><div class="page-width page-width--narrow" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
<p><a class="link gmc-acct-link" href="{{ routes.account_url }}">&larr; Back to account</a></p>
<h1 class="h2">Order {{ order.name }}</h1>
<p>Placed on {{ order.created_at | time_tag: format: 'date' }}{%- if order.cancelled %} &middot; Cancelled {{ order.cancelled_at | time_tag: format: 'date' }}{%- endif -%}</p>
<table class="gmc-acct__tbl"><thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead><tbody>
{%- for line_item in order.line_items -%}<tr><td>{%- if line_item.url != blank -%}<a class="link gmc-acct-link" href="{{ line_item.url }}">{{ line_item.title | escape }}</a>{%- else -%}{{ line_item.title | escape }}{%- endif -%}{%- unless line_item.product.has_only_default_variant -%}<br><small>{{ line_item.variant.title | escape }}</small>{%- endunless -%}{%- if line_item.fulfillment != blank -%}<br><small>Fulfilled {{ line_item.fulfillment.created_at | time_tag: format: 'date' }}</small>{%- endif -%}</td><td>{{ line_item.sku }}</td><td>{{ line_item.final_price | money }}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>{%- endfor -%}
</tbody><tfoot>
<tr><th colspan="4" scope="row">Subtotal</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
{%- for discount in order.cart_level_discount_applications -%}<tr><th colspan="4" scope="row">{{ discount.title }}</th><td>-{{ discount.total_allocated_amount | money }}</td></tr>{%- endfor -%}
{%- for shipping_method in order.shipping_methods -%}<tr><th colspan="4" scope="row">Shipping ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
{%- for tax_line in order.tax_lines -%}<tr><th colspan="4" scope="row">{{ tax_line.title }}</th><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
<tr><th colspan="4" scope="row">Total</th><td>{{ order.total_price | money_with_currency }}</td></tr>
</tfoot></table>
<div class="gmc-acct__grid"><div><h2 class="h3">Billing address</h2><p>Payment status: {{ order.financial_status_label }}</p>{{ order.billing_address | format_address }}</div><div><h2 class="h3">Shipping address</h2><p>Fulfilment status: {{ order.fulfillment_status_label }}</p>{{ order.shipping_address | format_address }}</div></div>
</div></div>
{% schema %}
{
  "name": "Customer order",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
