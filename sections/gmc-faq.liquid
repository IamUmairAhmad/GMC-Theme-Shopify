{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- comment -%} GMC Theme: FAQ accordion, usable on any page (original code). Optional FAQPage structured data for search engines. {%- endcomment -%}
{%- assign faq_id = 'gmc-faq-' | append: section.id -%}
<div class="gmc-faq color-{{ section.settings.color_scheme }} gradient" id="{{ faq_id }}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="page-width gmc-faq__wrap gmc-faq--{{ section.settings.width }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="title {{ section.settings.heading_size }} gmc-faq__title" style="text-align:{{ section.settings.align }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="gmc-faq__sub rte" style="text-align:{{ section.settings.align }}">{{ section.settings.subheading }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="gmc-faq__list gmc-faq--{{ section.settings.style }}">
        {%- for block in section.blocks -%}
          <details class="gmc-faq__item" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="gmc-faq__q">
              <span>{{ block.settings.question | escape }}</span>
              <span class="gmc-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="gmc-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- if section.settings.seo and section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for block in section.blocks -%}
{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
</script>
{%- endif -%}
<style>
  #{{ faq_id }} .gmc-faq__wrap.gmc-faq--narrow{max-width:72rem}
  #{{ faq_id }} .gmc-faq__wrap.gmc-faq--medium{max-width:96rem}
  #{{ faq_id }} .gmc-faq__title{margin:0 0 1.2rem}
  #{{ faq_id }} .gmc-faq__sub{margin:0 0 2.4rem}
  #{{ faq_id }} .gmc-faq__list{margin-top:2rem}
  #{{ faq_id }} .gmc-faq__item{border-bottom:1px solid rgba(var(--color-foreground),.15)}
  #{{ faq_id }} .gmc-faq--lined .gmc-faq__item:first-child{border-top:1px solid rgba(var(--color-foreground),.15)}
  #{{ faq_id }} .gmc-faq--boxed .gmc-faq__item{border:1px solid rgba(var(--color-foreground),.15);border-radius:var(--text-boxes-radius);margin-bottom:1rem;background:rgba(var(--color-foreground),.03)}
  #{{ faq_id }} .gmc-faq__q{display:flex;justify-content:space-between;align-items:center;gap:1.6rem;padding:1.6rem 0;cursor:pointer;list-style:none;font-weight:600;color:rgb(var(--color-foreground))}
  #{{ faq_id }} .gmc-faq--boxed .gmc-faq__q{padding:1.6rem 2rem}
  #{{ faq_id }} .gmc-faq__q::-webkit-details-marker{display:none}
  #{{ faq_id }} .gmc-faq__q:focus-visible{outline:.2rem solid rgba(var(--color-foreground),.5);outline-offset:.2rem}
  #{{ faq_id }} .gmc-faq__icon{position:relative;flex:0 0 1.4rem;height:1.4rem}
  #{{ faq_id }} .gmc-faq__icon:before,#{{ faq_id }} .gmc-faq__icon:after{content:"";position:absolute;left:0;top:50%;width:100%;height:.15rem;background:currentColor;transition:transform .2s}
  #{{ faq_id }} .gmc-faq__icon:after{transform:rotate(90deg)}
  #{{ faq_id }} details[open] .gmc-faq__icon:after{transform:rotate(0)}
  #{{ faq_id }} .gmc-faq__a{padding:0 0 1.8rem;color:rgba(var(--color-foreground),.8)}
  #{{ faq_id }} .gmc-faq--boxed .gmc-faq__a{padding:0 2rem 1.8rem}
  @media(prefers-reduced-motion:reduce){#{{ faq_id }} .gmc-faq__icon:before,#{{ faq_id }} .gmc-faq__icon:after{transition:none}}
</style>
{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "lined",
          "label": "Lines"
        },
        {
          "value": "boxed",
          "label": "Boxed"
        }
      ],
      "default": "lined"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "seo",
      "label": "Add FAQ structured data",
      "default": true,
      "info": "Helps search engines show your questions in results."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Replace this with your own answer.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Replace this with your own answer.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>Replace this with your own answer.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
