{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one message block.' -%}{%- endif -%}
<div class="gmc-vt {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--bg:{{ section.settings.bg }};--fg:{{ section.settings.fg }};--h:{{ section.settings.height }}px;--speed:{{ section.blocks.size | times: 3 }}s">
  <div class="gmc-vt__track">
    {%- for i in (1..2) -%}{%- for block in section.blocks -%}<div class="gmc-vt__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</div>{%- endfor -%}{%- endfor -%}
  </div>
</div>
<style>.gmc-vt{background:var(--bg);color:var(--fg);height:var(--h);overflow:hidden;text-align:center;font-weight:600}.gmc-vt__item{height:var(--h);line-height:var(--h)}.gmc-vt__track{animation:gmc-vt var(--speed) steps({{ section.blocks.size | at_least: 1 }}) infinite}@keyframes gmc-vt{to{transform:translateY(calc(var(--h) * -{{ section.blocks.size }}))}}@media(prefers-reduced-motion:reduce){.gmc-vt__track{animation:none}}</style>
{% schema %}
{
  "name": "Vertical ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "height",
      "min": 28,
      "max": 80,
      "unit": "px",
      "label": "Height",
      "default": 40
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your shipping message"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vertical ticker",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "text": "Your returns message"
          }
        }
      ]
    }
  ]
}
{% endschema %}
