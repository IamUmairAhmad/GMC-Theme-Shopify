{%- capture gmc_gate -%}{%- render 'gmc-gate', only: section.settings.gmc_only, hide: section.settings.gmc_hide -%}{%- endcapture -%}
{%- unless gmc_gate contains 'hide' -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- liquid
  assign s = section.settings
  assign n = section.blocks.size
  assign half = 0
  if n > 0
    assign half = s.rows | times: 1.0 | divided_by: n | ceil | times: n
  endif
  assign dur = s.rows | times: 1.0 | divided_by: s.speed | times: 4
  assign atc_p = s.gmc_atc_product
  if atc_p == blank
    assign atc_p = product
  endif
  assign show_atc = false
  if s.gmc_atc_label != blank and atc_p != blank
    assign show_atc = true
  endif
  assign show_panel = false
  if s.panel_show != 'never'
    assign show_panel = true
  endif
-%}
{%- if n == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one text line.' -%}{%- endif -%}
<div
  class="gmc-vtwrap{% if show_panel %} gmc-vtwrap--split{% endif %}{% if s.panel_side == 'right' %} gmc-vtwrap--ticker-first{% endif %}{% if s.panel_show == 'desktop' %} gmc-vtwrap--desk{% endif %}{% if s.bold %} gmc-vt--bold{% endif %}{% if s.italic %} gmc-vt--italic{% endif %}{% if s.uppercase %} gmc-vt--upper{% endif %}"
  id="gmc-vt-{{ section.id }}"
  style="--gmc-vt-size:{{ s.text_size }}rem;--gmc-vt-rows:{{ s.rows }};--gmc-vt-dur:{{ dur }}s;--gmc-vt-pt:{{ s.padding_top }}px;--gmc-vt-pb:{{ s.padding_bottom }}px;--gmc-vt-cpt:{{ s.content_pad_top }}px;--gmc-vt-cpb:{{ s.content_pad_bottom }}px"
>
  {%- if show_panel -%}
    <div class="gmc-vt__content color-{{ s.gmc_scheme }} gradient">
      {%- if s.content_image != blank -%}
        <div class="gmc-vt__bg">
          {{ s.content_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.content_image.alt }}
          <div class="gmc-vt__overlay" style="background:{{ s.overlay_color }};opacity:{{ s.overlay_opacity | divided_by: 100.0 }}"></div>
        </div>
      {%- endif -%}
      <div class="gmc-vt__copy">
        {%- if s.panel_heading != blank -%}
          <h2 class="title {{ s.content_heading_size }}">{{ s.panel_heading | escape }}</h2>
        {%- endif -%}
        {%- if s.panel_text != blank -%}
          <div class="rte">{{ s.panel_text }}</div>
        {%- endif -%}
        {%- if s.panel_btn != blank or show_atc -%}
          <div class="gmc-vt__actions">
            {%- if s.panel_btn != blank -%}
              <a
                class="button{% if s.button_secondary %} button--secondary{% endif %}"
                {% if s.panel_link != blank %}
                  href="{{ s.panel_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >{{ s.panel_btn | escape }}</a>
            {%- endif -%}
            {%- if show_atc -%}
              {%- render 'gmc-inline-atc', product: atc_p, label: s.gmc_atc_label, skip: s.gmc_atc_skip, align: 'center' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="gmc-vt__ticker color-{{ s.ticker_scheme }} gradient">
    {%- if n > 0 -%}
      <div class="gmc-vt__window">
        <div class="gmc-vt__track">
          {%- for copy in (1..2) -%}
            <div class="gmc-vt__set"{% if copy == 2 %} aria-hidden="true"{% endif %}>
              {%- for i in (1..half) -%}
                {%- assign idx = i | minus: 1 | modulo: n -%}
                {%- assign block = section.blocks[idx] -%}
                <p class="gmc-vt__item"{% if copy == 1 and n >= i %} {{ block.shopify_attributes }}{% endif %}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                  {%- else -%}
                    {{ block.settings.text | escape }}
                  {%- endif -%}
                </p>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  {%- if show_atc -%}
    {%- unless show_panel -%}
      <div class="gmc-vt__solo">
        {%- render 'gmc-inline-atc', product: atc_p, label: s.gmc_atc_label, skip: s.gmc_atc_skip, align: 'center' -%}
      </div>
    {%- endunless -%}
  {%- endif -%}
</div>
<style>
  #shopify-section-{{ section.id }} > .gmc-sec-atc { display: none; }
  #gmc-vt-{{ section.id }} { color: rgb(var(--color-foreground)); }
  #gmc-vt-{{ section.id }}.gmc-vtwrap--split { display: block; }
  #gmc-vt-{{ section.id }} .gmc-vt__content,
  #gmc-vt-{{ section.id }} .gmc-vt__ticker { position: relative; }
  #gmc-vt-{{ section.id }} .gmc-vt__ticker {
    display: flex;
    align-items: center;
    padding-top: calc(var(--gmc-vt-pt) * .75);
    padding-bottom: calc(var(--gmc-vt-pb) * .75);
  }
  #gmc-vt-{{ section.id }} .gmc-vt__content {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding-top: calc(var(--gmc-vt-cpt) * .75);
    padding-bottom: calc(var(--gmc-vt-cpb) * .75);
  }
  #gmc-vt-{{ section.id }} .gmc-vt__copy { position: relative; z-index: 1; width: min(100%, 46rem); padding: 0 2rem; }
  #gmc-vt-{{ section.id }} .gmc-vt__copy .title { margin: 0 0 1rem; }
  #gmc-vt-{{ section.id }} .gmc-vt__copy .rte { margin: 0; }
  #gmc-vt-{{ section.id }} .gmc-vt__actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center; margin-top: 1.6rem; }
  #gmc-vt-{{ section.id }} .gmc-vt__actions .gmc-sec-atc { padding: 0; }
  #gmc-vt-{{ section.id }} .gmc-vt__bg { position: absolute; inset: 0; z-index: 0; }
  #gmc-vt-{{ section.id }} .gmc-vt__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #gmc-vt-{{ section.id }} .gmc-vt__overlay { position: absolute; inset: 0; }
  #gmc-vt-{{ section.id }} .gmc-vt__window {
    width: 100%;
    overflow: hidden;
    height: calc(var(--gmc-vt-size) * .6 * 1.2 * var(--gmc-vt-rows));
  }
  #gmc-vt-{{ section.id }} .gmc-vt__item {
    margin: 0;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 1.5rem;
    font-size: calc(var(--gmc-vt-size) * .6);
  }
  #gmc-vt-{{ section.id }} .gmc-vt__item a { color: inherit; text-decoration: none; }
  #gmc-vt-{{ section.id }}.gmc-vt--bold .gmc-vt__item { font-weight: 700; }
  #gmc-vt-{{ section.id }}.gmc-vt--italic .gmc-vt__item { font-style: italic; }
  #gmc-vt-{{ section.id }}.gmc-vt--upper .gmc-vt__item { text-transform: uppercase; }
  #gmc-vt-{{ section.id }} .gmc-vt__track { animation: gmc-vt-rise var(--gmc-vt-dur) linear infinite; }
  #gmc-vt-{{ section.id }} .gmc-vt__ticker:hover .gmc-vt__track { animation-play-state: paused; }
  @media (min-width: 500px) {
    #gmc-vt-{{ section.id }} .gmc-vt__item { font-size: calc(var(--gmc-vt-size) * .8); }
    #gmc-vt-{{ section.id }} .gmc-vt__window { height: calc(var(--gmc-vt-size) * .8 * 1.2 * var(--gmc-vt-rows)); }
  }
  @media (min-width: 750px) {
    #gmc-vt-{{ section.id }}.gmc-vtwrap--split { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; }
    #gmc-vt-{{ section.id }}.gmc-vtwrap--ticker-first .gmc-vt__ticker { order: -1; }
    #gmc-vt-{{ section.id }} .gmc-vt__ticker { padding-top: var(--gmc-vt-pt); padding-bottom: var(--gmc-vt-pb); }
    #gmc-vt-{{ section.id }} .gmc-vt__content { padding-top: var(--gmc-vt-cpt); padding-bottom: var(--gmc-vt-cpb); }
    #gmc-vt-{{ section.id }} .gmc-vt__item { font-size: var(--gmc-vt-size); }
    #gmc-vt-{{ section.id }} .gmc-vt__window { height: calc(var(--gmc-vt-size) * 1.2 * var(--gmc-vt-rows)); }
  }
  @media (max-width: 749px) {
    #gmc-vt-{{ section.id }}.gmc-vtwrap--desk .gmc-vt__content { display: none; }
  }
  @keyframes gmc-vt-rise { to { transform: translateY(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    #gmc-vt-{{ section.id }} .gmc-vt__track { animation: none; }
  }
</style>
{%- endunless -%}
{% schema %}
{
  "name": "Vertical ticker",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Ticker" },
    { "type": "range", "id": "rows", "min": 1, "max": 16, "step": 1, "label": "Number of rows displayed", "default": 8 },
    { "type": "range", "id": "speed", "min": 1, "max": 5, "step": 0.5, "label": "Ticker speed", "default": 3, "info": "Higher is faster." },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "default": "4",
      "options": [
        { "value": "2", "label": "Extra small" },
        { "value": "3", "label": "Small" },
        { "value": "4", "label": "Medium" },
        { "value": "5", "label": "Large" },
        { "value": "6", "label": "Extra large" }
      ]
    },
    { "type": "checkbox", "id": "italic", "label": "Italic text", "default": false },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase text", "default": false },
    { "type": "checkbox", "id": "bold", "label": "Bold text", "default": false },
    { "type": "color_scheme", "id": "ticker_scheme", "label": "Ticker color scheme", "default": "scheme-4" },
    {
      "type": "select",
      "id": "panel_side",
      "label": "Ticker placement",
      "default": "left",
      "options": [
        { "value": "right", "label": "Ticker first" },
        { "value": "left", "label": "Ticker second" }
      ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Ticker top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Ticker bottom padding", "default": 40 },
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "panel_show",
      "label": "Display content",
      "default": "always",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "never", "label": "Never" }
      ]
    },
    { "type": "text", "id": "panel_heading", "label": "Heading", "default": "Vertical ticker" },
    {
      "type": "select",
      "id": "content_heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    { "type": "richtext", "id": "panel_text", "label": "Text", "default": "<p>Talk about features, perks, or benefits of your brand or product.</p>" },
    { "type": "text", "id": "panel_btn", "label": "Button label", "default": "Button label" },
    { "type": "url", "id": "panel_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_secondary", "label": "Use outline button style", "default": false },
    { "type": "image_picker", "id": "content_image", "label": "Background image", "info": "Sits behind the text column. GIFs are supported." },
    { "type": "color", "id": "overlay_color", "label": "Background overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Background overlay opacity", "default": 0 },
    { "type": "range", "id": "content_pad_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Content top padding", "default": 36 },
    { "type": "range", "id": "content_pad_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Content bottom padding", "default": 24 },
    { "type": "header", "content": "Product pages" },
    { "type": "textarea", "id": "gmc_only", "label": "Show only on these product handles", "info": "Comma separated. Leave empty to show on every page." },
    { "type": "textarea", "id": "gmc_hide", "label": "Hide on these product handles", "info": "Comma separated." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "gmc_pad_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Extra space above", "default": 0 },
    { "type": "range", "id": "gmc_pad_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Extra space below", "default": 0 },
    { "type": "range", "id": "gmc_max_width", "min": 0, "max": 1600, "step": 50, "unit": "px", "label": "Max content width (0 = theme default)", "default": 0 },
    { "type": "color", "id": "gmc_bg_color", "label": "Section background colour" },
    { "type": "text", "id": "gmc_bg_gradient", "label": "Section background gradient (CSS)", "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above." },
    { "type": "image_picker", "id": "gmc_bg_image", "label": "Background image" },
    { "type": "video", "id": "gmc_bg_video", "label": "Background video (MP4 upload)" },
    { "type": "range", "id": "gmc_bg_overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Background overlay", "default": 0 },
    { "type": "header", "content": "Add to cart in this section" },
    { "type": "product", "id": "gmc_atc_product", "label": "Add-to-cart product", "info": "Used when the button label below is filled in. Leave empty on a product page to add that product." },
    { "type": "text", "id": "gmc_atc_label", "label": "Add to cart button label", "info": "Leave blank to hide the Add to cart button." },
    { "type": "checkbox", "id": "gmc_atc_skip", "label": "Add to cart button: skip the cart and go to checkout", "default": false },
    { "type": "color_scheme", "id": "gmc_scheme", "label": "Content color scheme", "default": "scheme-4" },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "default": "all",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ]
    },
    { "type": "header", "content": "Section ID and pairing" },
    { "type": "text", "id": "gmc_anchor", "label": "Section ID (for links like #my-id)", "info": "Letters, numbers and dashes. Use this ID in a link to scroll here." },
    { "type": "text", "id": "gmc_pair_with", "label": "Place beside the section with this ID", "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)" },
    { "type": "checkbox", "id": "gmc_pair_rev", "label": "Reverse the pair order on mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Vertical ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping" } },
        { "type": "item", "settings": { "text": "Easy returns" } },
        { "type": "item", "settings": { "text": "Secure checkout" } },
        { "type": "item", "settings": { "text": "Ships today" } }
      ]
    }
  ]
}
{% endschema %}
