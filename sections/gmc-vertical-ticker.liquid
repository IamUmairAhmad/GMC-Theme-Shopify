{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one message block.' -%}{%- endif -%}
<div class="gmc-vtw {% render 'gmc-vis', hide: section.settings.hide_on %}{% if section.settings.panel_heading != blank or section.settings.panel_text != blank or section.settings.panel_btn != blank %} gmc-vtw--panel gmc-vtw--{{ section.settings.panel_side }}{% if section.settings.panel_show == 'desktop' %} gmc-vtw--pd{% elsif section.settings.panel_show == 'never' %} gmc-vtw--pn{% endif %}{% endif %}" style="--bg:{{ section.settings.bg }};--fg:{{ section.settings.fg }};--h:{{ section.settings.height }}px;--rows:{{ section.settings.rows }};--sz:{{ section.settings.size }}px;--fw:{% if section.settings.bold %}700{% else %}400{% endif %};--fs:{% if section.settings.italic %}italic{% else %}normal{% endif %};--tt:{% if section.settings.uppercase %}uppercase{% else %}none{% endif %};--al:{{ section.settings.align }};--speed:{{ section.blocks.size | times: section.settings.seconds }}s;--steps:{{ section.blocks.size | at_least: 1 }}">
  {%- if section.settings.panel_heading != blank or section.settings.panel_text != blank or section.settings.panel_btn != blank -%}
  <div class="gmc-vtw__panel">
    {%- if section.settings.panel_heading != blank -%}<h2 class="h2">{{ section.settings.panel_heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.panel_text != blank -%}<p>{{ section.settings.panel_text | escape }}</p>{%- endif -%}
    {%- if section.settings.panel_btn != blank -%}<a class="button" href="{{ section.settings.panel_link | default: '#' }}">{{ section.settings.panel_btn | escape }}</a>{%- endif -%}
  </div>
  {%- endif -%}
  <div class="gmc-vt gmc-vt--{{ section.settings.motion }}">
    <div class="gmc-vt__track">
      {%- for i in (1..2) -%}{%- for block in section.blocks -%}<div class="gmc-vt__item" {{ block.shopify_attributes }}{% if i == 2 %} aria-hidden="true"{% endif %}>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color:inherit">{%- endif -%}{{ block.settings.text | escape }}{%- if block.settings.link != blank -%}</a>{%- endif -%}</div>{%- endfor -%}{%- endfor -%}
    </div>
  </div>
</div>
<style>@media(max-width:749px){.gmc-vtw--pd .gmc-vtw__panel{display:none}}.gmc-vtw--pn .gmc-vtw__panel{display:none}.gmc-vtw--pn.gmc-vtw--panel{display:block}.gmc-vtw{display:block;background:var(--bg);color:var(--fg)}.gmc-vtw--panel{display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:2rem;padding:2rem}.gmc-vtw--right .gmc-vtw__panel{order:2}.gmc-vtw__panel h2{margin:0 0 1rem;color:var(--fg)}.gmc-vtw__panel p{color:var(--fg)}.gmc-vtw__panel p{margin:0 0 1.2rem}@media(max-width:749px){.gmc-vtw--panel{grid-template-columns:1fr}}
.gmc-vt{height:calc(var(--h) * var(--rows,1));overflow:hidden;text-align:var(--al,center);font-size:var(--sz,16px);font-weight:var(--fw,600);font-style:var(--fs,normal);text-transform:var(--tt,none)}.gmc-vt__item{height:var(--h);line-height:var(--h);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 1rem}
.gmc-vt--step .gmc-vt__track{animation:gmc-vt var(--speed) steps(var(--steps)) infinite}.gmc-vt--smooth .gmc-vt__track{animation:gmc-vt var(--speed) linear infinite}@keyframes gmc-vt{to{transform:translateY(-50%)}}@media(prefers-reduced-motion:reduce){.gmc-vt__track{animation:none!important}}</style>
{% schema %}
{
  "name": "Vertical ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "height",
      "min": 28,
      "max": 120,
      "unit": "px",
      "label": "Row height",
      "default": 40
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Visible rows",
      "default": 1
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Motion",
      "options": [
        {
          "value": "step",
          "label": "Row by row"
        },
        {
          "value": "smooth",
          "label": "Smooth scroll"
        }
      ],
      "default": "step"
    },
    {
      "type": "range",
      "id": "seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Seconds per message",
      "default": 3
    },
    {
      "type": "range",
      "id": "size",
      "min": 11,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "bold",
      "label": "Bold",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "italic",
      "label": "Italic",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Side panel"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "panel_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "panel_btn",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "panel_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "panel_show",
      "label": "Show side content",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "never",
          "label": "Never"
        }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "panel_side",
      "label": "Panel side",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your shipping message"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vertical ticker",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "text": "Your returns message"
          }
        }
      ]
    }
  ]
}
{% endschema %}
