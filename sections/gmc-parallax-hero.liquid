{%- comment -%} GMC Theme: layered hero whose images and text move as the page scrolls. {%- endcomment -%}
{%- render 'gmc-scheme' -%}
{%- liquid
  assign desk_min = '0px'
  if section.settings.desktop_height == 'pixels'
    assign desk_min = section.settings.desktop_height_px | append: 'px'
  elsif section.settings.desktop_height == '100vh'
    assign desk_min = '100vh'
  endif

  assign mob_min = '0px'
  if section.settings.mobile_height == 'pixels'
    assign mob_min = section.settings.mobile_height_px | append: 'px'
  elsif section.settings.mobile_height == '100vh'
    assign mob_min = '100svh'
  endif

  assign lift = '0px'
  if section.settings.transparent_header
    assign lift = 'var(--header-height, 0px)'
  endif

  assign has_mobile_bg = false
  if section.settings.mobile_image != blank or section.settings.mobile_video != blank
    assign has_mobile_bg = true
  endif
  assign has_desktop_bg = false
  if section.settings.desktop_image != blank or section.settings.desktop_video != blank
    assign has_desktop_bg = true
  endif
-%}
{%- style -%}
  #gmc-p3-{{ section.id }} {
    --p3-desk: {{ desk_min }};
    --p3-mob: {{ mob_min }};
    --p3-pad-t: {{ section.settings.padding_top }}px;
    --p3-pad-b: {{ section.settings.padding_bottom }}px;
    --p3-lift: {{ lift }};
    --p3-shade: {{ section.settings.overlay_color }};
    --p3-shade-o: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: block;
    min-height: var(--p3-mob);
  }
  {%- if section.settings.transparent_header -%}
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 0;
      margin-top: calc(-1 * var(--header-height, 0px));
    }
  {%- endif -%}
  @media screen and (min-width: 750px) {
    #gmc-p3-{{ section.id }} { min-height: var(--p3-desk); }
  }
  #gmc-p3-{{ section.id }} .gmc-p3__bg,
  #gmc-p3-{{ section.id }} .gmc-p3__shade,
  #gmc-p3-{{ section.id }} .gmc-p3__imgl {
    position: absolute;
    inset: 0;
  }
  #gmc-p3-{{ section.id }} .gmc-p3__bg img,
  #gmc-p3-{{ section.id }} .gmc-p3__bg video,
  #gmc-p3-{{ section.id }} .gmc-p3__imgl img,
  #gmc-p3-{{ section.id }} .gmc-p3__imgl video,
  #gmc-p3-{{ section.id }} .gmc-p3__imgl svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #gmc-p3-{{ section.id }} .gmc-p3__m { display: none; }
  #gmc-p3-{{ section.id }} .gmc-p3__shade {
    z-index: 1;
    background: var(--p3-shade);
    opacity: var(--p3-shade-o);
    pointer-events: none;
  }
  #gmc-p3-{{ section.id }} .gmc-p3__imgl { pointer-events: none; z-index: calc(var(--z, 1) + 2); }
  #gmc-p3-{{ section.id }} .gmc-p3__content {
    position: relative;
    z-index: calc(var(--z, 0) + 2);
    display: flex;
    align-items: var(--y, center);
    justify-content: var(--x, center);
    text-align: var(--align, center);
    box-sizing: border-box;
    width: 100%;
    min-height: var(--p3-mob);
    padding-top: calc(var(--p3-pad-t) * 0.75 + var(--p3-lift));
    padding-bottom: calc(var(--p3-pad-b) * 0.75);
  }
  #gmc-p3-{{ section.id }} .gmc-p3__content--full {
    max-width: none;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  #gmc-p3-{{ section.id }} .gmc-p3__box {
    width: 100%;
    max-width: var(--box, none);
    padding: 2rem 2.4rem;
    border-radius: var(--text-boxes-radius);
  }
  #gmc-p3-{{ section.id }} .gmc-p3__heading {
    margin: 0;
    line-height: 1.05;
    font-size: var(--h-mob);
  }
  #gmc-p3-{{ section.id }} .gmc-p3__prefix { margin: 0 0 0.6rem; }
  #gmc-p3-{{ section.id }} .gmc-p3__suffix { margin: 0.6rem 0 0; }
  #gmc-p3-{{ section.id }} .gmc-p3__text { margin-top: 1rem; }
  #gmc-p3-{{ section.id }} .gmc-p3__text > :first-child { margin-top: 0; }
  #gmc-p3-{{ section.id }} .gmc-p3__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.6rem;
    justify-content: var(--btn, center);
  }
  @media screen and (max-width: 749px) {
    #gmc-p3-{{ section.id }} .gmc-p3__content {
      align-items: var(--mob-y, var(--y, center));
      text-align: var(--mob-align, var(--align, center));
    }
    #gmc-p3-{{ section.id }} .gmc-p3__btns { justify-content: var(--mob-btn, var(--btn, center)); }
    #gmc-p3-{{ section.id }} .gmc-p3__box--pct { max-width: 100%; }
    #gmc-p3-{{ section.id }} .gmc-p3__split .gmc-p3__d,
    #gmc-p3-{{ section.id }} .gmc-p3__imgl--split .gmc-p3__d { display: none; }
    #gmc-p3-{{ section.id }} .gmc-p3__split .gmc-p3__m,
    #gmc-p3-{{ section.id }} .gmc-p3__imgl--split .gmc-p3__m { display: block; }
    #gmc-p3-{{ section.id }} .gmc-p3__imgl--nm { display: none; }
  }
  @media screen and (min-width: 750px) {
    #gmc-p3-{{ section.id }} .gmc-p3__content {
      min-height: var(--p3-desk);
      padding-top: calc(var(--p3-pad-t) + var(--p3-lift));
      padding-bottom: var(--p3-pad-b);
    }
    #gmc-p3-{{ section.id }} .gmc-p3__content--full { padding-left: 5rem; padding-right: 5rem; }
    #gmc-p3-{{ section.id }} .gmc-p3__heading { font-size: var(--h-desk); }
  }
  @media (prefers-reduced-motion: reduce) {
    #gmc-p3-{{ section.id }} [data-layer] { transform: none !important; }
  }
  {%- if section.settings.transparent_header -%}
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header-wrapper {
      background: transparent !important;
      border-bottom-color: transparent !important;
      box-shadow: none !important;
    }
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header a,
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header summary,
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header button,
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header .h2,
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header .header__icon {
      color: {{ section.settings.header_link_color }} !important;
    }
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header__active-menu-item,
    body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header__menu-item[aria-current='page'] {
      color: {{ section.settings.header_highlight_color }} !important;
      background: {{ section.settings.header_link_color }};
      border-radius: 2rem;
    }
    {%- if section.settings.header_hover_color != blank and section.settings.header_hover_color.alpha > 0 -%}
      body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header a:hover,
      body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header summary:hover {
        color: {{ section.settings.header_hover_color }} !important;
      }
    {%- endif -%}
    {%- if section.settings.header_logo == 'secondary' -%}
      .gmc-logo-light { display: none; }
      body.gmc-p3-clear .section-header:not(.scrolled-past-header) .header__heading-logo { display: none; }
      body.gmc-p3-clear .section-header:not(.scrolled-past-header) .gmc-logo-light { display: block; height: auto; }
    {%- endif -%}
    {%- if section.settings.hide_announcements -%}
      body.gmc-p3-clear .shopify-section-group-header-group .announcement-bar,
      body.gmc-p3-clear .shopify-section-group-header-group .utility-bar,
      body.gmc-p3-clear .shopify-section-group-header-group .gmc-ab-bar { display: none !important; }
    {%- endif -%}
  {%- endif -%}
{%- endstyle -%}

<gmc-parallax-hero
  id="gmc-p3-{{ section.id }}"
  class="gmc-parallax-hero gmc-hero"
  data-clear="{% if section.settings.transparent_header %}true{% else %}false{% endif %}"
>
  {%- if has_desktop_bg or has_mobile_bg -%}
    <div class="gmc-p3__bg{% if has_mobile_bg %} gmc-p3__split{% endif %}">
      {%- if section.settings.desktop_video != blank -%}
        {{ section.settings.desktop_video | video_tag: image_size: '2000x', autoplay: true, loop: true, muted: true, controls: false, class: 'gmc-p3__d' }}
      {%- elsif section.settings.desktop_image != blank -%}
        {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'gmc-p3__d', alt: section.settings.desktop_image.alt }}
      {%- endif -%}
      {%- if section.settings.mobile_video != blank -%}
        {{ section.settings.mobile_video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, class: 'gmc-p3__m' }}
      {%- elsif section.settings.mobile_image != blank -%}
        {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1200', sizes: '100vw', class: 'gmc-p3__m', alt: section.settings.mobile_image.alt }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="gmc-p3__shade" aria-hidden="true">&nbsp;</div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      case b.text_alignment
        when 'left'
          assign btn_x = 'flex-start'
        when 'right'
          assign btn_x = 'flex-end'
        else
          assign btn_x = 'center'
      endcase
      case b.mobile_text_alignment
        when 'left'
          assign mob_btn = 'flex-start'
        when 'right'
          assign mob_btn = 'flex-end'
        else
          assign mob_btn = 'center'
      endcase
      assign box_max = 'none'
      if b.content_width == 'pixels'
        assign box_max = b.content_width_px | append: 'px'
      elsif b.content_width == 'percentage'
        assign box_max = b.content_width_percent | append: '%'
      endif
    -%}
    {%- if block.type == 'content' -%}
      <div
        class="gmc-p3__content{% if b.full_width %} gmc-p3__content--full{% else %} page-width{% endif %}"
        style="--y:{{ b.vertical_position }};--x:{{ b.horizontal_position }};--align:{{ b.text_alignment }};--mob-y:{{ b.mobile_vertical_position }};--mob-align:{{ b.mobile_text_alignment }};--btn:{{ btn_x }};--mob-btn:{{ mob_btn }};--h-desk:{{ b.heading_size }}px;--h-mob:{{ b.heading_size_mobile }}px;--box:{{ box_max }};--z:{{ b.z_index }};"
        data-layer
        data-y="{{ b.scroll_y }}"
        data-x="{{ b.scroll_x }}"
        data-zoom="{{ b.zoom }}"
        data-turn="{{ b.rotation }}"
        {{ block.shopify_attributes }}
      >
        <div class="gmc-p3__box gradient color-{{ b.color_scheme }}{% if b.content_width == 'percentage' %} gmc-p3__box--pct{% endif %}">
          {%- if b.heading_prefix != blank -%}
            <p class="gmc-p3__prefix {{ b.affix_size }}">{{ b.heading_prefix | escape }}</p>
          {%- endif -%}
          {%- if b.heading != blank -%}
            <h2 class="gmc-p3__heading">{{ b.heading | escape }}</h2>
          {%- endif -%}
          {%- if b.heading_suffix != blank -%}
            <p class="gmc-p3__suffix {{ b.affix_size }}">{{ b.heading_suffix | escape }}</p>
          {%- endif -%}
          {%- if b.text != blank -%}
            <div class="gmc-p3__text rte">{{ b.text }}</div>
          {%- endif -%}
          {%- if b.button_label_1 != blank or b.button_label_2 != blank -%}
            <div class="gmc-p3__btns">
              {%- if b.button_label_1 != blank -%}
                <a
                  {% if b.button_link_1 == blank %}role="link" aria-disabled="true"{% else %}href="{{ b.button_link_1 }}"{% endif %}
                  class="button{% if b.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >{{ b.button_label_1 | escape }}</a>
              {%- endif -%}
              {%- if b.button_label_2 != blank -%}
                <a
                  {% if b.button_link_2 == blank %}role="link" aria-disabled="true"{% else %}href="{{ b.button_link_2 }}"{% endif %}
                  class="button{% if b.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >{{ b.button_label_2 | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- elsif block.type == 'image' -%}
      {%- liquid
        assign layer_mobile = false
        if b.image_mobile != blank
          assign layer_mobile = true
        endif
      -%}
      <div
        class="gmc-p3__imgl{% if b.hide_mobile %} gmc-p3__imgl--nm{% endif %}{% if layer_mobile %} gmc-p3__imgl--split{% endif %}"
        style="--z:{{ b.z_index }};"
        data-layer
        data-y="{{ b.scroll_y }}"
        data-x="{{ b.scroll_x }}"
        data-zoom="{{ b.zoom }}"
        data-turn="{{ b.rotation }}"
        {{ block.shopify_attributes }}
      >
        {%- if b.image != blank -%}
          {{ b.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'gmc-p3__d', alt: b.image.alt }}
        {%- elsif request.design_mode -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gmc-p3__d gmc-p3__ph' }}
        {%- endif -%}
        {%- if b.image_mobile != blank -%}
          {{ b.image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1200', sizes: '100vw', class: 'gmc-p3__m', alt: b.image_mobile.alt }}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</gmc-parallax-hero>

{%- render 'gmc-section-extras' -%}

{% javascript %}
  if (!customElements.get('gmc-parallax-hero')) {
    class GmcParallaxHero extends HTMLElement {
      connectedCallback() {
        this.layers = this.querySelectorAll('[data-layer]');
        this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.onScroll = () => {
          if (this.frame) return;
          this.frame = requestAnimationFrame(() => {
            this.frame = 0;
            this.paint();
          });
        };
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll);
        this.paint();
        if (this.dataset.clear === 'true') this.watchHeader();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onScroll);
        if (this.headerTick) {
          window.removeEventListener('scroll', this.headerTick);
          window.removeEventListener('resize', this.headerTick);
          document.body.classList.remove('gmc-p3-clear');
        }
      }

      paint() {
        if (this.motion.matches) {
          this.layers.forEach((layer) => {
            layer.style.transform = '';
          });
          return;
        }
        const rect = this.getBoundingClientRect();
        let travelled = 0;
        if (rect.top < 0) travelled = Math.min(-rect.top, rect.height);
        const progress = rect.height > 0 ? travelled / rect.height : 0;
        this.layers.forEach((layer) => {
          const y = travelled * (Number(layer.dataset.y) / 100);
          const x = Number(layer.dataset.x) * progress;
          const scale = (100 + (Number(layer.dataset.zoom) - 100) * progress) / 100;
          const turn = 3.6 * Number(layer.dataset.turn) * progress;
          layer.style.transform = 'translateY(' + y + 'px) translateX(' + x + '%) scale(' + scale + ') rotate(' + turn + 'deg)';
        });
      }

      watchHeader() {
        const tick = () => {
          const bar = document.querySelector('.section-header');
          if (bar) document.documentElement.style.setProperty('--header-height', bar.offsetHeight + 'px');
          document.body.classList.toggle('gmc-p3-clear', window.scrollY <= 8);
        };
        this.headerTick = tick;
        tick();
        window.addEventListener('scroll', tick, { passive: true });
        window.addEventListener('resize', tick);
      }
    }
    customElements.define('gmc-parallax-hero', GmcParallaxHero);
  }
{% endjavascript %}

{% schema %}
{
  "name": "3D Parallax hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Minimum desktop height",
      "options": [
        { "value": "autofit", "label": "Fit the content" },
        { "value": "pixels", "label": "Fixed pixels" },
        { "value": "100vh", "label": "Full screen" }
      ],
      "default": "pixels"
    },
    {
      "type": "number",
      "id": "desktop_height_px",
      "label": "Desktop minimum height in pixels",
      "default": 600
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Minimum mobile height",
      "options": [
        { "value": "autofit", "label": "Fit the content" },
        { "value": "pixels", "label": "Fixed pixels" },
        { "value": "100vh", "label": "Full screen" }
      ],
      "default": "pixels"
    },
    {
      "type": "number",
      "id": "mobile_height_px",
      "label": "Mobile minimum height in pixels",
      "default": 400
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent header",
      "default": false,
      "info": "Pulls this hero under the header and clears the header background until the page scrolls. Top padding grows by the header height."
    },
    {
      "type": "color",
      "id": "header_link_color",
      "label": "Transparent header links and icons",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "header_highlight_color",
      "label": "Transparent header current link",
      "default": "#121212",
      "info": "Text colour of the current menu item. Its background uses the link colour."
    },
    {
      "type": "color",
      "id": "header_hover_color",
      "label": "Transparent header hovered link"
    },
    {
      "type": "select",
      "id": "header_logo",
      "label": "Transparent header logo",
      "options": [
        { "value": "main", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "main",
      "info": "Secondary uses the header secondary logo, or the secondary logo in theme settings."
    },
    {
      "type": "checkbox",
      "id": "hide_announcements",
      "label": "Hide announcement bars",
      "default": false,
      "info": "Hides announcement bars in the header group while the header is clear."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop background image",
      "info": "Recommended: 2400 × 750 px (2400 px is the widest the theme loads). Tested: full width (1920 px) by 600 px at the default height; the image is cropped to fill, so keep the subject in the centre."
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop background video",
      "info": "Plays in place of the desktop image when a video is selected."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "info": "Recommended: 780 × 800 px (the theme loads up to 1200 px). Tested: 390 × 400 px on phones; the image is cropped to fill, so keep the subject in the centre."
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile background video",
      "info": "Plays in place of the mobile image when a video is selected."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Background overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Background overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "GMC extras"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop."
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Parallax"
        },
        {
          "type": "range",
          "id": "scroll_y",
          "min": -300,
          "max": 300,
          "step": 10,
          "unit": "%",
          "label": "Vertical scrolling",
          "default": 0,
          "info": "0 moves with the page. 100 holds the layer still while the hero scrolls away. Negative values move it up."
        },
        {
          "type": "range",
          "id": "scroll_x",
          "min": -300,
          "max": 300,
          "step": 10,
          "unit": "%",
          "label": "Horizontal scrolling",
