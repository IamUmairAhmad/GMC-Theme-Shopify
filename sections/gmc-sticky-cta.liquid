{%- render 'gmc-scheme' -%}
{%- if section.settings.link != blank -%}<a class="button gmc-scta {% render 'gmc-vis', hide: section.settings.hide_on %}" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>
<style>.gmc-scta{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--gmc-dock,0px) + 1.2rem);z-index:45;box-shadow:0 6px 20px rgba(var(--color-shadow),.25)}</style>{%- endif -%}
{% schema %}
{
  "name": "Sticky CTA",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "Sticky CTA"
    }
  ]
}
{% endschema %}
