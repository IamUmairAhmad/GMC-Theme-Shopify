{%- render 'gmc-scheme' -%}
{%- comment -%} GMC Theme: advanced announcement bar – rotating messages, optional countdown, dismiss button (original code). Add it to the Header group. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="gmc-ab-bar color-{{ section.settings.color_scheme }} gradient {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-abar-{{ section.id }}" role="region" aria-label="Announcements" style="{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}" data-interval="{{ section.settings.interval | times: 1000 }}" data-end="{{ section.settings.countdown_end | escape }}">
  <div class="page-width gmc-ab-bar__in">
    <div class="gmc-ab-bar__msgs">
      {%- for block in section.blocks -%}
        <p class="gmc-ab-bar__m" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          {%- if block.settings.icon_name != blank -%}{%- render 'gmc-icon', name: block.settings.icon_name, size: 18 -%} {% endif -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color:inherit">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    {%- if section.settings.countdown_end != blank -%}<span class="gmc-ab-bar__cd" aria-live="off"></span>{%- endif -%}
    {%- if section.settings.dismissible -%}<button type="button" class="gmc-ab-bar__x" aria-label="Close announcement">×</button>{%- endif -%}
  </div>
</div>
<style>.gmc-ab-bar{position:relative;text-align:center;font-size:{{ section.settings.size }}px}.gmc-ab-bar__in{display:flex;align-items:center;justify-content:center;gap:1.2rem;min-height:3.8rem;padding-top:.6rem;padding-bottom:.6rem}.gmc-ab-bar__m{margin:0}.gmc-ab-bar__m[hidden]{display:none}.gmc-ab-bar__cd{font-variant-numeric:tabular-nums;font-weight:700}.gmc-ab-bar__x{position:absolute;right:1rem;top:50%;transform:translateY(-50%);background:none;border:0;color:inherit;font-size:2.2rem;cursor:pointer;line-height:1}.gmc-ab-bar__x:focus-visible,.gmc-ab-bar a:focus-visible{outline:2px solid currentColor;outline-offset:2px}</style>
<script>(function(){var b=document.getElementById('gmc-abar-{{ section.id }}');if(!b)return;var K='gmc_abar_{{ section.id }}';
try{if(sessionStorage.getItem(K)&&!(window.Shopify&&Shopify.designMode)){b.remove();return;}}catch(e){}
var m=b.querySelectorAll('.gmc-ab-bar__m'),i=0;
if(m.length>1&&!matchMedia('(prefers-reduced-motion:reduce)').matches){setInterval(function(){m[i].hidden=true;i=(i+1)%m.length;m[i].hidden=false;},+b.dataset.interval||5000);}
var x=b.querySelector('.gmc-ab-bar__x');if(x)x.addEventListener('click',function(){b.remove();try{sessionStorage.setItem(K,'1');}catch(e){}});
var cd=b.querySelector('.gmc-ab-bar__cd');if(cd&&b.dataset.end){var end=new Date(b.dataset.end).getTime();function t(){var s=Math.max(0,Math.floor((end-Date.now())/1000));cd.textContent=Math.floor(s/86400)+'d '+String(Math.floor(s%86400/3600)).padStart(2,'0')+':'+String(Math.floor(s%3600/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');}t();setInterval(t,1000);}})();</script>
{%- elsif request.design_mode -%}
<p style="padding:1rem;text-align:center;opacity:.7">Announcement bar: add at least one message block.</p>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar (GMC)",
  "tag": "div",
  "class": "gmc-announcement",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Custom background (optional)"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Custom text color (optional)"
    },
    {
      "type": "range",
      "id": "size",
      "min": 11,
      "max": 20,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 12,
      "unit": "s",
      "label": "Seconds per message",
      "default": 5
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown end (optional)",
      "info": "e.g. 2026-12-31T23:59:00 — shows a live timer beside the message"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow visitors to close it",
      "default": false
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name (optional)",
          "info": "e.g. truck. See assets/gmc-icon-list.txt"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement bar (GMC)",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
