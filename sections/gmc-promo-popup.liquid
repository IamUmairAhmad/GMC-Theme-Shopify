{%- render 'gmc-scheme' -%}
{%- comment -%} GMC Theme: promo popup (original code). Controlled from Theme settings > GMC features > Promo popup. {%- endcomment -%}
{%- assign pg = request.page_type -%}
{%- assign allowed = false -%}
{%- case settings.gmc_popup_pages -%}
  {%- when 'all' -%}{%- assign allowed = true -%}
  {%- when 'index' -%}{%- if pg == 'index' -%}{%- assign allowed = true -%}{%- endif -%}
  {%- when 'product' -%}{%- if pg == 'product' -%}{%- assign allowed = true -%}{%- endif -%}
  {%- when 'collection' -%}{%- if pg == 'collection' -%}{%- assign allowed = true -%}{%- endif -%}
  {%- when 'not_cart' -%}{%- if pg != 'cart' -%}{%- assign allowed = true -%}{%- endif -%}
{%- endcase -%}
{%- if settings.gmc_popup_enabled and pg != 'password' and pg != 'customers/login' and allowed -%}
<div class="gmc-pop gmc-pop--{{ settings.gmc_popup_display }}" id="gmc-pop" hidden role="dialog" aria-modal="true" aria-labelledby="gmc-pop-h" data-trigger="{{ settings.gmc_popup_trigger }}" data-delay="{{ settings.gmc_popup_delay | times: 1000 }}" data-freq="{{ settings.gmc_popup_freq }}" data-preview="{{ settings.gmc_popup_preview }}" data-ok-image="{{ settings.gmc_popup_ok_image | escape }}">
  <div class="gmc-pop__box{% if settings.gmc_popup_image != blank %} gmc-pop__box--img gmc-pop__box--img-{{ settings.gmc_popup_image_side | default: 'start' }}{% endif %}">
    <button type="button" class="gmc-pop__x" data-gmc-close aria-label="Close">×</button>
    {%- if settings.gmc_popup_image != blank -%}<div class="gmc-pop__im">{{ settings.gmc_popup_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
    <div class="gmc-pop__body">
      {%- if settings.gmc_popup_prefix != blank -%}<p class="gmc-pop__pre">{{ settings.gmc_popup_prefix | escape }}</p>{%- endif -%}
      <h2 id="gmc-pop-h" class="{{ settings.gmc_popup_heading_size | default: 'h2' }}">{{ settings.gmc_popup_heading | escape }}</h2>
      {%- if settings.gmc_popup_suffix != blank -%}<p class="gmc-pop__suf">{{ settings.gmc_popup_suffix | escape }}</p>{%- endif -%}
      {%- if settings.gmc_popup_countdown > 0 -%}<p class="gmc-pop__cd" data-minutes="{{ settings.gmc_popup_countdown }}" aria-live="off">--:--</p>{%- endif -%}
      <p>{{ settings.gmc_popup_text | escape }}</p>
      {%- if settings.gmc_popup_mode == 'email' -%}
        {%- form 'customer', class: 'gmc-pop__form', id: 'gmc-pop-form' -%}
          {%- if form.posted_successfully? or settings.gmc_popup_preview == 'success' -%}
            <p role="status" style="font-weight:700" data-gmc-posted>{%- if settings.gmc_popup_ok_heading != blank -%}{{ settings.gmc_popup_ok_heading | escape }}{%- else -%}Thanks for subscribing!{%- endif -%}{% if settings.gmc_popup_ok_text != blank %} {{ settings.gmc_popup_ok_text | escape }}{% endif %}{% if settings.gmc_popup_code != blank %} <span class="gmc-pop__code">{{ settings.gmc_popup_code | escape }}</span> <button type="button" class="gmc-pop__copy" data-gmc-copy="{{ settings.gmc_popup_code | escape }}" data-done="{{ settings.gmc_popup_copied | default: 'Copied' | escape }}"><small>{{ settings.gmc_popup_copy | default: 'Copy' | escape }}</small></button>{% endif %}</p>
          {%- else -%}
            {%- if form.errors -%}<p role="alert" style="color:#b91c1c;margin:0">{{ form.errors | default_errors }}</p>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">
            <label class="visually-hidden" for="gmc-pop-email">{{ section.settings.email_label | escape }}</label>
            <input type="email" id="gmc-pop-email" name="contact[email]" required placeholder="{{ section.settings.email_label | escape }}" autocomplete="email" class="field__input" style="padding:1rem">
            <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
          {%- endif -%}
        {%- endform -%}
      {%- elsif settings.gmc_popup_link != blank -%}
        <a class="button" href="{{ settings.gmc_popup_link | escape }}">{{ settings.gmc_popup_btn | escape }}</a>
      {%- endif -%}
      {%- if settings.gmc_popup_dismiss != blank -%}<button type="button" class="link gmc-pop__dismiss" data-gmc-close>{{ settings.gmc_popup_dismiss | escape }}</button>{%- endif -%}
    </div>
  </div>
</div>
<style>
  .gmc-pop{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:100;display:grid;place-items:center;padding:1.5rem}.gmc-pop[hidden]{display:none}
  .gmc-pop__box{position:relative;background:rgb(var(--color-background));color:rgb(var(--color-foreground));max-width:440px;width:100%;border-radius:var(--text-boxes-radius);overflow:hidden;text-align:center}
  .gmc-pop__box--img{max-width:760px;display:grid;grid-template-columns:1fr 1fr}.gmc-pop__box--img-end .gmc-pop__im{order:2}.gmc-pop__im img{width:100%;height:100%;object-fit:cover;display:block}.gmc-pop__dismiss{margin-top:1rem;background:none;border:0;cursor:pointer;text-decoration:underline}
  .gmc-pop__body{padding:2.5rem 2rem}.gmc-pop__body h2{margin:0 0 .6rem}.gmc-pop__body p{margin:0 0 1rem}
  .gmc-pop__x{position:absolute;top:.4rem;right:.9rem;background:none;border:0;font-size:2.6rem;cursor:pointer;color:inherit;z-index:2;line-height:1}
  .gmc-pop__form{display:grid;gap:.8rem;margin-top:1rem}.gmc-pop__code{display:inline-block;padding:.2rem 1rem;border:2px dashed currentColor;border-radius:var(--text-boxes-radius);letter-spacing:.08em}
  .gmc-pop__pre,.gmc-pop__suf{letter-spacing:.15em;text-transform:uppercase;font-size:1.2rem;opacity:.7}.gmc-pop__cd{font-size:2.4rem;font-weight:700;font-variant-numeric:tabular-nums}.gmc-pop__copy{min-height:44px;min-width:44px;background:none;border:1px solid currentColor;border-radius:4px;color:inherit;cursor:pointer;padding:.1rem .6rem}
  .gmc-pop--side{place-items:end start;background:transparent;pointer-events:none}.gmc-pop--side .gmc-pop__box{pointer-events:auto;box-shadow:0 8px 32px rgba(0,0,0,.3)}
  .gmc-pop--bar{place-items:end center;background:transparent;pointer-events:none;padding:0}.gmc-pop--bar .gmc-pop__box{pointer-events:auto;max-width:100%;border-radius:0;box-shadow:0 -4px 20px rgba(0,0,0,.2)}
  .gmc-pop__box{max-height:calc(100vh - 3rem);max-height:calc(100dvh - 3rem);overflow-y:auto}.gmc-pop__x{min-width:44px;min-height:44px}
  @media(max-width:749px){.gmc-pop__box--img{grid-template-columns:1fr}.gmc-pop__im{max-height:180px}}
</style>
<script>
  (function(){var p=document.getElementById('gmc-pop');if(!p)return;var K='gmc_pop_seen',F=p.dataset.freq,posted=p.querySelector('[data-gmc-posted]');
  var days={session:0,day:1,week:7}[F]||0,now=Date.now();
  function seen(){try{if(localStorage.getItem(K)==='sub')return true;if(days===0)return !!sessionStorage.getItem(K);var t=+localStorage.getItem(K+'_t');return t&&now-t<days*86400000;}catch(e){return false;}}
  function mark(){try{sessionStorage.setItem(K,'1');localStorage.setItem(K+'_t',Date.now());}catch(e){}}
  if(posted && p.dataset.okImage=='false'){var im=p.querySelector('.gmc-pop__im');if(im)im.hidden=true;var box=p.querySelector('.gmc-pop__box');if(box)box.classList.remove('gmc-pop__box--img');}
  var prev=null,cd=p.querySelector('.gmc-pop__cd');if(cd){var cend=Date.now()+(+cd.dataset.minutes)*60000;setInterval(function(){var r=Math.max(0,Math.floor((cend-Date.now())/1000));cd.textContent=String(Math.floor(r/60)).padStart(2,'0')+':'+String(r%60).padStart(2,'0');},1000);}
  function open(){if(!p.hidden)return;prev=document.activeElement;p.hidden=false;var x=p.querySelector('.gmc-pop__x');if(x)x.focus();}
  function close(){p.hidden=true;mark();if(prev&&prev.focus)prev.focus();}
  p.querySelectorAll('[data-gmc-close]').forEach(function(el){el.addEventListener('click',close);});
  p.addEventListener('click',function(e){if(e.target===p)close();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!p.hidden)close();});
  var f=p.querySelector('form');if(f)f.addEventListener('submit',function(){try{localStorage.setItem(K,'sub');}catch(e){}});
  if(posted||p.dataset.preview==='success'||p.dataset.preview==='testing'){open();return;}
  if(seen()||(window.Shopify&&Shopify.designMode))return;
  var tr=p.dataset.trigger,fine=matchMedia('(hover:hover) and (pointer:fine)').matches;
  if(tr==='exit'&&fine){document.addEventListener('mouseout',function h(e){if(!e.relatedTarget&&e.clientY<=0){document.removeEventListener('mouseout',h);open();}});}
  else if(tr==='scroll'){addEventListener('scroll',function h(){if(scrollY>(document.documentElement.scrollHeight-innerHeight)*.5){removeEventListener('scroll',h);open();}},{passive:true});}
  else{setTimeout(open,+p.dataset.delay||8000);}})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Promo Pop-Up",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure under Theme settings > GMC features > Promo popup."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Subscribe button label",
      "default": "Subscribe"
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ]
}
{% endschema %}

