{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one message block.' -%}{%- endif -%}
{%- comment -%} GMC Theme: scrolling announcement ticker (original code) {%- endcomment -%}
<div class="gmc-ticker gmc-ticker-{{ section.id }}" style="--bg:{{ section.settings.bg }};--fg:{{ section.settings.fg }};--speed:{{ section.settings.speed }}s;--size:{{ section.settings.size }}px;--dir:{% if section.settings.reverse %}reverse{% else %}normal{% endif %}">
  <div class="gmc-ticker__track">
    {%- for i in (1..2) -%}
      <div class="gmc-ticker__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="gmc-ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}<span class="gmc-ticker__sep">{{ section.settings.separator | escape }}</span></span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<style>
  .gmc-ticker{background:var(--bg);color:var(--fg);overflow:hidden;white-space:nowrap;font-size:var(--size);padding:.7em 0}
  .gmc-ticker__track{display:flex;width:max-content;animation:gmc-marquee var(--speed) linear infinite;animation-direction:var(--dir)}
  .gmc-ticker:hover .gmc-ticker__track{animation-play-state:paused}
  .gmc-ticker__group{display:flex}
  .gmc-ticker__item{padding:0 1.2em;font-weight:600;letter-spacing:.04em}
  .gmc-ticker__sep{margin-left:2.4em;opacity:.6}
  @keyframes gmc-marquee{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.gmc-ticker__track{animation:none}}
</style>
{% schema %}
{
  "name": "Ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Loop duration",
      "default": 30
    },
    {
      "type": "range",
      "id": "size",
      "min": 11,
      "max": 28,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "✦"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse direction",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $50"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "text": "30-day money-back guarantee"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Secure checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
