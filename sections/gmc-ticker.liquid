{%- capture gmc_gate -%}{%- render 'gmc-gate', only: section.settings.gmc_only, hide: section.settings.gmc_hide -%}{%- endcapture -%}
{%- unless gmc_gate contains 'hide' -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one message block.' -%}{%- endif -%}
{%- comment -%} GMC Theme: scrolling announcement ticker (original code) {%- endcomment -%}
<div class="gmc-ticker gmc-ticker-{{ section.id }}" style="--bg:{{ section.settings.bg }};--fg:{{ section.settings.fg }};--speed:{{ section.settings.speed }}s;--size:{{ section.settings.size }}px;--size-m:{{ section.settings.size_m }}px;--gap:{{ section.settings.gap_d }}px;--gap-m:{{ section.settings.gap_m }}px;--img:{{ section.settings.img_size }}px;--fw:{% if section.settings.bold %}700{% else %}400{% endif %};--fs:{% if section.settings.italic %}italic{% else %}normal{% endif %};--tt:{% if section.settings.uppercase %}uppercase{% else %}none{% endif %};--dir:{% if section.settings.reverse %}reverse{% else %}normal{% endif %}">
  <div class="gmc-ticker__track">
    {%- for i in (1..2) -%}
      <div class="gmc-ticker__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="gmc-ticker__item" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 240 | image_tag: class: 'gmc-ticker__img', loading: 'lazy', alt: block.settings.image.alt | default: '' }}{%- endif -%}{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color:inherit">{%- endif -%}{{ block.settings.text | escape }}{%- if block.settings.link != blank -%}</a>{%- endif -%}<span class="gmc-ticker__sep">{{ section.settings.separator | escape }}</span></span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<style>
  .gmc-ticker{background:var(--bg);color:var(--fg);overflow:hidden;white-space:nowrap;font-size:var(--size);padding:.7em 0}
  .gmc-ticker__track{display:flex;width:max-content;animation:gmc-marquee var(--speed) linear infinite;animation-direction:var(--dir)}
  .gmc-ticker:hover .gmc-ticker__track{animation-play-state:paused}
  .gmc-ticker__group{display:flex}
  .gmc-ticker__item{padding:0 var(--gap,16px);font-weight:var(--fw,600);font-style:var(--fs,normal);text-transform:var(--tt,none);letter-spacing:.04em;display:inline-flex;align-items:center;gap:.6em}.gmc-ticker__img{height:var(--img,28px);width:auto;display:block}@media(max-width:749px){.gmc-ticker{font-size:var(--size-m,12px)}.gmc-ticker__item{padding:0 var(--gap-m,12px)}}
  .gmc-ticker__sep{margin-left:2.4em;opacity:.6}
  @keyframes gmc-marquee{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.gmc-ticker__track{animation:none}}
</style>
{%- endunless -%}
{% schema %}
{
  "name": "Horizontal Ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Loop duration",
      "default": 30
    },
    {
      "type": "range",
      "id": "size",
      "min": 11,
      "max": 28,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "\u2726"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse direction",
      "default": false
    },
    {
      "type": "range",
      "id": "size_m",
      "min": 10,
      "max": 24,
      "unit": "px",
      "label": "Text size on mobile",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "bold",
      "label": "Bold",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "italic",
      "label": "Italic",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "range",
      "id": "img_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Image height",
      "default": 28
    },
    {
      "type": "range",
      "id": "gap_d",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between items (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_m",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between items (mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "color_background",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient",
      "info": "Overrides the colour above when set."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Show only on products"
    },
    {
      "type": "textarea",
      "id": "gmc_only",
      "label": "Show only on these product handles",
      "info": "Comma separated. Leave empty to show everywhere."
    },
    {
      "type": "textarea",
      "id": "gmc_hide",
      "label": "Hide on these product handles",
      "info": "Comma separated."
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop."
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your shipping message"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Horizontal Ticker",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "text": "Your guarantee message"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Secure checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
