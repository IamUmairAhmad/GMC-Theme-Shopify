{%- if settings.gmc_scrolltop -%}
<button type="button" id="gmc-top" aria-label="Scroll to top" hidden>↑</button>
<style>
  #gmc-top{position:fixed;right:1.5rem;bottom:1.5rem;z-index:40;width:44px;height:44px;border-radius:50%;border:0;cursor:pointer;background:rgb(var(--color-foreground));color:rgb(var(--color-background));font-size:20px;box-shadow:0 2px 10px rgba(0,0,0,.25)}
  #gmc-top[hidden]{display:none}
</style>
<script>
  (function(){var b=document.getElementById('gmc-top');if(!b)return;
  window.addEventListener('scroll',function(){b.hidden=window.scrollY<600;},{passive:true});
  b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});})();
</script>
{%- endif -%}
{% schema %}
{ "name": "Scroll to top", "settings": [{"type":"paragraph","content":"Configure under Theme settings > GMC features."}] }
{% endschema %}
