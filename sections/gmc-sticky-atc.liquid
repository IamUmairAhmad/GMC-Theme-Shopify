{%- render 'gmc-scheme' -%}
{%- comment -%} GMC Theme: sticky add-to-cart bar (original code). Add it to the product template. {%- endcomment -%}
{%- if product != blank and settings.gmc_sticky_atc -%}
<div class="gmc-satc" id="gmc-satc" hidden>
  <div class="page-width gmc-satc__in">
    <span class="gmc-satc__name">{{ product.title | escape }}</span>
    <span class="gmc-satc__price" id="gmc-satc-price">{{ product.selected_or_first_available_variant.price | money }}</span>
    <button type="button" class="button" id="gmc-satc-btn">{{ section.settings.label | escape }}</button>
  </div>
</div>
<style>
  .gmc-satc{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgb(var(--color-background));border-top:1px solid rgba(var(--color-foreground),.15);padding:.8rem 0;box-shadow:0 -4px 16px rgba(var(--color-shadow),.08)}
  .gmc-satc[hidden]{display:none}
  .gmc-satc__in{display:flex;align-items:center;gap:1.5rem}.gmc-satc__name{flex:1;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>
<script>
  (function(){var bar=document.getElementById('gmc-satc'),btn=document.getElementById('gmc-satc-btn');
  var form=document.querySelector('product-form form, form[action*="/cart/add"]');if(!bar||!form)return;
  var target=form.querySelector('[type=submit]')||form;
  new IntersectionObserver(function(e){bar.hidden=e[0].isIntersecting||e[0].boundingClientRect.top>0;document.body.classList.toggle('gmc-sticky-on',!bar.hidden);document.documentElement.style.setProperty('--gmc-dock',bar.hidden?'0px':bar.offsetHeight+'px');}).observe(target);
  gmcWhenPubsub(function(){subscribe(PUB_SUB_EVENTS.variantChange,function(ev){var v=ev&&ev.data&&ev.data.variant;var pr=document.getElementById('gmc-satc-price');
  if(!v){btn.disabled=true;return;}
  try{pr.textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:(window.GMC&&GMC.money)||'USD'}).format(v.price/100);}catch(e){}
  btn.disabled=!v.available;btn.textContent=v.available?{{ section.settings.label | json }}:'Sold out';});});
  btn.addEventListener('click',function(){var s=form.querySelector('[type=submit]');if(s&&!s.disabled)s.click();else form.scrollIntoView({behavior:'smooth'});});})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Sticky add to cart",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "Sticky add to cart"
    }
  ]
}
{% endschema %}
