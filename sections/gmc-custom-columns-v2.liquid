{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add column blocks.' -%}{%- endif -%}
<div class="page-width gmc-c2 {% render 'gmc-vis', hide: section.settings.hide_on %}" style="--gap:{{ section.settings.gap }}px">
  <div class="gmc-c2__g">{%- for block in section.blocks -%}
    <div class="gmc-c2__c gmc-c2__c--{{ block.settings.span }}" style="background:{{ block.settings.bg }};color:{{ block.settings.fg }};text-align:{{ block.settings.align }};padding:{{ block.settings.pad }}px;justify-content:{{ block.settings.valign }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', style: 'width:100%;height:auto;border-radius:10px;margin-bottom:1rem' }}{%- endif -%}
      {%- if block.settings.heading != blank -%}<h3 style="margin:0 0 .5rem">{{ block.settings.heading | escape }}</h3>{%- endif -%}
      {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
      {%- if block.settings.link != blank -%}<a class="button" style="margin-top:1rem;align-self:{% if block.settings.align == 'center' %}center{% else %}flex-start{% endif %}" href="{{ block.settings.link }}">{{ block.settings.button | default: 'Shop now' | escape }}</a>{%- endif -%}
    </div>{%- endfor -%}</div>
</div>
<style>.gmc-c2{padding:30px 0}.gmc-c2__g{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--gap)}.gmc-c2__c{display:flex;flex-direction:column;border-radius:var(--text-boxes-radius);grid-column:span 4}.gmc-c2__c--3{grid-column:span 3}.gmc-c2__c--4{grid-column:span 4}.gmc-c2__c--6{grid-column:span 6}.gmc-c2__c--8{grid-column:span 8}.gmc-c2__c--12{grid-column:span 12}@media(max-width:749px){.gmc-c2__c{grid-column:span 12!important}}</style>
{% schema %}
{
  "name": "Custom columns V2",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 20
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "span",
          "label": "Width (of 12)",
          "options": [
            {
              "value": "3",
              "label": "3 (quarter)"
            },
            {
              "value": "4",
              "label": "4 (third)"
            },
            {
              "value": "6",
              "label": "6 (half)"
            },
            {
              "value": "8",
              "label": "8 (two thirds)"
            },
            {
              "value": "12",
              "label": "12 (full)"
            }
          ],
          "default": "4"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#F4F1EB"
        },
        {
          "type": "color",
          "id": "fg",
          "label": "Text",
          "default": "#121212"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Text align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "valign",
          "label": "Vertical align",
          "options": [
            {
              "value": "flex-start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "flex-end",
              "label": "Bottom"
            }
          ],
          "default": "flex-start"
        },
        {
          "type": "range",
          "id": "pad",
          "min": 0,
          "max": 60,
          "step": 4,
          "unit": "px",
          "label": "Padding",
          "default": 24
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom columns V2",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "span": "8"
          }
        },
        {
          "type": "column",
          "settings": {
            "span": "4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
