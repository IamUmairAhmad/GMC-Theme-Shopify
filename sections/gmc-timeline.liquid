{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one step block.' -%}{%- endif -%}
<div class="page-width gmc-tl {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <ol class="gmc-tl__list">{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span class="gmc-tl__dot">{{ forloop.index }}</span><div><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.text | escape }}</p></div></li>{%- endfor -%}</ol>
</div>
<style>.gmc-tl{padding:36px 0}.gmc-tl__list{list-style:none;max-width:640px;margin:1.5rem auto 0;padding:0;border-left:2px solid rgba(var(--color-foreground),.2)}.gmc-tl__list li{display:flex;gap:1.2rem;position:relative;left:-17px;margin-bottom:2rem}.gmc-tl__dot{flex:none;width:32px;height:32px;border-radius:50%;background:rgb(var(--color-foreground));color:rgb(var(--color-background));display:grid;place-items:center;font-weight:700}.gmc-tl__list p{margin:.2rem 0 0;opacity:.8}</style>
{% schema %}
{
 "name": "Timeline",
 "tag": "section",
 "class": "section",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "How it works"
  },
  {
   "type": "select",
   "id": "hide_on",
   "label": "Hide on",
   "options": [
    {
     "value": "",
     "label": "Show everywhere"
    },
    {
     "value": "mobile",
     "label": "Mobile"
    },
    {
     "value": "desktop",
     "label": "Desktop"
    }
   ],
   "default": ""
  },
  {
   "type": "header",
   "content": "Layout (GMC)"
  },
  {
   "type": "range",
   "id": "gmc_pad_top",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space above",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_pad_bottom",
   "min": 0,
   "max": 160,
   "step": 4,
   "unit": "px",
   "label": "Extra space below",
   "default": 0
  },
  {
   "type": "range",
   "id": "gmc_max_width",
   "min": 0,
   "max": 1600,
   "step": 50,
   "unit": "px",
   "label": "Max content width (0 = theme default)",
   "default": 0
  },
  {
   "type": "color",
   "id": "gmc_bg_color",
   "label": "Section background color"
  },
  {
   "type": "image_picker",
   "id": "gmc_bg_image",
   "label": "Background image"
  },
  {
   "type": "video",
   "id": "gmc_bg_video",
   "label": "Background video (MP4 upload)"
  },
  {
   "type": "range",
   "id": "gmc_bg_overlay",
   "min": 0,
   "max": 80,
   "step": 5,
   "unit": "%",
   "label": "Background overlay",
   "default": 0
  }
 ],
 "blocks": [
  {
   "type": "step",
   "name": "Step",
   "settings": [
    {
     "type": "text",
     "id": "title",
     "label": "Title",
     "default": "Order"
    },
    {
     "type": "textarea",
     "id": "text",
     "label": "Text",
     "default": "Place your order online."
    }
   ]
  }
 ],
 "max_blocks": 10,
 "presets": [
  {
   "name": "Timeline",
   "blocks": [
    {
     "type": "step"
    },
    {
     "type": "step",
     "settings": {
      "title": "Ship",
      "text": "We ship in 24 hours."
     }
    },
    {
     "type": "step",
     "settings": {
      "title": "Enjoy",
      "text": "Delivered to your door."
     }
    }
   ]
  }
 ]
}
{% endschema %}
