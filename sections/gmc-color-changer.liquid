{%- render 'gmc-scheme' -%}
{%- comment -%} Per-page color changer: add this section to any page/template to recolor that page only. {%- endcomment -%}
{%- assign bg = section.settings.bg | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign fg = section.settings.fg | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign ac = section.settings.accent | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign bt = section.settings.button_text | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
<style>
  body,[class*="color-"]{--color-background:{{ bg }};--color-foreground:{{ fg }};--color-button:{{ ac }};--color-button-text:{{ bt }};--color-link:{{ ac }};--color-base-background-1:{{ bg }};--color-base-text:{{ fg }};--gradient-background:{{ section.settings.bg }}}
  body{background:{{ section.settings.bg }}}
  [class*="color-"].gradient{background:{{ section.settings.bg }}}
</style>
{% schema %}
{
  "name": "Page color changer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recolors the whole page this section is on."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons / links",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Page color changer"
    }
  ]
}
{% endschema %}
