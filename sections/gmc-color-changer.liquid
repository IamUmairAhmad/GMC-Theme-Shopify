{%- render 'gmc-scheme' -%}
{%- comment -%} Per-page color changer: add this section to any page/template to recolor that page only. {%- endcomment -%}
{%- assign bg = section.settings.bg | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign fg = section.settings.fg | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign ac = section.settings.accent | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign bt = section.settings.button_text | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- if section.settings.outline != blank -%}
  {%- assign ol = section.settings.outline | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- endif -%}
<style>
  body,[class*="color-"]{--color-background:{{ bg }};--color-foreground:{{ fg }};--color-button:{{ ac }};--color-button-text:{{ bt }};--color-secondary-button:{{ bg }};--color-link:{% if ol != blank %}{{ ol }}{% else %}{{ ac }}{% endif %};--color-badge-foreground:{{ fg }};--color-badge-background:{{ bg }};--color-badge-border:{{ fg }};{% if ol != blank %}--color-secondary-button-text:{{ ol }};{% endif %}--gradient-background:{% if section.settings.gradient != blank %}{{ section.settings.gradient }}{% else %}{{ section.settings.bg }}{% endif %}}
  body{background:{% if section.settings.gradient != blank %}{{ section.settings.gradient }}{% else %}{{ section.settings.bg }}{% endif %}}
  [class*="color-"].gradient{background:{% if section.settings.gradient != blank %}{{ section.settings.gradient }}{% else %}{{ section.settings.bg }}{% endif %}}
</style>
{% schema %}
{
  "name": "Page color changer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recolors the whole page this section is on."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Buttons / links",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "outline",
      "label": "Outline buttons and links",
      "info": "Leave empty to use the buttons colour for links."
    },
    {
      "type": "color_background",
      "id": "gradient",
      "label": "Background gradient"
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "Page color changer"
    }
  ]
}
{% endschema %}
