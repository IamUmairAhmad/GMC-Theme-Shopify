{%- comment -%} Recolors this page only. Place it first so the new colours are in place before the rest of the page paints. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ink = s.fg
  assign paper = s.bg
  assign accent = s.accent
  assign on_accent = s.button_text
  assign outline = s.outline
  if outline == blank
    assign outline = accent
  endif
  assign accent_2 = s.accent_2
  if accent_2 == blank
    assign accent_2 = accent
  endif
  assign surface_2 = s.surface_2
  if surface_2 == blank
    assign surface_2 = paper
  endif

  assign paper_bg = paper
  if s.gradient != blank
    assign paper_try = s.gradient
    if paper_try contains 'gradient('
      unless paper_try contains ';' or paper_try contains '<'
        assign paper_bg = paper_try
      endunless
    endif
  endif
  assign accent_bg = accent
  if s.accent_gradient != blank
    assign accent_try = s.accent_gradient
    if accent_try contains 'gradient('
      unless accent_try contains ';' or accent_try contains '<'
        assign accent_bg = accent_try
      endunless
    endif
  endif
  assign accent_2_bg = accent_2
  if s.accent_2_gradient != blank
    assign accent_2_try = s.accent_2_gradient
    if accent_2_try contains 'gradient('
      unless accent_2_try contains ';' or accent_2_try contains '<'
        assign accent_2_bg = accent_2_try
      endunless
    endif
  endif
  assign surface_2_bg = surface_2
  if s.surface_2_gradient != blank
    assign surface_2_try = s.surface_2_gradient
    if surface_2_try contains 'gradient('
      unless surface_2_try contains ';' or surface_2_try contains '<'
        assign surface_2_bg = surface_2_try
      endunless
    endif
  endif

  assign bright = paper | color_brightness
  if bright <= 26
    assign contrast = paper | color_lighten: 50
  elsif bright <= 65
    assign contrast = paper | color_lighten: 5
  else
    assign contrast = paper | color_darken: 25
  endif
-%}
<style>
  {%- if s.gmc_display_on == 'mobile' -%}@media (max-width: 749px) { {%- elsif s.gmc_display_on == 'desktop' -%}@media (min-width: 750px) { {%- endif -%}
  :root {
    --gmc-a1: {{ accent.red }},{{ accent.green }},{{ accent.blue }};
    --gmc-a2: {{ accent_2.red }},{{ accent_2.green }},{{ accent_2.blue }};
    --gmc-s1: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --gmc-s2: {{ surface_2.red }},{{ surface_2.green }},{{ surface_2.blue }};
    --gmc-ink: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --gmc-on: {{ on_accent.red }},{{ on_accent.green }},{{ on_accent.blue }};
    --gmc-outline: {{ outline.red }},{{ outline.green }},{{ outline.blue }};
    --gmc-a1-bg: {{ accent_bg }};
    --gmc-a2-bg: {{ accent_2_bg }};
    --gmc-s1-bg: {{ paper_bg }};
    --gmc-s2-bg: {{ surface_2_bg }};
    --color-background: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --gradient-background: {{ paper_bg }};
    --color-foreground: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-background-contrast: {{ contrast.red }},{{ contrast.green }},{{ contrast.blue }};
    --color-shadow: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-button: {{ accent.red }},{{ accent.green }},{{ accent.blue }};
    --color-button-text: {{ on_accent.red }},{{ on_accent.green }},{{ on_accent.blue }};
    --color-secondary-button: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --color-secondary-button-text: {{ outline.red }},{{ outline.green }},{{ outline.blue }};
    --color-link: {{ outline.red }},{{ outline.green }},{{ outline.blue }};
    --color-badge-foreground: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-badge-background: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --color-badge-border: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --payment-terms-background-color: rgb({{ paper.rgb }});
  }
  {%- for scheme in settings.color_schemes -%}
  .color-{{ scheme.id }},
  .shopify-section:has(> .gmc-sch-{{ scheme.id }}) {
    --color-background: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --gradient-background: {{ paper_bg }};
    --color-foreground: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-background-contrast: {{ contrast.red }},{{ contrast.green }},{{ contrast.blue }};
    --color-shadow: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-button: {{ accent.red }},{{ accent.green }},{{ accent.blue }};
    --color-button-text: {{ on_accent.red }},{{ on_accent.green }},{{ on_accent.blue }};
    --color-secondary-button: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --color-secondary-button-text: {{ outline.red }},{{ outline.green }},{{ outline.blue }};
    --color-link: {{ outline.red }},{{ outline.green }},{{ outline.blue }};
    --color-badge-foreground: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --color-badge-background: {{ paper.red }},{{ paper.green }},{{ paper.blue }};
    --color-badge-border: {{ ink.red }},{{ ink.green }},{{ ink.blue }};
    --payment-terms-background-color: rgb({{ paper.rgb }});
    background: {{ paper_bg }};
    color: rgba({{ ink.red }},{{ ink.green }},{{ ink.blue }}, 0.75);
  }
  {%- endfor -%}
  body {
    background: {{ paper_bg }};
    color: rgba({{ ink.red }},{{ ink.green }},{{ ink.blue }}, 0.75);
  }
  a { color: rgb({{ outline.red }},{{ outline.green }},{{ outline.blue }}); }
  .color-accent-1 a:not(.button),
  .color-accent-2 a:not(.button),
  .color-inverse a:not(.button) { color: rgb(var(--color-link)); }
  {%- if accent_bg != accent -%}
  .button:not(.button--secondary):not(.button--tertiary) {
    background-color: transparent;
    background-image: {{ accent_bg }};
  }
  .color-accent-1 .button:not(.button--secondary):not(.button--tertiary),
  .color-accent-2 .button:not(.button--secondary):not(.button--tertiary),
  .color-inverse .button:not(.button--secondary):not(.button--tertiary) {
    background-color: rgba(var(--color-button), var(--alpha-button-background));
    background-image: none;
  }
  {%- endif -%}
  .rating-star.color-icon-accent-1 { --color-rating-star: rgb({{ accent.red }},{{ accent.green }},{{ accent.blue }}); }
  .rating-star.color-icon-accent-2 { --color-rating-star: rgb({{ accent_2.red }},{{ accent_2.green }},{{ accent_2.blue }}); }
  .rating-star.color-icon-outline { --color-rating-star: rgb({{ outline.red }},{{ outline.green }},{{ outline.blue }}); }
  {%- if settings.gmc_pill_accent == blank and settings.gmc_pill_scheme != blank and settings.gmc_pill_scheme != 'foreground' -%}
    {%- liquid
      case settings.gmc_pill_scheme
        when 'accent-1'
          assign page_pill = accent
        when 'accent-2'
          assign page_pill = accent_2
        when 'outline'
          assign page_pill = outline
        else
          assign page_pill = ink
      endcase
    -%}
    .product-form__input input[type='radio']:checked + label,
    .product-form__input input[type='radio']:checked + label.gmc-vcard {
      background: {{ page_pill }} !important;
      border-color: {{ page_pill }} !important;
      color: {{ on_accent }} !important;
    }
  {%- endif -%}
  {%- if settings.gmc_dd_border == blank and settings.gmc_dd_border_scheme != blank and settings.gmc_dd_border_scheme != 'custom' -%}
    {%- liquid
      case settings.gmc_dd_border_scheme
        when 'accent-1'
          assign page_line = accent
        when 'accent-2'
          assign page_line = accent_2
        when 'background-1'
          assign page_line = paper
        when 'background-2'
          assign page_line = surface_2
        else
          assign page_line = ink
      endcase
      if settings.gmc_dd_border_o < 100
        assign page_line_a = settings.gmc_dd_border_o | divided_by: 100.0
        assign page_line = page_line | color_modify: 'alpha', page_line_a
      endif
    -%}
    .product-form__input--dropdown .select__select,
    select.gmc-sec-atc__v { border: {{ settings.gmc_dd_thick }}px solid {{ page_line }} !important; }
  {%- endif -%}
  {%- if settings.gmc_dd_text == blank and settings.gmc_dd_text_scheme != blank and settings.gmc_dd_text_scheme != 'custom' -%}
    {%- liquid
      case settings.gmc_dd_text_scheme
        when 'accent-1'
          assign page_dd_ink = accent
        when 'accent-2'
          assign page_dd_ink = accent_2
        when 'background-1'
          assign page_dd_ink = paper
        when 'background-2'
          assign page_dd_ink = surface_2
        else
          assign page_dd_ink = ink
      endcase
    -%}
    .product-form__input--dropdown .select__select,
    .product-form__input--dropdown .select .svg-wrapper,
    select.gmc-sec-atc__v { color: {{ page_dd_ink }} !important; }
  {%- endif -%}
  {%- if settings.gmc_dd_overlay == blank and settings.gmc_dd_tint_scheme != blank and settings.gmc_dd_tint_scheme != 'custom' and settings.gmc_dd_overlay_o > 0 -%}
    {%- liquid
      case settings.gmc_dd_tint_scheme
        when 'accent-1'
          assign page_tint = accent
        when 'accent-2'
          assign page_tint = accent_2
        when 'background-1'
          assign page_tint = paper
        when 'background-2'
          assign page_tint = surface_2
        else
          assign page_tint = ink
      endcase
      assign page_tint_a = settings.gmc_dd_overlay_o | divided_by: 100.0
      assign page_tint = page_tint | color_modify: 'alpha', page_tint_a
    -%}
    .product-form__input--dropdown .select__select,
    select.gmc-sec-atc__v { background-image: linear-gradient({{ page_tint }}, {{ page_tint }}); }
  {%- endif -%}
  {%- if s.gmc_display_on == 'mobile' or s.gmc_display_on == 'desktop' -%} } {%- endif -%}
  #shopify-section-{{ section.id }} { display: none !important; }
</style>
{% schema %}
{
  "name": "Store colors changer",
  "limit": 1,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Changes the store colours on this page only."
    },
    {
      "type": "header",
      "content": "Important"
    },
    {
      "type": "paragraph",
      "content": "Place this section at the top of the page so the new colours are ready before the rest of the page paints."
    },
    {
      "type": "header",
      "content": "Accent"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Solid button labels",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent 1",
      "info": "Buttons, links when outline is empty, and accent 1 surfaces.",
      "default": "#121212"
    },
    {
      "type": "color_background",
      "id": "accent_gradient",
      "label": "Accent 1 gradient"
    },
    {
      "type": "color",
      "id": "accent_2",
      "label": "Accent 2",
      "default": "#121212"
    },
    {
      "type": "color_background",
      "id": "accent_2_gradient",
      "label": "Accent 2 gradient"
    },
    {
      "type": "header",
      "content": "Text and backgrounds"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "outline",
      "label": "Outline button labels",
      "info": "Also used for links. Leave empty to use accent 1."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background 1",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "gradient",
      "label": "Background 1 gradient"
    },
    {
      "type": "color",
      "id": "surface_2",
      "label": "Background 2",
      "default": "#F3F3F3"
    },
    {
      "type": "color_background",
      "id": "surface_2_gradient",
      "label": "Background 2 gradient"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Apply on",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "Store colors changer"
    }
  ]
}
{% endschema %}
