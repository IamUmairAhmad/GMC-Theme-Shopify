{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add icon blocks.' -%}{%- endif -%}
{%- comment -%} GMC Theme: icons with content (original code) {%- endcomment -%}
<div class="gmc-ic color-{{ section.settings.scheme }} gradient {% render 'gmc-vis', hide: section.settings.hide_on %}">
  <div class="page-width gmc-ic__in gmc-ic__in--{{ section.settings.media_side }}" style="padding-top:{{ section.settings.pad }}px;padding-bottom:{{ section.settings.pad }}px">
    <div class="gmc-ic__text">
      {%- if section.settings.caption != blank -%}<p class="gmc-ic__cap">{{ section.settings.caption | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="gmc-ic__list" role="list" style="--ic:{{ section.settings.icon_color }}">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="gmc-ic__i" style="width:{{ section.settings.icon_size | plus: 12 }}px;height:{{ section.settings.icon_size | plus: 12 }}px">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: width: section.settings.icon_size, height: section.settings.icon_size, alt: '', loading: 'lazy' }}{%- else -%}{%- render 'gmc-icon', name: block.settings.icon_name, size: section.settings.icon_size -%}{%- endif -%}</span>
            <span><strong>{{ block.settings.title | escape }}</strong>{%- if block.settings.text != blank -%}<br><span class="gmc-ic__d">{{ block.settings.text | escape }}</span>{%- endif -%}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button != blank -%}<a class="button" href="{{ section.settings.link | default: '#' }}">{{ section.settings.button | escape }}</a>{%- endif -%}
    </div>
    {%- if section.settings.video != blank or section.settings.image != blank -%}
    <div class="gmc-ic__media">
      {%- if section.settings.video != blank -%}<div class="gmc-pm__vid" data-gmc-vid><video playsinline preload="metadata" autoplay muted loop {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1200 }}"{% endif %}>{%- for vs in section.settings.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video></div>
      {%- else -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', alt: section.settings.image.alt }}{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</div>
<style>.gmc-ic__in{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}.gmc-ic__in--left .gmc-ic__media{order:-1}.gmc-ic__media img,.gmc-ic__media video{width:100%;height:auto;display:block;border-radius:var(--media-radius,8px)}.gmc-ic__cap{letter-spacing:.15em;text-transform:uppercase;font-size:1.2rem;opacity:.7;margin:0 0 .6rem}.gmc-ic__list{list-style:none;margin:1.6rem 0;padding:0;display:grid;gap:1.2rem}.gmc-ic__list li{display:flex;gap:1.2rem;align-items:center}.gmc-ic__i{display:grid;place-items:center;border-radius:50%;background:rgba(var(--color-foreground),.08);color:var(--ic,currentColor);flex:none}.gmc-ic__d{opacity:.75;font-size:1.4rem}@media(max-width:749px){.gmc-ic__in{grid-template-columns:1fr}.gmc-ic__in--left .gmc-ic__media{order:0}}</style>
{% schema %}
{
  "name": "Icons with content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explain your promise in a sentence or two.</p>"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (also used as video poster)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (MP4 upload)"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Media side",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top and bottom",
      "default": 36
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product"
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Go straight to checkout",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon item",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name",
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Or icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icons with content",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
