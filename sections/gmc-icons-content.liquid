{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add icon blocks.' -%}{%- endif -%}
{%- comment -%} GMC Theme: icons with content (original code) {%- endcomment -%}
<div class="gmc-ic color-{{ section.settings.scheme }} gradient {% render 'gmc-vis', hide: section.settings.hide_on %}">
  <div class="page-width gmc-ic__in gmc-ic__in--{{ section.settings.media_side }}" style="padding-top:{{ section.settings.pad }}px;padding-bottom:{{ section.settings.pad }}px">
    <div class="gmc-ic__text">
      {%- if section.settings.caption != blank -%}<p class="gmc-ic__cap">{{ section.settings.caption | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      <div class="gmc-ic__flow gmc-ic__list--{{ section.settings.icon_pos }}" style="--ic:{{ section.settings.icon_color }};--icc:{{ section.settings.cols }};--iccm:{{ section.settings.cols_m }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="gmc-ic__wide" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- when 'caption' -%}
              <p class="gmc-ic__cap gmc-ic__wide" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }}</p>
            {%- when 'text' -%}
              <div class="rte gmc-ic__wide" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              <div class="gmc-ic__wide" {{ block.shopify_attributes }}><a class="button{% if block.settings.secondary %} button--secondary{% endif %}" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a></div>
            {%- when 'atc_button' -%}
              {%- liquid
                assign ic_product = block.settings.product
                if ic_product == blank
                  assign ic_product = product
                endif
              -%}
              <div class="gmc-ic__wide" {{ block.shopify_attributes }}>{%- render 'gmc-inline-atc', product: ic_product, label: block.settings.label, skip: block.settings.skip, align: 'left' -%}</div>
            {%- when 'image' -%}
              <div class="gmc-ic__wide" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', alt: block.settings.image.alt }}{%- endif -%}
                {%- if block.settings.product != blank -%}{%- render 'gmc-inline-atc', product: block.settings.product, label: block.settings.label, skip: block.settings.skip, align: 'left' -%}{%- endif -%}
              </div>
            {%- when 'video' -%}
              {%- if block.settings.video != blank -%}
                <div class="gmc-ic__wide gmc-ic__clip" {{ block.shopify_attributes }}><video playsinline autoplay muted loop preload="metadata">{%- for vs in block.settings.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video></div>
              {%- endif -%}
            {%- else -%}
              <div class="gmc-ic__row" {{ block.shopify_attributes }}>
                <span class="gmc-ic__i" style="width:{{ section.settings.icon_size | plus: 12 }}px;height:{{ section.settings.icon_size | plus: 12 }}px">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: width: section.settings.icon_size, height: section.settings.icon_size, alt: '', loading: 'lazy' }}{%- else -%}{%- render 'gmc-icon', name: block.settings.icon_name, size: section.settings.icon_size, filled: block.settings.filled -%}{%- endif -%}</span>
                <span><strong>{{ block.settings.title | escape }}</strong>{%- if block.settings.text != blank -%}<br><span class="gmc-ic__d">{{ block.settings.text | escape }}</span>{%- endif -%}</span>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.button != blank -%}<a class="button" href="{{ section.settings.link | default: '#' }}">{{ section.settings.button | escape }}</a>{%- endif -%}
    </div>
    {%- if section.settings.video != blank or section.settings.image != blank -%}
    <div class="gmc-ic__media">
      {%- if section.settings.video != blank -%}<div class="gmc-pm__vid" data-gmc-vid><video playsinline preload="metadata" autoplay muted loop {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1200 }}"{% endif %}>{%- for vs in section.settings.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video></div>
      {%- else -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', alt: section.settings.image.alt }}{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</div>
<style>.gmc-ic__list{grid-template-columns:repeat(var(--icc,1),1fr)}.gmc-ic__list--above .gmc-ic__row{flex-direction:column;text-align:center}.gmc-ic__list--text .gmc-ic__row{align-items:flex-start}.gmc-ic__in{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}.gmc-ic__in--left .gmc-ic__media{order:-1}.gmc-ic__media img,.gmc-ic__media video{width:100%;height:auto;display:block;border-radius:var(--media-radius,8px)}.gmc-ic__cap{letter-spacing:.15em;text-transform:uppercase;font-size:1.2rem;opacity:.7;margin:0 0 .6rem}.gmc-ic__flow{margin:1.6rem 0;display:grid;grid-template-columns:repeat(var(--icc,1),minmax(0,1fr));gap:1.2rem}.gmc-ic__wide{grid-column:1 / -1}.gmc-ic__row{display:flex;gap:1.2rem;align-items:center}.gmc-ic__clip video,.gmc-ic__wide img{width:100%;height:auto;display:block;border-radius:var(--media-radius,8px)}@media(max-width:749px){.gmc-ic__flow{grid-template-columns:repeat(var(--iccm,1),minmax(0,1fr))}}.gmc-ic__i{display:grid;place-items:center;border-radius:50%;background:rgba(var(--color-foreground),.08);color:var(--ic,currentColor);flex:none}.gmc-ic__d{opacity:.75;font-size:1.4rem}@media(max-width:749px){.gmc-ic__in{grid-template-columns:1fr}.gmc-ic__in--left .gmc-ic__media{order:0}}</style>
{% schema %}
{
  "name": "Icons with content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explain your promise in a sentence or two.</p>"
    },
    {
      "type": "select",
      "id": "icon_pos",
      "label": "Icon position",
      "options": [
        {
          "value": "side",
          "label": "Next to title and text"
        },
        {
          "value": "above",
          "label": "Above title"
        },
        {
          "value": "text",
          "label": "Next to text, aligned to top"
        }
      ],
      "default": "side"
    },
    {
      "type": "select",
      "id": "cols",
      "label": "Icon columns (desktop)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "select",
      "id": "cols_m",
      "label": "Icon columns (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (also used as video poster)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (MP4 upload)"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Media side",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top and bottom",
      "default": 36
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product"
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Go straight to checkout",
      "default": false
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon item",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon name",
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Or icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "checkbox",
          "id": "filled",
          "label": "Filled icon",
          "default": false
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Why shoppers choose it"
        }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Details"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tell the story beside the icons.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "secondary",
          "label": "Outline style",
          "default": false
        }
      ]
    },
    {
      "type": "atc_button",
      "name": "Add to cart",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "On a product page, leave this empty to use that product."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "checkbox",
          "id": "skip",
          "label": "Go straight to checkout",
          "default": false
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Add this product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Add to cart"
        },
        {
          "type": "checkbox",
          "id": "skip",
          "label": "Go straight to checkout",
          "default": false
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icons with content",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
