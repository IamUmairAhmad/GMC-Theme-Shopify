      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 0,
      "info": "0 uses the desktop column gap."
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 50,
