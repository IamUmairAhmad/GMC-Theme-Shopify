{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'columns', title: 'Column blocks' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add a heading, text, icon, image, or another block.' -%}{%- endif -%}
{%- liquid
  assign cols = section.settings.columns
  assign dcount = 0
  if cols >= 1 and section.settings.col_1_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if cols >= 2 and section.settings.col_2_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if cols >= 3 and section.settings.col_3_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if cols >= 4 and section.settings.col_4_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if cols >= 5 and section.settings.col_5_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if cols >= 6 and section.settings.col_6_show != 'mobile'
    assign dcount = dcount | plus: 1
  endif
  if dcount == 0
    assign dcount = cols
  endif
  assign row_gap = section.settings.row_gap
  if row_gap == 0
    assign row_gap = section.settings.gap
  endif
  assign gap_m = section.settings.gap_mobile
  if gap_m == 0
    assign gap_m = section.settings.gap
  endif
  assign row_m = section.settings.row_gap_mobile
  if row_m == 0
    assign row_m = row_gap
  endif
-%}
<div class="page-width gmc-cb color-{{ section.settings.color_scheme }} gradient" style="--cb-cols:{{ cols }};--cb-d:{{ dcount }};--cb-gap:{{ section.settings.gap }}px;--cb-row:{{ row_gap }}px;--cb-gap-m:{{ gap_m }}px;--cb-row-m:{{ row_m }}px;--cb-align:{{ section.settings.valign }};--cb-align-m:{{ section.settings.valign_mobile }}">
  <div class="gmc-cb__grid{% if section.settings.custom_widths %} gmc-cb__grid--parts{% endif %}">
    {%- for i in (1..6) -%}
      {%- if i <= cols -%}
        {%- liquid
          case i
            when 1
              assign span_d = section.settings.col_1_desktop
              assign span_m = section.settings.col_1_mobile
              assign cshow = section.settings.col_1_show
            when 2
              assign span_d = section.settings.col_2_desktop
              assign span_m = section.settings.col_2_mobile
              assign cshow = section.settings.col_2_show
            when 3
              assign span_d = section.settings.col_3_desktop
              assign span_m = section.settings.col_3_mobile
              assign cshow = section.settings.col_3_show
            when 4
              assign span_d = section.settings.col_4_desktop
              assign span_m = section.settings.col_4_mobile
              assign cshow = section.settings.col_4_show
            when 5
              assign span_d = section.settings.col_5_desktop
              assign span_m = section.settings.col_5_mobile
              assign cshow = section.settings.col_5_show
            else
              assign span_d = section.settings.col_6_desktop
              assign span_m = section.settings.col_6_mobile
              assign cshow = section.settings.col_6_show
          endcase
        -%}
        <div class="gmc-cb__col{% if cshow == 'desktop' %} gmc-cb__col--desk{% elsif cshow == 'mobile' %} gmc-cb__col--mob{% endif %}"{% if section.settings.custom_widths %} style="--dspan:{{ span_d }};--mspan:{{ span_m }}"{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign cb_col = block.settings.column | plus: 0 -%}
            {%- if cb_col == i -%}
              <div class="gmc-cb__b gmc-cb__b--{{ block.settings.align | default: 'left' }}{% if block.settings.full_width %} gmc-cb__b--wide{% endif %} {% render 'gmc-vis', hide: block.settings.hide_on %}"{% if block.settings.mobile_align != blank %} data-ma="{{ block.settings.mobile_align }}"{% endif %} style="margin-top:{{ block.settings.margin_top | default: 0 }}px;margin-bottom:{{ block.settings.margin_bottom | default: 0 }}px" {{ block.shopify_attributes }}>
                {%- render 'gmc-column-block', block: block -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<style>
  .gmc-cb{padding:36px 0}
  .gmc-cb__grid{display:grid;grid-template-columns:repeat(var(--cb-d,var(--cb-cols)),minmax(0,1fr));column-gap:var(--cb-gap);row-gap:var(--cb-row,var(--cb-gap));align-items:var(--cb-align,start)}
  .gmc-cb__grid--parts{grid-template-columns:repeat(12,minmax(0,1fr))}
  .gmc-cb__grid--parts>.gmc-cb__col{grid-column:span var(--dspan,12)}
  .gmc-cb__b--left{text-align:left}
  .gmc-cb__b--center{text-align:center}
  .gmc-cb__b--right{text-align:right}
  .gmc-cb__b--center .gmc-cb__btns,.gmc-cb__b--center .gmc-cb__pay,.gmc-cb__b--center .gmc-cb__tis{justify-content:center}
  .gmc-cb__b--right .gmc-cb__btns,.gmc-cb__b--right .gmc-cb__pay,.gmc-cb__b--right .gmc-cb__tis{justify-content:flex-end}
  .gmc-cb__b--center .gmc-cb__media{margin-inline:auto}
  .gmc-cb__b--right .gmc-cb__media{margin-left:auto}
  .gmc-cb__b--left .gmc-cb__iwt--top{align-items:flex-start}
  .gmc-cb__b--center .gmc-cb__iwt--top{align-items:center}
  .gmc-cb__b--right .gmc-cb__iwt--top{align-items:flex-end}
  .gmc-cb__b--wide .gmc-cb__btns,.gmc-cb__b--wide .button,.gmc-cb__b--wide .gmc-sec-atc,.gmc-cb__b--wide .gmc-sec-atc__f{width:100%}
  .gmc-cb__h{margin:0;line-height:1.15}
  .gmc-cb__h--h2{font-size:1.8rem}
  .gmc-cb__h--h1{font-size:2.6rem}
  .gmc-cb__h--h0{font-size:3.4rem}
  .gmc-cb__rt--subtitle{font-size:1.2rem;letter-spacing:.08em;text-transform:uppercase;opacity:.75}
  .gmc-cb__stars{margin:0}
  .gmc-cb__stars a{display:inline-flex;align-items:center;gap:.6rem;color:inherit;text-decoration:none}
  .gmc-cb__starbox{position:relative;display:inline-block;font-size:var(--star-size,16px);line-height:1;letter-spacing:.06em}
  .gmc-cb__starbg{color:var(--star-bg,#ececec)}
  .gmc-cb__starbox--line .gmc-cb__starbg{color:transparent;-webkit-text-stroke:1px var(--star-bg,#ececec)}
  .gmc-cb__starfg{position:absolute;inset:0 auto 0 0;width:var(--fill,0%);overflow:hidden;color:var(--star,#f5a623);white-space:nowrap}
  .gmc-cb__starlabel{font-size:var(--star-size,16px);margin-left:.5rem}
  .gmc-cb__btns{display:flex;flex-wrap:wrap;gap:.8rem}
  .gmc-cb__btns--full .button{flex:1 1 12rem}
  .gmc-cb__tis{display:flex;flex-wrap:wrap;gap:var(--gap,12px);color:var(--tx,#121212);font-size:var(--ts,16px);width:100%}
  .gmc-cb__tis--fit{width:fit-content;max-width:100%}
  .gmc-cb__tis--vertical{flex-direction:column}
  .gmc-cb__tis p{display:flex;gap:.6rem;align-items:center;margin:0}
  .gmc-cb__tis .gmc-icon{color:var(--ic,#121212);width:calc(20px * var(--isz,1.2));height:calc(20px * var(--isz,1.2))}
  .gmc-cb__tis--bg{background:var(--bg,#F3F3F3);border-radius:var(--br,12px);padding:var(--pad,12px);border:var(--bw,0) solid var(--bc,#B7B7B7)}
  .gmc-cb__iwt{display:flex;gap:.8rem;align-items:flex-start;margin:.4rem 0}
  .gmc-cb__copy{min-width:0}
  .gmc-cb__iwt--top{flex-direction:column}
  .gmc-cb__iwt--title{display:grid;grid-template-columns:auto 1fr;column-gap:.6rem;row-gap:.2rem;align-items:center;width:fit-content;max-width:100%}
  .gmc-cb__iwt--title .gmc-cb__sub{grid-column:2}
  .gmc-cb__b--center .gmc-cb__iwt--left{justify-content:center}
  .gmc-cb__b--right .gmc-cb__iwt--left{justify-content:flex-end}
  .gmc-cb__b--center .gmc-cb__iwt--title{margin-inline:auto}
  .gmc-cb__b--right .gmc-cb__iwt--title{margin-left:auto}
  .gmc-cb__ih{display:block}
  .gmc-cb__ih--h5{font-size:1.3rem}
  .gmc-cb__ih--h4{font-size:1.5rem}
  .gmc-cb__ih--h3{font-size:1.8rem}
  .gmc-cb__ih--h2{font-size:2.2rem}
  .gmc-cb__sub{display:block;opacity:.8}
  .gmc-cb__sub p{margin:.2rem 0}
  .gmc-cb__media{max-width:100%}
  .gmc-cb__ph{width:100%;height:auto;background:#f3f3f3;border-radius:inherit}
  .gmc-cb__vid{position:relative;overflow:hidden}
  .gmc-cb__vid video{width:100%;display:block;border-radius:inherit}
  .gmc-cb__vc{position:absolute;left:0;right:0;bottom:0;display:flex;gap:.6rem;align-items:center;padding:.6rem;background:linear-gradient(transparent,rgba(0,0,0,.5))}
  .gmc-cb__vc button{background:rgba(0,0,0,.55);color:#fff;border:0;border-radius:50%;width:3.2rem;height:3.2rem;cursor:pointer}
  .gmc-cb__vt{flex:1;height:4px;background:rgba(255,255,255,.35);border-radius:2px;overflow:hidden}
  .gmc-cb__vt b{display:block;height:100%;width:0;background:#fff}
  .gmc-cb__vid--ripple .gmc-cb__vc button[data-gmc-vplay]{box-shadow:0 0 0 0 rgba(255,255,255,.7);animation:gmc-cb-rip 2s infinite}
  @keyframes gmc-cb-rip{to{box-shadow:0 0 0 14px rgba(255,255,255,0)}}
  .gmc-cb__acc{border-top:1px solid rgba(var(--color-foreground),.15)}
  .gmc-cb__acc--plain{border-top:0}
  .gmc-cb__acc summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;cursor:pointer;padding:.9rem 0;list-style:none}
  .gmc-cb__acc summary::-webkit-details-marker{display:none}
  .gmc-cb__acc-t{display:flex;align-items:center;gap:.6rem;text-align:left}
  .gmc-cb__acc--small summary{font-size:1.3rem}
  .gmc-cb__acc--medium summary{font-size:1.5rem}
  .gmc-cb__acc--large summary{font-size:1.8rem}
  .gmc-cb__acc-i{width:1.2rem;height:1.2rem;position:relative;flex:none}
  .gmc-cb__acc-i--caret:before{content:"";border:solid currentColor;border-width:0 1.5px 1.5px 0;display:block;width:.6rem;height:.6rem;transform:rotate(45deg);margin-top:-.3rem}
  .gmc-cb__acc[open] .gmc-cb__acc-i--caret:before{transform:rotate(-135deg);margin-top:.2rem}
  .gmc-cb__acc-i--plus:before,.gmc-cb__acc-i--plus:after{content:"";position:absolute;background:currentColor;left:50%;top:50%;transform:translate(-50%,-50%)}
  .gmc-cb__acc-i--plus:before{width:1.2rem;height:1.5px}
  .gmc-cb__acc-i--plus:after{width:1.5px;height:1.2rem}
  .gmc-cb__acc[open] .gmc-cb__acc-i--plus:after{display:none}
  .gmc-cb__pay{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;margin:0;padding:0}
  .gmc-cb__mail-h{margin:0 0 .4rem}
  .gmc-cb__mail-sub{margin-bottom:.8rem}
  .gmc-cb__mail-row{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:.6rem}
  .gmc-cb__mail-row--arrow{position:relative;flex-wrap:nowrap;margin-bottom:0}
  .gmc-cb__mail input{flex:1;min-width:12rem;padding:1rem;border:1px solid rgba(var(--color-foreground),.25);border-radius:var(--inputs-radius,6px);background:rgb(var(--color-background));color:inherit}
  .gmc-cb__arrow{position:absolute;right:.4rem;top:50%;transform:translateY(-50%);border:0;background:transparent;color:inherit;width:3.2rem;height:3.2rem;display:grid;place-items:center;cursor:pointer}
  @media(min-width:750px){.gmc-cb__col--mob{display:none}}
  @media(max-width:749px){
    .gmc-cb__grid{grid-template-columns:1fr;column-gap:var(--cb-gap-m,var(--cb-gap));row-gap:var(--cb-row-m,var(--cb-row,var(--cb-gap)));align-items:var(--cb-align-m,start)}
    .gmc-cb__grid--parts{grid-template-columns:repeat(4,minmax(0,1fr))}
    .gmc-cb__grid--parts>.gmc-cb__col{grid-column:span var(--mspan,4)}
    .gmc-cb__col--desk{display:none}
    .gmc-cb__tis{font-size:var(--tsm,14px)}
    .gmc-cb__b[data-ma="left"]{text-align:left}
    .gmc-cb__b[data-ma="center"]{text-align:center}
    .gmc-cb__b[data-ma="right"]{text-align:right}
    .gmc-cb__b[data-ma="left"] .gmc-cb__btns,.gmc-cb__b[data-ma="left"] .gmc-cb__pay,.gmc-cb__b[data-ma="left"] .gmc-cb__tis{justify-content:flex-start}
    .gmc-cb__b[data-ma="center"] .gmc-cb__btns,.gmc-cb__b[data-ma="center"] .gmc-cb__pay,.gmc-cb__b[data-ma="center"] .gmc-cb__tis{justify-content:center}
    .gmc-cb__b[data-ma="right"] .gmc-cb__btns,.gmc-cb__b[data-ma="right"] .gmc-cb__pay,.gmc-cb__b[data-ma="right"] .gmc-cb__tis{justify-content:flex-end}
    .gmc-cb__b[data-ma="left"] .gmc-cb__media{margin-left:0;margin-right:auto}
    .gmc-cb__b[data-ma="center"] .gmc-cb__media{margin-inline:auto}
    .gmc-cb__b[data-ma="right"] .gmc-cb__media{margin-left:auto;margin-right:0}
    .gmc-cb__b[data-ma="left"] .gmc-cb__iwt--top{align-items:flex-start}
    .gmc-cb__b[data-ma="center"] .gmc-cb__iwt--top{align-items:center}
    .gmc-cb__b[data-ma="right"] .gmc-cb__iwt--top{align-items:flex-end}
  }
  @media(prefers-reduced-motion:reduce){.gmc-cb__vid--ripple .gmc-cb__vc button[data-gmc-vplay]{animation:none}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "Custom columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 40,
      "info": "Space between rows on desktop."
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 20,
      "info": "Horizontal space on mobile."
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Mobile row gap",
      "default": 30,
      "info": "Vertical space on mobile."
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "valign_mobile",
      "label": "Mobile vertical alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_widths",
      "label": "Custom column widths",
      "default": true,
      "info": "Desktop widths share 12 parts. Mobile widths share 4 parts."
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "range",
      "id": "col_1_desktop",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Desktop width",
      "default": 12
    },
    {
      "type": "range",
      "id": "col_1_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Mobile width",
      "default": 4
    },
    {
      "type": "select",
      "id": "col_1_show",
      "label": "Display on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "range",
      "id": "col_2_desktop",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Desktop width",
      "default": 4
    },
    {
