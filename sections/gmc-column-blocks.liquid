{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add a heading, text, icon, image, or another block.' -%}{%- endif -%}
<div class="page-width gmc-cb color-{{ section.settings.color_scheme }} gradient" style="--cb-cols:{{ section.settings.columns }};--cb-gap:{{ section.settings.gap }}px">
  <div class="gmc-cb__grid">
    {%- for i in (1..4) -%}
      {%- if i <= section.settings.columns -%}
        <div class="gmc-cb__col">
          {%- for block in section.blocks -%}
            {%- assign cb_col = block.settings.column | plus: 0 -%}
            {%- if cb_col == i -%}
              <div class="gmc-cb__b {% render 'gmc-vis', hide: block.settings.hide_on %}" style="margin-top:{{ block.settings.margin_top | default: 0 }}px;margin-bottom:{{ block.settings.margin_bottom | default: 0 }}px" {{ block.shopify_attributes }}>
                {%- render 'gmc-column-block', block: block -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<style>
  .gmc-cb{padding:36px 0}
  .gmc-cb__grid{display:grid;grid-template-columns:repeat(var(--cb-cols),minmax(0,1fr));gap:var(--cb-gap);align-items:start}
  .gmc-cb__h{margin:0}
  .gmc-cb__stars{margin:0}
  .gmc-cb__stars a{color:inherit;text-decoration:none}
  .gmc-cb__btns{display:flex;flex-wrap:wrap;gap:.8rem}
  .gmc-cb__tis p,.gmc-cb__iwt{display:flex;gap:.8rem;align-items:center;margin:.4rem 0}
  .gmc-cb__iwt--top{flex-direction:column;align-items:flex-start}
  .gmc-cb__iwt strong{display:block}
  .gmc-cb__sub{display:block;opacity:.75}
  .gmc-cb__vid video{width:100%;display:block;border-radius:inherit}
  .gmc-cb__acc{border-top:1px solid rgba(var(--color-foreground),.15)}
  .gmc-cb__acc summary{cursor:pointer;padding:.8rem 0;font-weight:650}
  .gmc-cb__pay{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;margin:0;padding:0}
  .gmc-cb__mail{display:flex;gap:.6rem;flex-wrap:wrap}
  .gmc-cb__mail input{flex:1;min-width:16rem;padding:1rem;border:1px solid rgba(var(--color-foreground),.25);border-radius:var(--inputs-radius,6px);background:rgb(var(--color-background));color:inherit}
  @media(max-width:749px){.gmc-cb__grid{grid-template-columns:1fr}}
</style>
