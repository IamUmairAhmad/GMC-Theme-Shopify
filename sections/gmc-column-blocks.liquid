        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "header",
      "content": "Column 6"
    },
    {
      "type": "range",
      "id": "col_6_desktop",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Desktop width",
      "default": 4
    },
    {
      "type": "range",
      "id": "col_6_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Mobile width",
      "default": 4
    },
    {
      "type": "select",
      "id": "col_6_show",
      "label": "Display on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "Colour scheme override",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Custom columns"
