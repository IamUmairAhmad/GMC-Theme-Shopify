{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one story block.' -%}{%- endif -%}
<div class="page-width gmc-is {% render 'gmc-vis', hide: section.settings.hide_on %}" id="gmc-is-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-is__row">{%- for block in section.blocks -%}<button type="button" class="gmc-is__b" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}><span class="gmc-is__ring">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 160 | image_tag: width: 72, height: 72, loading: 'lazy' }}{%- endif -%}</span><small>{{ block.settings.title | escape }}</small></button>{%- endfor -%}</div>
  <div class="gmc-is__modal" hidden><button type="button" class="gmc-is__x" aria-label="Close">×</button>
    {%- for block in section.blocks -%}<div class="gmc-is__s" hidden>{%- if block.settings.video != blank -%}<video src="{% for s in block.settings.video.sources %}{% if s.format == 'mp4' %}{{ s.url }}{% endif %}{% endfor %}" playsinline controls></video>{%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{%- endif -%}{%- if block.settings.link != blank -%}<a class="button" href="{{ block.settings.link }}">{{ block.settings.cta | escape }}</a>{%- endif -%}</div>{%- endfor -%}</div>
</div>
<style>.gmc-is{padding:28px 0}.gmc-is__row{display:flex;gap:1.2rem;overflow-x:auto;justify-content:center;padding:.5rem}.gmc-is__b{background:none;border:0;cursor:pointer;text-align:center;color:inherit}.gmc-is__ring{display:block;padding:3px;border-radius:50%;background:linear-gradient(45deg,#f9ce34,#ee2a7b,#6228d7)}.gmc-is__ring img{display:block;border-radius:50%;border:3px solid rgb(var(--color-background));object-fit:cover}.gmc-is__modal{position:fixed;inset:0;z-index:130;background:rgba(0,0,0,.85);display:grid;place-items:center}.gmc-is__modal[hidden]{display:none}.gmc-is__s{max-width:min(420px,92vw);text-align:center}.gmc-is__s[hidden]{display:none}.gmc-is__s img,.gmc-is__s video{max-height:78vh;width:auto;max-width:100%;border-radius:var(--media-radius)}.gmc-is__x{position:absolute;top:1rem;right:1.4rem;background:none;border:0;color:#fff;font-size:3rem;cursor:pointer}</style>
<script>(function(){var w=document.getElementById('gmc-is-{{ section.id }}'),m=w.querySelector('.gmc-is__modal'),S=m.querySelectorAll('.gmc-is__s');
function close(){m.hidden=true;m.querySelectorAll('video').forEach(function(v){v.pause();});}
w.querySelectorAll('.gmc-is__b').forEach(function(b){b.addEventListener('click',function(){S.forEach(function(s,i){s.hidden=i!==+b.dataset.i;});m.hidden=false;});});
m.querySelector('.gmc-is__x').addEventListener('click',close);m.addEventListener('click',function(e){if(e.target===m)close();});document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});})();</script>
{% schema %}
{
  "name": "Stories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover / image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "MP4 video (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Story"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Stories"
    }
  ]
}
{% endschema %}
