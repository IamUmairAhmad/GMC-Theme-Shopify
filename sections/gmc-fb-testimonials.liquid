{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one comment block.' -%}{%- endif -%}
<div class="page-width gmc-fb {% render 'gmc-vis', hide: section.settings.hide_on %}">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="gmc-fb__list">{%- for block in section.blocks -%}
    <div class="gmc-fb__c" {{ block.shopify_attributes }}>
      {%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 80 | image_tag: width: 40, height: 40, loading: 'lazy', class: 'gmc-fb__av' }}{%- else -%}<span class="gmc-fb__av gmc-fb__av--ph">{{ block.settings.name | slice: 0 }}</span>{%- endif -%}
      <div class="gmc-fb__body"><div class="gmc-fb__bub"><strong>{{ block.settings.name | escape }}</strong><p>{{ block.settings.comment | escape }}</p>{%- if block.settings.likes > 0 -%}<span class="gmc-fb__likes">👍❤️ {{ block.settings.likes }}</span>{%- endif -%}</div>
        <div class="gmc-fb__meta">Like · Reply · {{ block.settings.time | escape }}</div>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', style: 'max-width:260px;border-radius:10px;margin-top:.5rem' }}{%- endif -%}</div>
    </div>{%- endfor -%}</div>
</div>
<style>.gmc-fb{padding:36px 0}.gmc-fb__list{max-width:640px;margin:1.5rem auto 0;display:grid;gap:1.2rem}.gmc-fb__c{display:flex;gap:.8rem}.gmc-fb__av{flex:none;width:40px;height:40px;border-radius:50%;object-fit:cover}.gmc-fb__av--ph{background:#1877f2;color:#fff;display:grid;place-items:center;font-weight:700}.gmc-fb__bub{position:relative;background:#f0f2f5;color:#1c1e21;padding:.8rem 1.2rem;border-radius:var(--text-boxes-radius);display:inline-block;max-width:100%}.gmc-fb__bub strong{font-size:1.3rem}.gmc-fb__bub p{margin:.2rem 0 0;font-size:1.45rem}.gmc-fb__likes{position:absolute;right:-6px;bottom:-12px;background:#fff;border-radius:var(--badge-corner-radius,99px);padding:1px 8px;box-shadow:0 1px 4px rgba(var(--color-shadow),.25);font-size:1.1rem}.gmc-fb__meta{font-size:1.2rem;opacity:.65;margin:.5rem 0 0 1rem;font-weight:600}</style>
{% schema %}
{
  "name": "Facebook testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people are saying"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "comment",
      "name": "Comment",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Emily R."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Profile photo"
        },
        {
          "type": "textarea",
          "id": "comment",
          "label": "Comment",
          "default": "Just got mine and I'm obsessed!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Attached photo"
        },
        {
          "type": "number",
          "id": "likes",
          "label": "Likes",
          "default": 12
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "2d"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Facebook testimonials",
      "blocks": [
        {
          "type": "comment"
        },
        {
          "type": "comment",
          "settings": {
            "name": "Michael B.",
            "comment": "Fast delivery and great quality.",
            "likes": 5,
            "time": "4d"
          }
        }
      ]
    }
  ]
}
{% endschema %}
