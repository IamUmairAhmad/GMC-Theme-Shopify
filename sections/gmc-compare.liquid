{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'compare', title: 'Compare products' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
<div class="page-width gmc-cmpw {% render 'gmc-vis', hide: section.settings.hide_on %}" style="padding-top:36px;padding-bottom:36px">
  {%- if section.settings.heading != blank -%}<h2 style="text-align:center;margin-bottom:2rem">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div data-gmc-compare data-empty="{{ section.settings.empty | escape }}" data-remove="{{ section.settings.remove | escape }}" data-price="{{ section.settings.l_price | escape }}" data-vendor="{{ section.settings.l_vendor | escape }}" data-type="{{ section.settings.l_type | escape }}" data-avail="{{ section.settings.l_avail | escape }}" data-in="{{ section.settings.l_in | escape }}" data-out="{{ section.settings.l_out | escape }}" data-desc="{{ section.settings.l_desc | escape }}"><div class="gmc-cmpbody"></div></div>
  <p style="text-align:center"><button type="button" class="button button--secondary" data-gmc-cmp-clear>{{ section.settings.clear | escape }}</button></p>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Compare products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare products"
    },
    {
      "type": "text",
      "id": "empty",
      "label": "Empty text",
      "default": "Pick products to compare using the Compare button on product cards."
    },
    {
      "type": "text",
      "id": "remove",
      "label": "Remove label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "clear",
      "label": "Clear button label",
      "default": "Clear all"
    },
    {
      "type": "text",
      "id": "l_price",
      "label": "Price row label",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "l_vendor",
      "label": "Brand row label",
      "default": "Brand"
    },
    {
      "type": "text",
      "id": "l_type",
      "label": "Type row label",
      "default": "Type"
    },
    {
      "type": "text",
      "id": "l_avail",
      "label": "Availability row label",
      "default": "Availability"
    },
    {
      "type": "text",
      "id": "l_in",
      "label": "In stock text",
      "default": "In stock"
    },
    {
      "type": "text",
      "id": "l_out",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "l_desc",
      "label": "Description row label",
      "default": "Description"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Hide on",
      "options": [
        {
          "value": "",
          "label": "Show everywhere"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Compare products"
    }
  ]
}
{% endschema %}
