{%- comment -%} GMC Theme: quantity break picker for product pages (original code). Sets the main form quantity. For real price discounts, create matching automatic discounts in Shopify admin. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="gmc-qb" id="gmc-qb-{{ section.id }}">
  {%- if section.settings.heading != blank -%}<p class="gmc-qb__title">{{ section.settings.heading | escape }}</p>{%- endif -%}
  {%- for block in section.blocks -%}
    <label class="gmc-qb__opt" {{ block.shopify_attributes }}>
      <input type="radio" name="gmc-qb-{{ section.id }}" value="{{ block.settings.qty }}" data-gift="{{ block.settings.gift_variant | strip }}" {% if forloop.first %}checked{% endif %}>
      <span class="gmc-qb__label"><strong>{{ block.settings.label | escape }}</strong>{% if block.settings.note != blank %}<em>{{ block.settings.note | escape }}</em>{% endif %}{% if block.settings.gift_variant != blank %}<em class="gmc-qb__gift">🎁 {{ block.settings.gift_text | default: "Free gift included" | escape }}</em>{% endif %}</span>
      {%- if block.settings.badge != blank -%}<span class="gmc-qb__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
      {%- if product != blank -%}{%- assign qb_full = product.selected_or_first_available_variant.price | times: block.settings.qty -%}{%- assign qb_pct = block.settings.percent | default: 0 -%}<span class="gmc-qb__price" data-qty="{{ block.settings.qty }}" data-pct="{{ qb_pct }}">{%- if qb_pct > 0 -%}<s style="opacity:.6;margin-right:.4rem">{{ qb_full | money }}</s>{%- assign qb_mult = 100 | minus: qb_pct -%}{{ qb_full | times: qb_mult | divided_by: 100.0 | round | money }}{%- else -%}{{ qb_full | money }}{%- endif -%}</span>{%- endif -%}
    </label>
  {%- endfor -%}
</div>
<style>
  .gmc-qb{margin:1.2rem 0;display:grid;gap:.7rem}.gmc-qb__title{margin:0;font-weight:700}
  .gmc-qb__opt{display:flex;align-items:center;gap:1rem;padding:1rem 1.2rem;border:1px solid rgba(var(--color-foreground),.2);border-radius:10px;cursor:pointer;position:relative}
  .gmc-qb__opt:has(input:checked){border-color:rgb(var(--color-foreground));background:rgba(var(--color-foreground),.04)}
  .gmc-qb__label{flex:1;display:flex;flex-direction:column}.gmc-qb__label em{font-size:.85em;opacity:.7;font-style:normal}
  .gmc-qb__gift{color:{{ settings.gmc_accent }};font-weight:600}.gmc-qb__badge{background:{{ settings.gmc_accent }};color:#fff;font-size:.75em;padding:2px 8px;border-radius:99px}
</style>
<script>
  (function(){var w=document.getElementById('gmc-qb-{{ section.id }}');if(!w)return;
  function apply(v){document.querySelectorAll('input[name="quantity"]').forEach(function(i){if(!(i.form&&/\/cart\/add/.test(i.form.action)))return;i.value=v;i.dispatchEvent(new Event('change',{bubbles:true}));});}
  w.addEventListener('change',function(e){if(e.target.type==='radio')apply(e.target.value);});
  window.addEventListener('load',function(){var c=w.querySelector('input:checked');if(c)apply(c.value);});
  gmcWhenPubsub(function(){subscribe(PUB_SUB_EVENTS.variantChange,function(ev){var v=ev&&ev.data&&ev.data.variant;if(!v)return;
    w.querySelectorAll('.gmc-qb__price').forEach(function(el){try{var f=new Intl.NumberFormat(undefined,{style:'currency',currency:(window.GMC&&GMC.money)||'USD'}),full=v.price*(+el.dataset.qty)/100,pct=+el.dataset.pct||0;el.innerHTML=pct>0?'<s style="opacity:.6;margin-right:.4rem">'+f.format(full)+'</s>'+f.format(full*(100-pct)/100):f.format(full);}catch(e){}});
    var c=w.querySelector('input:checked');if(c)apply(c.value);});});
  var forms=document.querySelectorAll('form[action*="/cart/add"]');
  forms.forEach(function(f){f.addEventListener('submit',function(){var c=w.querySelector('input:checked'),g=c&&c.dataset.gift;
    if(g&&window.gmcQueueAddon)gmcQueueAddon(g);},true);});})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Quantity breaks",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy more, save more"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "range",
          "id": "qty",
          "min": 1,
          "max": 12,
          "label": "Quantity",
          "default": 1
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Buy 1"
        },
        {
          "type": "range",
          "id": "percent",
          "min": 0,
          "max": 50,
          "step": 5,
          "unit": "%",
          "label": "Discount shown (%)",
          "default": 0,
          "info": "Display only. Create a matching automatic discount in Shopify admin, or the checkout price will not change."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "gift_variant",
          "label": "Bonus item variant ID (free gift or paid add-on)",
          "info": "Optional. For a free gift price it at 0 or add a 100% automatic discount; a normally priced variant works as a paid upsell."
        },
        {
          "type": "text",
          "id": "gift_text",
          "label": "Gift label",
          "default": "Free gift included"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Quantity breaks",
      "blocks": [
        {
          "type": "tier"
        },
        {
          "type": "tier",
          "settings": {
            "qty": 2,
            "label": "Buy 2"
          }
        },
        {
          "type": "tier",
          "settings": {
            "qty": 3,
            "label": "Buy 3",
            "badge": "Best value"
          }
        }
      ]
    }
  ]
}
{% endschema %}
