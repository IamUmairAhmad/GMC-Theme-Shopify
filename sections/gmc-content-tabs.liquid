{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add at least one tab block.' -%}{%- endif -%}
{%- comment -%} GMC Theme: tabbed content (original code) {%- endcomment -%}
<div class="page-width gmc-tabs gmc-tabs--{{ section.settings.nav_align }} gmc-tabs--w-{{ section.settings.width | default: 'normal' }} gmc-tabs--lay-{{ section.settings.tab_layout | default: 'above' }} gmc-tabs--btn-{{ section.settings.btn_style | default: 'outline' }}{% if section.settings.full_btn %} gmc-tabs--full{% endif %}{% if section.settings.full_mobile %} gmc-tabs--fullm{% endif %} gmc-tabs--a-{{ section.settings.anim }}{% if section.settings.btn_anim == 'moving' %} gmc-tabs--pill{% endif %}" id="gmc-tabs-{{ section.id }}" style="--gmc-tabs-r:{{ section.settings.btn_radius | default: 6 }}px;--btn-d:{{ section.settings.btn_size_desktop | default: 15 }}px;--btn-m:{{ section.settings.btn_size_mobile | default: 13 }}px">
  <div class="gmc-tabs__head">
    {%- if section.settings.heading != blank -%}<h2 class="gmc-tabs__title {{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="gmc-tabs__nav" role="tablist">
      {%- if section.settings.btn_anim == 'moving' -%}<span class="gmc-tabs__pill" aria-hidden="true"></span>{%- endif -%}
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="gmc-tabs__btn" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{%- if block.settings.icon != blank -%}<span class="gmc-tabs__ic">{%- render 'gmc-icon', name: block.settings.icon, size: 18, filled: block.settings.icon_filled -%}</span>{%- endif -%}{{ block.settings.title }}</button>
      {%- endfor -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- assign tb = block.settings -%}
    <div class="gmc-tabs__panel gmc-tabs__panel--{{ tb.media_pos | default: 'above' }} gmc-tabs__panel--{{ tb.media_width | default: 'half' }} gmc-tabs__panel--m-{{ tb.mobile_media | default: 'first' }} gmc-tabs__panel--ad-{{ tb.align | default: 'center' }} gmc-tabs__panel--am-{{ tb.mobile_align | default: tb.align | default: 'center' }}" role="tabpanel" {% unless forloop.first %}hidden{% endunless %}>
      {%- if tb.video != blank or tb.image != blank -%}
        <div class="gmc-tabs__media">
          {%- if tb.video != blank -%}
            <div class="gmc-pm__vid gmc-tabs__m" data-gmc-vid><video playsinline preload="metadata" {% if tb.autoplay %}autoplay muted{% else %}controls{% endif %}{% if tb.loop %} loop{% endif %}>{%- for vs in tb.video.sources -%}{%- if vs.format == 'mp4' -%}<source src="{{ vs.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>{%- unless tb.autoplay -%}<button type="button" class="gmc-tabs__play{% if tb.ripple %} gmc-tabs__play--ripple{% endif %}" aria-label="Play video">Play</button>{%- endunless -%}</div>
          {%- else -%}
            {{ tb.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'gmc-tabs__m', alt: tb.image.alt }}
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="gmc-tabs__copy rte">
        {%- if tb.panel_heading != blank -%}<h3 class="{{ tb.panel_size | default: 'h1' }}">{{ tb.panel_heading | escape }}</h3>{%- endif -%}
        {{ tb.content }}
        {%- if tb.link_label != blank -%}
          {%- if tb.link != blank -%}
            <a class="button{% if tb.link_secondary %} button--secondary{% else %} button--primary{% endif %}" href="{{ tb.link }}">{{ tb.link_label | escape }}</a>
          {%- else -%}
            <button type="button" class="button{% if tb.link_secondary %} button--secondary{% else %} button--primary{% endif %}" disabled aria-disabled="true">{{ tb.link_label | escape }}</button>
          {%- endif -%}
        {%- endif -%}
        {%- if tb.product != blank -%}{%- render 'gmc-inline-atc', product: tb.product, label: tb.button, skip: tb.skip_cart, align: tb.align -%}{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>
<style>
  .gmc-tabs{padding:36px 0}.gmc-tabs__title{text-align:center;margin:0 0 1.5rem}
  .gmc-tabs__nav{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;margin-bottom:1.5rem;position:relative}
  .gmc-tabs__btn{cursor:pointer;padding:.6rem 1.2rem;border:1px solid currentColor;background:transparent;color:inherit;font:inherit;font-size:var(--btn-m,13px);opacity:.65}
  .gmc-tabs__btn[aria-selected=true]{opacity:1;background:rgb(var(--color-foreground));color:rgb(var(--color-background))}
.gmc-tabs--left .gmc-tabs__nav{justify-content:flex-start}.gmc-tabs--right .gmc-tabs__nav{justify-content:flex-end}.gmc-tabs--full .gmc-tabs__nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr))}.gmc-tabs__btn{border-radius:var(--gmc-tabs-r,6px)}.gmc-tabs--btn-shadow .gmc-tabs__nav{padding:.4rem;border-radius:calc(var(--gmc-tabs-r,6px) + .4rem);box-shadow:0 4px 16px rgba(0,0,0,.12)}.gmc-tabs--btn-shadow .gmc-tabs__btn{border:0}.gmc-tabs--w-narrow{max-width:80rem;margin-inline:auto}.gmc-tabs--w-small{max-width:100rem;margin-inline:auto}.gmc-tabs--w-wide{max-width:120rem;margin-inline:auto}.gmc-tabs__ic{display:inline-flex;margin-right:.5rem;vertical-align:middle}.gmc-tabs__media{position:relative}.gmc-tabs__m{width:100%;height:auto;border-radius:var(--media-radius,8px);display:block}.gmc-tabs__copy{display:grid;gap:1rem}.gmc-tabs__panel{animation:gmc-tabs-fade .35s ease}.gmc-tabs__panel[hidden]{display:none}.gmc-tabs--a-none .gmc-tabs__panel{animation:none}.gmc-tabs--a-slide .gmc-tabs__panel{animation:gmc-tabs-slide .35s ease}.gmc-tabs__btn{transition:background .25s,color .25s,opacity .25s}
.gmc-tabs__panel--am-center,.gmc-tabs__panel--am-center .gmc-tabs__copy{text-align:center;justify-items:center}.gmc-tabs__panel--am-right,.gmc-tabs__panel--am-right .gmc-tabs__copy{text-align:right;justify-items:end}
.gmc-tabs--pill .gmc-tabs__pill{position:absolute;background:rgb(var(--color-foreground));border-radius:var(--gmc-tabs-r,6px);transition:left .28s ease,width .28s ease,top .28s ease;z-index:0}.gmc-tabs--pill .gmc-tabs__btn{position:relative;z-index:1;background:transparent;color:inherit}.gmc-tabs--pill .gmc-tabs__btn[aria-selected=true]{color:rgb(var(--color-background))}
.gmc-tabs__play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:4.4rem;height:4.4rem;border:0;border-radius:50%;background:rgb(var(--color-button));color:rgb(var(--color-button-text));cursor:pointer}.gmc-tabs__play--ripple{box-shadow:0 0 0 0 rgba(var(--color-button),.45);animation:gmc-tabs-rip 1.6s ease-out infinite}
@media(min-width:750px){.gmc-tabs__btn{font-size:var(--btn-d,15px)}.gmc-tabs--lay-inline .gmc-tabs__head{display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.gmc-tabs--lay-inline .gmc-tabs__title{margin:0;text-align:left}.gmc-tabs--lay-side{display:grid;grid-template-columns:minmax(16rem,24rem) 1fr;column-gap:2.4rem;align-items:start}.gmc-tabs--lay-side .gmc-tabs__head{display:contents}.gmc-tabs--lay-side .gmc-tabs__title{grid-column:1 / -1}.gmc-tabs--lay-side .gmc-tabs__nav{flex-direction:column;align-items:stretch}.gmc-tabs__panel--half.gmc-tabs__panel--left:not([hidden]),.gmc-tabs__panel--half.gmc-tabs__panel--right:not([hidden]){display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center}.gmc-tabs__panel--right .gmc-tabs__media{order:2}.gmc-tabs__panel--full:not([hidden]){display:flex;flex-direction:column}.gmc-tabs__panel--ad-left,.gmc-tabs__panel--ad-left .gmc-tabs__copy{text-align:left;justify-items:start}.gmc-tabs__panel--ad-center,.gmc-tabs__panel--ad-center .gmc-tabs__copy{text-align:center;justify-items:center}.gmc-tabs__panel--ad-right,.gmc-tabs__panel--ad-right .gmc-tabs__copy{text-align:right;justify-items:end}}@media(max-width:749px){.gmc-tabs--fullm .gmc-tabs__nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr))}.gmc-tabs__panel--m-second:not([hidden]){display:flex;flex-direction:column}.gmc-tabs__panel--m-second .gmc-tabs__media{order:2}.gmc-tabs__media{margin-bottom:1.2rem}}@keyframes gmc-tabs-fade{from{opacity:0}to{opacity:1}}@keyframes gmc-tabs-slide{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes gmc-tabs-rip{70%,100%{box-shadow:0 0 0 14px rgba(var(--color-button),0)}}</style>
<script>
  (function(){var w=document.getElementById('gmc-tabs-{{ section.id }}');if(!w)return;
  var b=w.querySelectorAll('.gmc-tabs__btn'),p=w.querySelectorAll('.gmc-tabs__panel'),pill=w.querySelector('.gmc-tabs__pill');
  function place(){if(!pill)return;var on=w.querySelector('.gmc-tabs__btn[aria-selected="true"]');if(!on)return;pill.style.left=on.offsetLeft+'px';pill.style.top=on.offsetTop+'px';pill.style.width=on.offsetWidth+'px';pill.style.height=on.offsetHeight+'px';}
  function select(i){b.forEach(function(y,j){y.setAttribute('aria-selected',j===i?'true':'false');});p.forEach(function(z,j){z.hidden=j!==i;});place();}
  b.forEach(function(x){x.addEventListener('click',function(){select(+x.dataset.i);});x.addEventListener('keydown',function(e){if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;e.preventDefault();var n=+x.dataset.i+(e.key==='ArrowRight'?1:-1);if(n<0)n=b.length-1;if(n>=b.length)n=0;b[n].focus();select(n);});});
  w.querySelectorAll('.gmc-tabs__play').forEach(function(btn){btn.addEventListener('click',function(){var v=btn.parentNode.querySelector('video');if(!v)return;v.controls=true;v.play();btn.hidden=true;});});
  place();window.addEventListener('resize',place);})();
</script>
{% schema %}
{
  "name": "Content tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Content tabs"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "wide", "label": "Medium" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "tab_layout",
      "label": "Tab placement on desktop",
      "options": [
        { "value": "above", "label": "Vertical" },
        { "value": "inline", "label": "Horizontal" },
        { "value": "side", "label": "Tabs beside the content" }
      ],
      "default": "above"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Tab button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "shadow", "label": "Shadow" }
      ],
      "default": "outline"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Buttons corner radius",
      "default": 6
    },
    {
      "type": "select",
      "id": "nav_align",
      "label": "Tab buttons alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_btn",
      "label": "Expand buttons to full width on desktop",
      "info": "Shares the row evenly. Best when every button fits on one line.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_mobile",
      "label": "Expand buttons to full width on mobile",
      "info": "Shares the row evenly. Best when every button fits on one line.",
      "default": true
    },
    {
      "type": "select",
      "id": "anim",
      "label": "Tab change animation",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide up"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "fade"
    },
    {
      "type": "select",
      "id": "btn_anim",
      "label": "Active button animation",
      "options": [
        { "value": "moving", "label": "Moving" },
        { "value": "opacity", "label": "Opacity" }
      ],
      "default": "moving",
      "info": "Moving slides a highlight behind the active button. It works best when the buttons stay on one line."
    },
    {
      "type": "range",
      "id": "btn_size_desktop",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop button font size",
      "default": 15
    },
    {
      "type": "range",
      "id": "btn_size_mobile",
      "min": 8,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Mobile button font size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 0
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Add to cart in this section"
    },
    {
      "type": "product",
      "id": "gmc_atc_product",
      "label": "Add-to-cart product",
      "info": "Adds a button (with variant dropdown if needed) at the end of this section."
    },
    {
      "type": "text",
      "id": "gmc_atc_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "gmc_atc_skip",
      "label": "Add to cart button: skip the cart and go to checkout",
      "default": false
    },
    {
      "type": "select",
      "id": "gmc_atc_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider options"
    },
    {
      "type": "checkbox",
      "id": "gmc_swipe_mobile",
      "label": "Swipe row on mobile",
      "info": "Turns this section's grid into a swipeable row on phones.",
      "default": false
    },
    {
      "type": "range",
      "id": "gmc_slider_autoplay",
      "label": "Slider autoplay (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Works on sections that contain a slider. Loops back to the start, pauses on hover and respects reduced-motion."
    },
    {
      "type": "color_scheme",
      "id": "gmc_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gmc_display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Section ID and pairing"
    },
    {
      "type": "text",
      "id": "gmc_anchor",
      "label": "Section ID (for links like #my-id)",
      "info": "Letters, numbers and dashes. Use this ID in a link to scroll here."
    },
    {
      "type": "text",
      "id": "gmc_pair_with",
      "label": "Place beside the section with this ID",
      "info": "Enter another section's ID. The two sections sit side by side on desktop. [Guide](https://github.com/IamUmairAhmad/GMC-Theme-Shopify/blob/main/docs/sections.md)"
    },
    {
      "type": "checkbox",
      "id": "gmc_pair_rev",
      "label": "Reverse the pair order on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Tab button label",
          "default": "Tab button"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Tab content goes here.</p>"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Tab icon name",
          "info": "A Tabler icon name, such as star or truck."
        },
        {
          "type": "checkbox",
          "id": "icon_filled",
          "label": "Filled icon",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (MP4)"
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop the video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Muted autoplay",
          "info": "Turn this on instead of a GIF. Turn it off to show a play button.",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "ripple",
          "label": "Play button ripple",
          "default": false
        },
        {
          "type": "select",
          "id": "media_width",
          "label": "Desktop media width",
          "options": [
            { "value": "half", "label": "Half of the tab" },
            { "value": "full", "label": "Full width of the tab" }
          ],
          "default": "half"
        },
        {
          "type": "select",
          "id": "media_pos",
          "label": "Desktop media placement",
          "options": [
            { "value": "left", "label": "Media first" },
            { "value": "right", "label": "Media second" },
            { "value": "above", "label": "Above the text" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "panel_heading",
          "label": "Content heading"
        },
        {
          "type": "select",
          "id": "panel_size",
          "label": "Content heading size",
          "options": [
            { "value": "h3", "label": "Extra small" },
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Desktop text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "mobile_media",
          "label": "Mobile media placement",
          "options": [
            { "value": "first", "label": "Media first" },
            { "value": "second", "label": "Media second" }
          ],
          "default": "first"
        },
        {
          "type": "select",
          "id": "mobile_align",
          "label": "Mobile text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link button link"
        },
        {
          "type": "checkbox",
          "id": "link_secondary",
          "label": "Use the secondary button style",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "skip_cart",
          "label": "Add to cart and go to checkout",
          "default": false
        },
        {
          "type": "product",
          "id": "product",
          "label": "Add-to-cart product"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Add to cart"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Content tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Details"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Shipping"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
