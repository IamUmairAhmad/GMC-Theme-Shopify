{%- if request.visual_preview_mode -%}
  {%- render 'gmc-visual-preview', look: 'features', title: 'Product features' -%}
{%- else -%}
{%- render 'gmc-scheme' -%}
{%- render 'gmc-section-extras' -%}
{%- if section.blocks.size == 0 -%}{%- render 'gmc-empty', msg: 'Add a hotspot or a bullet point.' -%}{%- endif -%}
{%- assign ss = section.settings -%}
{%- liquid
  assign show_copy = false
  if ss.heading != blank or ss.intro != blank or ss.button != blank or ss.atc_label != blank
    assign show_copy = true
  endif
  assign same_bg = false
  if ss.content_scheme == ss.gmc_scheme
    assign same_bg = true
  endif
-%}
<div
  class="page-width gmc-pf{% if ss.ripple %} gmc-pf--rip{% endif %}"
  id="gmc-pf-{{ section.id }}"
  data-open="{{ ss.open_on }}"
>
  <div class="gmc-pf__layout gmc-pf__layout--{{ ss.content_position }} gmc-pf__layout--m-{{ ss.mobile_content_position }}{% if ss.hide_content_mobile %} gmc-pf__layout--hide-m{% endif %}{% if same_bg %} gmc-pf__layout--same{% endif %}">
    {%- if show_copy -%}
      <div class="gmc-pf__copy gmc-pf__copy--{{ ss.content_align }} color-{{ ss.content_scheme }}">
        {%- if ss.heading != blank -%}<h2 class="gmc-pf__title {{ ss.heading_size }}">{{ ss.heading | escape }}</h2>{%- endif -%}
        {%- if ss.intro != blank -%}<div class="rte gmc-pf__intro">{{ ss.intro }}</div>{%- endif -%}
        {%- if ss.button != blank or ss.atc_label != blank -%}
          <div class="gmc-pf__actions">
            {%- if ss.button != blank -%}
              <a class="button{% if ss.secondary %} button--secondary{% else %} button--primary{% endif %}" {% if ss.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ ss.link }}"{% endif %}>{{ ss.button | escape }}</a>
            {%- endif -%}
            {%- if ss.atc_label != blank -%}
              <button type="button" class="button button--primary" data-gmc-pf-atc {% if product != blank and product.selected_or_first_available_variant.available == false %}disabled{% endif %}>{{ ss.atc_label | escape }}</button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div
      class="gmc-pf__stage{% if ss.image_mobile != blank %} gmc-pf__stage--has-m{% endif %}{% if ss.contain %} gmc-pf__stage--contain{% endif %}"
      data-gmc-pf-stage
      data-contain="{% if ss.contain %}true{% else %}false{% endif %}"
      style="--img:{{ ss.image_max }}px;--pop:{{ ss.popup_width }}px;--pop-m:{{ ss.modal_width_m }}px;--bw:{{ ss.bullet_width }}px"
    >
      {%- if ss.image != blank -%}
        <div class="gmc-pf__dimg">{{ ss.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'gmc-pf__img', widths: '400, 700, 1000, 1400, 1600', alt: ss.image.alt }}</div>
        {%- if ss.image_mobile != blank -%}
          <div class="gmc-pf__mimg">{{ ss.image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'gmc-pf__img', widths: '400, 700, 1000, 1200', alt: ss.image_mobile.alt }}</div>
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'gmc-pf__ph' }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if block.type == 'hotspot' -%}
          <div
            class="gmc-pf__hot{% if b.mobile_pos %} gmc-pf__hot--m{% endif %}"
            style="--x:{{ b.x }}%;--y:{{ b.y }}%;--xm:{{ b.x_m }}%;--ym:{{ b.y_m }}%"
            {{ block.shopify_attributes }}
          >
            <button type="button" class="gmc-pf__dot color-{{ ss.dot_scheme }}" aria-expanded="false" aria-controls="gmc-pf-pop-{{ block.id }}" aria-label="{{ b.title | default: 'Feature' | escape }}">+</button>
            <div class="gmc-pf__pop color-{{ ss.modal_scheme }} gmc-pf__pop--{{ b.align }}{% if b.image_size == 'small' and b.image != blank %} gmc-pf__pop--sm{% endif %}" id="gmc-pf-pop-{{ block.id }}" hidden>
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'gmc-pf__shot', widths: '160, 320, 640, 800', alt: b.image.alt }}
              {%- endif -%}
              <div class="gmc-pf__pop-copy">
                {%- if b.title != blank -%}<h3 class="gmc-pf__pop-title">{{ b.title | escape }}</h3>{%- endif -%}
                {%- if b.text != blank -%}<div class="rte gmc-pf__pop-text">{{ b.text }}</div>{%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div
            class="gmc-pf__bp gmc-pf__bp--{{ b.direction }} gmc-pf__bp--bend-{{ b.bend }} color-{{ ss.bullet_scheme }}{% if b.mobile_pos %} gmc-pf__bp--custom-m gmc-pf__bp--m-{{ b.mobile_direction }} gmc-pf__bp--m-bend-{{ b.mobile_bend }}{% endif %}"
            style="--x:{{ b.x }}%;--y:{{ b.y }}%;--xm:{{ b.x_m }}%;--ym:{{ b.y_m }}%"
            {{ block.shopify_attributes }}
          >
            <span class="gmc-pf__bp-dot"></span>
            <span class="gmc-pf__bp-v" aria-hidden="true"></span>
            <span class="gmc-pf__bp-h" aria-hidden="true"></span>
            <div class="gmc-pf__bp-card">
              {%- if b.title != blank -%}<h3 class="gmc-pf__bp-title">{{ b.title | escape }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="rte gmc-pf__bp-text">{{ b.text }}</div>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- if ss.gmc_pad_top > 0 or ss.gmc_pad_bottom > 0 -%}
<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {%- if ss.gmc_pad_top > 0 -%}padding-top: {{ ss.gmc_pad_top | times: 0.75 | round: 0 }}px;{%- endif -%}
      {%- if ss.gmc_pad_bottom > 0 -%}padding-bottom: {{ ss.gmc_pad_bottom | times: 0.75 | round: 0 }}px;{%- endif -%}
    }
  }
</style>
{%- endif -%}
<style>
  .gmc-pf__layout{display:flex;flex-direction:column;align-items:center;gap:2.4rem}
  .gmc-pf__copy{width:min(100%,52rem);border-radius:1rem;padding:2rem}
  .gmc-pf__layout--same .gmc-pf__copy{background:transparent;padding:0}
  .gmc-pf__title{margin:0}
  .gmc-pf__intro{margin-top:1rem}
  .gmc-pf__actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.6rem}
  .gmc-pf__copy--left{text-align:left}
  .gmc-pf__copy--center{text-align:center}
  .gmc-pf__copy--center .gmc-pf__actions{justify-content:center}
  .gmc-pf__copy--right{text-align:right}
  .gmc-pf__copy--right .gmc-pf__actions{justify-content:flex-end}
  .gmc-pf__stage{position:relative;width:100%;max-width:var(--img,900px);container-type:inline-size}
  .gmc-pf__img,.gmc-pf__ph{width:100%;height:auto;display:block}
  .gmc-pf__ph{background:#e7e2d8}
  .gmc-pf__mimg{display:none}
  .gmc-pf__stage--contain{overflow:hidden}
  .gmc-pf__hot{position:absolute;left:var(--x);top:var(--y);z-index:2;transform:translate(-50%,-50%)}
  .gmc-pf__hot.is-open{z-index:5}
  .gmc-pf__dot{width:3.2rem;height:3.2rem;border:0;border-radius:50%;padding:0;display:grid;place-items:center;cursor:pointer;font-size:2.2rem;line-height:1;background:rgb(var(--color-background));color:rgb(var(--color-foreground));box-shadow:0 .2rem .8rem rgba(0,0,0,.28)}
  .gmc-pf--rip .gmc-pf__dot{animation:gmc-pf-rip 1.8s ease-out infinite}
  @keyframes gmc-pf-rip{0%{box-shadow:0 0 0 0 rgba(var(--color-foreground),.45)}100%{box-shadow:0 0 0 1.4rem rgba(var(--color-foreground),0)}}
  @media(prefers-reduced-motion:reduce){.gmc-pf--rip .gmc-pf__dot{animation:none}}
  .gmc-pf__pop{position:absolute;top:calc(100% + .8rem);left:50%;transform:translateX(-50%);width:var(--pop-m,200px);padding:1.2rem;border-radius:1rem;background:rgb(var(--color-background));color:rgb(var(--color-foreground));box-shadow:0 .6rem 2rem rgba(0,0,0,.18);text-align:center}
  .gmc-pf__pop[hidden]{display:none}
  .gmc-pf__pop--left{text-align:left}
  .gmc-pf__pop--right{text-align:right}
  .gmc-pf__pop-title{margin:0 0 .4rem;font-size:1.6rem}
  .gmc-pf__pop-text{font-size:1.4rem}
  .gmc-pf__shot{width:100%;height:auto;display:block;border-radius:.6rem;margin-bottom:.8rem}
  .gmc-pf__pop--sm{display:flex;gap:1rem;align-items:flex-start;text-align:left}
  .gmc-pf__pop--sm .gmc-pf__shot{width:8rem;height:8rem;object-fit:cover;flex:none;margin:0}
  .gmc-pf__bp{position:absolute;left:var(--x);top:var(--y);z-index:1;color:rgb(var(--color-foreground));--elbow:0px}
  .gmc-pf__bp--bend-bottom{--elbow:3.2rem}
  .gmc-pf__bp--bend-top{--elbow:-3.2rem}
  .gmc-pf__bp-dot{position:absolute;left:0;top:0;width:1.1rem;height:1.1rem;border-radius:50%;transform:translate(-50%,-50%);background:rgb(var(--color-foreground))}
  .gmc-pf__bp-v{position:absolute;left:0;width:2px;background:currentColor;transform:translateX(-50%);display:none}
  .gmc-pf__bp--bend-bottom .gmc-pf__bp-v{display:block;top:0;height:3.2rem}
  .gmc-pf__bp--bend-top .gmc-pf__bp-v{display:block;top:-3.2rem;height:3.2rem}
  .gmc-pf__bp-h{position:absolute;top:var(--elbow);height:2px;width:4.8rem;background:currentColor;transform:translateY(-50%)}
  .gmc-pf__bp--left .gmc-pf__bp-h{right:0}
  .gmc-pf__bp--right .gmc-pf__bp-h{left:0}
  .gmc-pf__bp-card{position:absolute;top:var(--elbow);width:var(--bw,400px);transform:translateY(-50%);background:rgb(var(--color-background));color:rgb(var(--color-foreground));padding:.8rem 1rem;border-radius:.6rem;box-shadow:0 .3rem 1rem rgba(0,0,0,.12)}
  .gmc-pf__bp--left .gmc-pf__bp-card{right:4.8rem}
  .gmc-pf__bp--right .gmc-pf__bp-card{left:4.8rem}
  .gmc-pf__stage--contain .gmc-pf__bp-card{width:min(var(--bw,400px),100cqi)}
  .gmc-pf__bp-title{margin:0 0 .3rem;font-size:1.5rem}
  .gmc-pf__bp-text{font-size:1.3rem}
  @media(min-width:750px){
    .gmc-pf__layout--left,.gmc-pf__layout--right{flex-direction:row;align-items:center;justify-content:center}
    .gmc-pf__layout--left .gmc-pf__copy,.gmc-pf__layout--right .gmc-pf__copy{flex:1 1 28rem;width:auto}
    .gmc-pf__layout--right .gmc-pf__stage{order:-1}
    .gmc-pf__layout--bottom .gmc-pf__stage{order:-1}
    .gmc-pf__pop{width:var(--pop,340px)}
  }
  @media(max-width:749px){
    .gmc-pf__stage{overflow:hidden}
    .gmc-pf__layout--m-bottom .gmc-pf__stage{order:-1}
    .gmc-pf__layout--hide-m .gmc-pf__copy{display:none}
    .gmc-pf__hot--m{left:var(--xm);top:var(--ym)}
    .gmc-pf__stage--has-m .gmc-pf__dimg{display:none}
    .gmc-pf__stage--has-m .gmc-pf__mimg{display:block}
    .gmc-pf__bp-card{width:min(var(--bw,400px),60cqi)}
    .gmc-pf__bp--custom-m{left:var(--xm);top:var(--ym)}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-none{--elbow:0px}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-bottom{--elbow:3.2rem}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-top{--elbow:-3.2rem}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-none .gmc-pf__bp-v{display:none}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-bottom .gmc-pf__bp-v{display:block;top:0;height:3.2rem}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-bend-top .gmc-pf__bp-v{display:block;top:-3.2rem;height:3.2rem}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-left .gmc-pf__bp-h{left:auto;right:0}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-left .gmc-pf__bp-card{left:auto;right:4.8rem}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-right .gmc-pf__bp-h{right:auto;left:0}
    .gmc-pf__bp--custom-m.gmc-pf__bp--m-right .gmc-pf__bp-card{right:auto;left:4.8rem}
  }
</style>
<script>
  (function(){
    var root = document.getElementById('gmc-pf-{{ section.id }}');
    if (!root) return;
    var stage = root.querySelector('[data-gmc-pf-stage]');
    var hover = root.dataset.open === 'hover' && window.matchMedia('(hover:hover) and (pointer:fine)').matches;
    function shut(except){
      root.querySelectorAll('.gmc-pf__hot.is-open').forEach(function(hot){
        if (except && hot === except) return;
        var btn = hot.querySelector('.gmc-pf__dot');
        var pop = hot.querySelector('.gmc-pf__pop');
        hot.classList.remove('is-open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (pop) pop.hidden = true;
      });
    }
    function place(pop){
      pop.style.top = '';
      pop.style.bottom = '';
      pop.style.left = '50%';
      pop.style.transform = 'translateX(-50%)';
      var contain = !stage || stage.dataset.contain === 'true' || window.matchMedia('(max-width: 749px)').matches;
      if (!contain || !stage) return;
      var sb = stage.getBoundingClientRect();
      var pb = pop.getBoundingClientRect();
      var shift = 0;
      if (sb.left > pb.left) shift = sb.left - pb.left;
      if (pb.right > sb.right) shift = shift - (pb.right - sb.right);
      if (shift !== 0) pop.style.left = 'calc(50% + ' + shift + 'px)';
      if (pb.bottom > sb.bottom) {
        pop.style.top = 'auto';
        pop.style.bottom = 'calc(100% + .8rem)';
      }
    }
    function toggle(hot, on){
      var pop = hot.querySelector('.gmc-pf__pop');
      var btn = hot.querySelector('.gmc-pf__dot');
      if (!pop || !btn) return;
      if (on) {
        shut(hot);
        pop.hidden = false;
        hot.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        place(pop);
      } else {
        shut();
      }
    }
    root.querySelectorAll('.gmc-pf__hot').forEach(function(hot){
      var btn = hot.querySelector('.gmc-pf__dot');
      if (!btn) return;
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        toggle(hot, !hot.classList.contains('is-open'));
      });
      if (hover) {
        hot.addEventListener('mouseenter', function(){ toggle(hot, true); });
        hot.addEventListener('mouseleave', function(){ toggle(hot, false); });
      }
    });
    root.addEventListener('click', function(e){
      if (e.target.closest('.gmc-pf__hot')) return;
      shut();
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') shut();
    });
    var atc = root.querySelector('[data-gmc-pf-atc]');
    if (atc) {
      atc.addEventListener('click', function(){
        var form = document.querySelector('product-form');
        var submit = form && form.querySelector('[type="submit"]');
        if (submit) submit.click();
      });
    }
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Product features",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product features"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text",
      "default": "<p>Use this section to highlight key features and benefits of your product</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "secondary",
      "label": "Use outline button style",
      "default": false
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart button label",
      "info": "Leave blank to hide. On a product page this adds the variant selected on the page."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "right", "label": "Right" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "hide_content_mobile",
      "label": "Hide content on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "color_scheme",
      "id": "content_scheme",
      "label": "Content color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Main image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_max",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Image max width",
      "default": 900
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "If empty, the desktop image is used on mobile."
    },
    {
      "type": "header",
      "content": "Hotspot buttons and modals"
    },
    {
      "type": "select",
      "id": "open_on",
      "label": "Open modal on",
      "options": [
        { "value": "click", "label": "Click" },
        { "value": "hover", "label": "Hover" }
      ],
      "default": "click"
    },
    {
      "type": "color_scheme",
      "id": "dot_scheme",
      "label": "Hotspot button color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "ripple",
      "label": "Display button ripple animation",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "modal_scheme",
      "label": "Hotspot modal color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "contain",
      "label": "Contain labels inside the image",
      "info": "Keeps hotspot modals and bullet points inside the image on desktop. Mobile always keeps them inside.",
      "default": false
    },
    {
      "type": "range",
      "id": "popup_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Hotspot modal desktop width",
      "default": 340
    },
    {
      "type": "range",
      "id": "modal_width_m",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Hotspot modal mobile width",
      "default": 200
    },
    {
      "type": "header",
      "content": "Bullet points"
    },
    {
      "type": "color_scheme",
      "id": "bullet_scheme",
      "label": "Bullet point color scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "bullet_width",
      "min": 260,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Bullet point desktop maximum width",
      "default": 400
    },
    {
      "type": "header",
      "content": "Layout (GMC)"
    },
    {
      "type": "range",
      "id": "gmc_pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space above",
      "default": 36
    },
    {
      "type": "range",
      "id": "gmc_pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Extra space below",
      "default": 36
    },
    {
      "type": "range",
      "id": "gmc_max_width",
      "min": 0,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "color",
      "id": "gmc_bg_color",
      "label": "Section background color"
    },
    {
      "type": "text",
      "id": "gmc_bg_gradient",
      "label": "Section background gradient (CSS)",
      "info": "For example: linear-gradient(135deg, #ff7a18, #af002d). Overrides the colour above."
    },
    {
      "type": "image_picker",
      "id": "gmc_bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "gmc_bg_video",
      "label": "Background video (MP4 upload)"
    },
    {
      "type": "range",
      "id": "gmc_bg_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background overlay",
      "default": 0
    },
