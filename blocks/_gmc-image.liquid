{%- if block.settings.image != blank -%}
{%- capture gmc_istyle -%}width:100%;height:auto;aspect-ratio:{{ block.settings.ratio }};object-fit:cover;border-radius:{{ block.settings.radius | default: 0 }}px;object-position:{{ block.settings.image.presentation.focal_point }}{%- endcapture -%}
<figure class="gmc-b-img" style="margin:0" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', style: gmc_istyle }}</figure>
{%- elsif request.design_mode -%}<div {{ block.shopify_attributes }} style="padding:2rem;border:1px dashed currentColor;opacity:.6;text-align:center">Select an image</div>{%- endif -%}
{% schema %}
{"name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image", "info": "Recommended: 1400 px wide, any height. Tested: the theme loads it at 1400 px wide and fits it to the width of its column; the Aspect ratio setting below crops it to the shape you choose, and \"auto\" keeps your image's own shape."},{"type":"select","id":"ratio","label":"Aspect ratio","options":[{"value":"auto","label":"Original"},{"value":"1/1","label":"Square"},{"value":"4/5","label":"Portrait"},{"value":"3/2","label":"Landscape"},{"value":"16/9","label":"Wide"}],"default":"auto"},{"type":"range","id":"radius","min":0,"max":40,"unit":"px","label":"Corner radius","default":12}]}
{% endschema %}
