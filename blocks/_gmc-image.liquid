{%- if block.settings.image != blank -%}
<figure class="gmc-b-img" style="margin:0" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', style: 'width:100%;height:auto;aspect-ratio:' | append: block.settings.ratio | append: ';object-fit:cover;border-radius:' | append: block.settings.radius | append: 'px;object-position:' | append: block.settings.image.presentation.focal_point }}</figure>
{%- elsif request.design_mode -%}<div {{ block.shopify_attributes }} style="padding:2rem;border:1px dashed currentColor;opacity:.6;text-align:center">Select an image</div>{%- endif -%}
{% schema %}
{"name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"ratio","label":"Aspect ratio","options":[{"value":"auto","label":"Original"},{"value":"1/1","label":"Square"},{"value":"4/5","label":"Portrait"},{"value":"3/2","label":"Landscape"},{"value":"16/9","label":"Wide"}],"default":"auto"},{"type":"range","id":"radius","min":0,"max":40,"unit":"px","label":"Corner radius","default":12}]}
{% endschema %}
