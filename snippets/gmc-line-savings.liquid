{%- comment -%} GMC Theme: compare price + savings under each cart line (original code). Texts and colours come from the Cart items block. {%- endcomment -%}
{%- assign ci_block = section.blocks | where: 'type', 'cart_items' | first -%}
{%- assign ci = ci_block.settings -%}
{%- if settings.gmc_cart_compare and ci.show_savings != false -%}
  {%- assign cmp = item.variant.compare_at_price | times: item.quantity -%}
  {%- if item.variant.compare_at_price > item.variant.price -%}
    {%- assign save = cmp | minus: item.final_line_price -%}
    {%- assign save_money = save | money -%}
    <div class="gmc-line-save" style="font-size:1.2rem;margin-top:.3rem;text-align:right">
      <s class="gmc-line-save__old" style="opacity:.6">{{ cmp | money }}</s>
      {%- if save > 0 %} <span style="color:{{ ci.savings_color | default: settings.gmc_accent }};font-weight:600">{{ ci.savings_text | default: 'Save [amount]' | escape | replace: '[amount]', save_money }}</span>{% endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
