{% doc %}
  Sale, sold-out, and custom badges on a product card.
  @param {product} product - Product on the card
  @param {string} badge_id - Id prefix for the badge element
  @param {string} section_id - Section id used in the badge element id
  @param {string} [mode] - all, regular, custom, or disabled. Blank shows every badge.
{% enddoc %}
{%- liquid
  assign gmc_badge_mode = mode | default: 'all'
  assign gmc_show_regular = false
  if gmc_badge_mode != 'disabled' and gmc_badge_mode != 'custom'
    assign gmc_show_regular = true
  endif
-%}
<div class="card__badge {{ settings.badge_position }}">
  {%- if gmc_show_regular and product.available == false and settings.gmc_badge_show != 'sale' and settings.gmc_badge_show != 'none' -%}
    <span
      id="{{ badge_id }}-{{ section_id }}-{{ product.id }}"
      class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
    >
      {{- 'products.product.sold_out' | t -}}
    </span>
  {%- elsif gmc_show_regular and product.compare_at_price > product.price and product.available and settings.gmc_badge_show != 'soldout' and settings.gmc_badge_show != 'none' -%}
    <span
      id="{{ badge_id }}-{{ section_id }}-{{ product.id }}"
      class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
    >
      {%- render 'gmc-sale-badge', price: product.price, compare: product.compare_at_price -%}
    </span>
  {%- endif -%}
  {%- if gmc_badge_mode == 'all' or gmc_badge_mode == 'custom' -%}
    {%- render 'gmc-custom-badges', product: product -%}
  {%- endif -%}
</div>
