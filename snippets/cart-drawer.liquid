{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}"{% if section.settings.test_mode and request.design_mode %} data-gmc-test="true"{% endif %}>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      style="{% if section.settings.width > 0 %}--gmc-drawer-w:{{ section.settings.width }}px;{% endif %}{% if section.settings.width_mobile > 0 %}--gmc-drawer-wm:{{ section.settings.width_mobile }}px;{% endif %}{% if section.settings.header_bg != blank %}--gmc-hbg:{{ section.settings.header_bg }};{% endif %}{% if section.settings.body_bg != blank %}--gmc-bbg:{{ section.settings.body_bg }};{% endif %}{% if section.settings.footer_bg != blank %}--gmc-fbg:{{ section.settings.footer_bg }};{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{% if section.settings.continue_url != blank %}{{ section.settings.continue_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="button">
                {{ section.settings.continue_label | default: 'Continue shopping' | escape }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="drawer__header">
        <h2 class="drawer__heading" {% if section.settings.heading_align == 'center' %}style="flex:1;text-align:center"{% endif %}>{%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ 'sections.cart.title' | t }}{%- endif -%}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      {%- liquid
        assign gmc_items_seen = false
      -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'cart_items' -%}{%- break -%}{%- endif -%}
        {%- render 'gmc-cart-block', block: block -%}
      {%- endfor -%}
      {%- render 'gmc-cart-drawer-items' -%}
      <div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        {%- render 'gmc-cart-extras', blocks_mode: true -%}
        {%- render 'gmc-cart-upsell' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'cart_items' -%}
            {%- assign gmc_items_seen = true -%}
          {%- elsif gmc_items_seen -%}
            {%- render 'gmc-cart-block', block: block -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.continue_link and cart != empty -%}
          <p class="gmc-cont" style="text-align:center;margin:.6rem 0 1rem"><a href="{% if section.settings.continue_url != blank %}{{ section.settings.continue_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="link" onclick="var d=this.closest('cart-drawer');if(d&&d.close){d.close();}">{{ section.settings.continue_label | default: 'Continue shopping' | escape }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-drawer>
