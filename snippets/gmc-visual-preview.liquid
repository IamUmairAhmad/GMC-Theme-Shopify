{% doc %}
  Editor thumbnail shown while a merchant hovers a section in the Add section list.
  @param {string} look - Layout key such as banner, quotes, or faq
  @param {string} title - Heading used inside the thumbnail
{% enddoc %}
{{ 'gmc-visual-preview.css' | asset_url | stylesheet_tag }}
<div class="gmc-vp gmc-vp--{{ look }}" aria-label="{{ title | escape }}">
  {%- case look -%}
    {%- when 'banner', 'hero' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__center">
        <p class="gmc-vp__kicker">New arrival</p>
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">A short line about the product or the collection.</p>
        <span class="gmc-vp__btn">Shop now</span>
      </div>
    {%- when 'slideshow' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__center">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Slide one of three. The dots show the rest.</p>
        <span class="gmc-vp__btn">Shop now</span>
      </div>
      <div class="gmc-vp__dots"><i></i><i></i><i></i></div>
    {%- when 'richtext', 'article' -%}
      <div class="gmc-vp__copy">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Tell the story of the brand, the material, or the offer. This is the text block merchants edit.</p>
        <span class="gmc-vp__btn">Learn more</span>
      </div>
    {%- when 'newsletter' -%}
      <div class="gmc-vp__copy">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Join the list for new drops and early access.</p>
        <div class="gmc-vp__field"><span class="gmc-vp__input"></span><span class="gmc-vp__btn" style="margin-top:0">Join</span></div>
      </div>
    {%- when 'track' -%}
      <div class="gmc-vp__copy">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Enter the tracking number from the shipping email.</p>
        <div class="gmc-vp__field"><span class="gmc-vp__input"></span><span class="gmc-vp__btn" style="margin-top:0">Track</span></div>
      </div>
    {%- when 'imagetext' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__pad">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Pair a photo with a short explanation and a button.</p>
        <span class="gmc-vp__btn">Read more</span>
      </div>
    {%- when 'product' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__pad">
        <p class="gmc-vp__kicker">Featured</p>
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">A featured product with price, options, and add to cart.</p>
        <p class="gmc-vp__amt">$48</p>
        <span class="gmc-vp__btn">Add to cart</span>
      </div>
    {%- when 'vticker' -%}
      <div class="gmc-vp__pad">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Benefits sit beside a column of scrolling lines.</p>
        <span class="gmc-vp__btn">Shop</span>
      </div>
      <div class="gmc-vp__side gmc-vp__pad" style="background:#334fb4;color:#fff">
        <p class="gmc-vp__h" style="color:#fff;font-size:2rem">Free shipping</p>
        <p class="gmc-vp__h" style="color:#fff;font-size:2rem">Easy returns</p>
        <p class="gmc-vp__h" style="color:#fff;font-size:2rem">Secure checkout</p>
      </div>
    {%- when 'group' -%}
      <div class="gmc-vp__pad"><h2 class="gmc-vp__h">Left</h2><p class="gmc-vp__p">Two sections share this row on desktop.</p></div>
      <div class="gmc-vp__pad" style="background:#fff"><h2 class="gmc-vp__h">Right</h2><p class="gmc-vp__p">Pair any section by its ID.</p></div>
    {%- when 'columns', 'collection', 'blog' -%}
      <h2 class="gmc-vp__h" style="text-align:center">{{ title | escape }}</h2>
      <div class="gmc-vp__grid gmc-vp__grid--{% if look == 'collection' %}4{% else %}3{% endif %}" style="margin-top:1.6rem">
        {%- assign n = 3 -%}{%- if look == 'collection' -%}{%- assign n = 4 -%}{%- endif -%}
        {%- for i in (1..n) -%}
          <div>
            <div class="gmc-vp__ph{% if look == 'blog' %} gmc-vp__ph--sm{% endif %}"></div>
            <p class="gmc-vp__name">{% if look == 'blog' %}Article {{ i }}{% elsif look == 'collection' %}Product {{ i }}{% else %}Column {{ i }}{% endif %}</p>
            <p class="gmc-vp__p">{% if look == 'collection' %}$36{% else %}Short supporting text.{% endif %}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- when 'quotes' -%}
      <h2 class="gmc-vp__h" style="text-align:center">{{ title | escape }}</h2>
      <div class="gmc-vp__grid gmc-vp__grid--3" style="margin-top:1.6rem">
        {%- for i in (1..3) -%}
          <div class="gmc-vp__card">
            <p class="gmc-vp__stars">★★★★★</p>
            <p class="gmc-vp__p">“Exactly what I hoped for. Fast shipping and a beautiful finish.”</p>
            <p class="gmc-vp__name">Customer {{ i }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- when 'pricing' -%}
      <h2 class="gmc-vp__h" style="text-align:center">{{ title | escape }}</h2>
      <div class="gmc-vp__grid gmc-vp__grid--3" style="margin-top:1.6rem">
        <div class="gmc-vp__card"><p class="gmc-vp__name">Basic</p><p class="gmc-vp__amt">$19</p><p class="gmc-vp__p">For getting started</p></div>
        <div class="gmc-vp__card"><p class="gmc-vp__name">Plus</p><p class="gmc-vp__amt">$39</p><p class="gmc-vp__p">The popular choice</p></div>
        <div class="gmc-vp__card"><p class="gmc-vp__name">Pro</p><p class="gmc-vp__amt">$79</p><p class="gmc-vp__p">For the full set</p></div>
      </div>
    {%- when 'faq' -%}
      <h2 class="gmc-vp__h">{{ title | escape }}</h2>
      <div class="gmc-vp__row"><b>How long does shipping take?</b><span>−</span></div>
      <p class="gmc-vp__p" style="padding:.4rem 0 1rem">Most orders leave the studio in two business days.</p>
      <div class="gmc-vp__row"><b>What is the return window?</b><span>+</span></div>
      <div class="gmc-vp__row"><b>Do you ship internationally?</b><span>+</span></div>
    {%- when 'timeline' -%}
      <h2 class="gmc-vp__h">{{ title | escape }}</h2>
      <div class="gmc-vp__row"><b>Day 1</b> Order confirmed</div>
      <div class="gmc-vp__row"><b>Day 2</b> Packed and shipped</div>
      <div class="gmc-vp__row"><b>Day 5</b> Delivered</div>
    {%- when 'features' -%}
      <h2 class="gmc-vp__h">{{ title | escape }}</h2>
      <div class="gmc-vp__row"><span class="gmc-vp__mini"><i class="gmc-vp__ico">1</i><span><b>Material</b><br><span class="gmc-vp__p">Solid brass, made to last.</span></span></span></div>
      <div class="gmc-vp__row"><span class="gmc-vp__mini"><i class="gmc-vp__ico">2</i><span><b>Finish</b><br><span class="gmc-vp__p">Sealed by hand in small batches.</span></span></span></div>
      <div class="gmc-vp__row"><span class="gmc-vp__mini"><i class="gmc-vp__ico">3</i><span><b>Fit</b><br><span class="gmc-vp__p">Designed for everyday use.</span></span></span></div>
    {%- when 'contact' -%}
      <h2 class="gmc-vp__h">{{ title | escape }}</h2>
      <span class="gmc-vp__input"></span>
      <span class="gmc-vp__input"></span>
      <span class="gmc-vp__input" style="height:8rem"></span>
      <span class="gmc-vp__btn">Send</span>
    {%- when 'table' -%}
      <h2 class="gmc-vp__h" style="text-align:center">{{ title | escape }}</h2>
      <table>
        <tr><th></th><th>Ours</th><th>Others</th></tr>
        <tr><td>Free shipping</td><td>✓</td><td>—</td></tr>
        <tr><td>Warranty</td><td>✓</td><td>—</td></tr>
        <tr><td>Easy returns</td><td>✓</td><td>✓</td></tr>
      </table>
    {%- when 'icons', 'logos', 'results' -%}
      {%- if look == 'results' -%}
        <div class="gmc-vp__stat"><b>48k</b><span class="gmc-vp__p">Orders</span></div>
        <div class="gmc-vp__stat"><b>4.9</b><span class="gmc-vp__p">Rating</span></div>
        <div class="gmc-vp__stat"><b>12</b><span class="gmc-vp__p">Years</span></div>
      {%- elsif look == 'logos' -%}
        <b>VOGUE</b><b>FORBES</b><b>WIRED</b><b>MONOCLE</b>
      {%- else -%}
        <div class="gmc-vp__stat"><i class="gmc-vp__ico">✦</i><span>Shipping</span></div>
        <div class="gmc-vp__stat"><i class="gmc-vp__ico">✦</i><span>Returns</span></div>
        <div class="gmc-vp__stat"><i class="gmc-vp__ico">✦</i><span>Secure</span></div>
        <div class="gmc-vp__stat"><i class="gmc-vp__ico">✦</i><span>Support</span></div>
      {%- endif -%}
    {%- when 'announce', 'ticker' -%}
      <span>Free shipping</span><span>Easy returns</span><span>{{ title | escape }}</span><span>Secure checkout</span>
    {%- when 'divider' -%}
      <i></i><span>{{ title | escape }}</span><i></i>
    {%- when 'tabs' -%}
      <div class="gmc-vp__tabs"><b>Details</b><span>Shipping</span><span>Care</span></div>
      <div class="gmc-vp__pad"><h2 class="gmc-vp__h">{{ title | escape }}</h2><p class="gmc-vp__p">The open tab shows this panel. The other tabs stay one click away.</p></div>
    {%- when 'video', 'lottie' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__play"></div>
    {%- when 'shoppable' -%}
      <div class="gmc-vp__media"></div>
      <i class="gmc-vp__hot" style="left:30%;top:40%"></i>
      <i class="gmc-vp__hot" style="left:62%;top:58%"></i>
    {%- when 'before' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__media"></div>
    {%- when 'countdown' -%}
      <div class="gmc-vp__num"><b>02</b>Days</div>
      <div class="gmc-vp__num"><b>14</b>Hours</div>
      <div class="gmc-vp__num"><b>36</b>Min</div>
      <div class="gmc-vp__num"><b>08</b>Sec</div>
    {%- when 'music' -%}
      <div class="gmc-vp__disc"></div>
      <div><p class="gmc-vp__name">{{ title | escape }}</p><p class="gmc-vp__p">Track title · 1:24</p><span class="gmc-vp__btn">Play</span></div>
    {%- when 'colors' -%}
      <i class="gmc-vp__sw" style="background:#fff;border:1px solid #e6e1d8"></i>
      <i class="gmc-vp__sw" style="background:#f4f1eb"></i>
      <i class="gmc-vp__sw" style="background:#161616"></i>
      <i class="gmc-vp__sw" style="background:#334fb4"></i>
    {%- when 'sticky' -%}
      <span><b>{{ title | escape }}</b><br><span class="gmc-vp__p">$48</span></span>
      <span class="gmc-vp__btn" style="margin-top:0">Add to cart</span>
    {%- when 'popup' -%}
      <div class="gmc-vp__card">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">Take 10% off your first order.</p>
        <span class="gmc-vp__input" style="display:block;margin:1rem auto"></span>
        <span class="gmc-vp__btn">Subscribe</span>
      </div>
    {%- when 'progress' -%}
      <div class="gmc-vp__bar"></div>
      <div class="gmc-vp__pad"><h2 class="gmc-vp__h">{{ title | escape }}</h2><p class="gmc-vp__p">A thin bar tracks how far down the page the visitor has read.</p></div>
    {%- when 'stories' -%}
      {%- for i in (1..5) -%}<span class="gmc-vp__avatar"><i></i></span>{%- endfor -%}
    {%- when 'collage' -%}
      <div class="gmc-vp__media"></div>
      <div class="gmc-vp__stack"><div class="gmc-vp__media"></div><div class="gmc-vp__media"></div></div>
    {%- when 'code' -%}
      <p>{{ title | escape }}</p>
      <p>&lt;div class="offer"&gt;</p>
      <p>  Your custom code</p>
      <p>&lt;/div&gt;</p>
    {%- when 'tiktok' -%}
      <div class="gmc-vp__media"></div><div class="gmc-vp__media"></div><div class="gmc-vp__media"></div><div class="gmc-vp__media"></div>
    {%- when 'atc' -%}
      <span class="gmc-vp__btn" style="padding:1.4rem 4rem">{{ title | escape }}</span>
    {%- when 'compare' -%}
      <div class="gmc-vp__card"><div class="gmc-vp__ph"></div><p class="gmc-vp__name">Product A · $48</p></div>
      <div class="gmc-vp__card"><div class="gmc-vp__ph"></div><p class="gmc-vp__name">Product B · $62</p></div>
    {%- when 'wishlist' -%}
      {%- for i in (1..4) -%}<div><div class="gmc-vp__ph gmc-vp__ph--sm"></div><p class="gmc-vp__name">Saved {{ i }}</p></div>{%- endfor -%}
    {%- when 'orders' -%}
      <h2 class="gmc-vp__h">{{ title | escape }}</h2>
      <table>
        <tr><th>Product</th><th>Qty</th><th></th></tr>
        <tr><td>Sample product</td><td>6</td><td>Add</td></tr>
        <tr><td>Second product</td><td>2</td><td>Add</td></tr>
      </table>
    {%- when 'bundle' -%}
      <h2 class="gmc-vp__h" style="text-align:center">{{ title | escape }}</h2>
      <div class="gmc-vp__grid gmc-vp__grid--3" style="margin-top:1.6rem">
        <div class="gmc-vp__card"><div class="gmc-vp__ph gmc-vp__ph--sm"></div><p class="gmc-vp__name">1 · $48</p></div>
        <div class="gmc-vp__card"><div class="gmc-vp__ph gmc-vp__ph--sm"></div><p class="gmc-vp__name">2 · $84</p></div>
        <div class="gmc-vp__card" style="background:#161616;color:#fff"><div class="gmc-vp__ph gmc-vp__ph--sm"></div><p class="gmc-vp__name">3 · $110</p></div>
      </div>
    {%- else -%}
      <div class="gmc-vp__copy">
        <h2 class="gmc-vp__h">{{ title | escape }}</h2>
        <p class="gmc-vp__p">This section is ready to add. Open it to edit the text, media, and layout.</p>
        <span class="gmc-vp__btn">Add section</span>
      </div>
  {%- endcase -%}
</div>
