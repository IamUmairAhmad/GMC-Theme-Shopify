{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    {% # theme-check-disable %}
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {% # theme-check-enable %}
    class="{% if block.settings.full_width_dropdown %}gmc-vs--fullw{% endif %}"
    style="--gmc-sw-size:{{ block.settings.swatch_size | default: 36 }}px;--gmc-sw-r:{% case block.settings.swatch_radius %}{% when 'square' %}0{% when 'rounded' %}8px{% else %}50%{% endcase %}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign gmc_opt_name = option.name | downcase
        if gmc_opt_name contains 'color' or gmc_opt_name contains 'colour'
          assign swatch_count = swatch_count | plus: 1
        endif

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        assign gmc_ts = 'type_' | append: forloop.index
        assign gmc_ls = 'label_' | append: forloop.index
        assign gmc_type = block.settings[gmc_ts] | default: 'auto'
        assign gmc_label = block.settings[gmc_ls] | default: option.name
        assign gmc_force = ''
        assign opt_idx = forloop.index0
        assign gmc_imgmap = ''
        if gmc_type == 'pills'
          assign picker_type = 'button'
        elsif gmc_type == 'dropdown'
          assign picker_type = 'dropdown'
        elsif gmc_type == 'swatch'
          assign picker_type = 'button'
          assign gmc_force = 'swatch'
        elsif gmc_type == 'image'
          assign picker_type = 'button'
          assign gmc_force = 'image'
        elsif gmc_type == 'cards'
          assign picker_type = 'button'
          assign gmc_force = 'cards'
        endif
      -%}
      {%- if gmc_force == 'cards' -%}
        {%- capture gmc_imgmap -%}{ {%- for value in option.values -%}{%- assign vstr = value | append: '' -%}{%- assign gm_pr = '' -%}{%- for variant in product.variants -%}{%- assign vo = variant.options[opt_idx] -%}{%- if vo == vstr and gm_pr == '' -%}{%- assign gm_pr = variant.price | money -%}{%- endif -%}{%- endfor -%}{{ vstr | json }}:{{ gm_pr | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }{%- endcapture -%}
      {%- endif -%}
      {%- if gmc_force == 'image' -%}
        {%- capture gmc_imgmap -%}{ {%- for value in option.values -%}{%- assign vstr = value | append: '' -%}{%- assign gm_img = '' -%}{%- for variant in product.variants -%}{%- assign vo = variant.options[opt_idx] -%}{%- if vo == vstr and variant.featured_image and gm_img == '' -%}{%- assign gm_img = variant.featured_image | image_url: width: 120 -%}{%- endif -%}{%- endfor -%}{{ vstr | json }}:{{ gm_img | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }{%- endcapture -%}
      {%- endif -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ gmc_label | escape }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill"{% if gmc_force != blank %} data-gmc-force="{{ gmc_force }}" data-gmc-colors="{{ block.settings.swatch_colors | escape }}"{% endif %}{% if gmc_force == 'image' or gmc_force == 'cards' %} data-gmc-images="{{ gmc_imgmap | escape }}"{% endif %}>
          <legend class="form__label">{{ gmc_label | escape }}{% if gmc_force != blank %} <span data-selected-value>{{ option.selected_value }}</span>{% endif %}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ gmc_label | escape }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
