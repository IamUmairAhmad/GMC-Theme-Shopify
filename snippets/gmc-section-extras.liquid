{%- comment -%} GMC Theme: adds hide-by-device, background image and background MP4 to any section (original code). {%- endcomment -%}
{%- assign x_hide = section.settings.gmc_hide_on -%}
{%- assign x_img = section.settings.gmc_bg_image -%}
{%- assign x_vid = section.settings.gmc_bg_video -%}
{%- assign x_pt = section.settings.gmc_pad_top | default: 0 -%}
{%- assign x_pb = section.settings.gmc_pad_bottom | default: 0 -%}
{%- assign x_bgc = section.settings.gmc_bg_color -%}
{%- assign x_anchor = section.settings.gmc_anchor | handleize -%}
{%- assign x_pair = section.settings.gmc_pair_with | handleize -%}
{%- if x_anchor != blank or x_pair != blank -%}<span class="gmc-pairmark" style="display:block;height:0;overflow:hidden" {% if x_anchor != blank %}id="{{ x_anchor }}"{% endif %} data-gmc-pair="{{ x_pair }}" data-gmc-pair-rev="{{ section.settings.gmc_pair_rev }}" data-sec="shopify-section-{{ section.id }}"></span>{%- endif -%}
{%- assign x_grad = section.settings.gmc_bg_gradient -%}
{%- if x_grad contains 'gradient(' and x_grad contains ')' -%}<style>#shopify-section-{{ section.id }}{background:{{ x_grad | remove: ';' | remove: '{' | remove: '}' | remove: '<' }};}</style>{%- endif -%}
{%- assign x_tint = section.settings.gmc_card_tint | default: 0 -%}
{%- assign x_mw = section.settings.gmc_max_width | default: 0 -%}
{%- if x_tint > 0 -%}<style>#shopify-section-{{ section.id }} :is(.gmc-tm__card,.gmc-iconbar__item,.multicolumn-card,.gmc-pt__card,.gmc-pt__col){background:rgba(var(--color-foreground),{{ x_tint | divided_by: 100.0 }})!important;border-radius:var(--text-boxes-radius,8px);padding:1.2rem}</style>{%- endif -%}
{%- if x_hide != blank or x_img != blank or x_vid != blank or x_pt > 0 or x_pb > 0 or x_bgc != blank or x_mw > 0 -%}
<style>
  {%- if x_pt > 0 -%}#shopify-section-{{ section.id }}{padding-top:{{ x_pt }}px}{%- endif -%}
  {%- if x_pb > 0 -%}#shopify-section-{{ section.id }}{padding-bottom:{{ x_pb }}px}{%- endif -%}
  {%- if x_bgc != blank and x_bgc.alpha > 0 -%}#shopify-section-{{ section.id }}{background:{{ x_bgc }}}{%- endif -%}
  {%- if x_mw > 0 -%}#shopify-section-{{ section.id }} .page-width{max-width:{{ x_mw }}px}{%- endif -%}
  {%- if x_hide == 'mobile' -%}@media(max-width:749px){#shopify-section-{{ section.id }}{display:none!important}}{%- endif -%}
  {%- if x_hide == 'desktop' -%}@media(min-width:750px){#shopify-section-{{ section.id }}{display:none!important}}{%- endif -%}
  {%- if x_img != blank or x_vid != blank -%}
  #shopify-section-{{ section.id }}{position:relative;overflow:hidden}
  #shopify-section-{{ section.id }}>:not(.gmc-bg){position:relative;z-index:1;background:transparent!important}
  #shopify-section-{{ section.id }} .gmc-bg{position:absolute;inset:0;z-index:0;pointer-events:none}
  #shopify-section-{{ section.id }} .gmc-bg img,#shopify-section-{{ section.id }} .gmc-bg video{width:100%;height:100%;object-fit:cover;display:block;object-position:{{ x_img.presentation.focal_point | default: '50% 50%' }}}
  #shopify-section-{{ section.id }} .gmc-bg:after{content:"";position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.gmc_bg_overlay | divided_by: 100.0 }})}
  {%- endif -%}
</style>
{%- if x_img != blank or x_vid != blank -%}
<div class="gmc-bg" aria-hidden="true">
  {%- if x_vid != blank -%}
    <video autoplay muted loop playsinline {% if x_img != blank %}poster="{{ x_img | image_url: width: 1600 }}"{% endif %}>{%- for s in x_vid.sources -%}{%- if s.format == 'mp4' -%}<source src="{{ s.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}</video>
  {%- else -%}
    {{ x_img | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000', alt: '' }}
  {%- endif -%}
</div>
{%- endif -%}
{%- endif -%}

{%- comment -%} Swipe row on mobile + slider autoplay {%- endcomment -%}
{%- if section.settings.gmc_swipe_mobile -%}
<style>@media(max-width:749px){#shopify-section-{{ section.id }} ul.grid:not(.slider),#shopify-section-{{ section.id }} .grid.gmc-swipeable{display:flex!important;overflow-x:auto;scroll-snap-type:x mandatory;gap:1rem;padding-bottom:1rem;-webkit-overflow-scrolling:touch}#shopify-section-{{ section.id }} ul.grid:not(.slider)>li,#shopify-section-{{ section.id }} .grid.gmc-swipeable>*{flex:0 0 78%!important;max-width:78%!important;scroll-snap-align:start}}</style>
{%- endif -%}
{%- if section.settings.gmc_slider_autoplay > 0 -%}<span hidden data-gmc-autoplay="{{ section.settings.gmc_slider_autoplay }}"></span>{%- endif -%}
{%- comment -%} Add to cart button for a chosen product {%- endcomment -%}
{%- assign x_atc = section.settings.gmc_atc_product -%}
{%- if x_atc == blank and section.settings.gmc_atc_show and section.settings.product != blank -%}{%- assign x_atc = section.settings.product -%}{%- endif -%}
{%- if x_atc != blank and x_atc.available -%}
<div class="gmc-sec-atc page-width" data-gmc-sec-atc data-skip="{{ section.settings.gmc_atc_skip }}" style="text-align:{{ section.settings.gmc_atc_align | default: 'center' }};padding:1.5rem 0">
  <form class="gmc-sec-atc__f" action="{{ routes.cart_add_url }}" method="post">
    {%- if x_atc.variants.size > 1 -%}
    <select class="select__select gmc-sec-atc__v" name="id" aria-label="{{ x_atc.title | escape }} options" style="max-width:26rem;margin-bottom:1rem">
      {%- for v in x_atc.variants -%}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }} — {{ v.price | money }}</option>{%- endfor -%}
    </select><br>
    {%- else -%}<input type="hidden" name="id" value="{{ x_atc.selected_or_first_available_variant.id }}">{%- endif -%}
    <button type="submit" class="button button--primary">{{ section.settings.gmc_atc_label | default: 'Add to cart' | escape }}{%- if x_atc.variants.size == 1 -%} · {{ x_atc.price | money }}{%- endif -%}</button>
    <p class="gmc-sec-atc__m" role="status" style="margin:.8rem 0 0"></p>
  </form>
</div>
{%- endif -%}
