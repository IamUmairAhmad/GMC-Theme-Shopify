{%- comment -%} GMC Theme: per-section colour scheme marker and "Display on" device switch (original code). {%- endcomment -%}
{%- if section.settings.gmc_scheme != blank -%}<span class="gmc-sch gmc-sch-{{ section.settings.gmc_scheme }}" hidden></span>{%- endif -%}
{%- if section.settings.gmc_display_on == 'mobile' -%}<style>@media(min-width:750px){#shopify-section-{{ section.id }}{display:none!important}}</style>{%- elsif section.settings.gmc_display_on == 'desktop' -%}<style>@media(max-width:749px){#shopify-section-{{ section.id }}{display:none!important}}</style>{%- endif -%}
