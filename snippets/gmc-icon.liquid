{%- comment -%} Usage: {% render 'gmc-icon', name: 'truck', size: 28 %}. Names come from assets/gmc-icon-list.txt (Tabler Icons, MIT); common Material-style names are mapped. Optional: image (an image_picker value) draws a custom icon; filled: true fills the shapes. {%- endcomment -%}
{%- if image != blank -%}<img class="gmc-icon gmc-icon--img" src="{{ image | image_url: width: 120 }}" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" alt="" loading="lazy">
{%- elsif name != blank -%}
{%- assign nm = name | strip | downcase | replace: ' ', '-' | replace: '_', '_' -%}
{%- case nm -%}{%- when 'local_shipping' -%}{%- assign nm = 'truck' -%}{%- when 'shopping_cart' -%}{%- assign nm = 'shopping-cart' -%}{%- when 'shopping_bag' -%}{%- assign nm = 'shopping-bag' -%}{%- when 'favorite' -%}{%- assign nm = 'heart' -%}{%- when 'verified' -%}{%- assign nm = 'rosette-discount-check' -%}{%- when 'verified_user' -%}{%- assign nm = 'shield-check' -%}{%- when 'lock' -%}{%- assign nm = 'lock' -%}{%- when 'schedule' -%}{%- assign nm = 'clock' -%}{%- when 'payments' -%}{%- assign nm = 'credit-card' -%}{%- when 'credit_card' -%}{%- assign nm = 'credit-card' -%}{%- when 'mail' -%}{%- assign nm = 'mail' -%}{%- when 'call' -%}{%- assign nm = 'phone' -%}{%- when 'chat' -%}{%- assign nm = 'message' -%}{%- when 'star' -%}{%- assign nm = 'star' -%}{%- when 'done' -%}{%- assign nm = 'check' -%}{%- when 'check_circle' -%}{%- assign nm = 'circle-check' -%}{%- when 'support_agent' -%}{%- assign nm = 'headset' -%}{%- when 'redeem' -%}{%- assign nm = 'gift' -%}{%- when 'card_giftcard' -%}{%- assign nm = 'gift' -%}{%- when 'eco' -%}{%- assign nm = 'leaf' -%}{%- when 'recycling' -%}{%- assign nm = 'recycle' -%}{%- when 'bolt' -%}{%- assign nm = 'bolt' -%}{%- when 'public' -%}{%- assign nm = 'world' -%}{%- when 'location_on' -%}{%- assign nm = 'map-pin' -%}{%- when 'home' -%}{%- assign nm = 'home' -%}{%- when 'search' -%}{%- assign nm = 'search' -%}{%- when 'person' -%}{%- assign nm = 'user' -%}{%- when 'visibility' -%}{%- assign nm = 'eye' -%}{%- when 'thumb_up' -%}{%- assign nm = 'thumb-up' -%}{%- when 'autorenew' -%}{%- assign nm = 'refresh' -%}{%- when 'replay' -%}{%- assign nm = 'rotate' -%}{%- when 'percent' -%}{%- assign nm = 'percentage' -%}{%- when 'sell' -%}{%- assign nm = 'tag' -%}{%- when 'local_offer' -%}{%- assign nm = 'tag' -%}{%- when 'inventory_2' -%}{%- assign nm = 'package' -%}{%- when 'warehouse' -%}{%- assign nm = 'building-warehouse' -%}{%- when 'security' -%}{%- assign nm = 'shield' -%}{%- when 'workspace_premium' -%}{%- assign nm = 'award' -%}{%- when 'diamond' -%}{%- assign nm = 'diamond' -%}{%- when 'fitness_center' -%}{%- assign nm = 'barbell' -%}{%- when 'spa' -%}{%- assign nm = 'flower' -%}{%- when 'pets' -%}{%- assign nm = 'paw' -%}{%- when 'water_drop' -%}{%- assign nm = 'droplet' -%}{%- when 'wb_sunny' -%}{%- assign nm = 'sun' -%}{%- when 'dark_mode' -%}{%- assign nm = 'moon' -%}{%- when 'local_fire_department' -%}{%- assign nm = 'flame' -%}{%- when 'emoji_events' -%}{%- assign nm = 'trophy' -%}{%- when 'handshake' -%}{%- assign nm = 'heart-handshake' -%}{%- endcase -%}
{%- assign nm = nm | handleize -%}
<svg class="gmc-icon{% if filled or settings.gmc_icon_filled %} gmc-icon--fill{% endif %}" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" aria-hidden="true" focusable="false"><use href="#gmc-i-{{ nm }}"></use></svg>
{%- endif -%}
